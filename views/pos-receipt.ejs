<%- include('partials/header') %>

<div class="pos-receipt-page-wrapper" style="display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 20px auto;">
    <div class="pos-receipt-card" style="width: 100%; max-width: 380px; background: #ffffff; padding: 20px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08); border: 1px solid #e2e8f0; margin: 0 auto; font-family: Arial, sans-serif; color: #1e293b; box-sizing: border-box; position: relative;">
        <% if (tx.isDeleted) { %>
            <div style="position: absolute; top: 40%; left: 50%; transform: translate(-50%, -50%) rotate(-30deg); font-size: 40px; font-weight: bold; color: rgba(255, 0, 0, 0.2); z-index: 10; pointer-events: none; white-space: nowrap; border: 4px solid rgba(255, 0, 0, 0.2); padding: 10px; border-radius: 8px;">CANCELLED</div>
        <% } %>

        <div style="text-align: center; border-bottom: 2px dashed #cbd5e1; padding-bottom: 12px; margin-bottom: 14px;">
            <img src="/images/logo.png" alt="Nelna Logo" style="height: 48px; width: auto; object-fit: contain; margin-bottom: 4px; display: inline-block;">
            <div style="font-size: 15px; font-weight: 700; color: #0f172a;">Nelna Agri Development (Pvt) Ltd</div>
            <div style="font-size: 13px; font-weight: 600; color: #334155; margin-top: 2px; text-transform: uppercase;">Tray Transaction Receipt</div>
            <div style="font-size: 10px; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;">Store Operations Log (POS Thermal)</div>
        </div>

        <div style="display: flex; justify-content: space-between; font-size: 11px; color: #475569; margin-bottom: 12px; padding-bottom: 6px; border-bottom: 1px dashed #cbd5e1;">
            <div>
                <strong>Receipt No:</strong> RE-<%= String(tx.receiptNo || 0).padStart(6, '0') %><br>
                <strong>Created:</strong> <%= tx.user %>
            </div>
            <div style="text-align: right;">
                <strong>Date:</strong> <%= new Date(tx.date).toLocaleDateString() %><br>
                <strong>Time:</strong> <%= new Date(tx.date).toLocaleTimeString() %>
            </div>
        </div>

        <% 
            var isOut = (tx && tx.type === 'OUT'); 
            var rate = Number(tx && tx.depositPerTray) || 2000; 
            var countQty = Number(tx && tx.count) || 0; 
            var totalTrayDeposit = Number(tx && tx.expectedDeposit) || (countQty * rate); 
            var paidAmt = 0; 
            if (tx && tx.totalDeposit !== undefined && tx.totalDeposit !== null && tx.totalDeposit !== '') { 
                paidAmt = Number(tx.totalDeposit); 
            } else if (tx && tx.depositOption === 'ZERO') { 
                paidAmt = 0; 
            } else if (tx && tx.depositOption === 'HALF') { 
                paidAmt = totalTrayDeposit / 2; 
            } else { 
                paidAmt = totalTrayDeposit; 
            } 
            var pendingAmt = totalTrayDeposit - paidAmt; 
        %>

        <table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 12px;">
            <tr>
                <td style="padding: 4px 0; color: #475569; width: 48%;">Customer Name</td>
                <td style="padding: 4px 0; text-align: right; color: #0f172a; width: 52%;"><strong><%= customer ? customer.name : tx.customerName %></strong></td>
            </tr>
            <tr>
                <td style="padding: 4px 0; color: #475569;">Contact Number</td>
                <td style="padding: 4px 0; text-align: right; color: #0f172a;"><%= customer ? customer.phone : '-' %></td>
            </tr>
            <tr>
                <td style="padding: 4px 0; color: #475569;">Transaction Type</td>
                <td style="padding: 4px 0; text-align: right;">
                    <span class="badge badge-<%= tx.type === 'IN' ? 'in' : 'out' %>" style="font-size: 10px; padding: 3px 8px;">
                        <%= tx.type==='IN' ? 'TRAY RETURN (IN)' : 'TRAY ISSUE (OUT)' %>
                    </span>
                </td>
            </tr>
            <tr>
                <td style="padding: 4px 0; color: #475569; font-weight: 600;">Tray Quantity</td>
                <td style="padding: 4px 0; text-align: right; color: #0f172a;"><strong><%= tx.count %> Trays</strong></td>
            </tr>
            <tr>
                <td style="padding: 4px 0; color: #475569;">Rate</td>
                <td style="padding: 4px 0; text-align: right; color: #0f172a;">Rs. <%= (tx.depositPerTray || 2000).toLocaleString() %> / Tray</td>
            </tr>
            <tr>
                <td style="padding: 4px 0; color: #475569; font-weight: 600;"><%= isOut ? 'Total Payable Amount' : 'Total Refundable Amount' %></td>
                <td style="padding: 4px 0; text-align: right; color: #0f172a;"><strong>Rs. <%= totalTrayDeposit.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %></strong></td>
            </tr>
            <tr>
                <td style="padding: 4px 0; color: #475569; font-weight: 600;"><%= isOut ? 'Deposit Amount' : 'Refund Amount' %></td>
                <td style="padding: 4px 0; text-align: right;">
                    <strong style="color: <%= isOut ? '#b28900' : '#2e7d32' %>;">
                        Rs. <%= paidAmt.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                    </strong>
                </td>
            </tr>
            <tr>
                <td style="padding: 4px 0; color: #475569; font-weight: 600;"><%= isOut ? 'Pending Deposit Balance' : 'Pending Refund Balance' %></td>
                <td style="padding: 4px 0; text-align: right;">
                    <strong style="color: <%= pendingAmt > 0 ? '#d32f2f' : '#2e7d32' %>;">
                        Rs. <%= Math.abs(pendingAmt).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                    </strong>
                </td>
            </tr>
            <tr>
                <td style="padding: 4px 0; color: #475569;">Payment Mode</td>
                <td style="padding: 4px 0; text-align: right; color: #0f172a;">
                    <% if (tx.depositOption==='CUSTOM' || (paidAmt> 0 && paidAmt !== totalTrayDeposit && paidAmt !== totalTrayDeposit / 2)) { %>
                        Custom
                    <% } else if (tx.depositOption==='HALF' || (paidAmt===totalTrayDeposit / 2 && paidAmt> 0)) { %>
                        Half Payment (50%)
                    <% } else if (tx.depositOption==='ZERO' || paidAmt===0) { %>
                        No Deposit (0%)
                    <% } else { %>
                        Full Deposit (100%)
                    <% } %>
                </td>
            </tr>
            <tr>
                <td style="padding: 4px 0; color: #475569;">Vehicle No</td>
                <td style="padding: 4px 0; text-align: right; color: #0f172a;"><code><%= tx.vehicleNo %></code></td>
            </tr>
            <% if (tx.remarks) { %>
            <tr>
                <td style="padding: 4px 0; color: #475569;">Remarks</td>
                <td style="padding: 4px 0; text-align: right; color: #0f172a; font-style: italic;"><%= tx.remarks %></td>
            </tr>
            <% } %>
        </table>

        <!-- POS Statement Highlight Box -->
        <div style="background: <%= isOut ? '#fffbea' : '#e8f5e9' %>; border: 1.5px solid <%= isOut ? '#ffc107' : '#66bb6a' %>; border-radius: 6px; padding: 10px; margin: 12px 0;">
            <div style="font-weight: 700; font-size: 12.5px; color: #333;">
                <%= isOut ? 'Deposit Statement:' : 'Refund Statement:' %>
            </div>
            <div style="font-size: 11px; color: #555; margin-top: 2px;">
                Total: <%= countQty %> Trays × Rs. <%= rate.toLocaleString() %> = <strong>Rs. <%= totalTrayDeposit.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %></strong>
            </div>
            <div style="font-size: 11px; margin-top: 2px; font-weight: 600; color: <%= pendingAmt > 0 ? '#d32f2f' : '#2e7d32' %>;">
                <%= isOut ? 'Pending Unpaid:' : 'Pending Unrefunded:' %> Rs. <%= Math.abs(pendingAmt).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
            </div>
            <div style="font-size: 18px; font-weight: 900; margin-top: 4px; text-align: right; color: <%= isOut ? '#b28900' : '#2e7d32' %>;">
                Rs. <%= paidAmt.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
            </div>
        </div>

        <!-- POS Net Balance Box (Centered) -->
        <div style="padding: 10px 12px; background-color: #f1f5f9; border-radius: 6px; font-size: 11.5px; border: 1px dashed #94a3b8; margin-bottom: 12px; text-align: center;">
            <div>
                <strong>Customer's Net Tray Balance:</strong>
                <span style="font-weight: 700; color: <%= (customer && customer.currentBalance > 0) ? '#d32f2f' : '#2e7d32' %>">
                    <%= customer ? customer.currentBalance : 0 %> Trays Outstanding
                </span>
            </div>
            <div style="margin-top: 4px; padding-top: 4px; border-top: 1px dashed #cbd5e1;">
                <strong>Pending Deposit Balance:</strong>
                <span style="font-weight: 700; color: <%= (typeof totalCustomerPendingDeposit !== 'undefined' ? totalCustomerPendingDeposit : pendingAmt) > 0 ? '#d32f2f' : '#2e7d32' %>">
                    Rs. <%= (typeof totalCustomerPendingDeposit !== 'undefined' ? totalCustomerPendingDeposit : pendingAmt).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                </span>
            </div>
        </div>

        <div style="display: flex; justify-content: space-between; margin-top: 30px; gap: 8px;">
            <div style="flex: 1; border-top: 1px solid #64748b; text-align: center; padding-top: 4px; font-size: 10px; color: #475569;">Created By</div>
            <div style="flex: 1; border-top: 1px solid #64748b; text-align: center; padding-top: 4px; font-size: 10px; color: #475569;">Checked By</div>
            <div style="flex: 1; border-top: 1px solid #64748b; text-align: center; padding-top: 4px; font-size: 10px; color: #475569;">Received By</div>
        </div>
    </div>

    <div class="print-actions" style="text-align: center; margin-top: 20px; display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
        <button onclick="window.print()" class="btn btn-primary" style="padding: 12px 24px; background: #144d37;">
            <i class="fa-solid fa-print"></i> Print POS Receipt (80mm)
        </button>
        <a href="/transactions/<%= tx._id || tx.id %>/receipt" class="btn btn-secondary" style="padding: 12px 24px;">
            <i class="fa-solid fa-file-invoice"></i> Dot-Matrix Receipt (5.5" x 8.0")
        </a>
        <a href="/transactions" class="btn btn-secondary" style="padding: 12px 24px;">
            <i class="fa-solid fa-arrow-left"></i> Back to Logs
        </a>
    </div>
</div>

<%- include('partials/footer') %>
