            <div id="breakupPrintArea" class="table-responsive">
                <table
                    style="width: 100%; border-collapse: collapse; margin-bottom: 15px; background-color: #f9f9f9; border-radius: 8px; border: 1px solid #eee;">
                    <tr>
                        <td style="padding: 10px 15px;"><strong>Opening Tray Balance:</strong> <span
                                id="breakupInitialBal" style="font-weight: 700; color: #333;">0</span> Trays</td>
                        <td style="padding: 10px 15px;"><strong>Current Net Balance:</strong> <span
                                id="breakupCurrentBal" style="font-weight: 700;">0</span> Trays</td>
                        <td style="padding: 10px 15px;"><strong>Refundable Outstanding (Rs.):</strong> <span
                                id="breakupDepositOut" style="font-weight: 700;">Rs. 0.00</span></td>
                    </tr>
