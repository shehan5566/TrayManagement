    <!-- JSON Data Containers for Client-side JS -->
    <script id="allTransactionsJson"
        type="application/json"><%- JSON.stringify(typeof allTransactions !== 'undefined' ? allTransactions : []) %></script>
    <script id="customerBalancesJson" type="application/json"><%- JSON.stringify(customerBalances) %></script>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <!-- SheetJS Library for Client-side Excel (.xlsx) Export -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

    <script>
        $(document).ready(function () {
            const tableConfig = {
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                language: {
                    search: "Quick Search:"
                }
            };
            $('#balanceTable').DataTable(tableConfig);
            $('#reportOutTable').DataTable(tableConfig);
            $('#reportInTable').DataTable(tableConfig);
            $('#stockTransferTable').DataTable(tableConfig);
            $('#receiveStockTable').DataTable(tableConfig);
        });
    </script>

    <script>
        const allTransactionsData = JSON.parse(document.getElementById('allTransactionsJson').textContent || '[]');
        const customerBalancesData = JSON.parse(document.getElementById('customerBalancesJson').textContent || '[]');
        let currentBreakupCustomer = null;

        async function viewCustomerBreakup(customerId) {
            const cust = customerBalancesData.find(c => c.id === customerId);
            if (!cust) return;

            currentBreakupCustomer = cust;
            document.getElementById('breakupCustomerName').innerHTML = '<i class="fa-solid fa-user"></i> Date Breakup Statement: ' + cust.name;
            document.getElementById('breakupCustomerMeta').textContent = 'Phone: ' + (cust.phone || 'N/A') + ' | Customer ID: #' + cust.id;
            document.getElementById('breakupInitialBal').textContent = cust.initialBalance;
            document.getElementById('breakupCurrentBal').textContent = cust.currentBalance + ' Trays';
            document.getElementById('breakupCurrentBal').style.color = cust.currentBalance > 0 ? 'var(--danger)' : 'var(--success)';
            document.getElementById('breakupDepositOut').textContent = 'Rs. ' + (cust.depositOutstanding || 0).toLocaleString('en-LK', { minimumFractionDigits: 2 });
            document.getElementById('breakupDepositOut').style.color = (cust.depositOutstanding || 0) > 0 ? 'var(--danger)' : 'var(--success)';

            const tbody = document.getElementById('breakupTableBody');
            tbody.innerHTML = '<tr><td colspan="10" style="text-align:center; padding:25px;"><i class="fa-solid fa-spinner fa-spin"></i> Loading statement data...</td></tr>';

            document.getElementById('breakupModal').style.display = 'flex';

            try {
                const response = await fetch(`/api/customers/${customerId}/transactions`);
                const custTxs = await response.json();

                tbody.innerHTML = '';
                let runningTrayBal = cust.initialBalance;

                if (custTxs.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="10" style="text-align:center; padding:25px; color:#777;">No transaction records found for this customer. (Opening Balance: ${cust.initialBalance} Trays)</td></tr>`;
                } else {
                    custTxs.forEach(t => {
                        const isOut = (t.type === 'OUT');
                        if (isOut) {
                            runningTrayBal += t.count;
                        } else {
                            runningTrayBal -= t.count;
                        }

                        const receiptNo = 'RE-' + String(t.receiptNo || 0).padStart(6, '0');
                        const tr = document.createElement('tr');
                        tr.style.borderBottom = '1px solid #eee';
                        tr.style.backgroundColor = isOut ? '#fffcf5' : '#f6fff8';

                        tr.innerHTML = `
                            <td style="padding: 10px; font-size: 13px;">${new Date(t.date).toLocaleString()}</td>
                            <td style="padding: 10px;"><code>${receiptNo}</code></td>
                            <td style="padding: 10px; text-align: center;">
                                <span class="badge badge-${isOut ? 'out' : 'in'}" style="font-size: 11px; padding: 4px 8px; font-weight: 700;">
                                    ${isOut ? 'TRAY ISSUE (OUT)' : 'TRAY RETURN (IN)'}
                                </span>
                            </td>
                            <td style="padding: 10px;"><code>${t.vehicleNo || '-'}</code></td>
                            <td style="padding: 10px; text-align: right; color: #c62828; font-weight: bold; background-color: ${isOut ? '#ffebee' : 'transparent'};">${isOut ? t.count : '-'}</td>
                            <td style="padding: 10px; text-align: right; color: #2e7d32; font-weight: bold; background-color: ${!isOut ? '#e8f5e9' : 'transparent'};">${!isOut ? t.count : '-'}</td>
                            <td style="padding: 10px; text-align: right; font-weight: bold; color: ${runningTrayBal > 0 ? '#c62828' : '#2e7d32'};">${runningTrayBal}</td>
                            <td style="padding: 10px; text-align: right; font-weight: bold; color: #c62828; background-color: ${isOut && t.totalDeposit ? '#ffebee' : 'transparent'};">${isOut ? (t.totalDeposit || 0).toLocaleString() : '-'}</td>
                            <td style="padding: 10px; text-align: right; font-weight: bold; color: #2e7d32; background-color: ${!isOut && t.totalDeposit ? '#e8f5e9' : 'transparent'};">${!isOut ? (t.totalDeposit || 0).toLocaleString() : '-'}</td>
                            <td style="padding: 10px; font-size: 13px;"><strong>${t.user || 'admin'}</strong> ${t.remarks ? '<br><small style="color:#666;">' + t.remarks + '</small>' : ''}</td>
                        `;
                        tbody.appendChild(tr);
                    });
                }
            } catch (e) {
                tbody.innerHTML = '<tr><td colspan="10" style="text-align:center; padding:25px; color:red;">Failed to load statement. Please try again.</td></tr>';
            }
        }

        function closeBreakupModal() {
            document.getElementById('breakupModal').style.display = 'none';
        }

        window.onclick = function (event) {
            const modal = document.getElementById('breakupModal');
            if (event.target === modal) {
                modal.style.display = 'none';
            }
        }

        function exportCustomerBreakupExcel() {
            if (!currentBreakupCustomer) return;
            const table = document.getElementById('breakupTable');
            const wb = XLSX.utils.table_to_book(table, { sheet: "Date Breakup" });
            XLSX.writeFile(wb, `${currentBreakupCustomer.name.replace(/[^a-zA-Z0-9]/g, '_')}_Date_Breakup_${new Date().toISOString().slice(0, 10)}.xlsx`);
        }

        function printReportToPDF(title, tableId) {
            const tableElement = document.getElementById(tableId);
            if (!tableElement) return;
            const content = tableElement.outerHTML;
            triggerPrintWindow(title, content);
        }

        function triggerPrintWindow(title, content) {
            const win = window.open('', '', 'height=800,width=1000');
            const today = new Date().toLocaleDateString('en-CA');
            win.document.write(`
                <html>
                    <head>
                        <title>${title} - ${today}</title>
                        <style>
                            @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');
                            body { 
                                font-family: 'Inter', sans-serif; 
                                padding: 40px; 
                                color: #333;
                                background: #fff;
                            }
                            .letterhead {
                                display: flex;
                                align-items: center;
                                border-bottom: 3px solid #1b5e20;
                                padding-bottom: 20px;
                                margin-bottom: 30px;
                            }
                            .letterhead-img {
                                width: 80px;
                                height: 80px;
                                object-fit: contain;
                                margin-right: 20px;
                            }
                            .letterhead-text h1 {
                                margin: 0;
                                color: #1b5e20;
                                font-size: 26px;
                                text-transform: uppercase;
                                font-weight: 700;
                            }
                            .letterhead-text p {
                                margin: 5px 0 0 0;
                                font-size: 14px;
                                color: #555;
                            }
                            .report-title {
                                font-size: 20px;
                                font-weight: 600;
                                margin-bottom: 5px;
                                color: #222;
                            }
                            .report-meta {
                                font-size: 13px;
                                color: #666;
                                margin-bottom: 25px;
                            }
                            table { 
                                width: 100%; 
                                border-collapse: collapse; 
                                font-size: 12px; 
                            }
                            th, td { 
                                border: 1px solid #ddd; 
                                padding: 10px; 
                                text-align: left; 
                            }
                            th { 
                                background-color: #1b5e20 !important; /* Force print color */
                                color: white !important;
                                -webkit-print-color-adjust: exact; 
                                print-color-adjust: exact;
                            }
                            tr:nth-child(even) { background-color: #f9f9f9 !important; -webkit-print-color-adjust: exact; }
                            
                            /* Clean up UI elements from tables during print */
                            button, .btn, form { display: none !important; }
                        </style>
                    </head>
                    <body>
                        <div class="letterhead">
                            <!-- Try relative path for print window context -->
                            <img src="${window.location.origin}/images/logo.png" class="letterhead-img" alt="Nelna Logo" onerror="this.style.display='none'">
                            <div class="letterhead-text">
                                <h1>Nelna Agri Development (Pvt) Ltd</h1>
                                <p>No. 70, Nelna Farm, Ogodapola, Sri Lanka | Phone: 077 345 6789</p>
                                <p>Tray Management System - Official Report</p>
                            </div>
                        </div>
                        <h2 class="report-title">${title}</h2>
                        <div class="report-meta">Printed on: ${new Date().toLocaleString()}</div>
                        ${content}
                    </body>
                </html>
            `);
            win.document.close();
            win.focus();
            // Wait for image to load before printing
            setTimeout(() => {
                win.print();
                // Close after a brief delay so user can interact with print dialog
                setTimeout(() => { win.close(); }, 1000);
            }, 800);
        }

        function printCustomerBreakup() {
            const content = document.getElementById('breakupPrintArea').innerHTML;
            const name = currentBreakupCustomer ? currentBreakupCustomer.name : 'Customer';
            triggerPrintWindow(`Date Breakup Statement: ${name}`, content);
        }

        function exportCustomerBalancesDetailedExcel() {
            const wb = XLSX.utils.book_new();

            // 1. Balance Summary Sheet
            const summaryData = [
                ["Customer Name", "Phone", "Opening Balance", "Total Issued (Out)", "Total Returned (In)", "Closing Balance", "Deposit Collected (Rs.)", "Deposit Refunded (Rs.)", "Deposit Outstanding (Rs.)"]
            ];

            customerBalancesData.forEach(cb => {
                summaryData.push([
                    cb.name,
                    cb.phone || '',
                    cb.initialBalance,
                    cb.totalOut,
                    cb.totalIn,
                    cb.currentBalance,
                    cb.depositCollected || 0,
                    cb.depositRefunded || 0,
                    cb.depositOutstanding || 0
                ]);
            });

            const wsSummary = XLSX.utils.aoa_to_sheet(summaryData);
            XLSX.utils.book_append_sheet(wb, wsSummary, "Balance Summary");

            // 2. Detailed Transactions Breakup per Customer Sheet
            const breakdownData = [
                ["Customer Name", "Receipt No", "Date & Time", "Type", "Vehicle No", "Quantity Issued (Out)", "Quantity Returned (In)", "Running Tray Balance", "Deposit Collected (Rs.)", "Deposit Refunded (Rs.)", "Deposit Option Mode", "Operator", "Remarks"]
            ];

            customerBalancesData.forEach(cb => {
                const custTxs = allTransactionsData
                    .filter(t => t.customerId === cb.id)
                    .sort((a, b) => new Date(a.date) - new Date(b.date));

                let runningTrayBal = cb.initialBalance;

                if (custTxs.length === 0) {
                    breakdownData.push([
                        cb.name,
                        "-",
                        "-",
                        "NO TRANSACTIONS",
                        "-",
                        0,
                        0,
                        runningTrayBal,
                        0,
                        0,
                        "-",
                        "-",
                        `Opening Balance: ${cb.initialBalance} Trays`
                    ]);
                } else {
                    custTxs.forEach(t => {
                        const isOut = (t.type === 'OUT');
                        if (isOut) {
                            runningTrayBal += t.count;
                        } else {
                            runningTrayBal -= t.count;
                        }

                        const receiptNo = 'RE-' + String(t.receiptNo || 0).padStart(6, '0');

                        breakdownData.push([
                            cb.name,
                            receiptNo,
                            new Date(t.date).toLocaleString(),
                            isOut ? 'TRAY ISSUE (OUT)' : 'TRAY RETURN (IN)',
                            t.vehicleNo || '-',
                            isOut ? t.count : 0,
                            !isOut ? t.count : 0,
                            runningTrayBal,
                            isOut ? (t.totalDeposit || 0) : 0,
                            !isOut ? (t.totalDeposit || 0) : 0,
                            t.depositOption || 'FULL',
                            t.user || 'admin',
                            t.remarks || ''
                        ]);
                    });
                }
            });

            const wsBreakdown = XLSX.utils.aoa_to_sheet(breakdownData);

            // Apply Excel Cell Highlights for IN / OUT and Deposit Collected / Refunded
            if (wsBreakdown['!ref']) {
                const range = XLSX.utils.decode_range(wsBreakdown['!ref']);
                for (let R = range.s.r; R <= range.e.r; ++R) {
                    const typeCell = wsBreakdown[XLSX.utils.encode_cell({ r: R, c: 3 })];
                    const typeVal = typeCell ? String(typeCell.v) : '';
                    const isOutRow = typeVal.includes('OUT');
                    const isInRow = typeVal.includes('IN');

                    for (let C = range.s.c; C <= range.e.c; ++C) {
                        const cellRef = XLSX.utils.encode_cell({ r: R, c: C });
                        if (!wsBreakdown[cellRef]) continue;

                        if (R === 0) {
                            // Header Row
                            if (C === 3 || C === 5 || C === 8) {
                                wsBreakdown[cellRef].s = {
                                    fill: { fgColor: { rgb: "B71C1C" } },
                                    font: { color: { rgb: "FFFFFF" }, bold: true }
                                };
                            } else if (C === 6 || C === 9) {
                                wsBreakdown[cellRef].s = {
                                    fill: { fgColor: { rgb: "1B5E20" } },
                                    font: { color: { rgb: "FFFFFF" }, bold: true }
                                };
                            } else {
                                wsBreakdown[cellRef].s = {
                                    fill: { fgColor: { rgb: "2E7D32" } },
                                    font: { color: { rgb: "FFFFFF" }, bold: true }
                                };
                            }
                        } else {
                            // Data Rows
                            if (C === 3) { // Type Column
                                if (isOutRow) {
                                    wsBreakdown[cellRef].s = {
                                        fill: { fgColor: { rgb: "FFCDD2" } },
                                        font: { color: { rgb: "B71C1C" }, bold: true }
                                    };
                                } else if (isInRow) {
                                    wsBreakdown[cellRef].s = {
                                        fill: { fgColor: { rgb: "C8E6C9" } },
                                        font: { color: { rgb: "1B5E20" }, bold: true }
                                    };
                                }
                            } else if (C === 5 || C === 8) { // Issued (Out) & Deposit Collected
                                if (isOutRow && Number(wsBreakdown[cellRef].v) > 0) {
                                    wsBreakdown[cellRef].s = {
                                        fill: { fgColor: { rgb: "FFEBEE" } },
                                        font: { color: { rgb: "C62828" }, bold: true }
                                    };
                                }
                            } else if (C === 6 || C === 9) { // Returned (In) & Deposit Refunded
                                if (isInRow && Number(wsBreakdown[cellRef].v) > 0) {
                                    wsBreakdown[cellRef].s = {
                                        fill: { fgColor: { rgb: "E8F5E9" } },
                                        font: { color: { rgb: "2E7D32" }, bold: true }
                                    };
                                }
                            }
                        }
                    }
                }
            }

            XLSX.utils.book_append_sheet(wb, wsBreakdown, "Detailed Customer Transactions");

            XLSX.writeFile(wb, `Customer_Balances_With_Detailed_Transactions_${new Date().toISOString().slice(0, 10)}.xlsx`);
        }

        function exportTableToExcel(tableID, filename) {
            const table = document.getElementById(tableID);
            if (!table) return;
            const wb = XLSX.utils.table_to_book(table, { sheet: filename });
            XLSX.writeFile(wb, `${filename}_${new Date().toISOString().slice(0, 10)}.xlsx`);
        }

        function exportAllReportsToExcel() {
            const wb = XLSX.utils.book_new();

            const balanceTable = document.getElementById('balanceTable');
            if (balanceTable) {
                const ws1 = XLSX.utils.table_to_sheet(balanceTable);
                XLSX.utils.book_append_sheet(wb, ws1, "Customer Balances");
            }

            const outTable = document.getElementById('reportOutTable');
            if (outTable) {
                const ws2 = XLSX.utils.table_to_sheet(outTable);
                XLSX.utils.book_append_sheet(wb, ws2, "Tray Issues (OUT)");
            }

            const inTable = document.getElementById('reportInTable');
            if (inTable) {
                const ws3 = XLSX.utils.table_to_sheet(inTable);
                XLSX.utils.book_append_sheet(wb, ws3, "Tray Returns (IN)");
            }

            const damagesTable = document.getElementById('damagesReportTable');
            if (damagesTable) {
                const ws4 = XLSX.utils.table_to_sheet(damagesTable);
                XLSX.utils.book_append_sheet(wb, ws4, "Tray Damages & Loss");
            }

            XLSX.writeFile(wb, `Nelna_Agri_Tray_Reports_${new Date().toISOString().slice(0, 10)}.xlsx`);
        }

        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const showBreakupId = urlParams.get('showBreakup');
            if (showBreakupId) {
                viewCustomerBreakup(showBreakupId);
            }

            // Tab switching & date filter tab persistence
            const serverActiveTab = "<%= typeof activeTab !== 'undefined' ? activeTab : 'balanceReport' %>";
            const tabBtns = document.querySelectorAll('.tabs .tab-btn');
            const tabContents = document.querySelectorAll('.tab-content');
            const activeInput = document.getElementById('reportsActiveTabInput');

            function switchReportTab(targetId) {
                if (!targetId || !document.getElementById(targetId)) return;
                tabBtns.forEach(b => b.classList.remove('active'));
                tabContents.forEach(c => c.classList.remove('active'));

                const targetBtn = document.querySelector(`.tab-btn[data-tab="${targetId}"]`);
                const targetContent = document.getElementById(targetId);
                if (targetBtn) targetBtn.classList.add('active');
                if (targetContent) targetContent.classList.add('active');
                if (activeInput) activeInput.value = targetId;
            }

            tabBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    const targetId = btn.dataset.tab;
                    switchReportTab(targetId);
                });
            });

            if (serverActiveTab && serverActiveTab !== 'balanceReport') {
                switchReportTab(serverActiveTab);
            }
        });
    </script>

    <%- include('partials/footer') %>