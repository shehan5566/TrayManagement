                <table id="breakupTable" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background-color: var(--primary-green); color: white;">
                            <th style="padding: 10px; text-align: left;">Date & Time</th>
                            <th style="padding: 10px; text-align: left;">Receipt No</th>
                            <th style="padding: 10px; text-align: center;">Type</th>
                            <th style="padding: 10px; text-align: left;">Vehicle No</th>
                            <th style="padding: 10px; text-align: right; background-color: #b71c1c; color: white;">
                                Issued (Out)</th>
                            <th style="padding: 10px; text-align: right; background-color: #1b5e20; color: white;">
                                Returned (In)</th>
                            <th style="padding: 10px; text-align: right;">Running Tray Balance</th>
                            <th style="padding: 10px; text-align: right; background-color: #b71c1c; color: white;">
                                Deposit Collected (Rs.)</th>
                            <th style="padding: 10px; text-align: right; background-color: #1b5e20; color: white;">
                                Deposit Refunded (Rs.)</th>
