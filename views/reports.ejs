    <script>
        let allTransactionsData = [];
        let customerBalancesData = [];
        try {
            const el1 = document.getElementById('allTransactionsJson');
            if (el1 && el1.textContent) allTransactionsData = JSON.parse(el1.textContent);
        } catch (e) { console.error('Error parsing allTransactionsJson:', e); }

        try {
            const el2 = document.getElementById('customerBalancesJson');
            if (el2 && el2.textContent) customerBalancesData = JSON.parse(el2.textContent);
        } catch (e) { console.error('Error parsing customerBalancesJson:', e); }

        let currentBreakupCustomer = null;

        window.viewCustomerBreakup = async function (customerId, btnEl) {
            console.log('window.viewCustomerBreakup called for customerId:', customerId);
            
            // Move modal to body so nested parent divs never trap or obscure it
            const modal = document.getElementById('breakupModal');
            if (modal) {
                if (modal.parentElement !== document.body) {
                    document.body.appendChild(modal);
                }
                modal.style.setProperty('display', 'flex', 'important');
                modal.style.setProperty('z-index', '99999999', 'important');
                modal.style.setProperty('position', 'fixed', 'important');
                modal.style.setProperty('top', '0', 'important');
                modal.style.setProperty('left', '0', 'important');
                modal.style.setProperty('width', '100vw', 'important');
                modal.style.setProperty('height', '100vh', 'important');
                modal.style.setProperty('background-color', 'rgba(0,0,0,0.6)', 'important');
                modal.style.setProperty('overflow-y', 'auto', 'important');
            }

            // Flexible string-based ID lookup
            let cust = (customerBalancesData || []).find(c => String(c.id || c._id) === String(customerId));

            // If not found in customerBalancesData array, extract details directly from the table row if btnEl provided
            if (!cust && btnEl) {
                try {
                    const tr = btnEl.closest('tr');
                    if (tr) {
                        const tds = tr.querySelectorAll('td');
                        const name = tds[0] ? tds[0].innerText.trim() : 'Customer #' + customerId;
                        const phone = tds[1] ? tds[1].innerText.trim() : '';
                        const initialBalance = tds[2] ? parseFloat(tds[2].innerText.replace(/,/g, '')) || 0 : 0;
                        const currentBalance = tds[5] ? parseFloat(tds[5].innerText.replace(/,/g, '')) || 0 : 0;
                        const initialDeposit = tds[6] ? parseFloat(tds[6].innerText.replace(/,/g, '')) || 0 : 0;
                        const depositOutstanding = tds[9] ? parseFloat(tds[9].innerText.replace(/,/g, '')) || 0 : 0;
                        const pendingDeposit = tds[10] ? parseFloat(tds[10].innerText.replace(/,/g, '')) || 0 : 0;

                        cust = {
                            id: customerId,
                            name,
                            phone,
                            initialBalance,
                            initialDeposit,
                            currentBalance,
                            depositOutstanding,
                            pendingDeposit
                        };
                    }
                } catch (domErr) {
                    console.warn('Could not extract customer details from DOM row:', domErr);
                }
            }

            if (!cust) {
                cust = {
                    id: customerId,
                    name: 'Customer #' + customerId,
                    phone: '',
                    initialBalance: 0,
                    initialDeposit: 0,
                    currentBalance: 0,
                    depositOutstanding: 0,
                    pendingDeposit: 0
                };
            }

            currentBreakupCustomer = cust;
            document.getElementById('breakupCustomerName').innerHTML = '<i class="fa-solid fa-user"></i> Date Breakup Statement: ' + cust.name;
            document.getElementById('breakupCustomerMeta').textContent = 'Phone: ' + (cust.phone || 'N/A') + ' | Customer ID: #' + cust.id;
            document.getElementById('breakupInitialBal').textContent = cust.initialBalance || 0;
            document.getElementById('breakupCurrentBal').textContent = cust.currentBalance || 0;
            document.getElementById('breakupCurrentBal').style.color = '#000000';
            
            const depositBalEl = document.getElementById('breakupDepositBal');
            if (depositBalEl) {
                depositBalEl.textContent = 'Rs. ' + Number(cust.initialDeposit || 0).toLocaleString('en-LK', { minimumFractionDigits: 2 });
                depositBalEl.style.color = '#000000';
            }

            document.getElementById('breakupDepositOut').textContent = 'Rs. ' + (cust.depositOutstanding || 0).toLocaleString('en-LK', { minimumFractionDigits: 2 });
            document.getElementById('breakupDepositOut').style.color = '#000000';

            const pendingDepositEl = document.getElementById('breakupPendingDeposit');
            if (pendingDepositEl) {
                pendingDepositEl.textContent = 'Rs. ' + (cust.pendingDeposit || 0).toLocaleString('en-LK', { minimumFractionDigits: 2 });
                pendingDepositEl.style.color = '#000000';
            }

            const tbody = document.getElementById('breakupTableBody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="10" style="text-align:center; padding:25px;"><i class="fa-solid fa-spinner fa-spin"></i> Loading statement data...</td></tr>';
            }

            try {
                let custTxs = null;
                try {
                    const response = await fetch(`/api/customers/${customerId}/transactions`);
                    if (response.ok) {
                        custTxs = await response.json();
                    }
                } catch (fetchErr) {
                    console.warn('API fetch failed, using allTransactionsData fallback:', fetchErr);
                }

                // Fallback: Use allTransactionsData if API fetch failed or returned nothing
                if (!custTxs || custTxs.length === 0) {
                    custTxs = (allTransactionsData || []).filter(t => String(t.customerId) === String(customerId));
                    custTxs.sort((a, b) => new Date(a.date) - new Date(b.date));
                }

                if (tbody) {
                    tbody.innerHTML = '';
                    let runningTrayBal = cust.initialBalance || 0;

                    if (!custTxs || custTxs.length === 0) {
                        tbody.innerHTML = `<tr><td colspan="10" style="text-align:center; padding:25px; color:#777;">No transaction records found for this customer. (Opening Balance: ${cust.initialBalance || 0} Trays)</td></tr>`;
                    } else {
                        custTxs.forEach(t => {
                            const isOut = (t.type === 'OUT');
                            if (isOut) {
                                runningTrayBal += t.count;
                            } else {
                                runningTrayBal -= t.count;
                            }

                            const receiptNo = 'RE-' + String(t.receiptNo || 0).padStart(6, '0');
                            const tr = document.createElement('tr');
                            tr.style.borderBottom = '1px solid #eee';
                            tr.style.backgroundColor = '#ffffff';

                            tr.innerHTML = `
                                <td style="padding: 10px; font-size: 13px; color: #000000;">${new Date(t.date).toLocaleString()}</td>
                                <td style="padding: 10px;"><code style="color: #000000;">${receiptNo}</code></td>
                                <td style="padding: 10px; text-align: center;">
                                    <span class="badge badge-${isOut ? 'out' : 'in'}" style="font-size: 11px; padding: 4px 8px; font-weight: 700;">
                                        ${isOut ? 'OUT' : 'IN'}
                                    </span>
                                </td>
                                <td style="padding: 10px;"><code style="color: #000000;">${t.vehicleNo || '-'}</code></td>
                                <td style="padding: 10px; text-align: right; color: #000000;">${isOut ? t.count : '-'}</td>
                                <td style="padding: 10px; text-align: right; color: #000000;">${!isOut ? t.count : '-'}</td>
                                <td style="padding: 10px; text-align: right; color: #000000;">${runningTrayBal}</td>
                                <td style="padding: 10px; text-align: right; color: #000000;">${isOut ? (t.totalDeposit || 0).toLocaleString() : '-'}</td>
                                <td style="padding: 10px; text-align: right; color: #000000;">${!isOut ? (t.totalDeposit || 0).toLocaleString() : '-'}</td>
                                <td style="padding: 10px; font-size: 13px; color: #000000;"><span style="color: #000000;">${t.user || 'admin'}</span> ${t.remarks ? '<br><small style="color:#000000;">' + t.remarks + '</small>' : ''}</td>
                            `;
                            tbody.appendChild(tr);
                        });
                    }
                }
            } catch (e) {
                console.error('Error loading statement:', e);
                if (tbody) {
                    tbody.innerHTML = '<tr><td colspan="10" style="text-align:center; padding:25px; color:red;">Failed to load statement. Please try again.</td></tr>';
                }
            }
        };

