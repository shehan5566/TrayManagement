                                id="breakupDepositOut" style="font-weight: 700; color: #000000;">Rs. 0.00</span></td>
                        <td style="padding: 10px 15px; color: #000000;"><strong>Pending Deposit (Rs.):</strong> <span
                                id="breakupPendingDeposit" style="font-weight: 700; color: #000000;">Rs. 0.00</span></td>
                    </tr>
                </table>

                <table id="breakupTable" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background-color: #f8fafc; color: #000000; border-bottom: 2px solid #cbd5e1;">
                            <th style="padding: 10px; text-align: left; color: #000000;">Date & Time</th>
