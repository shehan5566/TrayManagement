    <!-- Customer Date Breakup Modal -->
    <div id="breakupModal" class="modal"
        style="display: none; position: fixed; z-index: 9999; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.6); overflow: auto;">
        <div
            style="background-color: #fff; margin: 30px auto; padding: 25px; border-radius: 12px; width: 92%; max-width: 1050px; box-shadow: 0 5px 25px rgba(0,0,0,0.3);">
            <div
                style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #eee; padding-bottom: 15px; margin-bottom: 20px; flex-wrap: wrap; gap: 10px;">
                <div>
                    <h3 id="breakupCustomerName" style="color: var(--primary-green-dark); margin: 0;"><i
                            class="fa-solid fa-user"></i> Customer Transaction Details View</h3>
                    <p id="breakupCustomerMeta" style="color: var(--text-light); margin: 4px 0 0 0; font-size: 13px;">
                    </p>
                </div>
                <div style="display: flex; gap: 10px; align-items: center;">
                    <button onclick="exportCustomerBreakupExcel()" class="btn btn-sm"
                        style="background-color: #1b5e20; color: white; padding: 8px 14px; border: none; border-radius: 6px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fa-solid fa-file-excel"></i> Export Statement (.xlsx)
                    </button>
                    <button onclick="printCustomerBreakup()" class="btn btn-sm"
                        style="background-color: #d32f2f; color: #fff; padding: 8px 14px; border: none; border-radius: 6px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fa-solid fa-file-pdf"></i> Download PDF
                    </button>
                    <button onclick="closeBreakupModal()"
                        style="background: none; border: none; font-size: 24px; cursor: pointer; color: #888; margin-left: 10px;">&times;</button>
                </div>
