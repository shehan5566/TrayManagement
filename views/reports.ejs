        function getFullReportTableHtml(tableId) {
            const tableElement = document.getElementById(tableId);
            if (!tableElement) return '';

            let clonedTable;

            if (window.jQuery && $.fn && $.fn.dataTable && $.fn.dataTable.isDataTable('#' + tableId)) {
                const dt = $('#' + tableId).DataTable();
                clonedTable = tableElement.cloneNode(false);

                // Clone thead
                const origThead = tableElement.querySelector('thead');
                if (origThead) {
                    clonedTable.appendChild(origThead.cloneNode(true));
                }

                // Clone full tbody containing ALL rows across all pages (respecting active search filter if any)
                const fullTbody = document.createElement('tbody');
                const rowNodes = dt.rows({ search: 'applied' }).nodes();
                if (rowNodes && rowNodes.length > 0) {
                    for (let i = 0; i < rowNodes.length; i++) {
                        fullTbody.appendChild(rowNodes[i].cloneNode(true));
                    }
                } else {
                    fullTbody.innerHTML = '<tr><td colspan="15" style="text-align:center; padding: 20px;">No matching records found</td></tr>';
                }
                clonedTable.appendChild(fullTbody);

                // Clone tfoot if exists
                const origTfoot = tableElement.querySelector('tfoot');
                if (origTfoot) {
                    clonedTable.appendChild(origTfoot.cloneNode(true));
                }
            } else {
                clonedTable = tableElement.cloneNode(true);
            }

            // Remove action/view columns from the print/PDF copy for maximum cleanliness
            const thElements = clonedTable.querySelectorAll('thead th');
            let actionColIndex = -1;
            thElements.forEach((th, idx) => {
                const text = th.textContent.trim().toLowerCase();
                if (text === 'view' || text === 'action' || text === 'actions') {
                    actionColIndex = idx;
                }
            });

            if (actionColIndex !== -1) {
                clonedTable.querySelectorAll('tr').forEach(r => {
                    if (r.cells.length > actionColIndex) {
                        r.deleteCell(actionColIndex);
                    }
                });
            }

            return clonedTable.outerHTML;
        }

