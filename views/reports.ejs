                    </button>
                    <button onclick="printCustomerBreakup()" class="btn btn-sm"
                        style="background-color: #27ae60; color: #fff; padding: 8px 14px; border: none; border-radius: 6px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fa-solid fa-file-pdf"></i> Download PDF
                    </button>
                    <button onclick="closeBreakupModal()"
                        style="background: none; border: none; font-size: 24px; cursor: pointer; color: #888; margin-left: 10px;">&times;</button>
                </div>
            </div>

            <div id="breakupPrintArea" class="table-responsive">
                <table
                    style="width: 100%; border-collapse: collapse; margin-bottom: 15px; background-color: #f9f9f9; border-radius: 8px; border: 1px solid #eee;">
                    <tr>
                        <td style="padding: 10px 15px; color: #000000;"><strong>Opening Tray Balance:</strong> <span
                                id="breakupInitialBal" style="font-weight: 700; color: #000000;">0</span> Trays</td>
