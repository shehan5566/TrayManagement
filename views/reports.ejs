<%- include('partials/header') %>

    <div style="margin-bottom: 25px; display: flex; flex-direction: column; gap: 15px;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <div>
                <h2 style="color: var(--primary-green-dark);"><i class="fa-solid fa-file-invoice"></i> Reports Dashboard
                </h2>
                <p style="color: var(--text-light); font-size: 14px;">Access full reports of tray issuing, returning,
                    and net balances for all customers.</p>
            </div>
        </div>

        <!-- Date Filter Form -->
        <form action="/reports" method="GET" class="responsive-filter-form" id="reportsFilterForm"
            style="display: flex; gap: 15px; align-items: flex-end; background: var(--bg-light); padding: 15px; border-radius: 8px; border: 1px solid var(--border-light);">
            <input type="hidden" name="activeTab" id="reportsActiveTabInput" value="<%= typeof activeTab !== 'undefined' ? activeTab : 'balanceReport' %>">
            <div style="display: flex; flex-direction: column; gap: 5px;">
                <label for="startDate" style="font-size: 12px; font-weight: 600; color: var(--text-dark);">Start
                    Date</label>
                <input type="date" id="startDate" name="startDate" value="<%= startDate %>"
                    style="padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
            </div>
            <div style="display: flex; flex-direction: column; gap: 5px;">
                <label for="endDate" style="font-size: 12px; font-weight: 600; color: var(--text-dark);">End Date (As
                    At)</label>
                <input type="date" id="endDate" name="endDate" value="<%= endDate %>"
                    style="padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
            </div>
            <button type="submit" class="btn btn-primary" style="padding: 8px 16px; height: 38px;">
                <i class="fa-solid fa-filter"></i> Apply Filter
            </button>
            <a href="/reports" class="btn btn-secondary"
                style="padding: 8px 16px; height: 38px; text-decoration: none; display: flex; align-items: center; justify-content: center; background-color: #f1f3f5; color: #333;">
                Clear
            </a>
        </form>

        <% if (user.role === 'admin' || user.username === 'admin' || (typeof hasPerm === 'function' && hasPerm('reports_send_manually'))) { %>
            <!-- Manual Email Report Form -->
            <form id="manualEmailForm" action="/admin/email/send" method="POST" class="responsive-filter-form"
                onsubmit="sendManualEmailReport(event, this)"
                style="display: flex; gap: 15px; align-items: flex-end; background: #fffbea; padding: 15px; border-radius: 8px; border: 1px dashed var(--accent-yellow); margin-top: -5px;">
                <div style="display: flex; flex-direction: column; gap: 5px; flex-grow: 1;">
                    <label for="emails" style="font-size: 12px; font-weight: 600; color: var(--text-dark);"><i
                            class="fa-solid fa-envelope"></i> Send Report Manually (Comma separated emails)</label>
                    <input type="text" id="emails" name="emails" value="shehand@nelna.lk" placeholder="e.g. manager@nelna.lk, admin2@gmail.com"
                        required style="padding: 8px; border: 1px solid #ccc; border-radius: 4px; width: 100%;">

                    <!-- Recent Emails Container -->
                    <div id="recentEmailsContainer" style="display:none; margin-top: 4px;">
                        <span style="font-size: 11px; color: var(--text-light);">Recent: </span>
                        <div id="recentEmailsList" style="display: inline-flex; gap: 5px; flex-wrap: wrap;"></div>
                    </div>
                </div>
                <button type="submit" id="sendNowAnimatedBtn" class="btn btn-primary btn-send-animated"
                    style="padding: 8px 16px; height: 38px; background-color: var(--primary-green); color: white;">
                    <span class="btn-content">
                        <i class="fa-solid fa-paper-plane"></i> Send Now
                    </span>
                    <i class="fa-solid fa-paper-plane plane-icon"></i>
                    <span class="sent-content">
                        <i class="fa-solid fa-check"></i> Sent
                    </span>
                </button>
            </form>

            <script>
                async function sendManualEmailReport(e, form) {
                    e.preventDefault();
                    const sendBtn = document.getElementById('sendNowAnimatedBtn');
                    const emailsInput = document.getElementById('emails');
                    const emailsVal = (emailsInput ? emailsInput.value.trim() : '') || 'shehand@nelna.lk';

                    // ✈️ 1. Trigger the User's Airplane Flying Animation (1.2s flight -> 'Sent' checkmark -> reset at 4s)
                    if (sendBtn) {
                        sendBtn.classList.remove('sent');
                        sendBtn.classList.add('sending');
                        setTimeout(() => {
                            sendBtn.classList.remove('sending');
                            sendBtn.classList.add('sent');
                        }, 1200);
                        setTimeout(() => {
                            sendBtn.classList.remove('sent');
                        }, 4000);
                    }

                    // 🌟 2. Instantly Display the "Email sent successfully" SweetAlert Toast
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'success',
                            title: 'Email sent successfully',
                            showConfirmButton: false,
                            timer: 3500,
                            timerProgressBar: true
                        });
                    }

                    // 3. Save recent email to localStorage
                    try {
                        let savedEmails = JSON.parse(localStorage.getItem('nelnaRecentEmails') || '[]');
                        const newEmails = emailsVal.split(',').map(em => em.trim()).filter(em => em && em.includes('@'));
                        let updatedEmails = [...new Set([...newEmails, ...savedEmails])].slice(0, 8);
                        localStorage.setItem('nelnaRecentEmails', JSON.stringify(updatedEmails));
                    } catch (storageErr) {}

                    // 4. Send background request to server
                    try {
                        const sd = document.getElementById('startDate') ? document.getElementById('startDate').value : '';
                        const ed = document.getElementById('endDate') ? document.getElementById('endDate').value : '';

                        const payload = {
                            emails: emailsVal,
                            startDate: sd,
                            endDate: ed
                        };

                        await fetch('/admin/email/send', {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: {
                                'Content-Type': 'application/json',
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify(payload)
                        });
                    } catch (err) {
                        console.error('Email send background error:', err);
                    }
                }

                document.addEventListener('DOMContentLoaded', () => {
                    const emailsInput = document.getElementById('emails');
                    const recentEmailsContainer = document.getElementById('recentEmailsContainer');
                    const recentEmailsList = document.getElementById('recentEmailsList');

                    // Load from localStorage
                    let savedEmails = [];
                    try {
                        savedEmails = JSON.parse(localStorage.getItem('nelnaRecentEmails') || '[]');
                    } catch (e) { }

                    if (savedEmails.length > 0) {
                        recentEmailsContainer.style.display = 'block';
                        savedEmails.forEach(email => {
                            const pill = document.createElement('span');
                            pill.textContent = email;
                            pill.style.cssText = 'background: #e0f2f1; color: #00695c; padding: 2px 8px; border-radius: 12px; font-size: 11px; cursor: pointer; border: 1px solid #b2dfdb; transition: all 0.2s;';
                            pill.onmouseover = () => pill.style.background = '#b2dfdb';
                            pill.onmouseout = () => pill.style.background = '#e0f2f1';
                            pill.onclick = () => {
                                const currentVal = emailsInput.value.trim();
                                if (currentVal === '') {
                                    emailsInput.value = email;
                                } else if (!currentVal.includes(email)) {
                                    emailsInput.value = currentVal.endsWith(',') ? currentVal + ' ' + email : currentVal + ', ' + email;
                                }
                            };
                            recentEmailsList.appendChild(pill);
                        });
                    }
                });
            </script>
            <% } %>
    </div>

    <!-- Tabs Navigation -->
    <div class="tabs">
        <button class="tab-btn active" data-tab="balanceReport"><i class="fa-solid fa-scale-balanced"></i> Customer Tray
            Balances</button>
        <button class="tab-btn" data-tab="outReport"><i class="fa-solid fa-arrow-up-from-bracket"></i> Tray Issues
            (Out)</button>
        <button class="tab-btn" data-tab="inReport"><i class="fa-solid fa-arrow-down-to-bracket"></i> Tray Returns
            (In)</button>
        <button class="tab-btn" data-tab="stockTransferReport"><i class="fa-solid fa-truck-fast"></i> Stock
            Transfer</button>
        <button class="tab-btn" data-tab="receiveStockReport"><i class="fa-solid fa-boxes-packing"></i> Receive
            Stock</button>
        <button class="tab-btn" data-tab="loadingReport"><i class="fa-solid fa-truck-loading"></i> Lorry Loading</button>
        <button class="tab-btn" data-tab="unloadingReport"><i class="fa-solid fa-truck-ramp-box"></i> Lorry Unloading</button>
        <button class="tab-btn" data-tab="warehouseBalanceReport"><i class="fa-solid fa-warehouse"></i> Warehouse Tray Balance</button>
        <button class="tab-btn" data-tab="damagesReport"><i class="fa-solid fa-boxes-stacked"></i> Tray Damages & Loss</button>
    </div>

    <!-- 1. Customer Balance Report Tab -->
    <div id="balanceReport" class="tab-content active">
        <div class="content-box">
            <div class="box-header" style="display: flex; justify-content: space-between; align-items: center;">
                <span class="box-title"><i class="fa-solid fa-clipboard-list"></i> Customer Tray Balance Summary</span>
                <div>
                    <button
                        onclick="printReportToPDF(`Customer Tray Balance Summary (${document.getElementById('startDate').value || 'All Time'} to ${document.getElementById('endDate').value || 'Today'})`, 'balanceTable')"
                        class="btn btn-sm"
                        style="background-color: #27ae60; color: #fff; border: none; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; margin-right: 8px;">
                        <i class="fa-solid fa-file-pdf"></i> Download PDF
                    </button>
                    <button onclick="exportCustomerBalancesDetailedExcel()" class="btn btn-sm"
                        style="background-color: #1b5e20; color: #fff; border: none; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; margin-right: 8px;">
                        <i class="fa-solid fa-file-excel"></i> Export Sheet to Excel
                    </button>
                    <a href="/api/reports/master-export?startDate=<%= startDate %>&endDate=<%= endDate %>"
                        class="btn btn-sm"
                        style="background-color: #ffbd09; color: #fff; border: none; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
                        <i class="fa-solid fa-download"></i> Download Full Master Report
                    </a>
                </div>
            </div>



            <div class="table-responsive">
                <table id="balanceTable">
                    <thead>
                        <tr>
                            <th style="min-width: 120px;">Customer Name</th>
                            <th>Phone</th>
                            <th style="text-align: right;">Opening<br>Balance</th>
                            <th style="text-align: right;">Total Issued<br>(Out)</th>
                            <th style="text-align: right;">Total Returned<br>(In)</th>
                            <th style="text-align: right;">Closing<br>Balance</th>
                            <th style="text-align: right;">Initial Deposit<br>(Rs.)</th>
                            <th style="text-align: right;">Deposit Coll.<br>(Rs.)</th>
                            <th style="text-align: right;">Deposit Ref.<br>(Rs.)</th>
                            <th style="text-align: right;">Refundable<br>Outst. (Rs.)</th>
                            <th style="text-align: right;">Pending Dep.<br>(Rs.)</th>
                            <th style="text-align: center; width: 38px;">View</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% customerBalances.forEach(cb=> { %>
                            <tr>
                                <td>
                                    <%= cb.name %>
                                </td>
                                <td>
                                    <%= cb.phone %>
                                </td>
                                <td style="text-align: right; color: #000000;">
                                    <%= cb.initialBalance %>
                                </td>
                                <td style="text-align: right; color: #000000;">
                                    <%= cb.totalOut %>
                                </td>
                                <td style="text-align: right; color: #000000;">
                                    <%= cb.totalIn %>
                                </td>
                                <td
                                    style="text-align: right; color: #000000;">
                                    <%= cb.currentBalance %>
                                </td>
                                <td style="text-align: right; color: #000000;">
                                    <%= (cb.initialDeposit || 0).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                                </td>
                                <td style="text-align: right; color: #000000;">
                                    <%= (cb.depositCollected || 0).toLocaleString() %>
                                </td>
                                <td style="text-align: right; color: #000000;">
                                    <%= (cb.depositRefunded || 0).toLocaleString() %>
                                </td>
                                <td
                                    style="text-align: right; color: #000000;">
                                    <%= (cb.depositOutstanding || 0).toLocaleString() %>
                                </td>
                                <td
                                    style="text-align: right; color: #000000;">
                                    <%= (cb.pendingDeposit || 0).toLocaleString() %>
                                </td>
                                <td style="text-align: center;">
                                    <button type="button" onclick="viewCustomerBreakup('<%= cb.id %>', this)" data-customer-id="<%= cb.id %>" class="btn btn-sm btn-view-customer" title="View Breakup">
                                        <i class="fa-solid fa-eye" style="pointer-events: none;"></i>
                                    </button>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                    <% let totalInitial=0; let totalOut=0; let totalIn=0; let totalCurrent=0; let totalInitialDep=0; let totalDepColl=0; let
                        totalDepRef=0; let totalDepOut=0; let totalPendingDep=0; if (customerBalances.length> 0) {
                        customerBalances.forEach(cb => {
                        totalInitial += (cb.initialBalance || 0);
                        totalOut += (cb.totalOut || 0);
                        totalIn += (cb.totalIn || 0);
                        totalCurrent += (cb.currentBalance || 0);
                        totalInitialDep += (cb.initialDeposit || 0);
                        totalDepColl += (cb.depositCollected || 0);
                        totalDepRef += (cb.depositRefunded || 0);
                        totalDepOut += (cb.depositOutstanding || 0);
                        totalPendingDep += (cb.pendingDeposit || 0);
                        });
                        }
                        %>
                        <tfoot
                            style="background-color: #f8fafc; font-weight: bold; border-top: 2px solid #cbd5e1;">
                            <tr>
                                <td colspan="2"
                                    style="text-align: right; color: #000000; font-size: 13px; font-weight: bold;">
                                    OUTSTANDING TRAY BALANCE & GRAND TOTAL:</td>
                                <td style="text-align: right; font-size: 14px; color: #000000; font-weight: bold;">
                                    <%= totalInitial %>
                                </td>
                                <td
                                    style="text-align: right; color: #000000; font-size: 14px; font-weight: bold;">
                                    <%= totalOut %>
                                </td>
                                <td
                                    style="text-align: right; color: #000000; font-size: 14px; font-weight: bold;">
                                    <%= totalIn %>
                                </td>
                                <td
                                    style="text-align: right; font-size: 15px; color: #000000; font-weight: bold;">
                                    <%= totalCurrent %>
                                </td>
                                <td
                                    style="text-align: right; font-size: 14px; color: #000000; font-weight: bold;">
                                    <%= totalInitialDep.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                                </td>
                                <td
                                    style="text-align: right; color: #000000; font-size: 14px; font-weight: bold;">
                                    <%= totalDepColl.toLocaleString() %>
                                </td>
                                <td
                                    style="text-align: right; color: #000000; font-size: 14px; font-weight: bold;">
                                    <%= totalDepRef.toLocaleString() %>
                                </td>
                                <td
                                    style="text-align: right; font-size: 15px; color: #000000; font-weight: bold;">
                                    <%= totalDepOut.toLocaleString() %>
                                </td>
                                <td
                                    style="text-align: right; font-size: 15px; color: #000000; font-weight: bold;">
                                    <%= totalPendingDep.toLocaleString() %>
                                </td>
                                <td></td>
                            </tr>
                        </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- 2. Tray Out Report Tab -->
    <div id="outReport" class="tab-content">
        <div class="content-box">
            <div class="box-header" style="display: flex; justify-content: space-between; align-items: center;">
                <span class="box-title"><i class="fa-solid fa-arrow-up-from-bracket"></i> Detailed Tray Issues (Out)
                    Log</span>
                <div>
                    <button
                        onclick="printReportToPDF(`Detailed Tray Issues (Out) Log (${document.getElementById('startDate').value || 'All Time'} to ${document.getElementById('endDate').value || 'Today'})`, 'reportOutTable')"
                        class="btn btn-sm"
                        style="background-color: #27ae60; color: #fff; border: none; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; margin-right: 8px;">
                        <i class="fa-solid fa-file-pdf"></i> Download PDF
                    </button>
                    <button onclick="exportTableToExcel('reportOutTable', 'Tray_Issues_OUT')" class="btn btn-sm"
                        style="background-color: #1b5e20; color: #fff; border: none; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fa-solid fa-file-excel"></i> Export Sheet to Excel
                    </button>
                </div>
            </div>



            <div class="table-responsive">
                <table id="reportOutTable">
                    <thead>
                        <tr>
                            <th>Date & Time</th>
                            <th>Receipt No</th>
                            <th>Customer Name</th>
                            <th>Vehicle Number</th>
                            <th>Operator</th>
                            <th>Remarks</th>
                            <th style="text-align: right;">Quantity Issued</th>
                            <th style="text-align: right;">Deposit Collected (Rs.)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% trayOutList.forEach(t=> { %>
                            <tr>
                                <td>
                                    <%= new Date(t.date).toLocaleString('en-GB', { timeZone: 'Asia/Colombo' }) %>
                                </td>
                                <td><code>RE-<%= String(t.receiptNo || 0).padStart(6, '0') %></code></td>
                                <td>
                                        <%= t.customerName %>
                                </td>
                                <td><code><%= t.vehicleNo %></code></td>
                                <td>
                                    <%= t.user %>
                                </td>
                                <td><span style="font-size: 13px; color: #000000;">
                                        <%= t.remarks || '-' %>
                                    </span></td>
                                <td
                                    style="text-align: right; color: #000000;">
                                    <%= t.count %>
                                </td>
                                <td
                                    style="text-align: right; color: #000000;">
                                    <%= (t.totalDeposit || 0).toLocaleString() %>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 3. Tray In Report Tab -->
    <div id="inReport" class="tab-content">
        <div class="content-box">
            <div class="box-header" style="display: flex; justify-content: space-between; align-items: center;">
                <span class="box-title"><i class="fa-solid fa-arrow-down-to-bracket"></i> Detailed Tray Returns (In)
                    Log</span>
                <div>
                    <button
                        onclick="printReportToPDF(`Detailed Tray Returns (In) Log (${document.getElementById('startDate').value || 'All Time'} to ${document.getElementById('endDate').value || 'Today'})`, 'reportInTable')"
                        class="btn btn-sm"
                        style="background-color: #27ae60; color: #fff; border: none; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; margin-right: 8px;">
                        <i class="fa-solid fa-file-pdf"></i> Download PDF
                    </button>
                    <button onclick="exportTableToExcel('reportInTable', 'Tray_Returns_IN')" class="btn btn-sm"
                        style="background-color: #1b5e20; color: #fff; border: none; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fa-solid fa-file-excel"></i> Export Sheet to Excel
                    </button>
                </div>
            </div>



            <div class="table-responsive">
                <table id="reportInTable">
                    <thead>
                        <tr>
                            <th>Date & Time</th>
                            <th>Receipt No</th>
                            <th>Customer Name</th>
                            <th>Vehicle Number</th>
                            <th>Created By</th>
                            <th>Remarks</th>
                            <th style="text-align: right;">Quantity Returned</th>
                            <th style="text-align: right;">Deposit Refunded (Rs.)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% trayInList.forEach(t=> { %>
                            <tr>
                                <td>
                                    <%= new Date(t.date).toLocaleString('en-GB', { timeZone: 'Asia/Colombo' }) %>
                                </td>
                                <td><code>RE-<%= String(t.receiptNo || 0).padStart(6, '0') %></code></td>
                                <td>
                                        <%= t.customerName %>
                                </td>
                                <td><code><%= t.vehicleNo %></code></td>
                                <td>
                                    <%= t.user %>
                                </td>
                                <td><span style="font-size: 13px; color: #000000;">
                                        <%= t.remarks || '-' %>
                                    </span></td>
                                <td
                                    style="text-align: right; color: #000000;">
                                    <%= t.count %>
                                </td>
                                <td
                                    style="text-align: right; color: #000000;">
                                    <%= (t.totalDeposit || 0).toLocaleString() %>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 4. Stock Transfer Report Tab -->
    <div id="stockTransferReport" class="tab-content">
        <div class="content-box">
            <div class="box-header" style="display: flex; justify-content: space-between; align-items: center;">
                <span class="box-title"><i class="fa-solid fa-truck-fast"></i> Detailed Stock Transfer Log</span>
                <div>
                    <button
                        onclick="printReportToPDF(`Detailed Stock Transfer Log (${document.getElementById('startDate').value || 'All Time'} to ${document.getElementById('endDate').value || 'Today'})`, 'stockTransferTable')"
                        class="btn btn-sm"
                        style="background-color: #27ae60; color: #fff; border: none; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; margin-right: 8px;">
                        <i class="fa-solid fa-file-pdf"></i> Download PDF
                    </button>
                    <a href="/reports/export/transfers-csv?startDate=<%= startDate %>&endDate=<%= endDate %>"
                        class="btn btn-sm"
                        style="background-color: #1b5e20; color: #fff; border: none; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
                        <i class="fa-solid fa-file-excel"></i> Export Sheet to Excel
                    </a>
                </div>
            </div>

            <div class="table-responsive">
                <table id="stockTransferTable" class="display" style="width:100%">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Transfer No</th>
                            <th>Source</th>
                            <th>Destination</th>
                            <th>Vehicle No</th>
                            <th>Created By</th>
                            <th style="text-align: right;">Dispatched Qty</th>
                            <th>Status</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% dispatchedTransfers.forEach(t=> { %>
                            <tr>
                                <td>
                                    <%= new Date(t.dispatchedDate).toLocaleString('en-GB', { timeZone: 'Asia/Colombo' }) %>
                                </td>
                                <td>
                                    <%= t.transferDocNo %>
                                </td>
                                <td>
                                    <%= t.fromLocationName %>
                                </td>
                                <td>
                                    <%= t.toLocationName %>
                                </td>
                                <td>
                                    <%= t.vehicleNo || '-' %>
                                </td>
                                <td>
                                    <%= t.dispatchedBy %>
                                </td>
                                <td style="text-align: right; color: #000000;">
                                    <%= t.dispatchedQty %>
                                </td>
                                <td>
                                    <span
                                        class="badge badge-<%= t.status === 'ACCEPTED' ? 'in' : (t.status === 'REJECTED' ? 'out' : 'warning') %>"
                                        style="font-size: 11px;">
                                        <%= t.status %>
                                    </span>
                                </td>
                                <td>
                                    <%= t.remarks || '-' %>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 5. Receive Stock Report Tab -->
    <div id="receiveStockReport" class="tab-content">
        <div class="content-box">
            <div class="box-header" style="display: flex; justify-content: space-between; align-items: center;">
                <span class="box-title"><i class="fa-solid fa-boxes-packing"></i> Detailed Receive Stock Log</span>
                <div>
                    <button
                        onclick="printReportToPDF(`Detailed Receive Stock Log (${document.getElementById('startDate').value || 'All Time'} to ${document.getElementById('endDate').value || 'Today'})`, 'receiveStockTable')"
                        class="btn btn-sm"
                        style="background-color: #27ae60; color: #fff; border: none; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; margin-right: 8px;">
                        <i class="fa-solid fa-file-pdf"></i> Download PDF
                    </button>
                    <a href="/reports/export/received-csv?startDate=<%= startDate %>&endDate=<%= endDate %>"
                        class="btn btn-sm"
                        style="background-color: #1b5e20; color: #fff; border: none; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
                        <i class="fa-solid fa-file-excel"></i> Export Sheet to Excel
                    </a>
                </div>
            </div>

            <div class="table-responsive">
                <table id="receiveStockTable" class="display" style="width:100%">
                    <thead>
                        <tr>
                            <th>Received Date</th>
                            <th>GRN No</th>
                            <th>Transfer No</th>
                            <th>Source</th>
                            <th>Vehicle No</th>
                            <th>Created By</th>
                            <th style="text-align: right;">Dispatch Qty</th>
                            <th style="text-align: right;">Received Qty</th>
                            <th style="text-align: right;">Variance</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% receivedTransfers.forEach(t=> { %>
                            <tr>
                                <td>
                                    <%= new Date(t.receivedDate).toLocaleString('en-GB', { timeZone: 'Asia/Colombo' }) %>
                                </td>
                                <td>
                                    <%= t.grnNo || '-' %>
                                </td>
                                <td>
                                    <%= t.transferDocNo %>
                                </td>
                                <td>
                                    <%= t.fromLocationName %>
                                </td>
                                <td>
                                    <%= t.vehicleNo || '-' %>
                                </td>
                                <td>
                                    <%= t.receivedBy || '-' %>
                                </td>
                                <td style="text-align: right; color: #000000;">
                                    <%= t.dispatchedQty %>
                                </td>
                                <td style="text-align: right; color: #000000;">
                                    <%= t.receivedQty || 0 %>
                                </td>
                                <td
                                    style="text-align: right; color: #000000;">
                                    <%= t.variance || 0 %>
                                </td>
                                <td>
                                    <%= t.remarks || '-' %>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 5.1. Lorry Loading Report Tab -->
    <div id="loadingReport" class="tab-content">
        <div class="content-box">
            <div class="box-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <span class="box-title"><i class="fa-solid fa-truck-loading" style="color: var(--primary-green);"></i> Detailed Lorry Loading Log</span>
                <div>
                    <button
                        onclick="printReportToPDF(`Detailed Lorry Loading Log (${document.getElementById('startDate').value || 'All Time'} to ${document.getElementById('endDate').value || 'Today'})`, 'reportLoadingTable')"
                        class="btn btn-sm"
                        style="background-color: #27ae60; color: #fff; border: none; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; margin-right: 8px;">
                        <i class="fa-solid fa-file-pdf"></i> Download PDF
                    </button>
                    <button onclick="exportTableToExcel('reportLoadingTable', 'Lorry_Loading_Report')" class="btn btn-sm"
                        style="background-color: #1b5e20; color: #fff; border: none; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fa-solid fa-file-excel"></i> Export Sheet to Excel
                    </button>
                </div>
            </div>

            <!-- Loading Metrics Summary Cards -->
            <% 
                const loadingList = typeof loadingReportList !== 'undefined' ? loadingReportList : [];
                let totalTraysLoaded = 0;
                let activeOnRouteCount = 0;
                let completedLoadingCount = 0;
                loadingList.forEach(t => {
                    totalTraysLoaded += (t.loadedQty || 0);
                    if (t.status === 'ON_ROUTE') activeOnRouteCount++;
                    if (t.status === 'COMPLETED') completedLoadingCount++;
                });
            %>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin-bottom: 14px;">
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 7px 12px;">
                    <div style="font-size: 10.5px; color: var(--text-light); font-weight: 700; text-transform: uppercase; letter-spacing: 0.2px;">Total Dispatched</div>
                    <div style="font-size: 16px; font-weight: 800; color: #1e293b; margin-top: 2px;"><%= loadingList.length %></div>
                </div>
                <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 6px; padding: 7px 12px;">
                    <div style="font-size: 10.5px; color: #166534; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2px;">Total Loaded</div>
                    <div style="font-size: 16px; font-weight: 800; color: #15803d; margin-top: 2px;"><%= totalTraysLoaded.toLocaleString() %></div>
                </div>
                <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 6px; padding: 7px 12px;">
                    <div style="font-size: 10.5px; color: #1e40af; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2px;">On-Route Trips</div>
                    <div style="font-size: 16px; font-weight: 800; color: #2563eb; margin-top: 2px;"><%= activeOnRouteCount %></div>
                </div>
                <div style="background: #faf5ff; border: 1px solid #e9d5ff; border-radius: 6px; padding: 7px 12px;">
                    <div style="font-size: 10.5px; color: #6b21a8; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2px;">Completed Trips</div>
                    <div style="font-size: 16px; font-weight: 800; color: #7e22ce; margin-top: 2px;"><%= completedLoadingCount %></div>
                </div>
            </div>

            <div class="table-responsive">
                <table id="reportLoadingTable" class="display" style="width:100%">
                    <thead>
                        <tr>
                            <th>Date & Time</th>
                            <th>Loading No</th>
                            <th>Vehicle No</th>
                            <th>Driver</th>
                            <th>Warehouse</th>
                            <th>Created By</th>
                            <th style="text-align: center;">Status</th>
                            <th style="text-align: right;">Loaded Qty</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% loadingList.forEach(t => { %>
                            <tr>
                                <td data-order="<%= new Date(t.dispatchedDate).getTime() %>" style="white-space: nowrap; color: #000000;">
                                    <%= new Date(t.dispatchedDate).toLocaleDateString('en-GB', { timeZone: 'Asia/Colombo' }) %> <span style="color: #000000; font-size: 11px;"><%= new Date(t.dispatchedDate).toLocaleTimeString('en-US', { timeZone: 'Asia/Colombo', hour: '2-digit', minute: '2-digit', hour12: true }) %></span>
                                </td>
                                <td style="white-space: nowrap; color: #000000;">
                                    <%= t.tripNo %>
                                </td>
                                <td style="white-space: nowrap; color: #000000;">
                                    <%= t.vehicleNo %></td>
                                <td style="white-space: nowrap; color: #000000;"><%= t.driverName || '-' %><% if (t.helperName) { %> <span style="font-size: 11px; color: #000000; font-weight: normal;">(Helper: <%= t.helperName %>)</span><% } %>
                                </td>
                                <td style="white-space: nowrap;">
                                    <span class="badge" style="background: #f1f5f9; color: #000000; border: 1px solid #cbd5e1; font-weight: 600; font-size: 11px; white-space: nowrap;">
                                        <%= t.locationName || 'Head Office' %>
                                    </span>
                                </td>
                                <td style="white-space: nowrap; color: #000000;"><%= t.dispatchedBy || 'System' %></td>
                                <td style="text-align: center; white-space: nowrap;">
                                    <% if (t.status === 'COMPLETED') { %>
                                        <span class="badge badge-in" style="font-size: 10px; padding: 2px 6px; background: #dcfce7; color: #166534; border: 1px solid #86efac; white-space: nowrap;">COMPLETED</span>
                                    <% } else if (t.status === 'CANCELLED') { %>
                                        <span class="badge badge-out" style="font-size: 10px; padding: 2px 6px; background: #fee2e2; color: #b91c1c; border: 1px solid #fca5a5; white-space: nowrap;">CANCELLED</span>
                                    <% } else { %>
                                        <span class="badge" style="font-size: 10px; padding: 2px 6px; background: #eff6ff; color: #1d4ed8; border: 1px solid #93c5fd; white-space: nowrap;">ON ROUTE</span>
                                    <% } %>
                                </td>
                                <td data-order="<%= t.loadedQty || 0 %>" style="text-align: right; font-size: 13px; color: #000000; white-space: nowrap;">
                                    <%= (t.loadedQty || 0).toLocaleString() %>
                                </td>
                                <td style="color: #000000;"><%= t.notes || '-' %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 5.2. Lorry Unloading & Reconciliation Report Tab -->
    <div id="unloadingReport" class="tab-content">
        <div class="content-box">
            <div class="box-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <span class="box-title"><i class="fa-solid fa-truck-ramp-box" style="color: var(--primary-green);"></i> Detailed Lorry Unloading & Settle Log</span>
                <div>
                    <button
                        onclick="printReportToPDF(`Detailed Lorry Unloading & Settle Log (${document.getElementById('startDate').value || 'All Time'} to ${document.getElementById('endDate').value || 'Today'})`, 'reportUnloadingTable')"
                        class="btn btn-sm"
                        style="background-color: #27ae60; color: #fff; border: none; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; margin-right: 8px;">
                        <i class="fa-solid fa-file-pdf"></i> Download PDF
                    </button>
                    <button onclick="exportTableToExcel('reportUnloadingTable', 'Lorry_Unloading_Report')" class="btn btn-sm"
                        style="background-color: #1b5e20; color: #fff; border: none; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fa-solid fa-file-excel"></i> Export Sheet to Excel
                    </button>
                </div>
            </div>

            <!-- Unloading Metrics Summary Cards -->
            <% 
                const unloadingList = typeof unloadingReportList !== 'undefined' ? unloadingReportList : [];
                let totalUnloadLoaded = 0;
                let totalUnloadDelivered = 0;
                let totalUnloadCollected = 0;
                let totalUnloadExpected = 0;
                let totalUnloadActual = 0;
                let totalUnloadVariance = 0;
                unloadingList.forEach(t => {
                    totalUnloadLoaded += (t.loadedQty || 0);
                    totalUnloadDelivered += (t.totalDeliveredQty || 0);
                    totalUnloadCollected += (t.totalCollectedQty || 0);
                    totalUnloadExpected += (t.expectedRemainingQty || 0);
                    if (t.actualUnloadedQty !== undefined && t.actualUnloadedQty !== null) {
                        totalUnloadActual += Number(t.actualUnloadedQty);
                    }
                    totalUnloadVariance += (t.variance || 0);
                });
            %>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 8px; margin-bottom: 14px;">
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 7px 10px;">
                    <div style="font-size: 10px; color: var(--text-light); font-weight: 700; text-transform: uppercase; letter-spacing: 0.2px;">Total Trips</div>
                    <div style="font-size: 16px; font-weight: 800; color: #1e293b; margin-top: 2px;"><%= unloadingList.length %></div>
                </div>
                <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 6px; padding: 7px 10px;">
                    <div style="font-size: 10px; color: #166534; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2px;">Total Loaded</div>
                    <div style="font-size: 16px; font-weight: 800; color: #15803d; margin-top: 2px;"><%= totalUnloadLoaded.toLocaleString() %></div>
                </div>
                <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 6px; padding: 7px 10px;">
                    <div style="font-size: 10px; color: #991b1b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2px;">OUT (Delivered)</div>
                    <div style="font-size: 16px; font-weight: 800; color: #dc2626; margin-top: 2px;"><%= totalUnloadDelivered.toLocaleString() %></div>
                </div>
                <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 6px; padding: 7px 10px;">
                    <div style="font-size: 10px; color: #1e40af; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2px;">IN (Collected)</div>
                    <div style="font-size: 16px; font-weight: 800; color: #2563eb; margin-top: 2px;"><%= totalUnloadCollected.toLocaleString() %></div>
                </div>
                <div style="background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 6px; padding: 7px 10px;">
                    <div style="font-size: 10px; color: #065f46; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2px;">Total Unloaded</div>
                    <div style="font-size: 16px; font-weight: 800; color: #059669; margin-top: 2px;"><%= totalUnloadActual.toLocaleString() %></div>
                </div>
                <div style="background: <%= totalUnloadVariance === 0 ? '#f0fdf4' : (totalUnloadVariance < 0 ? '#fef2f2' : '#eff6ff') %>; border: 1px solid <%= totalUnloadVariance === 0 ? '#bbf7d0' : (totalUnloadVariance < 0 ? '#fecaca' : '#bfdbfe') %>; border-radius: 6px; padding: 7px 10px;">
                    <div style="font-size: 10px; color: <%= totalUnloadVariance === 0 ? '#166534' : (totalUnloadVariance < 0 ? '#991b1b' : '#1e40af') %>; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2px;">Net Variance</div>
                    <div style="font-size: 16px; font-weight: 800; color: <%= totalUnloadVariance === 0 ? '#166534' : (totalUnloadVariance < 0 ? '#dc2626' : '#2563eb') %>; margin-top: 2px;"><%= totalUnloadVariance > 0 ? ('+' + totalUnloadVariance) : totalUnloadVariance %></div>
                </div>
            </div>

            <div class="table-responsive">
                <table id="reportUnloadingTable" class="display" style="width:100%">
                    <thead>
                        <tr>
                            <th>Date & Time</th>
                            <th>Unloading No</th>
                            <th>Loading No</th>
                            <th>Vehicle No</th>
                            <th>Driver</th>
                            <th>Warehouse</th>
                            <th style="text-align: right;">Loaded</th>
                            <th style="text-align: right;">OUT</th>
                            <th style="text-align: right;">IN</th>
                            <th style="text-align: right;">Expected</th>
                            <th style="text-align: right;">Unloaded</th>
                            <th style="text-align: right;">Variance</th>
                            <th>Received By</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% unloadingList.forEach(t => { %>
                            <tr>
                                <td data-order="<%= t.returnedDate ? new Date(t.returnedDate).getTime() : (t.dispatchedDate ? new Date(t.dispatchedDate).getTime() : 0) %>" style="white-space: nowrap; color: #000000;">
                                    <%= new Date(t.returnedDate || t.dispatchedDate).toLocaleDateString('en-GB', { timeZone: 'Asia/Colombo' }) %> <span style="color: #000000; font-size: 11px;"><%= new Date(t.returnedDate || t.dispatchedDate).toLocaleTimeString('en-US', { timeZone: 'Asia/Colombo', hour: '2-digit', minute: '2-digit', hour12: true }) %></span>
                                </td>
                                <td style="white-space: nowrap; color: #000000;"><%= t.unloadingNo || '-' %></td>
                                <td style="white-space: nowrap; color: #000000;"><%= t.tripNo %></td>
                                <td style="white-space: nowrap; color: #000000;">
                                    <%= t.vehicleNo %></td>
                                <td style="white-space: nowrap; color: #000000;"><%= t.driverName || '-' %><% if (t.helperName) { %> <span style="font-size: 11px; color: #000000; font-weight: normal;">(Helper: <%= t.helperName %>)</span><% } %>
                                </td>
                                <td style="white-space: nowrap;">
                                    <span class="badge" style="background: #f1f5f9; color: #000000; border: 1px solid #cbd5e1; font-weight: 600; font-size: 11px; white-space: nowrap;">
                                        <%= t.locationName || 'Head Office' %>
                                    </span>
                                </td>
                                <td data-order="<%= t.loadedQty || 0 %>" style="text-align: right; white-space: nowrap; color: #000000;"><%= t.loadedQty || 0 %></td>
                                <td data-order="<%= t.totalDeliveredQty || 0 %>" style="text-align: right; color: #000000; white-space: nowrap;"><%= t.totalDeliveredQty || 0 %></td>
                                <td data-order="<%= t.totalCollectedQty || 0 %>" style="text-align: right; color: #000000; white-space: nowrap;"><%= t.totalCollectedQty || 0 %></td>
                                <td data-order="<%= t.expectedRemainingQty || 0 %>" style="text-align: right; white-space: nowrap; color: #000000;"><%= t.expectedRemainingQty || 0 %></td>
                                <td data-order="<%= t.actualUnloadedQty !== undefined && t.actualUnloadedQty !== null ? t.actualUnloadedQty : -1 %>" style="text-align: right; color: #000000; white-space: nowrap;">
                                    <%= t.actualUnloadedQty !== undefined && t.actualUnloadedQty !== null ? t.actualUnloadedQty : '-' %>
                                </td>
                                <td data-order="<%= t.variance || 0 %>" style="text-align: right; white-space: nowrap;">
                                    <% if (t.status === 'COMPLETED') { %>
                                        <% if (t.variance === 0) { %>
                                            <span class="badge badge-in" style="background:#dcfce7; color:#166534; border:1px solid #86efac; font-weight: 700; white-space: nowrap; padding: 3px 8px;">0</span>
                                        <% } else if (t.variance < 0) { %>
                                            <span class="badge badge-out" style="background:#fee2e2; color:#b91c1c; border:1px solid #fca5a5; font-weight: 700; white-space: nowrap; padding: 3px 8px;"><%= t.variance %></span>
                                        <% } else { %>
                                            <span class="badge" style="background:#eff6ff; color:#1d4ed8; border:1px solid #93c5fd; font-weight: 700; white-space: nowrap; padding: 3px 8px;">+<%= t.variance %></span>
                                        <% } %>
                                    <% } else { %>
                                        <span style="color: #000000;">-</span>
                                    <% } %>
                                </td>
                                <td style="white-space: nowrap; color: #000000;"><%= t.receivedBy || '-' %></td>
                                <td style="color: #000000;"><%= t.notes || '-' %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 5.5. Warehouse Tray Balance Report Tab -->
    <div id="warehouseBalanceReport" class="tab-content">
        <div class="content-box">
            <div class="box-header" style="display: flex; justify-content: space-between; align-items: center;">
                <span class="box-title"><i class="fa-solid fa-warehouse" style="color: var(--primary-green);"></i> Warehouse Tray Balance Audit Report</span>
                <div>
                    <button
                        onclick="printReportToPDF(`Warehouse Tray Balance Audit Report (${document.getElementById('startDate').value || 'All Time'} to ${document.getElementById('endDate').value || 'Today'})`, 'warehouseBalanceTable')"
                        class="btn btn-sm"
                        style="background-color: #27ae60; color: #fff; border: none; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; margin-right: 8px;">
                        <i class="fa-solid fa-file-pdf"></i> Download PDF
                    </button>
                    <button onclick="exportTableToExcel('warehouseBalanceTable', 'Warehouse_Tray_Balance_Report')" class="btn btn-sm"
                        style="background-color: #1b5e20; color: #fff; border: none; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fa-solid fa-file-excel"></i> Export Sheet to Excel
                    </button>
                </div>
            </div>

            <!-- Summary Ribbon -->
            <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; padding: 10px 14px; background: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0; font-size: 13px; align-items: center;">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <span style="color: #64748b; font-weight: 600;">Opening Balance:</span>
                    <span style="font-weight: 700; color: #0f172a;"><%= typeof warehouseOpeningBalance !== 'undefined' ? warehouseOpeningBalance : 0 %></span>
                </div>
                <div style="color: #cbd5e1;">|</div>
                <div style="display: flex; align-items: center; gap: 6px;">
                    <span style="color: #64748b; font-weight: 600;">Total IN:</span>
                    <span style="font-weight: 700; color: #15803d;">+<%= typeof totalInMovement !== 'undefined' ? totalInMovement : 0 %></span>
                </div>
                <div style="color: #cbd5e1;">|</div>
                <div style="display: flex; align-items: center; gap: 6px;">
                    <span style="color: #64748b; font-weight: 600;">Total OUT:</span>
                    <span style="font-weight: 700; color: #b91c1c;">-<%= typeof totalOutMovement !== 'undefined' ? totalOutMovement : 0 %></span>
                </div>
                <div style="color: #cbd5e1;">|</div>
                <div style="display: flex; align-items: center; gap: 6px;">
                    <span style="color: #64748b; font-weight: 600;">Warehouse Trays:</span>
                    <span style="font-weight: 700; color: #0f172a;"><%= typeof totalWarehouseCurrentStock !== 'undefined' ? totalWarehouseCurrentStock : 0 %></span>
                </div>
                <div style="color: #cbd5e1;">|</div>
                <div style="display: flex; align-items: center; gap: 6px;">
                    <span style="color: #64748b; font-weight: 600;">Customer Trays:</span>
                    <span style="font-weight: 700; color: #0f172a;"><%= typeof customerCurrentBalance !== 'undefined' ? customerCurrentBalance : 0 %></span>
                </div>
                <div style="color: #cbd5e1;">|</div>
                <div style="display: flex; align-items: center; gap: 6px; margin-left: auto;">
                    <span style="color: #0f172a; font-weight: 700;">Closing Balance:</span>
                    <span style="font-weight: 800; font-size: 14px; color: #15803d; background: #dcfce7; padding: 2px 8px; border-radius: 4px; border: 1px solid #86efac;">
                        <%= typeof warehouseFinalClosingBalance !== 'undefined' ? warehouseFinalClosingBalance : 0 %>
                    </span>
                </div>
            </div>

            <div class="table-responsive">
                <table id="warehouseBalanceTable" class="display" style="width:100%">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Ref. No</th>
                            <th>Description</th>
                            <th style="text-align: right; color: #15803d;">IN</th>
                            <th style="text-align: right; color: #b91c1c;">OUT</th>
                            <th style="text-align: right; font-weight: bold; color: #000000;">Closing Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr style="background-color: #f8fafc;">
                            <td><strong><%= typeof warehouseOpeningDate !== 'undefined' ? warehouseOpeningDate : (startDate || today) %></strong></td>
                            <td><code style="color: #64748b;">-</code></td>
                            <td><strong style="color: #0f172a;">Opening Balance</strong></td>
                            <td style="text-align: right; color: #64748b;">-</td>
                            <td style="text-align: right; color: #64748b;">-</td>
                            <td style="text-align: right; font-weight: bold; color: #000000;"><%= typeof warehouseOpeningBalance !== 'undefined' ? warehouseOpeningBalance : 0 %></td>
                        </tr>
                        <% (typeof warehouseBalanceList !== 'undefined' ? warehouseBalanceList : []).forEach(wb => { %>
                            <tr>
                                <td>
                                    <% 
                                    let formattedDate = '-';
                                    if (wb.date) {
                                        let d = new Date(wb.date);
                                        if (isNaN(d.getTime()) && !isNaN(Number(wb.date))) {
                                            d = new Date(Number(wb.date));
                                        }
                                        if (!isNaN(d.getTime())) {
                                            formattedDate = d.toLocaleString();
                                        }
                                    }
                                    %>
                                    <%= formattedDate %>
                                </td>
                                <td><code><%= wb.refNo || '-' %></code></td>
                                <td style="color: #334155;"><%= wb.label || '-' %></td>
                                <td style="text-align: right; color: <%= wb.inQty > 0 ? '#15803d' : '#64748b' %>; font-weight: <%= wb.inQty > 0 ? '600' : 'normal' %>;">
                                    <%= wb.inQty > 0 ? ('+' + wb.inQty) : '-' %>
                                </td>
                                <td style="text-align: right; color: <%= wb.outQty > 0 ? '#b91c1c' : '#64748b' %>; font-weight: <%= wb.outQty > 0 ? '600' : 'normal' %>;">
                                    <%= wb.outQty > 0 ? ('-' + wb.outQty) : '-' %>
                                </td>
                                <td style="text-align: right; color: #000000; font-weight: bold;"><%= wb.closingBalance %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                    <tfoot>
                        <tr style="background-color: #f8fafc; border-top: 2px solid #cbd5e1;">
                            <th colspan="3" style="text-align: right; font-weight: 700; color: #000000;">Period Total Movement / Closing:</th>
                            <th style="text-align: right; font-weight: 700; color: #15803d;"><%= typeof totalInMovement !== 'undefined' ? ('+' + totalInMovement) : 0 %></th>
                            <th style="text-align: right; font-weight: 700; color: #b91c1c;"><%= typeof totalOutMovement !== 'undefined' ? ('-' + totalOutMovement) : 0 %></th>
                            <th style="text-align: right; font-weight: 700; color: #000000;"><%= typeof warehouseFinalClosingBalance !== 'undefined' ? warehouseFinalClosingBalance : 0 %></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- 6. Tray Damages & Loss Report Tab -->
    <div id="damagesReport" class="tab-content">
        <div class="content-box">
            <div class="box-header" style="display: flex; justify-content: space-between; align-items: center;">
                <span class="box-title"><i class="fa-solid fa-boxes-stacked" style="color: var(--primary-green);"></i> Tray Damage & Loss Log</span>
                <div>
                    <button
                        onclick="printReportToPDF(`Tray Damage & Loss Log (${document.getElementById('startDate').value || 'All Time'} to ${document.getElementById('endDate').value || 'Today'})`, 'damagesReportTable')"
                        class="btn btn-sm"
                        style="background-color: #27ae60; color: #fff; border: none; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; margin-right: 8px;">
                        <i class="fa-solid fa-file-pdf"></i> Download PDF
                    </button>
                    <button onclick="exportTableToExcel('damagesReportTable', 'Tray_Damages_Report')" class="btn btn-sm"
                        style="background-color: #1b5e20; color: #fff; border: none; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fa-solid fa-file-excel"></i> Export Sheet to Excel
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table id="damagesReportTable" class="display" style="width:100%">
                    <thead>
                        <tr>
                            <th>Date & Time</th>
                            <th>Ref No</th>
                            <th>Location / Branch</th>
                            <th>Type</th>
                            <th style="text-align: right;">Quantity (Trays)</th>
                            <th>Reason / Remarks</th>
                            <th>Reported By</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% (typeof damageLogs !== 'undefined' ? damageLogs : []).forEach(d => { %>
                            <tr>
                                <td><%= new Date(d.date).toLocaleString('en-GB', { timeZone: 'Asia/Colombo' }) %></td>
                                <td><%= d.damageNo || '-' %></td>
                                <td><%= d.locationName || 'Head Office' %></td>
                                <td>
                                    <span class="badge" style="background-color: <%= d.type === 'LOST' ? '#ef4444' : '#f59e0b' %>; color: white;">
                                        <%= d.type %>
                                    </span>
                                </td>
                                <td style="text-align: right; color: #d97706;"><%= d.qty %></td>
                                <td><%= d.reason || '-' %></td>
                                <td><%= d.reportedBy || '-' %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Customer Date Breakup Modal -->
    <div id="breakupModal" class="modal"
