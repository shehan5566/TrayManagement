                const currentUrl = new URL(window.location.href);
                if (isReload && (currentUrl.searchParams.has('startDate') || currentUrl.searchParams.has('endDate'))) {
                    currentUrl.searchParams.delete('startDate');
                    currentUrl.searchParams.delete('endDate');
                    window.location.replace(currentUrl.toString());
                    return;
                } else if (window.history && window.history.replaceState) {
                    if (currentUrl.searchParams.has('startDate') || currentUrl.searchParams.has('endDate')) {
                        currentUrl.searchParams.delete('startDate');
                        currentUrl.searchParams.delete('endDate');
