<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Special Transaction Approval | Nelna Agri</title>
    <!-- Favicon / Tab Logo -->
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link rel="shortcut icon" type="image/png" href="/images/logo.png">
    <link rel="apple-touch-icon" href="/images/logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-green: #107c41;
            --primary-dark: #0b532c;
            --primary-light: #e8f5e9;
            --danger-red: #dc2626;
            --danger-light: #fef2f2;
            --text-dark: #1e293b;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --card-bg: #ffffff;
            --page-bg: #f8fafc;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--page-bg);
            color: var(--text-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 16px;
        }

        .approval-wrapper {
            width: 100%;
            max-width: 480px;
            margin: 0 auto;
        }

        .brand-header {
            text-align: center;
            margin-bottom: 20px;
            padding-top: 10px;
        }

        .brand-logo-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #ffffff;
            padding: 8px 18px;
            border-radius: 9999px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
            border: 1px solid var(--border-color);
            margin-bottom: 12px;
        }

        .brand-logo-badge i {
            color: var(--primary-green);
            font-size: 18px;
        }

        .brand-logo-badge span {
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: var(--primary-dark);
            text-transform: uppercase;
        }

        .portal-title {
            font-size: 20px;
            font-weight: 800;
            color: var(--text-dark);
            line-height: 1.3;
        }

        .portal-subtitle {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        .card {
            background: var(--card-bg);
            border-radius: 16px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            border: 1px solid var(--border-color);
            overflow: hidden;
            margin-bottom: 16px;
        }

        .warning-strip {
            background: #fff1f2;
            border-bottom: 1px solid #fecdd3;
            padding: 12px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: #9f1239;
        }

        .warning-strip i {
            font-size: 20px;
            color: #e11d48;
            flex-shrink: 0;
        }

        .warning-strip div {
            font-size: 13px;
            line-height: 1.4;
        }

        .card-body {
            padding: 20px;
        }

        .metric-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 20px;
        }

        .metric-box {
            padding: 14px;
            border-radius: 12px;
            text-align: center;
            border: 1px solid var(--border-color);
        }

        .metric-box.due {
            background: #fff1f2;
            border-color: #fecdd3;
        }

        .metric-box.request {
            background: #f0fdf4;
            border-color: #bbf7d0;
        }

        .metric-box.pending-dep {
            background: #fffbeb;
            border-color: #fde68a;
        }

        .metric-box.refundable {
            background: #eff6ff;
            border-color: #bfdbfe;
        }

        .metric-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .metric-box.due .metric-label { color: #9f1239; }
        .metric-box.request .metric-label { color: #166534; }
        .metric-box.pending-dep .metric-label { color: #b45309; }
        .metric-box.refundable .metric-label { color: #1d4ed8; }

        .metric-value {
            font-size: 26px;
            font-weight: 900;
            line-height: 1;
        }

        .metric-box.due .metric-value { color: #b91c1c; }
        .metric-box.request .metric-value { color: #15803d; }
        .metric-box.pending-dep .metric-value { color: #d97706; font-size: 18px; }
        .metric-box.refundable .metric-value { color: #2563eb; font-size: 18px; }

        .metric-sub {
            font-size: 11px;
            margin-top: 4px;
            color: var(--text-muted);
        }

        .info-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 20px;
            background: #f8fafc;
            padding: 14px;
            border-radius: 10px;
            border: 1px solid var(--border-color);
        }

        .info-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13px;
        }

        .info-item .label {
            color: var(--text-muted);
            font-weight: 500;
        }

        .info-item .val {
            color: var(--text-dark);
            font-weight: 700;
            text-align: right;
        }

        .action-container {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 10px;
        }

        .btn {
            width: 100%;
            padding: 14px 20px;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 700;
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.15s ease;
        }

        .btn:active {
            transform: scale(0.98);
        }

        .btn-approve {
            background: linear-gradient(135deg, #15803d 0%, #166534 100%);
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(21, 128, 61, 0.3);
        }

        .btn-reject {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fca5a5;
        }

        .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        .notes-input {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            font-size: 13px;
            margin-bottom: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

        .notes-input:focus {
            border-color: var(--primary-green);
        }

        /* Status Banner for Completed/Rejected */
        .status-banner {
            padding: 24px 20px;
            text-align: center;
            border-radius: 16px;
            margin-bottom: 16px;
            border: 1px solid var(--border-color);
        }

        .status-banner.approved {
            background: #f0fdf4;
            border-color: #86efac;
            color: #14532d;
        }

        .status-banner.rejected {
            background: #fef2f2;
            border-color: #fecdd3;
            color: #7f1d1d;
        }

        .status-banner.expired {
            background: #fffbeb;
            border-color: #fde68a;
            color: #78350f;
        }

        .status-icon {
            font-size: 44px;
            margin-bottom: 12px;
        }

        .status-title {
            font-size: 18px;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .status-desc {
            font-size: 13px;
            line-height: 1.5;
            color: #475569;
        }

        .footer {
            text-align: center;
            margin-top: 20px;
            font-size: 11px;
            color: var(--text-muted);
        }
    </style>
</head>
<body>

<div class="approval-wrapper">
    <div class="brand-header">
        <div class="brand-logo-badge">
            <i class="fa-solid fa-shield-halved"></i>
            <span>Nelna Agri Development</span>
        </div>
        <h1 class="portal-title">Special Dispatch Approval</h1>
        <p class="portal-subtitle">Sales Management Authorization Portal</p>
    </div>

    <% if (!approval) { %>
        <div class="card card-body" style="text-align:center; padding: 40px 20px;">
            <i class="fa-solid fa-triangle-exclamation" style="font-size: 40px; color: #f59e0b; margin-bottom: 15px;"></i>
            <h3 style="margin-bottom: 8px;">Invalid or Expired Request</h3>
            <p style="color: var(--text-muted); font-size: 13px;">This approval link is invalid or has already been removed from the system.</p>
        </div>
    <% } else if (approval.status === 'APPROVED') { %>
        <div class="status-banner approved">
            <div class="status-icon" style="color: #16a34a;"><i class="fa-solid fa-circle-check"></i></div>
            <div class="status-title">Transaction Approved!</div>
            <div class="status-desc">
                This transaction has been approved by <strong><%= approval.approvedBy || 'Sales Manager' %></strong>.
                <% if (approval.receiptNo) { %>
                    <br><span style="display:inline-block; margin-top:8px; background:#dcfce7; padding:4px 12px; border-radius:6px; font-weight:800; font-size:14px; color:#15803d;">Receipt No: RE-<%= String(approval.receiptNo).padStart(6, '0') %></span>
                <% } %>
            </div>
            <div style="margin-top: 18px; padding-top: 14px; border-top: 1px dashed #bbf7d0;">
                <p style="font-size: 12px; color: #166534; margin-bottom: 8px; font-weight: 500;">Approved by mistake? You can revoke this authorization:</p>
                <button type="button" class="btn btn-reject" style="width: auto; padding: 8px 18px; font-size: 13px; margin: 0 auto; display: inline-flex; align-items: center; gap: 6px;" onclick="revokeApproval()">
                    <i class="fa-solid fa-rotate-left"></i> Undo / Revoke Approval (අවලංගු කරන්න)
                </button>
            </div>
        </div>
    <% } else if (approval.status === 'REJECTED') { %>
        <div class="status-banner rejected">
            <div class="status-icon" style="color: #dc2626;"><i class="fa-solid fa-circle-xmark"></i></div>
            <div class="status-title">Request Rejected</div>
            <div class="status-desc">
                This transaction was rejected by <strong><%= approval.approvedBy || 'Sales Manager' %></strong>.
                <% if (approval.rejectionReason) { %>
                    <br><strong>Reason:</strong> <%= approval.rejectionReason %>
                <% } %>
            </div>
        </div>
    <% } else if (approval.status === 'EXPIRED') { %>
        <div class="status-banner expired">
            <div class="status-icon" style="color: #d97706;"><i class="fa-solid fa-clock-rotate-left"></i></div>
            <div class="status-title">Approval Request Expired</div>
            <div class="status-desc">
                This request timed out. Please request the operator to submit a fresh request from the branch.
            </div>
        </div>
    <% } else { %>
        <!-- PENDING APPROVAL FORM -->
        <div class="card" id="approvalCard">
            <div class="warning-strip">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <div>
                    <strong>Customer Outstanding Alert:</strong><br>
                    Customer has unreturned trays. Tray issue is blocked without your authorization.
                </div>
            </div>

            <div class="card-body">
                <!-- Metrics -->
                <div class="metric-grid">
                    <div class="metric-box due">
                        <div class="metric-label">Outstanding Trays</div>
                        <div class="metric-value"><%= approval.currentBalance %></div>
                        <div class="metric-sub">Currently Due</div>
                    </div>
                    <div class="metric-box request">
                        <div class="metric-label">Requested Issue</div>
                        <div class="metric-value"><%= approval.requestedQty %></div>
                        <div class="metric-sub">Trays (OUT)</div>
                    </div>
                    <div class="metric-box pending-dep">
                        <div class="metric-label">Pending Deposit</div>
                        <div class="metric-value">Rs. <%= (approval.pendingDepositBalance || 0).toLocaleString('en-LK') %></div>
                        <div class="metric-sub">Deposit Due</div>
                    </div>
                    <div class="metric-box refundable">
                        <div class="metric-label">Refundable Deposit</div>
                        <div class="metric-value">Rs. <%= (approval.refundableOutstanding || 0).toLocaleString('en-LK') %></div>
                        <div class="metric-sub">Deposit with Nelna</div>
                    </div>
                </div>

                <!-- Details List -->
                <div class="info-list">
                    <div class="info-item">
                        <span class="label">Customer Name</span>
                        <span class="val" style="color: var(--primary-dark);"><%= approval.customerName %></span>
                    </div>
                    <div class="info-item">
                        <span class="label">Contact Number</span>
                        <span class="val">
                            <% if (approval.customerPhone && approval.customerPhone !== 'N/A') { %>
                                <a href="tel:<%= approval.customerPhone %>" style="color: #0284c7; text-decoration: none; font-weight: 700;">
                                    <i class="fa-solid fa-phone" style="font-size: 11px; margin-right: 3px;"></i><%= approval.customerPhone %>
                                </a>
                            <% } else { %>
                                <span style="color: var(--text-muted);">N/A</span>
                            <% } %>
                        </span>
                    </div>
                    <div class="info-item">
                        <span class="label">Pending Deposit Balance</span>
                        <span class="val" style="color: <%= (approval.pendingDepositBalance > 0) ? '#d97706' : '#16a34a' %>;">
                            Rs. <%= (approval.pendingDepositBalance || 0).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                        </span>
                    </div>
                    <div class="info-item">
                        <span class="label">Refundable Outstanding</span>
                        <span class="val" style="color: #2563eb;">
                            Rs. <%= (approval.refundableOutstanding || 0).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                        </span>
                    </div>
                    <div class="info-item">
                        <span class="label">Branch / Location</span>
                        <span class="val"><%= approval.locationName %></span>
                    </div>
                    <div class="info-item">
                        <span class="label">Requested By</span>
                        <span class="val"><%= approval.requestedBy %></span>
                    </div>
                    <% if (approval.txPayload && approval.txPayload.vehicleNo && approval.txPayload.vehicleNo !== 'N/A') { %>
                        <div class="info-item">
                            <span class="label">Vehicle No</span>
                            <span class="val"><%= approval.txPayload.vehicleNo %></span>
                        </div>
                    <% } %>
                    <div class="info-item">
                        <span class="label">Request Time</span>
                        <span class="val"><%= new Date(approval.createdAt).toLocaleTimeString('en-US', { timeZone: 'Asia/Colombo', hour: '2-digit', minute: '2-digit', hour12: true }) %> (<%= new Date(approval.createdAt).toLocaleDateString('en-GB', { timeZone: 'Asia/Colombo' }) %>)</span>
                    </div>
                    <div class="info-item">
                        <span class="label">Override PIN</span>
                        <span class="val" style="font-family: monospace; letter-spacing: 2px; color: #107c41; font-size: 14px;"><%= approval.pin %></span>
                    </div>
                </div>

                <!-- Manager Remarks -->
                <div style="margin-bottom: 12px;">
                    <label for="managerNotes" style="display:block; font-size:12px; font-weight:600; color:var(--text-dark); margin-bottom:4px;">
                        Manager Remarks / Instructions (Optional):
                    </label>
                    <input type="text" id="managerNotes" class="notes-input" placeholder="e.g. Approved for delivery today. Return due tomorrow.">
                </div>

                <!-- Action Buttons -->
                <div class="action-container" id="buttonContainer">
                    <button type="button" class="btn btn-approve" id="approveBtn" onclick="handleAction('APPROVE')">
                        <i class="fa-solid fa-check-circle"></i> Approve & Save Transaction
                    </button>
                    <button type="button" class="btn btn-reject" id="rejectBtn" onclick="handleAction('REJECT')">
                        <i class="fa-solid fa-times-circle"></i> Reject Request
                    </button>
                </div>

                <div id="loadingState" style="display:none; text-align:center; padding: 20px 0;">
                    <i class="fa-solid fa-circle-notch fa-spin" style="font-size:32px; color:var(--primary-green); margin-bottom:10px;"></i>
                    <div style="font-weight:600; font-size:14px; color:var(--text-dark);">Processing Authorization...</div>
                </div>
            </div>
        </div>

        <div id="resultCard" style="display:none;"></div>
    <% } %>

    <div class="footer">
        Nelna Agri Development (Pvt) Ltd &bull; Smart Tray Management System
    </div>
</div>

<script>
    async function handleAction(action) {
        const approveBtn = document.getElementById('approveBtn');
        const rejectBtn = document.getElementById('rejectBtn');
        const btnContainer = document.getElementById('buttonContainer');
        const loadingState = document.getElementById('loadingState');
        const notes = document.getElementById('managerNotes') ? document.getElementById('managerNotes').value : '';

        if (action === 'APPROVE') {
            const cust = "<%= (approval && approval.customerName) ? approval.customerName : '' %>";
            const phone = "<%= (approval && approval.customerPhone) ? approval.customerPhone : '' %>";
            const qty = "<%= (approval && approval.requestedQty) ? approval.requestedQty : '' %>";
            const bal = "<%= (approval && approval.currentBalance) ? approval.currentBalance : '' %>";
            const pendingDep = "<%= (approval && approval.pendingDepositBalance) ? Number(approval.pendingDepositBalance).toLocaleString('en-LK', { minimumFractionDigits: 2 }) : '0.00' %>";
            const refundOut = "<%= (approval && approval.refundableOutstanding) ? Number(approval.refundableOutstanding).toLocaleString('en-LK', { minimumFractionDigits: 2 }) : '0.00' %>";

            const confirmMsg = "⚠️ Please Confirm Special Approval\n\n" +
                "• Customer: " + cust + (phone && phone !== 'N/A' ? " (" + phone + ")" : "") + "\n" +
                "• Due Trays: " + bal + " Trays\n" +
                "• Requested Issue: " + qty + " Trays\n" +
                "• Pending Deposit: Rs. " + pendingDep + "\n" +
                "• Refundable Outstanding: Rs. " + refundOut + "\n\n" +
                "Are you sure you want to AUTHORIZE and automatically SAVE this transaction?";
            if (!confirm(confirmMsg)) {
                return;
            }
        }

        let finalNotes = notes;
        if (action === 'REJECT') {
            const reason = prompt("Please enter the reason for REJECTING this request (or click OK to proceed):", notes || "Previous outstanding trays must be returned first.");
            if (reason === null) return; // Manager cancelled prompt
            finalNotes = reason.trim() || 'Rejected by Sales Manager';
        }

        btnContainer.style.display = 'none';
        loadingState.style.display = 'block';

        try {
            const res = await fetch('/approval/<%= (approval && approval.token) ? approval.token : "" %>/action', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action, notes: finalNotes, approverName: 'Sales Manager' })
            });

            const result = await res.json();
            const card = document.getElementById('approvalCard');
            const resultCard = document.getElementById('resultCard');

            if (result.success) {
                card.style.display = 'none';
                resultCard.style.display = 'block';
                if (action === 'APPROVE') {
                    const rNo = result.receiptNo ? `RE-${String(result.receiptNo).padStart(6, '0')}` : 'Generated';
                    resultCard.innerHTML = `
                        <div class="status-banner approved">
                            <div class="status-icon" style="color: #16a34a;"><i class="fa-solid fa-circle-check"></i></div>
                            <div class="status-title">Transaction Approved!</div>
                            <div class="status-desc">
                                Special approval granted. The transaction has been automatically saved in the system and unlocked on the branch screen.<br>
                                <span style="display:inline-block; margin-top:10px; background:#dcfce7; padding:6px 14px; border-radius:6px; font-weight:800; font-size:15px; color:#15803d;">Receipt No: ${rNo}</span>
                            </div>
                            <div style="margin-top: 20px; padding-top: 14px; border-top: 1px dashed #bbf7d0;">
                                <p style="font-size: 12px; color: #166534; margin-bottom: 8px; font-weight: 500;">Approved by mistake? You can revoke this authorization:</p>
                                <button type="button" class="btn btn-reject" style="width: auto; padding: 8px 18px; font-size: 13px; margin: 0 auto; display: inline-flex; align-items: center; gap: 6px;" onclick="revokeApproval()">
                                    <i class="fa-solid fa-rotate-left"></i> Undo / Revoke Approval (අවලංගු කරන්න)
                                </button>
                            </div>
                        </div>
                    `;
                } else {
                    resultCard.innerHTML = `
                        <div class="status-banner rejected">
                            <div class="status-icon" style="color: #dc2626;"><i class="fa-solid fa-circle-xmark"></i></div>
                            <div class="status-title">Request Rejected</div>
                            <div class="status-desc">
                                You have rejected this transaction request. The branch operator has been notified.
                            </div>
                        </div>
                    `;
                }
            } else {
                btnContainer.style.display = 'flex';
                loadingState.style.display = 'none';
                alert(result.error || 'Failed to process action. Please try again.');
            }
        } catch (err) {
            btnContainer.style.display = 'flex';
            loadingState.style.display = 'none';
            alert('Connection error: ' + err.message);
        }
    }

    async function revokeApproval() {
        const confirmed = confirm(
            "⚠️ CANCEL / REVOKE APPROVAL\n\n" +
            "Are you sure you want to REVOKE this approval?\n\n" +
            "This will:\n" +
            "1. Immediately DELETE the saved transaction\n" +
            "2. Reverse the customer's tray balance\n" +
            "3. Restore the warehouse tray stock"
        );
        if (!confirmed) return;

        const reason = prompt("Reason for revoking (optional):", "Approved by mistake - Revoked by Sales Manager");
        if (reason === null) return;

        try {
            const res = await fetch('/approval/<%= (approval && approval.token) ? approval.token : "" %>/revoke', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason: reason.trim() || 'Approved by mistake' })
            });
            const data = await res.json();
            if (data.success) {
                alert("✅ Approval has been REVOKED.\nThe transaction was deleted and tray stock restored.");
                window.location.reload();
            } else {
                alert(data.error || 'Failed to revoke approval.');
            }
        } catch (e) {
            alert("Network error: " + e.message);
        }
    }
</script>

</body>
</html>
