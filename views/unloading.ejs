<%- include('partials/header') %>

<div style="margin-bottom: 25px;">
    <h2 style="color: var(--primary-green-dark);"><i class="fa-solid fa-truck-ramp-box"></i> Lorry Unloading & Tray Reconciliation</h2>
    <p style="color: var(--text-light); font-size: 14px;">Receive returning lorries, reconcile delivered & collected trays, and settle warehouse inventory.</p>
</div>

<% if (locals.error) { %>
    <div class="error-banner">
        <i class="fa-solid fa-triangle-exclamation"></i> <%= error %>
    </div>
<% } %>

<!-- 1. Active Returning Lorries on Route (Awaiting Return & Unload) -->
<div class="content-box">
    <div class="box-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
        <span class="box-title"><i class="fa-solid fa-truck-ramp-box"></i> Active Lorries on Route (Awaiting Return & Unload)</span>
        <a href="/loading" class="btn btn-secondary" style="text-decoration: none; font-size: 12px; padding: 5px 12px; display: inline-flex; align-items: center; gap: 6px;">
            <i class="fa-solid fa-truck-loading"></i> Go to Loading Page
        </a>
    </div>

    <% const activeTrips = (trips || []).filter(t => t.status === 'ON_ROUTE'); %>
    <% if (activeTrips.length === 0) { %>
        <p style="text-align: center; color: var(--text-light); padding: 30px 0;">
            <i class="fa-solid fa-check-circle" style="color: #10b981; font-size: 24px; display: block; margin-bottom: 8px;"></i>
            No active lorry trips on route. All lorries have been unloaded and reconciled.
        </p>
    <% } else { %>
        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>Date & Time</th>
                        <th>Loading No</th>
                        <th>Vehicle & Driver</th>
                        <th>Warehouse</th>
                        <th style="text-align: right;">Loaded</th>
                        <th style="text-align: right;">Delivered (OUT)</th>
                        <th style="text-align: right;">Collected (IN)</th>
                        <th style="text-align: right; background: #f0fdf4;">Current in Lorry</th>
                        <th style="text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% activeTrips.forEach(t => { %>
                        <tr>
                            <td style="white-space: nowrap;">
                                <%= new Date(t.dispatchedDate).toLocaleDateString() %> <span style="color: var(--text-light); font-size: 11px;"><%= new Date(t.dispatchedDate).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
                            </td>
                            <td style="white-space: nowrap;"><strong><%= t.tripNo %></strong></td>
                            <td style="white-space: nowrap;">
                                <strong style="color: var(--primary-green-dark);"><%= t.vehicleNo %></strong><% if (t.driverName) { %> <span style="font-size: 11px; color: var(--text-light); font-weight: normal;">(<%= t.driverName %>)</span><% } %>
                            </td>
                            <td>
                                <span class="badge" style="background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; font-weight: 600; font-size: 11px;">
                                    <%= t.locationName || 'Head Office' %>
                                </span>
                            </td>
                            <td style="text-align: right; font-weight: 700;"><%= t.loadedQty %></td>
                            <td style="text-align: right; color: #dc2626; font-weight: 700;"><%= t.totalDeliveredQty || 0 %></td>
                            <td style="text-align: right; color: #2563eb; font-weight: 700;"><%= t.totalCollectedQty || 0 %></td>
                            <td style="text-align: right; font-weight: 900; font-size: 16px; color: #107c41; background: #f0fdf4;">
                                <%= (t.loadedQty || 0) - (t.totalDeliveredQty || 0) + (t.totalCollectedQty || 0) %>
                            </td>
                            <td style="text-align: center;">
                                <button onclick="openSettleModal('<%= t.id %>', '<%= t.tripNo %>', '<%= t.vehicleNo %>', '<%= t.driverName %>', <%= t.loadedQty %>, <%= t.totalDeliveredQty || 0 %>, <%= t.totalCollectedQty || 0 %>)" 
                                        class="btn btn-primary" 
                                        style="padding: 6px 14px; font-size: 12px; background: #144d37; color: #ffffff; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; font-weight: 600; border-radius: 6px;">
                                    <i class="fa-solid fa-truck-ramp-box"></i> Unload
                                </button>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<style>
    .table-responsive table th, 
    .table-responsive table td {
        white-space: nowrap !important;
        vertical-align: middle !important;
    }
</style>

<!-- 2. Unloading History -->
<div class="content-box">
    <div class="box-header">
        <span class="box-title"><i class="fa-solid fa-clock-rotate-left"></i> Unloading History</span>
    </div>

    <% const completedTrips = (trips || []).filter(t => t.status === 'COMPLETED' || t.status === 'CANCELLED'); %>
    <% if (completedTrips.length === 0) { %>
        <p style="text-align: center; color: var(--text-light); padding: 20px 0;">No unloading history records yet.</p>
    <% } else { %>
        <div class="table-responsive">
            <table id="completedTripsTable" class="display" style="width: 100%;">
                <thead>
                    <tr>
                        <th style="white-space: nowrap;">Date & Time</th>
                        <th style="white-space: nowrap;">Unloading No</th>
                        <th style="white-space: nowrap;">Loading No</th>
                        <th style="white-space: nowrap;">Vehicle & Driver</th>
                        <th style="white-space: nowrap;">Warehouse</th>
                        <th style="text-align: right; white-space: nowrap;">Loaded</th>
                        <th style="text-align: right; white-space: nowrap;">OUT</th>
                        <th style="text-align: right; white-space: nowrap;">IN</th>
                        <th style="text-align: right; white-space: nowrap;">Expected</th>
                        <th style="text-align: right; white-space: nowrap;">Unloaded</th>
                        <th style="text-align: right; white-space: nowrap;">Variance</th>
                        <th style="text-align: center; min-width: 160px; white-space: nowrap;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% completedTrips.forEach(t => { %>
                        <tr>
                            <td data-order="<%= t.returnedDate ? new Date(t.returnedDate).getTime() : (t.dispatchedDate ? new Date(t.dispatchedDate).getTime() : 0) %>" style="white-space: nowrap;">
                                <%= new Date(t.returnedDate || t.dispatchedDate).toLocaleDateString() %> <span style="color: var(--text-light); font-size: 11px;"><%= new Date(t.returnedDate || t.dispatchedDate).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
                            </td>
                            <td style="white-space: nowrap;"><strong style="color: #1e293b;"><%= t.unloadingNo || '-' %></strong></td>
                            <td style="white-space: nowrap;"><strong><%= t.tripNo %></strong></td>
                            <td style="white-space: nowrap;">
                                <strong style="color: var(--primary-green-dark);"><%= t.vehicleNo %></strong><% if (t.driverName) { %> <span style="font-size: 11px; color: var(--text-light); font-weight: normal;">(<%= t.driverName %>)</span><% } %>
                            </td>
                            <td style="white-space: nowrap;">
                                <span class="badge" style="background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; font-weight: 600; font-size: 11px; white-space: nowrap;">
                                    <%= t.locationName || 'Head Office' %>
                                </span>
                            </td>
                            <td data-order="<%= t.loadedQty || 0 %>" style="text-align: right; font-weight: 700; white-space: nowrap;"><%= t.loadedQty %></td>
                            <td data-order="<%= t.totalDeliveredQty || 0 %>" style="text-align: right; color: #dc2626; font-weight: 700; white-space: nowrap;"><%= t.totalDeliveredQty || 0 %></td>
                            <td data-order="<%= t.totalCollectedQty || 0 %>" style="text-align: right; color: #2563eb; font-weight: 700; white-space: nowrap;"><%= t.totalCollectedQty || 0 %></td>
                            <td data-order="<%= t.expectedRemainingQty || 0 %>" style="text-align: right; font-weight: 800; white-space: nowrap;"><%= t.expectedRemainingQty || 0 %></td>
                            <td data-order="<%= t.actualUnloadedQty !== undefined && t.actualUnloadedQty !== null ? t.actualUnloadedQty : -1 %>" style="text-align: right; font-weight: 800; color: #107c41; white-space: nowrap;">
                                <%= t.actualUnloadedQty !== undefined && t.actualUnloadedQty !== null ? t.actualUnloadedQty : '-' %>
                            </td>
                            <td data-order="<%= t.variance || 0 %>" style="text-align: right; white-space: nowrap;">
                                <% if (t.status === 'COMPLETED') { %>
                                    <% if (t.variance === 0) { %>
                                        <span class="badge badge-in" style="background:#dcfce7; color:#166534; border:1px solid #86efac; font-weight: 700; white-space: nowrap; padding: 3px 8px;">0</span>
                                    <% } else if (t.variance < 0) { %>
                                        <span class="badge badge-out" style="background:#fee2e2; color:#b91c1c; border:1px solid #fca5a5; font-weight: 700; white-space: nowrap; padding: 3px 8px;"><%= t.variance %></span>
                                    <% } else { %>
                                        <span class="badge" style="background:#eff6ff; color:#1d4ed8; border:1px solid #93c5fd; font-weight: 700; white-space: nowrap; padding: 3px 8px;">+<%= t.variance %></span>
                                    <% } %>
                                <% } else { %>
                                    <span style="color: #9ca3af;">-</span>
                                <% } %>
                            </td>
                            <td style="text-align: center; white-space: nowrap;">
                                <div style="display: flex; gap: 6px; justify-content: center; align-items: center; margin: 0 auto; width: fit-content; white-space: nowrap;">
                                    <a href="/unloading/<%= t.id %>/print" target="_blank" class="btn btn-receipt-action" title="Print Unloading Note">
                                        <i class="fa-solid fa-print"></i> Print
                                    </a>
                                    <% if (typeof user !== 'undefined' && user && (user.username === 'admin' || user.role === 'admin' || (typeof hasPerm === 'function' && hasPerm('transactions_edit')))) { %>
                                        <button onclick='openEditUnloadModal(<%- JSON.stringify(t).replace(/'/g, "\\'") %>)' class="btn btn-action-edit" title="Edit Unloading Record" type="button">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                    <% } %>
                                    <% if (typeof user !== 'undefined' && user && (user.username === 'admin' || user.role === 'admin' || (typeof hasPerm === 'function' && (hasPerm('transactions_delete') || hasPerm('delete_records'))))) { %>
                                        <form action="/unloading/<%= t.id %>/delete" method="POST" onsubmit="confirmAjaxDelete(event, this, 'unloading record')" style="display: inline-flex; margin: 0; padding: 0;">
                                            <button type="submit" class="btn btn-action-delete" title="Delete Record">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<!-- Settle / Unload Modal -->
<div id="settleModal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,0.6); backdrop-filter: blur(4px);">
    <div style="background-color: #fff; margin: 5% auto; padding: 25px; border-radius: 12px; width: 90%; max-width: 500px; box-shadow: 0 10px 25px rgba(0,0,0,0.3); border-top: 5px solid #107c41;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
            <h3 style="margin: 0; color: var(--primary-green-dark);"><i class="fa-solid fa-truck-ramp-box"></i> Unloading Vehicle</h3>
            <span onclick="closeSettleModal()" style="font-size: 24px; font-weight: bold; cursor: pointer; color: #666;">&times;</span>
        </div>

        <form id="settleForm" action="" method="POST" onsubmit="submitAjaxForm(event, this, 'Trip settled and stock updated successfully')">
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px; margin-bottom: 18px;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                    <span style="color: #64748b; font-size: 13px;">Loading No:</span>
                    <strong id="modalTripNo"></strong>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                    <span style="color: #64748b; font-size: 13px;">Vehicle & Driver:</span>
                    <strong id="modalVehicle"></strong>
                </div>
                <hr style="margin: 8px 0; border: 0; border-top: 1px dashed #cbd5e1;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 13px;">
                    <span>Loaded at Warehouse:</span>
                    <strong id="modalLoaded">0</strong>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 13px; color: #dc2626;">
                    <span>Delivered to Customers:</span>
                    <strong id="modalDelivered">0</strong>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 13px; color: #2563eb;">
                    <span>Collected from Customers:</span>
                    <strong id="modalCollected">0</strong>
                </div>
                <div style="display: flex; justify-content: space-between; margin-top: 8px; padding-top: 6px; border-top: 1.5px solid #cbd5e1; font-size: 14px;">
                    <strong style="color: #1e293b;">Expected Remaining Trays:</strong>
                    <strong id="modalExpected" style="color: #107c41; font-size: 16px;">0</strong>
                </div>
            </div>

            <div class="form-group">
                <label for="actualUnloadedQty" style="font-weight: 700; color: #1e293b;">Actual Unloaded Trays <span style="color:red;">*</span></label>
                <input type="number" id="actualUnloadedQty" name="actualUnloadedQty" min="0" class="form-control" style="font-size: 18px; font-weight: 800; padding: 10px;" placeholder="0" required oninput="calculateVariance()">
            </div>

            <!-- Live Variance Display -->
            <div id="varianceBox" style="display: none; padding: 10px 14px; border-radius: 8px; margin-bottom: 15px; font-size: 13px; font-weight: 700;">
            </div>

            <div class="form-group">
                <label for="settleNotes">Remarks</label>
                <input type="text" id="settleNotes" name="notes" class="form-control" placeholder="">
            </div>

            <div style="display: flex; gap: 10px; margin-top: 20px;">
                <button type="submit" class="btn btn-primary" style="flex: 1; padding: 12px; background-color: #107c41; border: none;">
                    <i class="fa-solid fa-check"></i> Settle & Update Warehouse Stock
                </button>
                <button type="button" onclick="closeSettleModal()" class="btn btn-secondary" style="padding: 12px;">
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Unloading Modal -->
<div id="editUnloadModal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,0.6); backdrop-filter: blur(4px);">
    <div style="background-color: #fff; margin: 5% auto; padding: 25px; border-radius: 12px; width: 90%; max-width: 500px; box-shadow: 0 10px 25px rgba(0,0,0,0.3); border-top: 5px solid #107c41;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
            <h3 style="margin: 0; color: var(--primary-green-dark);"><i class="fa-solid fa-pen-to-square"></i> Edit Unloading Record</h3>
            <span onclick="closeEditUnloadModal()" style="font-size: 24px; font-weight: bold; cursor: pointer; color: #666;">&times;</span>
        </div>

        <form id="editUnloadForm" action="" method="POST" onsubmit="submitAjaxForm(event, this, 'Unloading record updated successfully')">
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; margin-bottom: 15px; font-size: 13px;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">
                    <span style="color: #64748b;">Unloading No:</span>
                    <strong id="editUnloadNo"></strong>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">
                    <span style="color: #64748b;">Loading No:</span>
                    <strong id="editTripNo"></strong>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <span style="color: #64748b;">Vehicle:</span>
                    <strong id="editVehicleNo"></strong>
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 12px;">
                <label for="editActualUnloadedQty" style="font-weight: 700;">Actual Unloaded Trays <span style="color:red;">*</span></label>
                <input type="number" id="editActualUnloadedQty" name="actualUnloadedQty" min="0" required class="form-control" style="font-size: 18px; font-weight: 800; padding: 8px;">
            </div>

            <div class="form-group" style="margin-bottom: 15px;">
                <label for="editNotes" style="font-weight: 600;">Remarks</label>
                <input type="text" id="editNotes" name="notes" class="form-control">
            </div>

            <div style="display: flex; gap: 10px; margin-top: 20px;">
                <button type="submit" class="btn btn-primary" style="flex: 1; padding: 12px; background-color: #107c41; border: none;">
                    <i class="fa-solid fa-check"></i> Save Changes
                </button>
                <button type="button" onclick="closeEditUnloadModal()" class="btn btn-secondary" style="padding: 12px;">
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    let currentExpectedQty = 0;

    function openSettleModal(tripId, tripNo, vehicleNo, driverName, loaded, delivered, collected) {
        const form = document.getElementById('settleForm');
        form.action = '/lorry-trips/' + tripId + '/settle';

        document.getElementById('modalTripNo').innerText = tripNo;
        document.getElementById('modalVehicle').innerText = vehicleNo + (driverName ? ' (' + driverName + ')' : '');
        document.getElementById('modalLoaded').innerText = loaded;
        document.getElementById('modalDelivered').innerText = delivered;
        document.getElementById('modalCollected').innerText = collected;

        currentExpectedQty = loaded - delivered + collected;
        document.getElementById('modalExpected').innerText = currentExpectedQty + ' Trays';
        
        document.getElementById('actualUnloadedQty').value = '';
        document.getElementById('settleNotes').value = '';
        document.getElementById('varianceBox').style.display = 'none';

        const submitBtn = document.querySelector('#settleForm button[type="submit"]');
        if (submitBtn) submitBtn.disabled = false;

        document.getElementById('settleModal').style.display = 'block';
    }

    function closeSettleModal() {
        document.getElementById('settleModal').style.display = 'none';
    }

    function openEditUnloadModal(trip) {
        document.getElementById('editUnloadForm').action = '/unloading/' + trip.id + '/edit';
        document.getElementById('editUnloadNo').innerText = trip.unloadingNo || '-';
        document.getElementById('editTripNo').innerText = trip.tripNo || '-';
        document.getElementById('editVehicleNo').innerText = trip.vehicleNo || '-';
        document.getElementById('editActualUnloadedQty').value = trip.actualUnloadedQty !== undefined ? trip.actualUnloadedQty : '';
        document.getElementById('editNotes').value = trip.notes || '';
        document.getElementById('editUnloadModal').style.display = 'block';
    }

    function closeEditUnloadModal() {
        document.getElementById('editUnloadModal').style.display = 'none';
    }

    function calculateVariance() {
        const actualInput = document.getElementById('actualUnloadedQty');
        const box = document.getElementById('varianceBox');
        if (actualInput.value === '') {
            box.style.display = 'none';
            return;
        }

        const actual = parseInt(actualInput.value) || 0;
        const diff = actual - currentExpectedQty;

        box.style.display = 'block';
        if (diff === 0) {
            box.style.background = '#dcfce7';
            box.style.color = '#15803d';
            box.style.border = '1px solid #86efac';
            box.innerHTML = '<i class="fa-solid fa-circle-check"></i> Perfect! Tray count matches 100% (Variance: 0)';
        } else if (diff < 0) {
            box.style.background = '#fee2e2';
            box.style.color = '#b91c1c';
            box.style.border = '1px solid #fca5a5';
            box.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> Tray shortage detected! Missing count: ${Math.abs(diff)} Trays (Shortage)`;
        } else {
            box.style.background = '#eff6ff';
            box.style.color = '#1d4ed8';
            box.style.border = '1px solid #93c5fd';
            box.innerHTML = `<i class="fa-solid fa-circle-info"></i> Excess trays found: +${diff} Trays (Excess)`;
        }
    }
</script>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script>
    $(document).ready(function () {
        if ($('#completedTripsTable').length) {
            $('#completedTripsTable').DataTable({
                pageLength: 25,
                order: [[0, 'desc']], // Sort by Date & Time descending
                columnDefs: [
                    { orderable: false, targets: [11] } // Disable sorting on Actions column
                ]
            });
        }
    });
</script>

<%- include('partials/footer') %>
