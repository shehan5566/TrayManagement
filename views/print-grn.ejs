<%- include('partials/header') %>

<div class="receipt-card" style="position: relative;">
    <% if (transfer.isDeleted) { %>
        <div style="position: absolute; top: 40%; left: 50%; transform: translate(-50%, -50%) rotate(-30deg); font-size: 70px; font-weight: bold; color: rgba(255, 0, 0, 0.15); z-index: 10; pointer-events: none; white-space: nowrap; border: 5px solid rgba(255, 0, 0, 0.15); padding: 20px; border-radius: 10px;">CANCELLED</div>
    <% } %>
    <div class="receipt-header">
        <img src="/images/logo.png" alt="Nelna Agri Development Logo" class="receipt-logo-img">
        <div class="receipt-title">Nelna Agri Development (Pvt) Ltd</div>
        <div class="receipt-doc-title" style="font-size: 15px; color: var(--primary-green-dark); font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;">Goods Received Note (GRN)</div>
        <div class="receipt-subtitle">Official Inward Stock Receipt & Verification Log</div>
    </div>

    <div class="receipt-meta">
        <div>
            <strong>GRN No:</strong> <%= transfer.grnNo || '-' %><br>
            <strong>Transfer Doc No:</strong> <%= transfer.transferDocNo || '-' %><br>
            <strong>Received By:</strong> <%= transfer.receivedBy || 'Pending' %>
        </div>
        <div style="text-align: right;">
            <strong>Received Date:</strong> <%= transfer.receivedDate ? new Date(transfer.receivedDate).toLocaleDateString() : 'Pending' %><br>
            <strong>Time:</strong> <%= transfer.receivedDate ? new Date(transfer.receivedDate).toLocaleTimeString() : '-' %>
        </div>
    </div>

    <table class="receipt-details-table">
        <tr>
            <td class="label">Received At Branch</td>
            <td class="value"><strong><%= transfer.toLocationName %></strong></td>
        </tr>
        <tr>
            <td class="label">Dispatched From</td>
            <td class="value"><strong><%= transfer.fromLocationName %></strong></td>
        </tr>
        <tr>
            <td class="label" style="font-weight: 600; color: #1b5e20;">Dispatched Quantity</td>
            <td class="value"><strong><%= transfer.dispatchedQty %> Trays</strong></td>
        </tr>
        <tr>
            <td class="label" style="font-weight: 600; color: #1b5e20;">Received Quantity</td>
            <td class="value">
                <% if(transfer.status === 'ACCEPTED' || transfer.status === 'REJECTED') { %>
                    <strong style="font-size: 16px; color: #1b5e20;"><%= transfer.receivedQty %> Trays</strong>
                <% } else { %>
                    <span style="color: #f57f17; font-weight: bold;">Pending GRN Confirmation</span>
                <% } %>
            </td>
        </tr>
        <tr>
            <td class="label">Variance</td>
            <td class="value">
                <% if(transfer.status === 'ACCEPTED' || transfer.status === 'REJECTED') { %>
                    <strong style="color: <%= transfer.variance < 0 ? '#d32f2f' : '#2e7d32' %>;">
                        <%= transfer.variance %> Trays
                    </strong>
                <% } else { %>
                    -
                <% } %>
            </td>
        </tr>
        <tr>
            <td class="label" style="font-weight: 600;">GRN Status</td>
            <td class="value">
                <% if (transfer.status === 'ACCEPTED') { %>
                    <span class="badge" style="background:#1b5e20; color:white; padding:4px 10px; font-size:12px;">ACCEPTED</span>
                <% } else if (transfer.status === 'REJECTED') { %>
                    <span class="badge" style="background:#d32f2f; color:white; padding:4px 10px; font-size:12px;">REJECTED</span>
                <% } else { %>
                    <span class="badge" style="background:var(--accent-yellow); color:#333; padding:4px 10px; font-size:12px;">PENDING RECEIPT</span>
                <% } %>
            </td>
        </tr>
        <tr>
            <td class="label">Vehicle No</td>
            <td class="value"><code><%= transfer.vehicleNo || '-' %></code></td>
        </tr>
        <tr>
            <td class="label">Dispatched By & Date</td>
            <td class="value"><%= transfer.dispatchedBy || 'System' %> (<%= new Date(transfer.dispatchedDate).toLocaleDateString() %>)</td>
        </tr>
        <% if (transfer.remarks) { %>
            <tr>
                <td class="label" style="font-weight: 600; color: #1b5e20;">Remarks / Notes</td>
                <td class="value" style="font-style: italic;">
                    <%= transfer.remarks %>
                </td>
            </tr>
        <% } %>
    </table>

    <!-- GRN Highlight Box -->
    <% 
       let bgColor = '#fff8e1';
       let borderColor = '#ffc107';
       let iconClass = 'fa-clock-rotate-left';
       let statusText = 'Pending GRN Confirmation';
       
       if (transfer.status === 'ACCEPTED') {
           bgColor = '#e8f5e9';
           borderColor = '#66bb6a';
           iconClass = 'fa-circle-check';
           statusText = 'Stock Successfully Received & Credited';
       } else if (transfer.status === 'REJECTED') {
           bgColor = '#ffebee';
           borderColor = '#ef5350';
           iconClass = 'fa-circle-xmark';
           statusText = 'GRN Stock Rejected';
       }
    %>
    <div style="margin: 18px 0; padding: 16px 20px; border-radius: 8px; background-color: <%= bgColor %>; border: 2px solid <%= borderColor %>;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <div style="font-size: 14px; font-weight: 700; color: #333;">
                    <i class="fa-solid <%= iconClass %>"></i> GRN Status: <%= statusText %>
                </div>
                <div style="font-size: 12px; color: #555; margin-top: 4px;">
                    Received at: <strong><%= transfer.toLocationName %></strong> &nbsp;|&nbsp; From: <strong><%= transfer.fromLocationName %></strong>
                </div>
                <div style="font-size: 12px; margin-top: 2px; color: <%= transfer.variance < 0 ? '#d32f2f' : '#2e7d32' %>; font-weight: 600;">
                    <% if (transfer.status === 'ACCEPTED' || transfer.status === 'REJECTED') { %>
                        Variance: <%= transfer.variance %> Trays
                    <% } else { %>
                        Variance: Pending Inspection
                    <% } %>
                </div>
            </div>
            <div style="text-align: right;">
                <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #666; margin-bottom: 2px;">
                    Received Quantity
                </div>
                <div style="font-size: 24px; font-weight: 900; color: #1b5e20;">
                    <%= transfer.status === 'PENDING' ? 'Pending' : transfer.receivedQty + ' Trays' %>
                </div>
            </div>
        </div>
    </div>

    <!-- Verification Note Box -->
    <div style="margin: 12px 0 20px 0; padding: 10px 14px; border: 1px dashed #1565c0; background: #e3f2fd; border-radius: 6px; font-size: 11px; color: #1565c0; display: flex; justify-content: space-between; align-items: center;">
        <div>
            <i class="fa-solid fa-boxes-packing"></i> <strong>Stock Inward Verification:</strong> Physical count verified upon arrival at receiving branch.
        </div>
        <div style="font-weight: 600; color: #333;">
            Inward Date: <%= transfer.receivedDate ? new Date(transfer.receivedDate).toLocaleDateString() : '____________' %>
        </div>
    </div>

    <div class="receipt-signatures">
        <div class="signature-line">Received By</div>
        <div class="signature-line">Checked By</div>
        <div class="signature-line">Driver</div>
        <div class="signature-line">Authorized Manager</div>
    </div>
</div>

<div class="print-actions">
    <button onclick="window.print()" class="btn btn-primary" style="padding: 12px 24px; background-color: #1b5e20; border-color: #1b5e20;">
        <i class="fa-solid fa-print"></i> Print Goods Received Note (GRN)
    </button>
    <span class="badge" style="background: #e3f2fd; color: #0d47a1; padding: 10px 16px; font-size: 12px; display: inline-flex; align-items: center; gap: 6px; border: 1px solid #bbdefb;">
        <i class="fa-solid fa-print"></i> Size: 5.5" × 8.0" (Epson Dot Matrix)
    </span>
    <a href="/receive-stock" class="btn btn-secondary" style="padding: 12px 24px;">
        <i class="fa-solid fa-arrow-left"></i> Back to Receive Stock
    </a>
</div>

<%- include('partials/footer') %>
