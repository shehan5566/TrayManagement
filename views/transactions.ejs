<%- include('partials/header') %>

    <div style="margin-bottom: 25px;">
        <h2 style="color: var(--primary-green-dark);"><i class="fa-solid fa-right-left"></i> Tray In & Out Entry</h2>
    </div>

    <% if (error) { %>
        <div class="error-banner">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <%= error %>
        </div>
        <% } %>

            <% if (typeof hasPerm !== 'function' || hasPerm('transactions_create')) { %>
                <!-- Entry Form -->
                <div class="content-box" style="border-top: 4px solid var(--accent-yellow);">
                    <div class="box-header">
                        <span class="box-title"><i class="fa-solid fa-pen-nib"></i> New Transaction Entry</span>
                    </div>

                    <form id="transactionForm" action="/transactions" method="POST"
                        onsubmit="handleTransactionFormSubmit(event, this)">
                        <div class="form-grid" style="row-gap: 22px;">
                            <div class="form-group">
                                <label for="date">Transaction Date & Time</label>
                                <input type="datetime-local" id="date" name="date" required>
                            </div>

                            <div class="form-group" style="position: relative;">
                                <label for="customerSearchInput">Search Customer</label>
                                <input type="text" id="customerSearchInput"
                                    placeholder="Type or click to search customer..." required autocomplete="off">
                                <div id="autocomplete-list"
                                    style="position: absolute; border: 1px solid #d4d4d4; border-bottom: none; border-top: none; z-index: 99; top: 100%; left: 0; right: 0; background-color: #fff; max-height: 200px; overflow-y: auto; display: none; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border-radius: 4px;">
                                </div>
                                <input type="hidden" id="customerId" name="customerId" required>
                                <div id="selectedCustomerBadge" style="display: none; margin-top: 6px;"></div>
                            </div>

                            <div class="form-group">
                                <label for="type">Transaction Type</label>
                                <select id="type" name="type" required>
                                    <option value="OUT">TRAY OUT (Issue to Customer)</option>
                                    <option value="IN">TRAY IN (Return from Customer)</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="vehicleNo">Vehicle Number</label>
                                <select id="vehicleNo" name="vehicleNo">
                                    <option value="N/A">Select Vehicle</option>
                                    <option value="LK-3945">LK-3945</option>
                                    <option value="LN-4124">LN-4124</option>
                                    <option value="PX-1430">PX-1430</option>
                                    <option value="PU-4451">PU-4451</option>
                                    <option value="LP-3506">LP-3506</option>
                                    <option value="LG-1095">LG-1095</option>
                                    <option value="LK-8422">LK-8422</option>
                                    <option value="LM-6632">LM-6632</option>
                                    <option value="DAG-2712">DAG-2712</option>
                                    <option value="RENTED">RENTED</option>
                                    <option value="OWNOUTLET">OWNOUTLET</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="count">Tray Quantity</label>
                                <input type="number" id="count" name="count" min="1" placeholder="Enter tray count..."
                                    required>
                            </div>

                            <div class="form-group">
                                <label for="depositPerTray">Standard Deposit per Tray (Rs.)</label>
                                <input type="number" id="depositPerTray" name="depositPerTray" min="0" step="0.01"
                                    value="<%= (typeof settings !== 'undefined' && settings && settings.depositPerTray) ? settings.depositPerTray : 2000 %>" required>
                            </div>

                            <div class="form-group" style="display: none;">
                                <label for="depositOption">Deposit / Refund Option</label>
                                <select id="depositOption" name="depositOption">
                                    <option value="FULL">Full Deposit / Refund (100%)</option>
                                    <option value="HALF">Half Payment / Half Refund (50%)</option>
                                    <option value="ZERO">No Deposit / No Refund (0%)</option>
                                    <option value="CUSTOM">Custom Amount (Manually Enter)</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                    <label for="actualDeposit" id="actualDepositLabel" style="margin-bottom: 0;">Actual Deposit Collected (Rs.)</label>
                                    <div style="display: flex; gap: 6px;">
                                        <button type="button" class="btn" style="padding: 2px 8px; font-size: 11px; background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; font-weight: 700; border-radius: 4px; cursor: pointer;" onclick="setQuickDeposit('FULL')">Full Amount</button>
                                        <button type="button" class="btn" style="padding: 2px 8px; font-size: 11px; background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; font-weight: 700; border-radius: 4px; cursor: pointer;" onclick="setQuickDeposit('ZERO')">Rs. 0 (Credit)</button>
                                    </div>
                                </div>
                                <input type="number" id="actualDeposit" name="actualDeposit" min="0" step="0.01"
                                    placeholder="Enter actual cash collected..." required>
                            </div>
                        </div>

                        <!-- Live Deposit Total Display -->
                        <div id="depositSummaryBox"
                            style="margin-bottom: 20px; padding: 14px 18px; border-radius: 8px; background-color: #fffbea; border: 2px solid var(--accent-yellow); display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <span id="depositLabel"
                                    style="font-size: 14px; font-weight: 600; color: var(--primary-green-dark);">
                                    <i class="fa-solid fa-coins"></i> Deposit Summary (OUT):
                                </span>
                                <div id="expectedDepositText" style="font-size: 12px; color: #666; margin-top: 2px;">
                                    Expected: Rs. 0.00</div>
                            </div>
                            <div style="text-align: right;">
                                <div style="font-size: 11px; font-weight: 600; text-transform: uppercase; color: #777;">
                                    Actual Amount</div>
                                <span style="font-size: 22px; font-weight: 800; color: var(--primary-green-dark);">Rs.
                                    <span id="totalDepositDisplay">0.00</span></span>
                            </div>
                        </div>

                        <div class="form-group" style="margin-bottom: 20px;">
                            <label for="remarks">Remarks / Special Notes</label>
                            <textarea id="remarks" name="remarks" rows="2" placeholder="Any comments..."></textarea>
                        </div>



                                <button type="submit" class="btn btn-primary" style="padding: 12px 24px;">
                                    <i class="fa-solid fa-receipt"></i> Save & Print Receipt
                                </button>
                    </form>

                    <hr style="margin: 25px 0 20px 0; border: 0; border-top: 1px dashed var(--border-color);">
                    <div style="font-size: 13px; font-weight: bold; margin-bottom: 10px; color: var(--text-dark); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 6px;">
                        <span><i class="fa-solid fa-file-excel" style="color: #107c41;"></i> Bulk Import (Excel)</span>
                        <span style="font-size: 11px; color: var(--text-light); font-weight: normal;">Upload multiple Tray IN & OUT entries at once via spreadsheet</span>
                    </div>
                    <form action="/transactions/import" method="POST" enctype="multipart/form-data" onsubmit="submitAjaxForm(event, this, 'Transactions imported successfully')">
                        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
                            <input type="file" name="excelFile" accept=".xlsx, .xls, .csv" required style="font-size: 12px; padding: 8px 12px; border: 1px dashed var(--border-color); border-radius: 4px; flex: 1; min-width: 250px; box-sizing: border-box; background: var(--bg-light);">
                            <div style="display: flex; gap: 8px;">
                                <button type="submit" class="btn btn-primary" style="background-color: var(--accent-yellow); color: var(--primary-green-dark); border: none; padding: 8px 18px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                                    <i class="fa-solid fa-upload"></i> Import
                                </button>
                                <a href="/templates/Transaction_Template.xlsx" class="btn btn-secondary" style="padding: 8px 16px; display: inline-flex; align-items: center; gap: 6px; text-decoration: none;" title="Download Template">
                                    <i class="fa-solid fa-download"></i> Template
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
                <% } %>

                    <div class="content-box">
                        <div class="box-header">
                            <span class="box-title"><i class="fa-solid fa-list-check"></i> Transaction History
                                Log</span>
                        </div>

                        <form method="GET" action="/transactions" class="search-container"
                            style="display: flex; gap: 10px; flex-wrap: wrap;">
                            <input type="text" name="search" class="search-input"
                                value="<%= locals.searchQuery || '' %>" placeholder="Search logs by customer, driver, or vehicle..."
                                style="flex-grow: 1;">
                            <button type="submit" class="btn btn-primary" style="padding: 10px 20px;"><i
                                    class="fa-solid fa-search"></i> Search</button>
                            <% if (locals.searchQuery) { %>
                                <a href="/transactions" class="btn btn-secondary"
                                    style="padding: 10px 20px; display: flex; align-items: center; justify-content: center; text-decoration: none;">Clear</a>
                                <% } %>
                        </form>

                        <% if (transactions.length===0) { %>
                            <p style="text-align: center; color: var(--text-light); padding: 30px 0;">No transactions
                                registered
                                yet.</p>
                            <% } else { %>
                                <div class="table-responsive">
                                    <table id="transactionsTable">
                                        <thead>
                                            <tr>
                                                <th>Date & Time</th>
                                                <th>Customer</th>
                                                <th>Type</th>
                                                <th>Quantity</th>
                                                <th>Deposit (Rs.)</th>
                                                <th>Vehicle No</th>
                                                <th>Operator</th>
                                                <th>Remarks</th>
                                                <th style="text-align: center;">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% transactions.forEach(tx=> { %>
                                                <tr>
                                                    <td>
                                                        <%= new Date(tx.date).toLocaleString() %>
                                                    </td>
                                                    <td><strong>
                                                            <%= tx.customerName %>
                                                        </strong></td>
                                                    <td>
                                                        <span
                                                            class="badge badge-<%= tx.type === 'IN' ? 'in' : 'out' %>">
                                                            <%= tx.type==='IN' ? 'IN' : 'OUT' %>
                                                        </span>
                                                    </td>
                                                    <td style="font-weight: bold;">
                                                        <%= tx.count %>
                                                    </td>
                                                    <td
                                                        style="font-weight: bold; color: <%= tx.type === 'OUT' ? 'var(--danger)' : 'var(--success)' %>;">
                                                        <%= tx.type==='OUT' ? '+' : '-' %> Rs. <%= (tx.totalDeposit ||
                                                                0).toLocaleString() %>
                                                                <div
                                                                    style="font-size: 11px; color: var(--text-light); font-weight: normal;">
                                                                    <% if (tx.depositOption==='ZERO' ) { %>
                                                                        <span class="badge"
                                                                            style="background:#6c757d; color:#fff; font-size:10px; padding:2px 5px;">No
                                                                            Deposit</span>
                                                                        <% } else if (tx.depositOption==='HALF' ) { %>
                                                                            <span class="badge"
                                                                                style="background:#fd7e14; color:#fff; font-size:10px; padding:2px 5px;">Half
                                                                                Payment</span>
                                                                            <% } else if (tx.depositOption==='CUSTOM' )
                                                                                { %>
                                                                                <span class="badge"
                                                                                    style="background:#17a2b8; color:#fff; font-size:10px; padding:2px 5px;">Custom
                                                                                    Amount</span>
                                                                                <% } else { %>
                                                                                    Rs.<%= (tx.depositPerTray || (typeof settings !== 'undefined' && settings && settings.depositPerTray ? settings.depositPerTray : 2000)).toLocaleString() %>/tray
                                                                                        <% } %>
                                                                </div>
                                                    </td>
                                                    <td><code><%= tx.vehicleNo %></code></td>
                                                    <td>
                                                        <% if (tx.driverName) { %>
                                                            <strong style="color: var(--primary-green-dark);"><%= tx.driverName %></strong>
                                                            <% if (tx.user && tx.user !== tx.driverName && !tx.user.startsWith('Driver (')) { %>
                                                                <div style="font-size: 11px; color: var(--text-light);">(<%= tx.user %>)</div>
                                                            <% } %>
                                                        <% } else { %>
                                                            <%= tx.user %>
                                                        <% } %>
                                                    </td>
                                                    <td><span style="font-size: 13px; color: var(--text-light);">
                                                            <%= tx.remarks || '-' %>
                                                        </span></td>
                                                    <td>
                                                        <div style="display: flex; gap: 8px; justify-content: center;">
                                                            <a href="/transactions/<%= tx.id %>/receipt"
                                                                class="btn btn-secondary"
                                                                style="padding: 6px 10px; font-size: 12px;"
                                                                title="Print Receipt">
                                                                <i class="fa-solid fa-print"></i> Receipt
                                                            </a>
                                                             <% if (user.username === 'admin' || user.role === 'admin' || (typeof hasPerm === 'function' && hasPerm('transactions_edit'))) { %>
                                                                 <button
                                                                     onclick='openEditModal(<%- JSON.stringify(tx).replace(/'/g, "\\'") %>)' class="btn btn-primary"
                                                                     style="padding: 6px 10px; font-size: 12px;"
                                                                     title="Edit Record">
                                                                     <i class="fa-solid fa-pen"></i>
                                                                 </button>
                                                             <% } %>
                                                             <% if (user.username === 'admin' || user.role === 'admin' || (typeof hasPerm === 'function' && (hasPerm('transactions_delete') || hasPerm('delete_records')))) { %>
                                                                 <form action="/transactions/<%= tx.id %>/delete"
                                                                     method="POST"
                                                                     onsubmit="confirmAjaxDelete(event, this, 'transaction record')">
                                                                      <button type="submit" class="btn btn-danger"
                                                                          style="padding: 6px 10px; font-size: 12px; background-color: #ffc300; border-color: #e6b000; color: #000000;"
                                                                          title="Delete Record">
                                                                          <i class="fa-solid fa-trash"></i>
                                                                      </button>
                                                                 </form>
                                                             <% } %>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                        </tbody>
                                    </table>
                                </div>

                                <% if (locals.totalPages> 1) { %>
                                    <div
                                        style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px; padding: 15px 0 5px 0; border-top: 1px solid #eee;">
                                        <span style="color: var(--text-light); font-size: 14px;">Page <strong>
                                                <%= currentPage %>
                                            </strong> of <strong>
                                                <%= totalPages %>
                                            </strong></span>
                                        <div style="display: flex; gap: 8px;">
                                            <% if (currentPage> 1) { %>
                                                <a href="/transactions?page=<%= currentPage - 1 %><%= searchQuery ? '&search=' + searchQuery : '' %>"
                                                    class="btn btn-secondary"
                                                    style="padding: 6px 15px; font-size: 13px; text-decoration: none;"><i
                                                        class="fa-solid fa-chevron-left"></i> Prev</a>
                                                <% } %>

                                                    <% if (currentPage < totalPages) { %>
                                                        <a href="/transactions?page=<%= currentPage + 1 %><%= searchQuery ? '&search=' + searchQuery : '' %>"
                                                            class="btn btn-primary"
                                                            style="padding: 6px 15px; font-size: 13px; text-decoration: none;">Next
                                                            <i class="fa-solid fa-chevron-right"></i></a>
                                                        <% } %>
                                        </div>
                                    </div>
                                    <% } %>

                                        <% } %>
                    </div>

                    <!-- Edit Transaction Modal -->
                    <div id="editTxModal" class="modal"
                        style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5);">
                        <div class="modal-content"
                            style="background-color: #fefefe; margin: 5% auto; padding: 25px; border-radius: 8px; width: 90%; max-width: 700px; max-height: 90vh; overflow-y: auto;">
                            <div
                                style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 2px solid var(--accent-yellow); padding-bottom: 10px;">
                                <h3 style="margin: 0; color: var(--primary-green-dark);"><i
                                        class="fa-solid fa-pen-to-square"></i> Edit Transaction</h3>
                                <span onclick="closeEditModal()"
                                    style="color: #aaa; font-size: 28px; font-weight: bold; cursor: pointer;">&times;</span>
                            </div>

                            <form id="editTxForm" method="POST"
                                onsubmit="submitAjaxForm(event, this, 'Transaction updated successfully')">
                                <div class="form-grid">
                                    <div class="form-group">
                                        <label>Customer</label>
                                        <select id="editCustomerId" name="customerId" required>
                                            <% customers.forEach(c=> { %>
                                                <option value="<%= c.id %>">
                                                    <%= c.name %> - <%= c.phone %>
                                                </option>
                                                <% }) %>
                                        </select>
                                    </div>

                                    <div class="form-group">
                                        <label>Transaction Type</label>
                                        <select id="editType" name="type" required>
                                            <option value="OUT">TRAY OUT (Issue to Customer)</option>
                                            <option value="IN">TRAY IN (Return from Customer)</option>
                                        </select>
                                    </div>

                                    <div class="form-group">
                                        <label>Tray Quantity</label>
                                        <input type="number" id="editCount" name="count" min="1" required>
                                    </div>

                                    <div class="form-group">
                                        <label>Vehicle Number</label>
                                        <select id="editVehicleNo" name="vehicleNo">
                                            <option value="N/A">Select Vehicle</option>
                                            <option value="LK-3945">LK-3945</option>
                                            <option value="LN-4124">LN-4124</option>
                                            <option value="PX-1430">PX-1430</option>
                                            <option value="PU-4451">PU-4451</option>
                                            <option value="LP-3506">LP-3506</option>
                                            <option value="LG-1095">LG-1095</option>
                                            <option value="LK-8422">LK-8422</option>
                                            <option value="LM-6632">LM-6632</option>
                                            <option value="DAG-2712">DAG-2712</option>
                                            <option value="RENTED">RENTED</option>
                                            <option value="OWNOUTLET">OWNOUTLET</option>
                                        </select>
                                    </div>

                                    <div class="form-group">
                                        <label>Deposit per Tray (Rs.)</label>
                                        <input type="number" id="editDepositPerTray" name="depositPerTray" min="0"
                                            step="0.01" required>
                                    </div>

                                    <div class="form-group">
                                        <label>Deposit Option</label>
                                        <select id="editDepositOption" name="depositOption" required>
                                            <option value="FULL">Full Deposit / Refund (100%)</option>
                                            <option value="HALF">Half Payment / Half Refund (50%)</option>
                                            <option value="ZERO">No Deposit / No Refund (0%)</option>
                                            <option value="CUSTOM">Custom Amount (Manually Enter)</option>
                                        </select>
                                    </div>

                                    <div class="form-group">
                                        <label>Actual Deposit Collected (Rs.)</label>
                                        <input type="number" id="editActualDeposit" name="actualDeposit" min="0"
                                            step="0.01" required>
                                    </div>

                                    <div class="form-group">
                                        <label>Date & Time</label>
                                        <input type="datetime-local" id="editDate" name="date" required>
                                    </div>
                                </div>

                                <div class="form-group" style="margin-bottom: 20px;">
                                    <label>Remarks</label>
                                    <textarea id="editRemarks" name="remarks" rows="2"></textarea>
                                </div>

                                <% if (user.role==='admin' || user.username==='admin' ) { %>
                                    <% } %>


                                        <div style="display: flex; gap: 10px; justify-content: flex-end;">
                                            <button type="button" onclick="closeEditModal()" class="btn btn-secondary"
                                                style="padding: 10px 20px;">Cancel</button>
                                            <button type="submit" class="btn btn-primary" style="padding: 10px 20px;"><i
                                                    class="fa-solid fa-save"></i> Save Changes</button>
                                        </div>
                            </form>
                        </div>
                    </div>

                    <script>
                        document.addEventListener('DOMContentLoaded', () => {
                            // Auto-fill transaction datetime picker with local time
                            const dateInput = document.getElementById('date');
                            if (dateInput) {
                                const now = new Date();
                                now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
                                dateInput.value = now.toISOString().slice(0, 16);
                            }

                            // Elements for deposit logic
                            const countInput = document.getElementById('count');
                            const depositRateInput = document.getElementById('depositPerTray');
                            const depositOptionSelect = document.getElementById('depositOption');
                            const actualDepositInput = document.getElementById('actualDeposit');
                            const actualDepositLabel = document.getElementById('actualDepositLabel');
                            const totalDisplay = document.getElementById('totalDepositDisplay');
                            const expectedDisplay = document.getElementById('expectedDepositText');
                            const depositLabel = document.getElementById('depositLabel');
                            const typeSelect = document.getElementById('type');

                            let isManualEdit = false;

                            function updateDepositDisplay() {
                                const qty = parseFloat(countInput ? countInput.value : 0) || 0;
                                const defaultRate = <%= (typeof settings !== 'undefined' && settings && settings.depositPerTray) ? settings.depositPerTray : 2000 %>;
                                const rate = parseFloat(depositRateInput ? depositRateInput.value : defaultRate) || 0;
                                const expectedTotal = qty * rate;
                                const isOut = typeSelect ? (typeSelect.value === 'OUT') : true;

                                // Update Labels based on IN / OUT
                                if (depositLabel) {
                                    if (isOut) {
                                        depositLabel.innerHTML = '<i class="fa-solid fa-coins"></i> Deposit Summary (OUT - Collected):';
                                        depositLabel.style.color = 'var(--danger)';
                                        if (actualDepositLabel) actualDepositLabel.textContent = 'Actual Deposit Collected (Rs.)';
                                    } else {
                                        depositLabel.innerHTML = '<i class="fa-solid fa-coins"></i> Refund Summary (IN - Returned):';
                                        depositLabel.style.color = 'var(--success)';
                                        if (actualDepositLabel) actualDepositLabel.textContent = 'Actual Deposit Refunded (Rs.)';
                                    }
                                }

                                // Update deposit options labels depending on OUT/IN
                                if (depositOptionSelect) {
                                    const optFull = depositOptionSelect.options[0];
                                    const optHalf = depositOptionSelect.options[1];
                                    const optZero = depositOptionSelect.options[2];

                                    if (isOut) {
                                        optFull.text = "Full Deposit (100%)";
                                        optHalf.text = "Half Payment (50%)";
                                        optZero.text = "No Deposit (0% - Free Issue)";
                                    } else {
                                        optFull.text = "Full Refund (100%)";
                                        optHalf.text = "Half Refund (50%)";
                                        optZero.text = "No Refund (0% - Deposit Kept)";
                                    }
                                }

                                // Calculate auto value for option if not manually editing actualDeposit directly
                                if (!isManualEdit && actualDepositInput) {
                                    const option = depositOptionSelect ? depositOptionSelect.value : 'FULL';
                                    if (option === 'FULL') {
                                        actualDepositInput.value = expectedTotal.toFixed(2);
                                    } else if (option === 'HALF') {
                                        actualDepositInput.value = (expectedTotal / 2).toFixed(2);
                                    } else if (option === 'ZERO') {
                                        actualDepositInput.value = (0).toFixed(2);
                                    }
                                }

                                const actualVal = parseFloat(actualDepositInput ? actualDepositInput.value : 0) || 0;
                                const isShortfall = (typeSelect && typeSelect.value === 'OUT' && qty > 0 && actualVal < expectedTotal);

                                if (totalDisplay) {
                                    totalDisplay.textContent = actualVal.toLocaleString('en-LK', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                                }

                                if (expectedDisplay) {
                                    if (isShortfall) {
                                        const shortfall = expectedTotal - actualVal;
                                        expectedDisplay.innerHTML = 'Expected: Rs. ' + expectedTotal.toLocaleString('en-LK', { minimumFractionDigits: 2 }) + ' <span style="color:#dc2626; font-weight:700; margin-left:8px;"><i class="fa-solid fa-triangle-exclamation"></i> Shortfall: Rs. ' + shortfall.toLocaleString('en-LK', { minimumFractionDigits: 2 }) + ' (Approval Required)</span>';
                                    } else {
                                        expectedDisplay.innerHTML = 'Expected: Rs. ' + expectedTotal.toLocaleString('en-LK', { minimumFractionDigits: 2 }) + (qty > 0 ? ' <span style="color:#16a34a; font-weight:700; margin-left:8px;"><i class="fa-solid fa-circle-check"></i> Full Deposit Paid</span>' : '');
                                    }
                                }

                                checkCustomerOutstanding();
                            }

                            window.setQuickDeposit = function(opt) {
                                isManualEdit = (opt !== 'FULL');
                                const qty = parseFloat(countInput ? countInput.value : 0) || 0;
                                const defaultRate = <%= (typeof settings !== 'undefined' && settings && settings.depositPerTray) ? settings.depositPerTray : 2000 %>;
                                const rate = parseFloat(depositRateInput ? depositRateInput.value : defaultRate) || 0;
                                const expectedTotal = qty * rate;

                                if (opt === 'FULL') {
                                    if (actualDepositInput) actualDepositInput.value = expectedTotal.toFixed(2);
                                    if (depositOptionSelect) depositOptionSelect.value = 'FULL';
                                } else if (opt === 'ZERO') {
                                    if (actualDepositInput) actualDepositInput.value = (0).toFixed(2);
                                    if (depositOptionSelect) depositOptionSelect.value = 'ZERO';
                                }
                                updateDepositDisplay();
                            };

                            if (countInput) countInput.addEventListener('input', () => { isManualEdit = false; updateDepositDisplay(); });
                            if (depositRateInput) depositRateInput.addEventListener('input', () => { isManualEdit = false; updateDepositDisplay(); });
                            if (typeSelect) typeSelect.addEventListener('change', () => { isManualEdit = false; updateDepositDisplay(); });
                            if (depositOptionSelect) depositOptionSelect.addEventListener('change', () => {
                                if (depositOptionSelect.value !== 'CUSTOM') {
                                    isManualEdit = false;
                                }
                                updateDepositDisplay();
                            });
                            ['input', 'change', 'keyup'].forEach(evt => {
                                if (actualDepositInput) {
                                    actualDepositInput.addEventListener(evt, () => {
                                        isManualEdit = true;
                                        if (depositOptionSelect) {
                                            const val = parseFloat(actualDepositInput.value) || 0;
                                            const qty = parseFloat(countInput ? countInput.value : 0) || 0;
                                            const defaultRate = <%= (typeof settings !== 'undefined' && settings && settings.depositPerTray) ? settings.depositPerTray : 2000 %>;
                                            const rate = parseFloat(depositRateInput ? depositRateInput.value : defaultRate) || 0;
                                            const expectedTotal = qty * rate;

                                            if (val >= expectedTotal) {
                                                depositOptionSelect.value = 'FULL';
                                            } else if (val === expectedTotal / 2 && val > 0) {
                                                depositOptionSelect.value = 'HALF';
                                            } else if (val === 0) {
                                                depositOptionSelect.value = 'ZERO';
                                            } else {
                                                depositOptionSelect.value = 'CUSTOM';
                                            }
                                        }
                                        updateDepositDisplay();
                                    });
                                }
                            });

                            updateDepositDisplay(); // Initial call

                            // Custom Autocomplete for Customer Search
                            const searchInput = document.getElementById('customerSearchInput');
                            const hiddenId = document.getElementById('customerId');
                            const autocompleteList = document.getElementById('autocomplete-list');

                            const customersData = [
                        <% customers.forEach(c => { %>
                                { name: "<%= c.name.replace(/\"/g, '&quot;') %>", id: "<%= c.id %>", phone: "<%= (c.phone || '').replace(/\"/g, '&quot;') %>", balance: <%= c.currentBalance || 0 %>, pendingDeposit: <%= c.pendingDeposit || 0 %> },
                                <% }) %>
                            ];

                            let currentFocus = -1;

                            function renderSelectedCustomerBadge(c) {
                                const badge = document.getElementById('selectedCustomerBadge');
                                if (!badge) return;
                                if (!c) {
                                    badge.style.display = 'none';
                                    badge.innerHTML = '';
                                    return;
                                }

                                const trayBal = Number(c.balance || 0);
                                const pendDep = Number(c.pendingDeposit || 0);
                                const trayColor = '#166534';
                                const depColor = '#166534';

                                badge.style.display = 'block';
                                badge.innerHTML = `
                                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 4px;">
                                        <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; padding: 6px 10px; display: flex; align-items: center; justify-content: space-between; white-space: nowrap; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">
                                            <span style="font-size: 11px; color: #64748b; font-weight: 700;">Net Trays:</span>
                                            <strong style="color: ${trayColor}; font-size: 12.5px; margin-left: 6px;">
                                                ${trayBal} Trays
                                            </strong>
                                        </div>
                                        <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; padding: 6px 10px; display: flex; align-items: center; justify-content: space-between; white-space: nowrap; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">
                                            <span style="font-size: 11px; color: #64748b; font-weight: 700;">Pending:</span>
                                            <strong style="color: ${depColor}; font-size: 12.5px; margin-left: 6px;">
                                                Rs. ${pendDep.toLocaleString('en-LK', { minimumFractionDigits: 2 })}
                                            </strong>
                                        </div>
                                    </div>
                                `;
                            }

                            function removeActive(items) {
                                for (let i = 0; i < items.length; i++) {
                                    items[i].classList.remove("autocomplete-active");
                                    items[i].style.backgroundColor = "#fff";
                                    items[i].style.color = "#333";
                                }
                            }

                            function setActiveItem(items, index) {
                                if (!items || items.length === 0) return;
                                removeActive(items);

                                if (index >= items.length) currentFocus = 0;
                                else if (index < 0) currentFocus = items.length - 1;
                                else currentFocus = index;

                                const activeDiv = items[currentFocus];
                                if (activeDiv) {
                                    activeDiv.classList.add("autocomplete-active");
                                    activeDiv.style.backgroundColor = "#007bff";
                                    activeDiv.style.color = "#fff";

                                    // Scroll container so the active item is always visible
                                    activeDiv.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                                }
                            }

                            function renderAutocomplete(val, showAll = false) {
                                autocompleteList.innerHTML = '';
                                currentFocus = -1;
                                if (!val && !showAll) {
                                    autocompleteList.style.display = 'none';
                                    return;
                                }

                                autocompleteList.style.display = 'block';
                                let matches = 0;

                                customersData.forEach(c => {
                                    if (showAll || c.name.toUpperCase().includes(val.toUpperCase())) {
                                        matches++;
                                        let div = document.createElement("div");
                                        div.className = "autocomplete-item";
                                        div.style.padding = "10px";
                                        div.style.cursor = "pointer";
                                        div.style.backgroundColor = "#fff";
                                        div.style.borderBottom = "1px solid #d4d4d4";
                                        div.style.color = "#333";
                                        div.style.fontSize = "14px";
                                        div.innerHTML = `<span style="font-weight: 600;">${c.name}</span>`;

                                        div.addEventListener("mouseenter", function () {
                                            const items = autocompleteList.getElementsByClassName("autocomplete-item");
                                            removeActive(items);
                                            currentFocus = Array.from(items).indexOf(this);
                                            this.classList.add("autocomplete-active");
                                            this.style.backgroundColor = "#007bff";
                                            this.style.color = "#fff";
                                        });

                                        div.addEventListener("mouseleave", function () {
                                            this.classList.remove("autocomplete-active");
                                            this.style.backgroundColor = "#fff";
                                            this.style.color = "#333";
                                        });

                                        div.addEventListener("click", function (e) {
                                            searchInput.value = c.name;
                                            hiddenId.value = c.id;
                                            autocompleteList.style.display = 'none';
                                            currentFocus = -1;
                                            selectedCustomerObj = c;
                                            renderSelectedCustomerBadge(c);
                                            checkCustomerOutstanding();
                                        });
                                        autocompleteList.appendChild(div);
                                    }
                                });

                                if (matches === 0) {
                                    autocompleteList.style.display = 'none';
                                }
                            }

                            if (searchInput && hiddenId && autocompleteList) {
                                searchInput.addEventListener('input', function () {
                                    hiddenId.value = ''; // reset on typing
                                    selectedCustomerObj = null;
                                    const badge = document.getElementById('selectedCustomerBadge');
                                    if (badge) badge.style.display = 'none';
                                    checkCustomerOutstanding();
                                    renderAutocomplete(this.value);
                                });

                                searchInput.addEventListener('click', function () {
                                    if (this.value === '') {
                                        renderAutocomplete('', true); // show all on empty click
                                    } else {
                                        renderAutocomplete(this.value);
                                    }
                                });

                                // Enable Keyboard Navigation (ArrowDown, ArrowUp, Enter, Escape)
                                searchInput.addEventListener('keydown', function (e) {
                                    const items = autocompleteList.getElementsByClassName("autocomplete-item");

                                    if (e.key === "ArrowDown" || e.keyCode === 40) {
                                        e.preventDefault();
                                        if (autocompleteList.style.display === 'none' || items.length === 0) {
                                            renderAutocomplete(this.value, this.value === '');
                                            const newItems = autocompleteList.getElementsByClassName("autocomplete-item");
                                            setActiveItem(newItems, 0);
                                        } else {
                                            setActiveItem(items, currentFocus + 1);
                                        }
                                    } else if (e.key === "ArrowUp" || e.keyCode === 38) {
                                        e.preventDefault();
                                        if (autocompleteList.style.display !== 'none' && items.length > 0) {
                                            setActiveItem(items, currentFocus - 1);
                                        }
                                    } else if (e.key === "Enter" || e.keyCode === 13) {
                                        if (autocompleteList.style.display !== 'none' && items.length > 0) {
                                            if (currentFocus > -1 && items[currentFocus]) {
                                                e.preventDefault();
                                                items[currentFocus].click();
                                            } else if (items.length === 1) {
                                                e.preventDefault();
                                                items[0].click();
                                            }
                                        }
                                    } else if (e.key === "Escape" || e.keyCode === 27) {
                                        autocompleteList.style.display = 'none';
                                        currentFocus = -1;
                                    }
                                });

                                document.addEventListener("click", function (e) {
                                    if (e.target !== searchInput && !autocompleteList.contains(e.target)) {
                                        autocompleteList.style.display = 'none';
                                        currentFocus = -1;
                                    }
                                });
                            }

                        // Attach change listener to Transaction Type and Deposit Option
                        const typeInput = document.getElementById('type');
                        if (typeInput) {
                            typeInput.addEventListener('change', checkCustomerOutstanding);
                        }
                        if (depositOptionSelect) {
                            depositOptionSelect.addEventListener('change', checkCustomerOutstanding);
                        }

                        // Check Outstanding on load if customer pre-selected
                        if (hiddenId && hiddenId.value) {
                            const preCust = customersData.find(c => c.id === hiddenId.value);
                            if (preCust) {
                                selectedCustomerObj = preCust;
                                renderSelectedCustomerBadge(preCust);
                            }
                        }
                        checkCustomerOutstanding();
                });

                // Global variables for Approval workflow
                let selectedCustomerObj = null;
                let approvalPollingInterval = null;

                function checkCustomerOutstanding() {
                    // Inline warning banner removed per user request
                }

                // Handle Form Submit with Unified Outstanding / Underpayment Block Check
                async function handleTransactionFormSubmit(event, form) {
                    event.preventDefault();
                    const type = document.getElementById('type').value;
                    const count = parseInt(document.getElementById('count').value, 10) || 0;
                    const customerId = document.getElementById('customerId').value;
                    const depositRateInput = document.getElementById('depositPerTray');
                    const defaultRate = <%= (typeof settings !== 'undefined' && settings && settings.depositPerTray) ? settings.depositPerTray : 2000 %>;
                    const rateVal = parseFloat(depositRateInput ? depositRateInput.value : defaultRate) || 0;
                    const expectedTotal = count * rateVal;

                    const actualDepositInput = document.getElementById('actualDeposit');
                    const actualDepositVal = parseFloat(actualDepositInput ? actualDepositInput.value : 0) || 0;
                    const isBlockEnabled = <%= (settings && settings.enableOutstandingBlock !== false) ? 'true' : 'false' %>;

                    const cust = selectedCustomerObj || (typeof customersData !== 'undefined' ? customersData.find(c => c.id === customerId) : null);
                    const pendingDeposit = Number(cust ? (cust.pendingDeposit || 0) : 0);
                    const isUnderpaid = (count > 0 && actualDepositVal < expectedTotal);
                    const isBlocked = isBlockEnabled && type === 'OUT' && (pendingDeposit > 0 || isUnderpaid);

                    if (isBlocked && cust) {
                        const mgrPhone = "<%= (settings && settings.salesManagerPhone) ? settings.salesManagerPhone : '0770000000' %>";
                        const shortfall = Math.max(0, expectedTotal - actualDepositVal);

                        let reasonHtml = '';
                        if (pendingDeposit > 0 && isUnderpaid) {
                            reasonHtml = `Customer has an unsettled pending deposit of <strong style="color:#dc2626;">Rs. ${pendingDeposit.toLocaleString('en-LK', { minimumFractionDigits: 2 })}</strong> and this issue is underpaid by <strong style="color:#dc2626;">Rs. ${shortfall.toLocaleString('en-LK', { minimumFractionDigits: 2 })}</strong> (Paid: Rs. ${actualDepositVal.toLocaleString('en-LK', { minimumFractionDigits: 2 })} / Expected: Rs. ${expectedTotal.toLocaleString('en-LK', { minimumFractionDigits: 2 })}).`;
                        } else if (pendingDeposit > 0) {
                            reasonHtml = `Customer has an unsettled pending deposit balance of <strong style="color:#dc2626;">Rs. ${pendingDeposit.toLocaleString('en-LK', { minimumFractionDigits: 2 })}</strong>.`;
                        } else {
                            reasonHtml = `Deposit paid (<strong>Rs. ${actualDepositVal.toLocaleString('en-LK', { minimumFractionDigits: 2 })}</strong>) is less than expected full deposit <strong>Rs. ${expectedTotal.toLocaleString('en-LK', { minimumFractionDigits: 2 })}</strong> (Shortfall: <strong style="color:#dc2626;">Rs. ${shortfall.toLocaleString('en-LK', { minimumFractionDigits: 2 })}</strong>).`;
                        }

                        Swal.fire({
                            title: 'Special Approval Required',
                            html: `
                                <div style="text-align:left; font-size:14px; line-height:1.5;">
                                    <div style="background:#fff1f2; border:1px solid #fecdd3; border-radius:8px; padding:12px; margin-bottom:14px;">
                                        <strong style="color:#9f1239;">Customer:</strong> <span style="font-weight:700; color:#1e293b;">${cust.name}</span><br>
                                        <strong style="color:#9f1239;">Pending Deposit:</strong> <span style="color:#dc2626; font-weight:800; font-size:15px;">Rs. ${pendingDeposit.toLocaleString('en-LK', { minimumFractionDigits: 2 })}</span><br>
                                        <strong style="color:#9f1239;">Expected Deposit:</strong> <span style="color:#1e293b; font-weight:700;">Rs. ${expectedTotal.toLocaleString('en-LK', { minimumFractionDigits: 2 })}</span><br>
                                        <strong style="color:#9f1239;">Actual Paid:</strong> <span style="color:${isUnderpaid ? '#dc2626' : '#166534'}; font-weight:800;">Rs. ${actualDepositVal.toLocaleString('en-LK', { minimumFractionDigits: 2 })}</span>
                                        ${isUnderpaid ? `<br><strong style="color:#9f1239;">Shortfall:</strong> <span style="color:#dc2626; font-weight:800;">Rs. ${shortfall.toLocaleString('en-LK', { minimumFractionDigits: 2 })}</span>` : ''}
                                    </div>
                                    <p style="color:#334155; margin-bottom:10px;">
                                        ${reasonHtml}<br>
                                        Issuing <strong>${count} Trays</strong> is blocked until authorized by the Sales Manager.
                                    </p>
                                    <p style="color:#059669; font-weight:600;">
                                        Would you like to send a <strong>Special Approval Request</strong> to the Sales Manager via WhatsApp?
                                    </p>
                                </div>
                            `,
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonText: '<i class="fa-brands fa-whatsapp"></i> Request Approval',
                            confirmButtonColor: '#107c41',
                            cancelButtonText: 'Cancel',
                            cancelButtonColor: '#64748b'
                        }).then(async (result) => {
                            if (result.isConfirmed) {
                                initiateApprovalRequest(form, cust, count);
                            }
                        });
                        return false;
                    }

                    // Normal submit when pending deposit == 0 and FULL option or IN (Return)
                    return submitAjaxForm(event, form, 'Transaction added successfully');
                }

                // Initiate WhatsApp Approval Request to Sales Manager
                async function initiateApprovalRequest(form, cust, count) {
                    const formData = new FormData(form);
                    const txPayload = Object.fromEntries(formData.entries());

                    Swal.fire({
                        title: 'Sending Approval Request...',
                        html: '<i class="fa-solid fa-circle-notch fa-spin" style="font-size:32px; color:#107c41; margin-top:10px;"></i>',
                        allowOutsideClick: false,
                        showConfirmButton: false
                    });

                    try {
                        const res = await fetch('/api/approvals/request', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(txPayload)
                        });
                        const data = await res.json();
                        if (!data.success) {
                            Swal.fire('Error', data.error || 'Failed to request approval', 'error');
                            return;
                        }

                        const requestId = data.requestId;
                        const managerPhone = data.managerPhone || 'Sales Manager';
                        let timerSeconds = 600; // 10 minutes timeout
                        let timerInterval = null;

                        Swal.fire({
                            title: 'Waiting for Sales Manager Approval',
                            html: `
                                <div style="text-align:center; padding: 10px 0;">
                                    <div style="margin-bottom: 15px;">
                                        <i class="fa-solid fa-spinner fa-spin" style="font-size: 38px; color: #107c41;"></i>
                                    </div>
                                    <p style="font-size: 14px; font-weight: 700; color: #1e293b; margin-bottom: 4px;">
                                        WhatsApp Alert Sent to Sales Manager (${managerPhone})
                                    </p>
                                    <p style="font-size: 12px; color: #64748b; margin-bottom: 14px;">
                                        The system will automatically record this transaction the moment approval is given.
                                    </p>
                                    
                                    <div style="background: #f1f5f9; border-radius: 8px; padding: 10px 14px; margin-bottom: 12px; font-size: 12.5px; text-align: left; border: 1px solid #e2e8f0;">
                                        <div style="font-weight: 700; color: #1e293b; margin-bottom: 2px;">Customer: ${cust.name} ${cust.phone ? `(${cust.phone})` : ''}</div>
                                        <div style="color: #475569;">
                                            Pending Deposit: <strong style="color: #dc2626;">Rs. ${(cust.pendingDeposit || 0).toLocaleString('en-LK')}</strong> | 
                                            Option: <strong style="color: #d97706;">${txPayload.depositOption || 'FULL'}</strong> | 
                                            Request: <strong style="color: #15803d;">${count} Trays</strong>
                                        </div>
                                    </div>
                                    
                                    ${data.whatsAppUrl ? `
                                    <div style="margin-bottom: 14px;">
                                        <a href="${data.whatsAppUrl}" target="_blank" style="background: #25d366; color: #fff; font-weight: 600; font-size: 13px; padding: 9px 14px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; box-shadow: 0 2px 6px rgba(37, 211, 102, 0.25);">
                                            <i class="fa-brands fa-whatsapp" style="font-size: 17px;"></i> Send via WhatsApp (${managerPhone})
                                        </a>
                                        <div style="font-size: 11px; color: #64748b; margin-top: 4px;">
                                            (Optional) Click if you want to open WhatsApp manually
                                        </div>
                                    </div>
                                    ` : ''}
                                    
                                    <div style="background: #f8fafc; border: 1px dashed #cbd5e1; padding: 14px; border-radius: 10px; margin-top: 10px; text-align: left;">
                                        <span style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 6px;">
                                            <i class="fa-solid fa-key" style="color: #107c41;"></i> Or enter Override PIN from Manager:
                                        </span>
                                        <div style="display: flex; gap: 8px;">
                                            <input type="text" id="swalOverridePin" maxlength="6" placeholder="PIN" style="flex: 1; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 16px; font-weight: bold; text-align: center; letter-spacing: 2px;">
                                            <button type="button" class="swal2-confirm swal2-styled" style="margin: 0; background: #107c41; padding: 8px 14px; font-size: 13px;" onclick="submitOverridePin('${requestId}')">Verify</button>
                                        </div>
                                    </div>

                                    <div style="margin-top: 15px; font-size: 12px; color: #94a3b8;">
                                        Waiting for response... Timeout in <span id="swalTimer">10:00</span>
                                    </div>
                                </div>
                            `,
                            allowOutsideClick: false,
                            showConfirmButton: false,
                            showCancelButton: true,
                            cancelButtonText: 'Cancel Request',
                            cancelButtonColor: '#ef4444',
                            didOpen: () => {
                                // Start polling every 2 seconds
                                approvalPollingInterval = setInterval(async () => {
                                    try {
                                        const statusRes = await fetch('/api/approvals/status/' + requestId);
                                        const statusData = await statusRes.json();
                                        if (statusData.success) {
                                            if (statusData.status === 'APPROVED') {
                                                clearInterval(approvalPollingInterval);
                                                clearInterval(timerInterval);
                                                const receiptNo = statusData.receiptNo ? `RE-${String(statusData.receiptNo).padStart(6, '0')}` : '';
                                                Swal.fire({
                                                    icon: 'success',
                                                    title: 'Special Approval Granted!',
                                                    html: `Transaction has been approved by <strong>${statusData.approvedBy || 'Sales Manager'}</strong>!<br><span style="color:#15803d; font-weight:bold; font-size:16px;">${receiptNo}</span><br>Redirecting to receipt...`,
                                                    timer: 1800,
                                                    showConfirmButton: false
                                                }).then(() => {
                                                    window.location.href = `/transactions/${statusData.transactionId}/receipt?autoPrint=false`;
                                                });
                                            } else if (statusData.status === 'REJECTED') {
                                                clearInterval(approvalPollingInterval);
                                                clearInterval(timerInterval);
                                                Swal.fire('Request Rejected', statusData.rejectionReason || 'The Sales Manager rejected this transaction.', 'error');
                                            } else if (statusData.status === 'EXPIRED') {
                                                clearInterval(approvalPollingInterval);
                                                clearInterval(timerInterval);
                                                Swal.fire('Request Expired', 'The approval request timed out.', 'warning');
                                            }
                                        }
                                    } catch (e) {
                                        console.error('Polling error:', e);
                                    }
                                }, 2000);

                                // Start countdown
                                timerInterval = setInterval(() => {
                                    timerSeconds--;
                                    const m = Math.floor(timerSeconds / 60);
                                    const s = timerSeconds % 60;
                                    const timerEl = document.getElementById('swalTimer');
                                    if (timerEl) timerEl.innerText = `${m}:${s < 10 ? '0' : ''}${s}`;
                                    if (timerSeconds <= 0) {
                                        clearInterval(timerInterval);
                                        clearInterval(approvalPollingInterval);
                                        Swal.fire('Timed Out', 'No response received from Sales Manager within 10 minutes.', 'info');
                                    }
                                }, 1000);
                            },
                            willClose: () => {
                                if (approvalPollingInterval) clearInterval(approvalPollingInterval);
                                if (timerInterval) clearInterval(timerInterval);
                            }
                        });

                    } catch (err) {
                        Swal.fire('Error', 'Connection failed: ' + err.message, 'error');
                    }
                }

                // Verify Override PIN
                window.submitOverridePin = async function(requestId) {
                    const pinInput = document.getElementById('swalOverridePin');
                    const pin = pinInput ? pinInput.value.trim() : '';
                    if (!pin) {
                        alert('Please enter the 4-digit PIN code.');
                        return;
                    }

                    try {
                        const res = await fetch('/api/approvals/verify-pin', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ requestId, pin })
                        });
                        const result = await res.json();
                        if (result.success) {
                            if (approvalPollingInterval) clearInterval(approvalPollingInterval);
                            const receiptNo = result.receiptNo ? `RE-${String(result.receiptNo).padStart(6, '0')}` : '';
                            Swal.fire({
                                icon: 'success',
                                title: 'PIN Verified & Approved!',
                                html: `Transaction recorded successfully!<br><span style="color:#15803d; font-weight:bold; font-size:16px;">${receiptNo}</span><br>Redirecting to receipt...`,
                                timer: 1800,
                                showConfirmButton: false
                            }).then(() => {
                                window.location.href = `/transactions/${result.transactionId}/receipt?autoPrint=false`;
                            });
                        } else {
                            alert(result.error || 'Invalid PIN code');
                        }
                    } catch (err) {
                        alert('Verification error: ' + err.message);
                    }
                };

                        // Edit Modal Logic
                        function openEditModal(tx) {
                            document.getElementById('editTxForm').action = '/transactions/' + tx.id + '/update';
                            document.getElementById('editCustomerId').value = tx.customerId;
                            document.getElementById('editType').value = tx.type;
                            document.getElementById('editCount').value = tx.count;
                            document.getElementById('editVehicleNo').value = tx.vehicleNo || 'N/A';
                            document.getElementById('editDepositPerTray').value = tx.depositPerTray || <%= (typeof settings !== 'undefined' && settings && settings.depositPerTray) ? settings.depositPerTray : 2000 %>;
                            document.getElementById('editDepositOption').value = tx.depositOption || 'FULL';
                            document.getElementById('editActualDeposit').value = tx.totalDeposit || 0;



                            document.getElementById('editRemarks').value = tx.remarks || '';
                            document.getElementById('editTxModal').style.display = 'block';
                        }

                        function closeEditModal() {
                            document.getElementById('editTxModal').style.display = 'none';
                        }

                        window.addEventListener('click', function (event) {
                            const modal = document.getElementById('editTxModal');
                            if (event.target === modal) {
                                closeEditModal();
                            }
                        });
                    </script>

