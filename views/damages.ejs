<%- include('partials/header') %>

<div class="content-header" style="margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
            <h2 style="font-size: 26px; font-weight: 700; color: var(--text-dark); margin: 0; display: flex; align-items: center; gap: 12px;">
                <span style="position: relative; display: inline-flex; align-items: center; justify-content: center;">
                    <i class="fa-solid fa-boxes-stacked" style="color: #ef4444;"></i>
                    <i class="fa-solid fa-burst" style="position: absolute; right: -4px; top: -4px; font-size: 11px; color: #ef4444;"></i>
                </span>
                Tray Damage, Loss & Audit
            </h2>
            <p style="color: var(--text-light); margin: 4px 0 0 0; font-size: 14px;">
                Track broken, lost, or written-off trays across all branches and reconcile physical stock counts.
            </p>
        </div>
        <button class="btn btn-primary" onclick="openAddDamageModal()" style="display: inline-flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-plus"></i> Record Damage / Audit Loss
        </button>
    </div>
</div>

<!-- Summary Cards -->
<div class="metrics-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 28px;">
    <% 
        const totalDamaged = logs.filter(l => l.type === 'DAMAGED').reduce((s, l) => s + (l.qty || 0), 0);
        const totalDisposed = logs.filter(l => l.type === 'DISPOSED').reduce((s, l) => s + (l.qty || 0), 0);
        const totalAuditAdj = logs.filter(l => l.type === 'AUDIT_ADJUSTMENT').reduce((s, l) => s + (l.qty || 0), 0);
    %>
    <div class="card metric-card" style="border-left: 4px solid #ef4444;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <span style="font-size: 13px; font-weight: 600; color: var(--text-light); text-transform: uppercase;">Damaged Trays</span>
                <h3 style="font-size: 28px; font-weight: 800; color: var(--text-dark); margin: 8px 0 0 0;"><%= totalDamaged.toLocaleString() %></h3>
            </div>
            <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(239, 68, 68, 0.15); display: flex; align-items: center; justify-content: center; color: #ef4444; font-size: 20px; position: relative;">
                <i class="fa-solid fa-boxes-stacked"></i>
                <i class="fa-solid fa-burst" style="position: absolute; right: 6px; top: 6px; font-size: 11px; color: #ef4444;"></i>
            </div>
        </div>
    </div>

    <div class="card metric-card" style="border-left: 4px solid #f59e0b;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <span style="font-size: 13px; font-weight: 600; color: var(--text-light); text-transform: uppercase;">Disposed Trays</span>
                <h3 style="font-size: 28px; font-weight: 800; color: var(--text-dark); margin: 8px 0 0 0;"><%= totalDisposed.toLocaleString() %></h3>
            </div>
            <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(245, 158, 11, 0.15); display: flex; align-items: center; justify-content: center; color: #f59e0b; font-size: 20px;">
                <i class="fa-solid fa-trash-can"></i>
            </div>
        </div>
    </div>

    <div class="card metric-card" style="border-left: 4px solid #3b82f6;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <span style="font-size: 13px; font-weight: 600; color: var(--text-light); text-transform: uppercase;">Audit Adjustments</span>
                <h3 style="font-size: 28px; font-weight: 800; color: var(--text-dark); margin: 8px 0 0 0;"><%= totalAuditAdj.toLocaleString() %></h3>
            </div>
            <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(59, 130, 246, 0.15); display: flex; align-items: center; justify-content: center; color: #3b82f6; font-size: 20px;">
                <i class="fa-solid fa-clipboard-check"></i>
            </div>
        </div>
    </div>
</div>

<!-- Damage Log Table Card -->
<div class="card" style="padding: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h3 style="font-size: 18px; font-weight: 700; color: var(--text-dark); margin: 0;">
            <i class="fa-solid fa-list-check" style="color: var(--primary-green); margin-right: 8px;"></i> Recent Loss & Audit Records
        </h3>
    </div>

    <div class="table-responsive">
        <table class="table" id="damageTable">
            <thead>
                <tr>
                    <th>Date & Time</th>
                    <th>Ref No</th>
                    <th>Location / Branch</th>
                    <th>Type</th>
                    <th>Qty</th>
                    <th>Reason / Details</th>
                    <th>Reported By</th>
                    <% if (user.username === 'admin' || user.role === 'admin') { %>
                        <th style="text-align: right;">Action</th>
                    <% } %>
                </tr>
            </thead>
            <tbody>
                <% if (logs && logs.length > 0) { %>
                    <% logs.forEach(log => { %>
                        <tr>
                            <td><%= new Date(log.date).toLocaleString('en-GB') %></td>
                            <td><span style="font-weight: 700; font-family: monospace; color: var(--primary-green);"><%= log.damageNo %></span></td>
                            <td><span class="badge" style="background: rgba(16, 185, 129, 0.15); color: var(--primary-green);"><%= log.locationName %></span></td>
                            <td>
                                <% if (log.type === 'DAMAGED') { %>
                                    <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: #ef4444;"><i class="fa-solid fa-boxes-stacked" style="font-size: 11px;"></i><i class="fa-solid fa-burst" style="font-size: 9px; margin-right: 4px;"></i> DAMAGED</span>
                                <% } else if (log.type === 'DISPOSED') { %>
                                    <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b;"><i class="fa-solid fa-trash"></i> DISPOSED</span>
                                <% } else { %>
                                    <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6;"><i class="fa-solid fa-sliders"></i> AUDIT ADJUST</span>
                                <% } %>
                            </td>
                            <td style="font-weight: 800; font-size: 15px;"><%= log.qty %> Trays</td>
                            <td style="color: var(--text-light);"><%= log.reason || 'N/A' %></td>
                            <td><i class="fa-solid fa-user-gear" style="margin-right: 4px; opacity: 0.7;"></i> <%= log.reportedBy %></td>
                            <% if (user.username === 'admin' || user.role === 'admin') { %>
                                <td style="text-align: right;">
                                    <div style="display: flex; gap: 6px; justify-content: flex-end;">
                                        <button class="btn btn-secondary btn-sm" onclick="openEditDamageModal('<%= log.id %>', '<%= log.locationId %>', '<%= log.type %>', <%= log.qty %>, `<%= log.reason %>`)" title="Edit Record">
                                            <i class="fa-solid fa-pen"></i> Edit
                                        </button>
                                        <button class="btn btn-danger btn-sm" onclick="deleteDamageRecord('<%= log.id %>', '<%= log.damageNo %>')" style="background: #ef4444; border: none;" title="Delete Record">
                                            <i class="fa-solid fa-trash"></i> Delete
                                        </button>
                                    </div>
                                </td>
                            <% } %>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="<%= (user.username === 'admin' || user.role === 'admin') ? 8 : 7 %>" style="text-align: center; padding: 40px; color: var(--text-light);">
                            <i class="fa-solid fa-box-archive" style="font-size: 32px; margin-bottom: 12px; display: block; opacity: 0.5;"></i>
                            No damage or audit loss records found.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Record Damage / Audit -->
<div id="addDamageModal" class="modal" style="display: none; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(8px); z-index: 9999; align-items: center; justify-content: center; padding: 16px;">
    <div class="card" style="background: var(--white); color: var(--text-dark); border: 1px solid var(--border-color); border-radius: 16px; box-shadow: 0 20px 40px var(--shadow-color); max-width: 500px; width: 100%; padding: 24px;">
        <div style="border-bottom: 2px solid var(--primary-green); padding-bottom: 12px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0; font-size: 18px; font-weight: 700; color: var(--text-dark); display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-boxes-stacked" style="color: var(--primary-green);"></i> Record Damage / Audit Loss
            </h3>
            <button onclick="closeAddDamageModal()" style="background: none; border: none; font-size: 22px; font-weight: bold; color: var(--text-light); cursor: pointer; line-height: 1;" title="Close">&times;</button>
        </div>

        <form id="damageForm" onsubmit="handleDamageSubmit(event)">
            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text-dark); margin-bottom: 6px;">Branch / Location</label>
                <select name="locationId" class="form-control" style="width: 100%; background: var(--bg-light); color: var(--text-dark); border: 1.5px solid var(--border-color); border-radius: 8px; padding: 10px 12px;" required>
                    <% locations.forEach(loc => { %>
                        <option value="<%= loc.id %>" <%= user.locationId === loc.id ? 'selected' : '' %>><%= loc.name %> (<%= loc.code %>)</option>
                    <% }); %>
                </select>
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text-dark); margin-bottom: 6px;">Entry Type</label>
                <select name="type" class="form-control" style="width: 100%; background: var(--bg-light); color: var(--text-dark); border: 1.5px solid var(--border-color); border-radius: 8px; padding: 10px 12px;" required>
                    <option value="DAMAGED">DAMAGED (Cracked / Broken Trays)</option>
                    <option value="DISPOSED">DISPOSED (Scrapped & Thrown Away)</option>
                    <option value="AUDIT_ADJUSTMENT">AUDIT ADJUSTMENT (Physical Count Reduction)</option>
                </select>
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text-dark); margin-bottom: 6px;">Tray Quantity</label>
                <input type="number" name="qty" class="form-control" min="1" placeholder="Enter tray count (e.g. 25)" style="width: 100%; background: var(--bg-light); color: var(--text-dark); border: 1.5px solid var(--border-color); border-radius: 8px; padding: 10px 12px;" required>
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text-dark); margin-bottom: 6px;">Reason / Incident Details</label>
                <textarea name="reason" class="form-control" rows="3" placeholder="Provide reason for damage or audit findings..." style="width: 100%; background: var(--bg-light); color: var(--text-dark); border: 1.5px solid var(--border-color); border-radius: 8px; padding: 10px 12px; resize: vertical;"></textarea>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border-color);">
                <button type="button" class="btn btn-secondary" onclick="closeAddDamageModal()" style="padding: 9px 18px; font-weight: 600;">Cancel</button>
                <button type="submit" class="btn btn-primary" style="padding: 9px 20px; font-weight: 600; background: var(--primary-green); border: none; display: inline-flex; align-items: center; gap: 8px;"><i class="fa-solid fa-check"></i> Save & Update Stock</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Admin Edit Damage Record -->
<div id="editDamageModal" class="modal" style="display: none; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(8px); z-index: 9999; align-items: center; justify-content: center; padding: 16px;">
    <div class="card" style="background: var(--white); color: var(--text-dark); border: 1px solid var(--border-color); border-radius: 16px; box-shadow: 0 20px 40px var(--shadow-color); max-width: 500px; width: 100%; padding: 24px;">
        <div style="border-bottom: 2px solid var(--primary-green); padding-bottom: 12px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0; font-size: 18px; font-weight: 700; color: var(--text-dark); display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-pen-to-square" style="color: var(--primary-green);"></i> Edit Damage / Audit Record
            </h3>
            <button onclick="closeEditDamageModal()" style="background: none; border: none; font-size: 22px; font-weight: bold; color: var(--text-light); cursor: pointer; line-height: 1;" title="Close">&times;</button>
        </div>

        <form id="editDamageForm" onsubmit="handleEditDamageSubmit(event)">
            <input type="hidden" id="editLogId" name="id">
            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text-dark); margin-bottom: 6px;">Branch / Location</label>
                <select id="editLocationId" name="locationId" class="form-control" style="width: 100%; background: var(--bg-light); color: var(--text-dark); border: 1.5px solid var(--border-color); border-radius: 8px; padding: 10px 12px;" required>
                    <% locations.forEach(loc => { %>
                        <option value="<%= loc.id %>"><%= loc.name %> (<%= loc.code %>)</option>
                    <% }); %>
                </select>
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text-dark); margin-bottom: 6px;">Entry Type</label>
                <select id="editType" name="type" class="form-control" style="width: 100%; background: var(--bg-light); color: var(--text-dark); border: 1.5px solid var(--border-color); border-radius: 8px; padding: 10px 12px;" required>
                    <option value="DAMAGED">DAMAGED (Cracked / Broken Trays)</option>
                    <option value="DISPOSED">DISPOSED (Scrapped & Thrown Away)</option>
                    <option value="AUDIT_ADJUSTMENT">AUDIT ADJUSTMENT (Physical Count Reduction)</option>
                </select>
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text-dark); margin-bottom: 6px;">Tray Quantity</label>
                <input type="number" id="editQty" name="qty" class="form-control" min="1" style="width: 100%; background: var(--bg-light); color: var(--text-dark); border: 1.5px solid var(--border-color); border-radius: 8px; padding: 10px 12px;" required>
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text-dark); margin-bottom: 6px;">Reason / Incident Details</label>
                <textarea id="editReason" name="reason" class="form-control" rows="3" style="width: 100%; background: var(--bg-light); color: var(--text-dark); border: 1.5px solid var(--border-color); border-radius: 8px; padding: 10px 12px; resize: vertical;"></textarea>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border-color);">
                <button type="button" class="btn btn-secondary" onclick="closeEditDamageModal()" style="padding: 9px 18px; font-weight: 600;">Cancel</button>
                <button type="submit" class="btn btn-primary" style="padding: 9px 20px; font-weight: 600; background: var(--primary-green); border: none; display: inline-flex; align-items: center; gap: 8px;"><i class="fa-solid fa-check"></i> Update & Adjust Stock</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openAddDamageModal() {
        document.getElementById('addDamageModal').style.display = 'flex';
    }
    function closeAddDamageModal() {
        document.getElementById('addDamageModal').style.display = 'none';
    }

    function openEditDamageModal(id, locationId, type, qty, reason) {
        document.getElementById('editLogId').value = id;
        document.getElementById('editLocationId').value = locationId;
        document.getElementById('editType').value = type;
        document.getElementById('editQty').value = qty;
        document.getElementById('editReason').value = reason || '';
        document.getElementById('editDamageModal').style.display = 'flex';
    }

    function closeEditDamageModal() {
        document.getElementById('editDamageModal').style.display = 'none';
    }

    async function handleDamageSubmit(e) {
        e.preventDefault();
        const form = e.target;
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        try {
            const res = await fetch('/damages/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (result.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Record Saved!',
                    text: result.message,
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => {
                    window.location.reload();
                });
            } else {
                Swal.fire('Error', result.error || 'Failed to save record', 'error');
            }
        } catch (err) {
            Swal.fire('Error', 'Failed to communicate with server', 'error');
        }
    }

    async function handleEditDamageSubmit(e) {
        e.preventDefault();
        const id = document.getElementById('editLogId').value;
        const form = e.target;
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        try {
            const res = await fetch(`/damages/${id}/edit`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (result.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Record Updated!',
                    text: result.message,
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => {
                    window.location.reload();
                });
            } else {
                Swal.fire('Error', result.error || 'Failed to update record', 'error');
            }
        } catch (err) {
            Swal.fire('Error', 'Failed to communicate with server', 'error');
        }
    }

    function deleteDamageRecord(id, damageNo) {
        Swal.fire({
            title: 'Delete Damage Record?',
            text: `Are you sure you want to delete ${damageNo}? This will restore the deducted tray quantity back to branch stock!`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            confirmButtonText: 'Yes, Delete Record',
            cancelButtonText: 'Cancel'
        }).then(async (result) => {
            if (result.isConfirmed) {
                try {
                    const res = await fetch(`/damages/${id}/delete`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const data = await res.json();
                    if (data.success) {
                        Swal.fire('Deleted!', data.message, 'success').then(() => {
                            window.location.reload();
                        });
                    } else {
                        Swal.fire('Error', data.error || 'Failed to delete record', 'error');
                    }
                } catch (err) {
                    Swal.fire('Error', 'Failed to send delete request', 'error');
                }
            }
        });
    }
</script>

<%- include('partials/footer') %>
