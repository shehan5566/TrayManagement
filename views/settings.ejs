<%- include('partials/header') %>

<div class="content-header" style="margin-bottom: 24px;">
    <div>
        <h2 style="font-size: 26px; font-weight: 700; color: var(--text-dark); margin: 0; display: flex; align-items: center; gap: 12px;">
            <i class="fa-solid fa-sliders" style="color: var(--primary-green);"></i> System Settings & Configuration
        </h2>
        <p style="color: var(--text-light); margin: 4px 0 0 0; font-size: 14px;">
            Configure global default deposit rates, company details, SMS/Email notification endpoints, and receipt parameters.
        </p>
    </div>
</div>

<div class="card" style="max-width: 800px; padding: 32px; border-radius: 20px;">
    <form id="settingsForm" onsubmit="handleSettingsSubmit(event)">
        <div style="border-bottom: 1px solid var(--border-color); padding-bottom: 16px; margin-bottom: 24px;">
            <h3 style="font-size: 18px; font-weight: 700; color: var(--text-dark); margin: 0; display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-coins" style="color: var(--accent-yellow);"></i> Financial & Deposit Parameters
            </h3>
        </div>

        <div style="margin-bottom: 24px;">
            <label style="display: block; font-size: 14px; font-weight: 600; color: var(--text-dark); margin-bottom: 8px;">
                Global Deposit Rate per Tray (LKR)
            </label>
            <div style="position: relative;">
                <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font-weight: 700; color: var(--primary-green);">LKR</span>
                <input type="number" name="depositPerTray" class="form-control" value="<%= settings.depositPerTray || 2000 %>" style="padding-left: 55px; width: 100%; font-size: 16px; font-weight: 700;" min="0" step="100" required>
            </div>
            <p style="font-size: 12px; color: var(--text-light); margin-top: 6px;">
                Default cash deposit expected per tray during Customer OUT transactions.
            </p>
        </div>

        <div style="border-bottom: 1px solid var(--border-color); padding-bottom: 16px; margin-bottom: 24px; margin-top: 36px;">
            <h3 style="font-size: 18px; font-weight: 700; color: var(--text-dark); margin: 0; display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-building-user" style="color: var(--primary-green);"></i> Company Branding & Printing
            </h3>
        </div>

        <div style="margin-bottom: 20px;">
            <label style="display: block; font-size: 14px; font-weight: 600; color: var(--text-dark); margin-bottom: 8px;">
                Official Company Name
            </label>
            <input type="text" name="companyName" class="form-control" value="<%= settings.companyName || 'NELNA AGRI DEVELOPMENT (PVT) LTD' %>" style="width: 100%;" required>
        </div>

        <div style="margin-bottom: 24px;">
            <label style="display: block; font-size: 14px; font-weight: 600; color: var(--text-dark); margin-bottom: 8px;">
                Print Receipt Footer Note
            </label>
            <textarea name="receiptFooterNote" class="form-control" rows="2" style="width: 100%; resize: vertical;"><%= settings.receiptFooterNote || 'Official Inward Stock Receipt & Verification Log' %></textarea>
        </div>

        <div style="border-bottom: 1px solid var(--border-color); padding-bottom: 16px; margin-bottom: 24px; margin-top: 36px;">
            <h3 style="font-size: 18px; font-weight: 700; color: var(--text-dark); margin: 0; display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-bell-concierge" style="color: #3b82f6;"></i> Notification & Automation Webhooks
            </h3>
        </div>

        <div style="margin-bottom: 20px;">
            <label style="display: block; font-size: 14px; font-weight: 600; color: var(--text-dark); margin-bottom: 8px;">
                SMS Gateway Webhook URL (MacroDroid / Twilio)
            </label>
            <input type="url" name="smsWebhookUrl" class="form-control" value="<%= settings.smsWebhookUrl || '' %>" style="width: 100%; font-family: monospace;" placeholder="https://trigger.macrodroid.com/..." required>
        </div>

        <div style="margin-bottom: 32px;">
            <label style="display: block; font-size: 14px; font-weight: 600; color: var(--text-dark); margin-bottom: 8px;">
                System Alert Email Receiver
            </label>
            <input type="text" name="emailReceiver" class="form-control" value="<%= settings.emailReceiver || 'shehand@nelna.lk' %>" style="width: 100%;" placeholder="e.g. shehand@nelna.lk, admin@nelna.lk" required>
            <small style="display: block; margin-top: 6px; color: var(--text-light); font-size: 12px;">
                <i class="fa-solid fa-circle-info"></i> You can enter multiple email addresses separated by commas (e.g. <code>email1@nelna.lk, email2@nelna.lk</code>).
            </small>
        </div>

        <div style="border-bottom: 1px solid var(--border-color); padding-bottom: 16px; margin-bottom: 24px; margin-top: 36px;">
            <h3 style="font-size: 18px; font-weight: 700; color: var(--text-dark); margin: 0; display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-shield-halved" style="color: #107c41;"></i> Customer Outstanding Block & WhatsApp Authorization
            </h3>
        </div>

        <div style="margin-bottom: 20px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 12px; padding: 16px;">
            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: 14px; font-weight: 700; color: #166534;">
                <input type="checkbox" name="enableOutstandingBlock" value="true" <%= (settings.enableOutstandingBlock !== false) ? 'checked' : '' %> style="width: 18px; height: 18px; accent-color: #107c41;">
                Strictly Block Customer Tray OUT when Outstanding Balance > 0
            </label>
            <p style="font-size: 12px; color: #15803d; margin: 6px 0 0 28px;">
                When enabled, operators and drivers cannot issue trays to any customer with unreturned trays unless approved by the Sales Manager.
            </p>
        </div>

        <div style="margin-bottom: 24px; background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 18px 20px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
                <div>
                    <label style="font-size: 14.5px; font-weight: 700; color: var(--text-dark); display: flex; align-items: center; gap: 8px; margin: 0;">
                        <i class="fa-solid fa-user-shield" style="color: var(--primary-green);"></i> Authorized Approvers & WhatsApp Alert Recipients
                    </label>
                    <p style="font-size: 12px; color: var(--text-light); margin: 3px 0 0 0;">
                        WhatsApp alerts will only be sent to selected (checked) approvers. The entered title will be printed on receipts as <code>Approved By: &lt;Title&gt;</code>.
                    </p>
                </div>
                <button type="button" onclick="addNewApproverRow()" class="btn" style="background: #107c41; color: white; padding: 6px 14px; font-size: 12.5px; font-weight: 700; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; border: none; cursor: pointer;">
                    <i class="fa-solid fa-plus"></i> Add Approver
                </button>
            </div>

            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                    <thead>
                        <tr style="border-bottom: 1.5px solid #cbd5e1; text-align: left; color: #475569;">
                            <th style="padding: 8px 10px; width: 80px; text-align: center;">Send Alert</th>
                            <th style="padding: 8px 10px;">Designation / Receipt Name <span style="color:red;">*</span></th>
                            <th style="padding: 8px 10px;">Mobile Number <span style="color:red;">*</span></th>
                            <th style="padding: 8px 10px; width: 60px; text-align: center;">Remove</th>
                        </tr>
                    </thead>
                    <tbody id="approversTableBody">
                        <!-- Rendered by JavaScript -->
                    </tbody>
                </table>
            </div>
            <input type="hidden" name="salesManagerPhone" id="salesManagerPhoneHidden" value="<%= settings.salesManagerPhone || '0770000000' %>">
        </div>

        <div style="margin-bottom: 32px;">
            <label style="display: block; font-size: 14px; font-weight: 600; color: var(--text-dark); margin-bottom: 8px;">
                Allowed Grace Trays (Credit Threshold)
            </label>
            <input type="number" name="allowedGraceTrays" class="form-control" value="<%= settings.allowedGraceTrays || 0 %>" style="width: 100%;" min="0" required>
            <small style="display: block; margin-top: 6px; color: var(--text-light); font-size: 12px;">
                Set to <code>0</code> to strictly enforce zero outstanding trays before next issue. (Set higher if you wish to allow a small tolerance without manager approval).
            </small>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid var(--border-color); padding-top: 20px;">
            <button type="submit" class="btn btn-primary" style="padding: 12px 28px; font-size: 15px; font-weight: 700; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-floppy-disk"></i> Save System Configuration
            </button>
        </div>
    </form>
</div>

<!-- WhatsApp Automated Gateway (QR Bot) Card -->
<div class="card" style="max-width: 800px; padding: 32px; border-radius: 20px; margin-top: 30px; border-top: 4px solid #25d366;">
    <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding-bottom: 16px; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: #e8f5e9; display: flex; align-items: center; justify-content: center;">
                <i class="fa-brands fa-whatsapp" style="font-size: 26px; color: #25d366;"></i>
            </div>
            <div>
                <h3 style="font-size: 19px; font-weight: 700; color: var(--text-dark); margin: 0;">
                    Automated WhatsApp Gateway (QR Bot)
                </h3>
                <p style="font-size: 13px; color: var(--text-light); margin: 2px 0 0 0;">
                    Link a WhatsApp account to automatically send special approval alerts to the Sales Manager in the background.
                </p>
            </div>
        </div>
        <div id="waStatusBadge">
            <span style="background: #f1f5f9; color: #64748b; font-size: 12.5px; font-weight: 700; padding: 6px 14px; border-radius: 20px; display: inline-flex; align-items: center; gap: 6px;">
                <i class="fa-solid fa-spinner fa-spin"></i> Checking Status...
            </span>
        </div>
    </div>

    <!-- Live Status & QR Area -->
    <div id="waContentArea" style="text-align: center; padding: 10px 0;">
        <i class="fa-solid fa-spinner fa-spin" style="font-size: 32px; color: #107c41;"></i>
        <div style="margin-top: 10px; font-size: 13px; color: #64748b;">Loading WhatsApp gateway status...</div>
    </div>
</div>

<script>
    const initialApprovers = <%- JSON.stringify(settings.approvers || [{ id: 'appr_default', name: 'Sales Manager', phone: settings.salesManagerPhone || '0770000000', enabled: true }]) %>;
    let approversList = [...initialApprovers];

    function escapeHtml(text) {
        return String(text || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function renderApproversTable() {
        const tbody = document.getElementById('approversTableBody');
        if (!tbody) return;
        tbody.innerHTML = '';

        if (approversList.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="4" style="text-align: center; padding: 16px; color: #94a3b8; font-style: italic;">
                        No approvers configured. Click "+ Add Approver" to add one.
                    </td>
                </tr>
            `;
            return;
        }

        approversList.forEach((appr, idx) => {
            const tr = document.createElement('tr');
            tr.style.borderBottom = '1px solid #e2e8f0';
            tr.innerHTML = `
                <td style="padding: 10px; text-align: center;">
                    <input type="checkbox" onchange="updateApproverField(${idx}, 'enabled', this.checked)" ${appr.enabled !== false ? 'checked' : ''} style="width: 18px; height: 18px; accent-color: #107c41; cursor: pointer;" title="Check to send alerts to this approver">
                </td>
                <td style="padding: 10px;">
                    <input type="text" class="form-control" style="width: 100%; font-size: 13.5px; padding: 7px 10px; font-weight: 600;" value="${escapeHtml(appr.name || 'Sales Manager')}" placeholder="e.g. Sales Manager, Area Manager" oninput="updateApproverField(${idx}, 'name', this.value)" required>
                </td>
                <td style="padding: 10px;">
                    <input type="text" class="form-control" style="width: 100%; font-size: 13.5px; font-family: monospace; padding: 7px 10px;" value="${escapeHtml(appr.phone || '')}" placeholder="e.g. 0771234567" oninput="updateApproverField(${idx}, 'phone', this.value)" required>
                </td>
                <td style="padding: 10px; text-align: center;">
                    <button type="button" onclick="deleteApproverRow(${idx})" style="background: none; border: none; color: #dc2626; cursor: pointer; padding: 6px 10px; font-size: 15px;" title="Remove this approver">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </td>
            `;
            tbody.appendChild(tr);
        });

        // Update hidden input for legacy compatibility
        const firstActive = approversList.find(a => a.enabled && a.phone);
        const hiddenPhone = document.getElementById('salesManagerPhoneHidden');
        if (hiddenPhone && firstActive) {
            hiddenPhone.value = firstActive.phone;
        }
    }

    function addNewApproverRow() {
        approversList.push({
            id: 'appr_' + Date.now(),
            name: 'Sales Manager',
            phone: '',
            enabled: true
        });
        renderApproversTable();
    }

    function deleteApproverRow(index) {
        if (approversList.length <= 1) {
            Swal.fire('Warning', 'At least one approver must remain in the configuration.', 'warning');
            return;
        }
        approversList.splice(index, 1);
        renderApproversTable();
    }

    function updateApproverField(index, field, value) {
        if (approversList[index]) {
            approversList[index][field] = value;
            if (field === 'phone' || field === 'enabled') {
                const firstActive = approversList.find(a => a.enabled && a.phone);
                const hiddenPhone = document.getElementById('salesManagerPhoneHidden');
                if (hiddenPhone && firstActive) {
                    hiddenPhone.value = firstActive.phone;
                }
            }
        }
    }

    async function handleSettingsSubmit(e) {
        e.preventDefault();
        const form = e.target;
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        data.enableOutstandingBlock = form.enableOutstandingBlock ? form.enableOutstandingBlock.checked : false;
        data.approvers = approversList;

        try {
            const res = await fetch('/settings/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (result.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Settings Updated!',
                    text: result.message,
                    timer: 1500,
                    showConfirmButton: false
                });
            } else {
                Swal.fire('Error', result.error || 'Failed to update settings', 'error');
            }
        } catch (err) {
            Swal.fire('Error', 'Failed to save settings', 'error');
        }
    }

    // --- WhatsApp Bot Gateway Controller ---
    let waPollInterval = null;

    async function checkWhatsAppStatus() {
        try {
            const res = await fetch('/api/whatsapp/status');
            const data = await res.json();
            renderWhatsAppStatus(data);
        } catch (e) {
            console.error('Error fetching WhatsApp status:', e);
        }
    }

    function renderWhatsAppStatus(data) {
        const badgeEl = document.getElementById('waStatusBadge');
        const contentEl = document.getElementById('waContentArea');
        if (!badgeEl || !contentEl) return;

        if (data.status === 'CONNECTED') {
            badgeEl.innerHTML = `
                <span style="background: #dcfce7; color: #15803d; font-size: 13px; font-weight: 700; padding: 6px 14px; border-radius: 20px; display: inline-flex; align-items: center; gap: 6px; border: 1px solid #bbf7d0;">
                    <i class="fa-solid fa-circle-check"></i> Connected & Active
                </span>
            `;
            contentEl.innerHTML = `
                <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 16px; padding: 24px; text-align: left; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
                    <div style="display: flex; align-items: center; gap: 16px;">
                        <div style="width: 50px; height: 50px; border-radius: 50%; background: #25d366; color: white; display: flex; align-items: center; justify-content: center; font-size: 24px;">
                            <i class="fa-brands fa-whatsapp"></i>
                        </div>
                        <div>
                            <div style="font-size: 16px; font-weight: 700; color: #1e293b;">
                                Linked Account: <span style="color: #107c41; font-family: monospace;">+${data.connectedPhone || 'Connected'}</span>
                            </div>
                            <div style="font-size: 13px; color: #15803d; margin-top: 4px;">
                                ${data.connectedName ? `Name: <strong>${data.connectedName}</strong> | ` : ''}Ready to auto-dispatch Special Approvals silently in background.
                            </div>
                        </div>
                    </div>
                    <button type="button" onclick="unlinkWhatsApp()" class="btn" style="background: #fee2e2; color: #dc2626; border: 1px solid #fca5a5; font-size: 13px; padding: 8px 16px;">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i> Unlink Device
                    </button>
                </div>
                <div style="margin-top: 15px; font-size: 12.5px; color: #64748b; text-align: left;">
                    <i class="fa-solid fa-shield-halved" style="color: #107c41;"></i> 
                    All Customer Block approval requests will now be silently dispatched to the Sales Manager via this WhatsApp account with zero manual intervention required.
                </div>
            `;
        } else if (data.status === 'SCAN_QR' && data.qrDataUrl) {
            badgeEl.innerHTML = `
                <span style="background: #fef9c3; color: #854d0e; font-size: 13px; font-weight: 700; padding: 6px 14px; border-radius: 20px; display: inline-flex; align-items: center; gap: 6px; border: 1px solid #fef08a;">
                    <i class="fa-solid fa-qrcode"></i> Ready for QR Scan
                </span>
            `;
            contentEl.innerHTML = `
                <div style="max-width: 520px; margin: 0 auto; text-align: center;">
                    <p style="font-size: 14.5px; font-weight: 600; color: #1e293b; margin-bottom: 16px;">
                        Scan this QR code with WhatsApp on the sender phone:
                    </p>
                    <div style="display: inline-block; padding: 12px; background: white; border: 2px dashed #107c41; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.06); margin-bottom: 16px;">
                        <img src="${data.qrDataUrl}" alt="WhatsApp QR Code" style="width: 220px; height: 220px; display: block; border-radius: 8px;">
                    </div>
                    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px 18px; text-align: left; font-size: 13px; color: #334155; margin-bottom: 16px;">
                        <strong style="color: #0f172a; display: block; margin-bottom: 6px;">How to link:</strong>
                        1. Open <strong>WhatsApp</strong> on the sender phone.<br>
                        2. Tap <strong>Settings</strong> or <strong>⋮ (Menu)</strong> &gt; <strong>Linked Devices</strong>.<br>
                        3. Tap <strong>Link a Device</strong> and point your camera at this QR Code.
                    </div>
                    <div>
                        <button type="button" onclick="restartWhatsAppQR()" class="btn btn-primary" style="font-size: 13px; padding: 8px 16px;">
                            <i class="fa-solid fa-rotate-right"></i> Refresh QR Code
                        </button>
                    </div>
                </div>
            `;
        } else if (data.status === 'CONNECTING' || (data.hasSavedSession && data.status !== 'SCAN_QR')) {
            badgeEl.innerHTML = `
                <span style="background: #e0f2fe; color: #0284c7; font-size: 13px; font-weight: 700; padding: 6px 14px; border-radius: 20px; display: inline-flex; align-items: center; gap: 6px; border: 1px solid #bae6fd;">
                    <i class="fa-solid fa-spinner fa-spin"></i> Connecting / Syncing...
                </span>
            `;
            contentEl.innerHTML = `
                <div style="background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 16px; padding: 24px; text-align: left; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
                    <div style="display: flex; align-items: center; gap: 16px;">
                        <div style="width: 50px; height: 50px; border-radius: 50%; background: #0284c7; color: white; display: flex; align-items: center; justify-content: center; font-size: 24px;">
                            <i class="fa-solid fa-rotate fa-spin"></i>
                        </div>
                        <div>
                            <div style="font-size: 16px; font-weight: 700; color: #1e293b;">
                                Linked Account: <span style="color: #0284c7; font-family: monospace;">+${data.connectedPhone || 'Restoring Session...'}</span>
                            </div>
                            <div style="font-size: 13px; color: #0369a1; margin-top: 4px;">
                                Syncing with WhatsApp servers. Please wait a few moments...
                            </div>
                        </div>
                    </div>
                    <button type="button" onclick="unlinkWhatsApp()" class="btn" style="background: #fee2e2; color: #dc2626; border: 1px solid #fca5a5; font-size: 13px; padding: 8px 16px;">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i> Unlink Device
                    </button>
                </div>
            `;
        } else {
            badgeEl.innerHTML = `
                <span style="background: #f1f5f9; color: #64748b; font-size: 13px; font-weight: 700; padding: 6px 14px; border-radius: 20px; display: inline-flex; align-items: center; gap: 6px; border: 1px solid #e2e8f0;">
                    <i class="fa-solid fa-circle-pause"></i> Not Linked
                </span>
            `;
            contentEl.innerHTML = `
                <div style="padding: 20px 0; text-align: center;">
                    <div style="margin-bottom: 14px; color: #94a3b8; font-size: 42px;">
                        <i class="fa-brands fa-whatsapp"></i>
                    </div>
                    <p style="font-size: 14px; color: #475569; margin-bottom: 18px;">
                        No WhatsApp account is currently linked. Click below to generate a QR Code and connect your WhatsApp.
                    </p>
                    <button type="button" onclick="restartWhatsAppQR()" class="btn btn-primary" style="font-size: 14px; padding: 10px 24px; background: #25d366;">
                        <i class="fa-solid fa-qrcode"></i> Connect WhatsApp Device
                    </button>
                </div>
            `;
        }
    }

    async function restartWhatsAppQR() {
        Swal.fire({
            title: 'Generating QR Code...',
            text: 'Initializing WhatsApp socket session...',
            allowOutsideClick: false,
            didOpen: () => Swal.showLoading()
        });
        try {
            const res = await fetch('/api/whatsapp/restart', { method: 'POST' });
            const data = await res.json();
            Swal.close();
            renderWhatsAppStatus(data);
        } catch (e) {
            Swal.fire('Error', 'Failed to generate QR: ' + e.message, 'error');
        }
    }

    async function unlinkWhatsApp() {
        const confirm = await Swal.fire({
            title: 'Unlink WhatsApp Device?',
            text: 'Are you sure you want to disconnect this WhatsApp account?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc2626',
            confirmButtonText: 'Yes, Unlink'
        });
        if (!confirm.isConfirmed) return;

        Swal.fire({
            title: 'Disconnecting...',
            didOpen: () => Swal.showLoading()
        });
        try {
            await fetch('/api/whatsapp/logout', { method: 'POST' });
            Swal.fire('Unlinked!', 'WhatsApp account has been disconnected.', 'success');
            checkWhatsAppStatus();
        } catch (e) {
            Swal.fire('Error', 'Failed to unlink: ' + e.message, 'error');
        }
    }

    // Start live polling status
    document.addEventListener('DOMContentLoaded', () => {
        renderApproversTable();
        checkWhatsAppStatus();
        waPollInterval = setInterval(checkWhatsAppStatus, 3000);
    });
    window.addEventListener('beforeunload', () => {
        if (waPollInterval) clearInterval(waPollInterval);
    });
</script>

<%- include('partials/footer') %>

