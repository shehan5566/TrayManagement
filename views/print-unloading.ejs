<%- include('partials/header') %>

<div class="receipt-card" style="position: relative;">
    <% if (trip.isDeleted || trip.status === 'CANCELLED') { %>
        <div style="position: absolute; top: 40%; left: 50%; transform: translate(-50%, -50%) rotate(-30deg); font-size: 70px; font-weight: bold; color: rgba(255, 0, 0, 0.15); z-index: 10; pointer-events: none; white-space: nowrap; border: 5px solid rgba(255, 0, 0, 0.15); padding: 20px; border-radius: 10px;">CANCELLED</div>
    <% } %>
    <div class="receipt-header">
        <img src="/images/logo.png" alt="Nelna Agri Development Logo" class="receipt-logo-img">
        <div class="receipt-title">Nelna Agri Development (Pvt) Ltd</div>
        <div class="receipt-doc-title" style="font-size: 14px; color: var(--text-dark); font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;">LORRY UNLOADING & SETTLEMENT NOTE</div>
        <div class="receipt-subtitle">Vehicle Return, Tray Reconciliation & Warehouse Inventory Settlement</div>
    </div>

    <div class="receipt-meta">
        <div>
            <strong>Unloading No:</strong> <%= trip.unloadingNo || '-' %><br>
            <strong>Loading No:</strong> <%= trip.tripNo %><br>
            <strong>Warehouse:</strong> <%= trip.locationName || 'Head Office' %><br>
            <strong>Received By:</strong> <%= trip.receivedBy || 'System' %>
        </div>
        <div style="text-align: right;">
            <strong>Returned Date:</strong> <%= trip.returnedDate ? new Date(trip.returnedDate).toLocaleDateString('en-GB', { timeZone: 'Asia/Colombo' }) : (trip.dispatchedDate ? new Date(trip.dispatchedDate).toLocaleDateString('en-GB', { timeZone: 'Asia/Colombo' }) : '-') %><br>
            <strong>Time:</strong> <%= trip.returnedDate ? new Date(trip.returnedDate).toLocaleTimeString('en-US', { timeZone: 'Asia/Colombo', hour: '2-digit', minute: '2-digit', hour12: true }) : (trip.dispatchedDate ? new Date(trip.dispatchedDate).toLocaleTimeString('en-US', { timeZone: 'Asia/Colombo', hour: '2-digit', minute: '2-digit', hour12: true }) : '-') %><br>
            <strong>Status:</strong> <%= trip.status %>
        </div>
    </div>

    <table class="receipt-details-table">
        <tr>
            <td class="label">Vehicle Number</td>
            <td class="value"><code><%= trip.vehicleNo %></code></td>
        </tr>
        <tr>
            <td class="label">Driver Name</td>
            <td class="value"><strong><%= trip.driverName || '-' %></strong></td>
        </tr>
        <tr>
            <td class="label">Warehouse</td>
            <td class="value"><strong><%= trip.locationName || 'Head Office' %></strong></td>
        </tr>
        <tr>
            <td class="label">Loaded Qty</td>
            <td class="value"><strong><%= trip.loadedQty %> Trays</strong></td>
        </tr>
        <tr>
            <td class="label" style="color: #dc2626;">OUT</td>
            <td class="value" style="color: #dc2626; font-weight: 700;"><strong><%= trip.totalDeliveredQty || 0 %> Trays</strong></td>
        </tr>
        <tr>
            <td class="label" style="color: #2563eb;">IN</td>
            <td class="value" style="color: #2563eb; font-weight: 700;"><strong><%= trip.totalCollectedQty || 0 %> Trays</strong></td>
        </tr>
        <tr>
            <td class="label" style="font-weight: 700;">Expected Qty</td>
            <td class="value"><strong><%= trip.expectedRemainingQty || 0 %> Trays</strong></td>
        </tr>
        <tr>
            <td class="label" style="font-weight: 700; color: #1b5e20;">Unloaded Qty</td>
            <td class="value" style="color: #1b5e20; font-size: 15px;"><strong><%= trip.actualUnloadedQty !== undefined ? trip.actualUnloadedQty : '-' %> Trays</strong></td>
        </tr>
        <tr>
            <td class="label">Variance</td>
            <td class="value">
                <% if (trip.variance === 0) { %>
                    <span class="badge" style="background:#dcfce7; color:#166534; padding:4px 8px; font-size:11px; font-weight: 700;">0 Trays</span>
                <% } else if (trip.variance < 0) { %>
                    <span class="badge" style="background:#fee2e2; color:#b91c1c; padding:4px 8px; font-size:11px; font-weight: 700;"><%= trip.variance %> Trays</span>
                <% } else { %>
                    <span class="badge" style="background:#eff6ff; color:#1d4ed8; padding:4px 8px; font-size:11px; font-weight: 700;">+<%= trip.variance %> Trays</span>
                <% } %>
            </td>
        </tr>
        <tr>
            <td class="label" style="font-weight: 600; color: #1b5e20;">Remarks</td>
            <td class="value" style="font-style: italic;">
                <%= trip.notes || '-' %>
            </td>
        </tr>
    </table>

    <!-- Unloading Summary Highlight Box -->
    <div style="margin: 18px 0 10px 0; padding: 16px 20px; border-radius: 8px; background-color: #e8f5e9; border: 2px solid #66bb6a;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <div style="font-size: 14px; font-weight: 700; color: #333;">
                    <i class="fa-solid fa-truck-ramp-box"></i> Unload Summary:
                </div>
                <div style="font-size: 12px; color: #555; margin-top: 4px;">
                    Vehicle: <strong><%= trip.vehicleNo %></strong> &nbsp;|&nbsp; Driver: <strong><%= trip.driverName || 'N/A' %></strong>
                </div>
                <div style="font-size: 12px; margin-top: 2px; color: #2e7d32; font-weight: 600;">
                    Unloading Ref: <%= trip.unloadingNo || '-' %> &nbsp;|&nbsp; Loading Ref: <%= trip.tripNo %>
                </div>
            </div>
            <div style="text-align: right;">
                <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #666; margin-bottom: 2px;">
                    Actual Unloaded Quantity
                </div>
                <div style="font-size: 24px; font-weight: 900; color: #1b5e20;">
                    <%= trip.actualUnloadedQty !== undefined ? trip.actualUnloadedQty : 0 %> Trays
                </div>
            </div>
        </div>
    </div>

    <!-- Security Gate Pass Clearance Box -->
    <div style="margin: 12px 0 20px 0; padding: 10px 14px; border: 1px dashed #2e7d32; background: #f1f8e9; border-radius: 6px; font-size: 11px; color: #2e7d32; display: flex; justify-content: space-between; align-items: center;">
        <div>
            <i class="fa-solid fa-shield-halved"></i> <strong>Gate Clearance Verification:</strong> Verified at return gate by security officer.
        </div>
        <div style="font-weight: 600; color: #333;">
            Gate In Time: ____________
        </div>
    </div>

    <div class="receipt-signatures">
        <div class="signature-line">Unloaded By</div>
        <div class="signature-line">Checked By</div>
        <div class="signature-line">Received By</div>
    </div>
</div>

<div class="print-actions">
    <button onclick="window.print()" class="btn btn-primary" style="padding: 12px 24px; background-color: #1b5e20; border-color: #1b5e20;">
        <i class="fa-solid fa-print"></i> Print Unloading Note
    </button>
    <a href="/unloading" class="btn btn-secondary" style="padding: 12px 24px;">
        <i class="fa-solid fa-arrow-left"></i> Back to Unloading
    </a>
</div>

<%- include('partials/footer') %>
