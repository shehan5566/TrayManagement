<%- include('partials/header') %>

<div style="margin-bottom: 25px;">
    <h2 style="color: var(--primary-green-dark);"><i class="fa-solid fa-truck-loading"></i> Lorry Loading & Dispatch</h2>
    <p style="color: var(--text-light); font-size: 14px;">Manage vehicle loading, assign tray counts, and dispatch lorries for delivery routes.</p>
</div>

<% if (locals.error) { %>
    <div class="error-banner">
        <i class="fa-solid fa-triangle-exclamation"></i> <%= error %>
    </div>
<% } %>

<!-- 1. Dispatch Lorry (Load Trays) -->
<% if (typeof hasPerm !== 'function' || hasPerm('transactions_create')) { %>
<div class="content-box" style="border-top: 4px solid var(--primary-green);">
    <div class="box-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
        <span class="box-title"><i class="fa-solid fa-truck-loading"></i> Loading</span>
        <span style="font-size: 13px; font-weight: 700; color: var(--primary-green-dark); background: #dcfce7; padding: 4px 12px; border-radius: 20px; border: 1px solid #86efac;">
            <i class="fa-solid fa-warehouse"></i> Warehouse Stock: <%= (typeof currentStock !== 'undefined') ? currentStock : 0 %> Trays
        </span>
    </div>

    <% if (typeof currentStock !== 'undefined' && currentStock <= 0) { %>
        <div style="background: #fee2e2; border: 1px solid #fca5a5; color: #b91c1c; padding: 10px 14px; border-radius: 8px; margin-bottom: 15px; font-size: 13px; font-weight: 600;">
            <i class="fa-solid fa-triangle-exclamation"></i> Warehouse stock is currently 0 Trays. Lorries cannot be loaded until new stock is received or returned.
        </div>
    <% } %>

    <form action="/lorry-trips/dispatch" method="POST" onsubmit="submitAjaxForm(event, this, 'Lorry dispatched successfully')">
        <div class="form-grid">
            <div class="form-group">
                <label for="vehicleNo">Vehicle Number <span style="color:red;">*</span></label>
                <select id="vehicleNo" name="vehicleNo" required>
                    <option value="">Select Vehicle</option>
                    <% (vehicles || []).forEach(v => { %>
                        <option value="<%= v %>"><%= v %></option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group">
                <label for="driverName">Driver Name</label>
                <input type="text" id="driverName" name="driverName" placeholder="e.g. Nuwan Kumara" required>
            </div>

            <div class="form-group">
                <label for="loadedQty">Loaded Tray Quantity <span style="color:red;">*</span></label>
                <input type="number" id="loadedQty" name="loadedQty" min="1" max="<%= (typeof currentStock !== 'undefined') ? currentStock : '' %>" placeholder="Enter tray count..." required oninput="validateDispatchStock(this)">
                <small id="stockWarning" style="display: none; color: #dc2626; font-weight: 600; margin-top: 4px;">
                    <i class="fa-solid fa-triangle-exclamation"></i> Quantity exceeds available warehouse stock (<%= (typeof currentStock !== 'undefined') ? currentStock : 0 %> Trays)!
                </small>
            </div>

            <div class="form-group">
                <label for="dispatchedDate">Dispatch Date & Time</label>
                <input type="datetime-local" id="dispatchedDate" name="dispatchedDate" required>
            </div>
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
            <label for="notes">Remarks</label>
            <input type="text" id="notes" name="notes" placeholder="e.g. Gampaha - Negombo Delivery Route, or any remarks...">
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <button type="submit" id="dispatchBtn" class="btn btn-primary" style="padding: 10px 24px;" <%= (typeof currentStock !== 'undefined' && currentStock <= 0) ? 'disabled' : '' %>>
                <i class="fa-solid fa-paper-plane"></i> Dispatch Lorry with Trays
            </button>
            <a href="/driver" target="_blank" class="btn btn-secondary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                <i class="fa-solid fa-mobile-screen-button"></i> Open Driver Mobile Portal (/driver)
            </a>
        </div>
    </form>
</div>
<% } %>

<style>
    .table-responsive table th, 
    .table-responsive table td {
        white-space: nowrap !important;
        vertical-align: middle !important;
    }
</style>

<!-- 2. Loading History -->
<div class="content-box">
    <div class="box-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
        <span class="box-title"><i class="fa-solid fa-clock-rotate-left"></i> Loading History</span>
        <a href="/unloading" class="btn btn-secondary" style="text-decoration: none; font-size: 12px; padding: 5px 12px; display: inline-flex; align-items: center; gap: 6px;">
            <i class="fa-solid fa-truck-ramp-box"></i> Go to Unloading Page
        </a>
    </div>

    <% const loadingTrips = (trips || []).filter(t => !t.isDeleted); %>
    <% if (loadingTrips.length === 0) { %>
        <p style="text-align: center; color: var(--text-light); padding: 30px 0;">
            <i class="fa-solid fa-check-circle" style="color: #10b981; font-size: 24px; display: block; margin-bottom: 8px;"></i>
            No loading history records yet.
        </p>
    <% } else { %>
        <div class="table-responsive">
            <table id="loadingHistoryTable" class="display" style="width: 100%;">
                <thead>
                    <tr>
                        <th style="white-space: nowrap;">Date & Time</th>
                        <th style="white-space: nowrap;">Loading No</th>
                        <th style="white-space: nowrap;">Vehicle & Driver</th>
                        <th style="white-space: nowrap;">Warehouse</th>
                        <th style="white-space: nowrap;">Created By</th>
                        <th style="text-align: right; white-space: nowrap;">Loaded Qty</th>
                        <th style="text-align: center; min-width: 160px; white-space: nowrap;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% loadingTrips.forEach(t => { %>
                        <tr>
                            <td data-order="<%= new Date(t.dispatchedDate).getTime() %>" style="white-space: nowrap;">
                                <%= new Date(t.dispatchedDate).toLocaleDateString() %> <span style="color: var(--text-light); font-size: 11px;"><%= new Date(t.dispatchedDate).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
                            </td>
                            <td style="white-space: nowrap;">
                                <strong style="color: #1e293b;"><%= t.tripNo %></strong>
                                <% if (t.status === 'COMPLETED') { %>
                                    <span class="badge badge-in" style="font-size: 10px; padding: 2px 6px; margin-left: 4px; background: #dcfce7; color: #166534; border: 1px solid #86efac; white-space: nowrap;">COMPLETED</span>
                                <% } else if (t.status === 'CANCELLED') { %>
                                    <span class="badge badge-out" style="font-size: 10px; padding: 2px 6px; margin-left: 4px; background: #fee2e2; color: #b91c1c; border: 1px solid #fca5a5; white-space: nowrap;">CANCELLED</span>
                                <% } else { %>
                                    <span class="badge" style="font-size: 10px; padding: 2px 6px; margin-left: 4px; background: #eff6ff; color: #1d4ed8; border: 1px solid #93c5fd; white-space: nowrap;">ON ROUTE</span>
                                <% } %>
                            </td>
                            <td style="white-space: nowrap;">
                                <strong style="color: var(--primary-green-dark);"><%= t.vehicleNo %></strong><% if (t.driverName) { %> <span style="font-size: 11px; color: var(--text-light); font-weight: normal;">(<%= t.driverName %>)</span><% } %>
                            </td>
                            <td style="white-space: nowrap;">
                                <span class="badge" style="background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; font-weight: 600; font-size: 11px; white-space: nowrap;">
                                    <%= t.locationName || 'Head Office' %>
                                </span>
                            </td>
                            <td style="white-space: nowrap;"><%= t.dispatchedBy || 'System' %></td>
                            <td data-order="<%= t.loadedQty %>" style="text-align: right; font-weight: 800; font-size: 15px; color: #107c41; white-space: nowrap;">
                                <%= t.loadedQty %>
                            </td>
                            <td style="text-align: center; white-space: nowrap;">
                                <div style="display: flex; gap: 6px; justify-content: center; align-items: center; margin: 0 auto; width: fit-content; white-space: nowrap;">
                                    <a href="/loading/<%= t.id %>/print" target="_blank" class="btn btn-receipt-action" title="Print Loading Note">
                                        <i class="fa-solid fa-print"></i> Print
                                    </a>
                                    <% if (typeof user !== 'undefined' && user && (user.username === 'admin' || user.role === 'admin' || (typeof hasPerm === 'function' && hasPerm('transactions_edit')))) { %>
                                        <button onclick='openEditModal(<%- JSON.stringify(t).replace(/'/g, "\\'") %>)' class="btn btn-action-edit" title="Edit Loading Record" type="button">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                    <% } %>
                                    <% if (typeof user !== 'undefined' && user && (user.username === 'admin' || user.role === 'admin' || (typeof hasPerm === 'function' && (hasPerm('transactions_delete') || hasPerm('delete_records'))))) { %>
                                        <form action="/loading/<%= t.id %>/delete" method="POST" onsubmit="confirmAjaxDelete(event, this, 'loading record')" style="display: inline-flex; margin: 0; padding: 0;">
                                            <button type="submit" class="btn btn-action-delete" title="Delete Record">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<!-- Edit Loading Modal -->
<div id="editModal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,0.6); backdrop-filter: blur(4px);">
    <div style="background-color: #fff; margin: 5% auto; padding: 25px; border-radius: 12px; width: 90%; max-width: 500px; box-shadow: 0 10px 25px rgba(0,0,0,0.3); border-top: 5px solid var(--primary-green);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
            <h3 style="margin: 0; color: var(--primary-green-dark);"><i class="fa-solid fa-pen-to-square"></i> Edit Loading Record</h3>
            <span onclick="closeEditModal()" style="font-size: 24px; font-weight: bold; cursor: pointer; color: #666;">&times;</span>
        </div>

        <form id="editForm" action="" method="POST" onsubmit="submitAjaxForm(event, this, 'Loading record updated successfully')">
            <div class="form-group" style="margin-bottom: 12px;">
                <label style="font-weight: 600;">Loading Number</label>
                <input type="text" id="editTripNo" class="form-control" readonly style="background: #f1f5f9; font-weight: 700; color: #334155;">
            </div>

            <div class="form-group" style="margin-bottom: 12px;">
                <label for="editVehicleNo" style="font-weight: 600;">Vehicle Number <span style="color:red;">*</span></label>
                <select id="editVehicleNo" name="vehicleNo" required class="form-control">
                    <% (vehicles || []).forEach(v => { %>
                        <option value="<%= v %>"><%= v %></option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 12px;">
                <label for="editDriverName" style="font-weight: 600;">Driver Name</label>
                <input type="text" id="editDriverName" name="driverName" class="form-control" required>
            </div>

            <div class="form-group" style="margin-bottom: 12px;">
                <label for="editLoadedQty" style="font-weight: 600;">Loaded Tray Quantity <span style="color:red;">*</span></label>
                <input type="number" id="editLoadedQty" name="loadedQty" min="1" class="form-control" required oninput="validateEditStock(this)">
                <small id="editStockWarning" style="display: none; color: #dc2626; font-weight: 600; margin-top: 4px;">
                    <i class="fa-solid fa-triangle-exclamation"></i> <span id="editStockWarningText"></span>
                </small>
            </div>

            <div class="form-group" style="margin-bottom: 12px;">
                <label for="editDispatchedDate" style="font-weight: 600;">Dispatch Date & Time</label>
                <input type="datetime-local" id="editDispatchedDate" name="dispatchedDate" class="form-control" required>
            </div>

            <div class="form-group" style="margin-bottom: 20px;">
                <label for="editNotes" style="font-weight: 600;">Remarks</label>
                <input type="text" id="editNotes" name="notes" class="form-control">
            </div>

            <div style="display: flex; gap: 10px;">
                <button type="submit" id="editSaveBtn" class="btn btn-primary" style="flex: 1; padding: 12px;">
                    <i class="fa-solid fa-save"></i> Save Changes
                </button>
                <button type="button" onclick="closeEditModal()" class="btn btn-secondary" style="padding: 12px;">
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    const warehouseStock = <%= (typeof currentStock !== 'undefined') ? currentStock : 0 %>;
    let editOriginalLoadedQty = 0;

    document.addEventListener('DOMContentLoaded', function() {
        const now = new Date();
        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
        const dtInput = document.getElementById('dispatchedDate');
        if (dtInput) dtInput.value = now.toISOString().slice(0, 16);
    });

    function validateDispatchStock(input) {
        const val = parseInt(input.value, 10) || 0;
        const warn = document.getElementById('stockWarning');
        const btn = document.getElementById('dispatchBtn');
        if (val > warehouseStock) {
            warn.style.display = 'block';
            input.style.borderColor = '#dc2626';
            if (btn) btn.disabled = true;
        } else {
            warn.style.display = 'none';
            input.style.borderColor = '';
            if (btn && warehouseStock > 0) btn.disabled = false;
        }
    }

    function validateEditStock(input) {
        const val = parseInt(input.value, 10) || 0;
        const maxAllowed = warehouseStock + editOriginalLoadedQty;
        const warn = document.getElementById('editStockWarning');
        const warnText = document.getElementById('editStockWarningText');
        const saveBtn = document.getElementById('editSaveBtn');

        if (val > maxAllowed) {
            warn.style.display = 'block';
            warnText.innerText = `Maximum allowed is ${maxAllowed} Trays (Available stock: ${warehouseStock} + Current loaded: ${editOriginalLoadedQty})!`;
            input.style.borderColor = '#dc2626';
            if (saveBtn) saveBtn.disabled = true;
        } else {
            warn.style.display = 'none';
            input.style.borderColor = '';
            if (saveBtn) saveBtn.disabled = false;
        }
    }

    function openEditModal(t) {
        document.getElementById('editForm').action = '/loading/' + t.id + '/edit';
        document.getElementById('editTripNo').value = t.tripNo || '';
        document.getElementById('editVehicleNo').value = t.vehicleNo || '';
        document.getElementById('editDriverName').value = t.driverName || '';
        document.getElementById('editLoadedQty').value = t.loadedQty || '';

        editOriginalLoadedQty = parseInt(t.loadedQty, 10) || 0;
        const isCompleted = t.status === 'COMPLETED' || t.status === 'CANCELLED';
        const qtyInput = document.getElementById('editLoadedQty');
        if (isCompleted) {
            qtyInput.readOnly = true;
            qtyInput.style.backgroundColor = '#f1f5f9';
            qtyInput.title = 'Loaded quantity cannot be changed for completed trips';
        } else {
            qtyInput.readOnly = false;
            qtyInput.style.backgroundColor = '';
            qtyInput.title = '';
        }
        qtyInput.max = warehouseStock + editOriginalLoadedQty;
        document.getElementById('editStockWarning').style.display = 'none';
        qtyInput.style.borderColor = '';
        if (document.getElementById('editSaveBtn')) document.getElementById('editSaveBtn').disabled = false;
        
        if (t.dispatchedDate) {
            const d = new Date(t.dispatchedDate);
            d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
            document.getElementById('editDispatchedDate').value = d.toISOString().slice(0, 16);
        }
        document.getElementById('editNotes').value = t.notes || '';
        document.getElementById('editModal').style.display = 'block';
    }

    function closeEditModal() {
        document.getElementById('editModal').style.display = 'none';
    }
</script>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script>
    $(document).ready(function () {
        if ($('#loadingHistoryTable').length) {
            $('#loadingHistoryTable').DataTable({
                pageLength: 25,
                order: [[0, 'desc']],
                columnDefs: [
                    { orderable: false, targets: 6 }
                ]
            });
        }
    });
</script>

<%- include('partials/footer') %>
