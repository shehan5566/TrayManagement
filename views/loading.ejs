<%- include('partials/header') %>

<div style="margin-bottom: 25px;">
    <h2 style="color: var(--primary-green-dark);"><i class="fa-solid fa-truck-loading"></i> Lorry Loading & Dispatch</h2>
    <p style="color: var(--text-light); font-size: 14px;">Manage vehicle loading, assign tray counts, and dispatch lorries for delivery routes.</p>
</div>

<% if (locals.error) { %>
    <div class="error-banner">
        <i class="fa-solid fa-triangle-exclamation"></i> <%= error %>
    </div>
<% } %>

<!-- 1. Dispatch Lorry (Load Trays) -->
<% if (typeof hasPerm !== 'function' || hasPerm('transactions_create')) { %>
<div class="content-box" style="border-top: 4px solid var(--primary-green);">
    <div class="box-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
        <span class="box-title"><i class="fa-solid fa-truck-loading"></i> Loading</span>
        <span style="font-size: 13px; font-weight: 700; color: var(--primary-green-dark); background: #dcfce7; padding: 4px 12px; border-radius: 20px; border: 1px solid #86efac;">
            <i class="fa-solid fa-warehouse"></i> Warehouse Stock: <%= (typeof currentStock !== 'undefined') ? currentStock : 0 %> Trays
        </span>
    </div>

    <form action="/lorry-trips/dispatch" method="POST" onsubmit="submitAjaxForm(event, this, 'Lorry dispatched successfully')">
        <div class="form-grid">
            <div class="form-group">
                <label for="vehicleNo">Vehicle Number <span style="color:red;">*</span></label>
                <select id="vehicleNo" name="vehicleNo" required>
                    <option value="">Select Vehicle</option>
                    <% (vehicles || []).forEach(v => { %>
                        <option value="<%= v %>"><%= v %></option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group">
                <label for="driverName">Driver Name</label>
                <input type="text" id="driverName" name="driverName" placeholder="e.g. Nuwan Kumara" required>
            </div>

            <div class="form-group">
                <label for="loadedQty">Loaded Tray Quantity <span style="color:red;">*</span></label>
                <input type="number" id="loadedQty" name="loadedQty" min="1" placeholder="Enter tray count..." required>
            </div>

            <div class="form-group">
                <label for="dispatchedDate">Dispatch Date & Time</label>
                <input type="datetime-local" id="dispatchedDate" name="dispatchedDate" required>
            </div>
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
            <label for="notes">Remarks</label>
            <input type="text" id="notes" name="notes" placeholder="e.g. Gampaha - Negombo Delivery Route, or any remarks...">
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <button type="submit" class="btn btn-primary" style="padding: 10px 24px;">
                <i class="fa-solid fa-paper-plane"></i> Dispatch Lorry with Trays
            </button>
            <a href="/driver" target="_blank" class="btn btn-secondary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                <i class="fa-solid fa-mobile-screen-button"></i> Open Driver Mobile Portal (/driver)
            </a>
        </div>
    </form>
</div>
<% } %>

<!-- 2. Active Loaded Lorries on Route -->
<div class="content-box">
    <div class="box-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
        <span class="box-title"><i class="fa-solid fa-route"></i> Active Loaded Lorries on Route</span>
        <a href="/unloading" class="btn btn-secondary" style="text-decoration: none; font-size: 12px; padding: 5px 12px; display: inline-flex; align-items: center; gap: 6px;">
            <i class="fa-solid fa-truck-ramp-box"></i> Go to Unloading Page
        </a>
    </div>

    <% const activeTrips = (trips || []).filter(t => t.status === 'ON_ROUTE'); %>
    <% if (activeTrips.length === 0) { %>
        <p style="text-align: center; color: var(--text-light); padding: 30px 0;">
            <i class="fa-solid fa-check-circle" style="color: #10b981; font-size: 24px; display: block; margin-bottom: 8px;"></i>
            No active lorry trips on route. All lorries have been unloaded and reconciled.
        </p>
    <% } else { %>
        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>Date & Time</th>
                        <th>Loading No</th>
                        <th>Vehicle & Driver</th>
                        <th>Warehouse</th>
                        <th>Created By</th>
                        <th style="text-align: right;">Loaded Qty</th>
                        <th>Remarks</th>
                        <th style="text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% activeTrips.forEach(t => { %>
                        <tr>
                            <td>
                                <%= new Date(t.dispatchedDate).toLocaleDateString() %><br>
                                <small style="color: var(--text-light);"><%= new Date(t.dispatchedDate).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></small>
                            </td>
                            <td><strong style="color: #1e293b;"><%= t.tripNo %></strong></td>
                            <td>
                                <strong style="color: var(--primary-green-dark);"><i class="fa-solid fa-truck"></i> <%= t.vehicleNo %></strong>
                                <div style="font-size: 11px; color: var(--text-light);"><%= t.driverName || 'Driver' %> &bull; <span style="color: #0284c7; font-weight: 600;">PIN: <%= t.pin %></span></div>
                            </td>
                            <td>
                                <span class="badge" style="background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; font-weight: 600; font-size: 11px;">
                                    <i class="fa-solid fa-warehouse"></i> <%= t.locationName || 'Head Office' %>
                                </span>
                            </td>
                            <td><%= t.dispatchedBy || 'System' %></td>
                            <td style="text-align: right; font-weight: 800; font-size: 15px; color: #107c41;">
                                <%= t.loadedQty %>
                            </td>
                            <td>
                                <span style="font-size: 12px; color: var(--text-light);"><%= t.notes || '-' %></span>
                            </td>
                            <td style="text-align: center;">
                                <div style="display: flex; gap: 6px; justify-content: center; align-items: center;">
                                    <a href="/loading/<%= t.id %>/print" class="btn btn-secondary" style="padding: 6px 10px; font-size: 12px;" title="Print Loading Note">
                                        <i class="fa-solid fa-print"></i> Note
                                    </a>
                                    <% if (typeof user !== 'undefined' && user && (user.username === 'admin' || user.role === 'admin' || (typeof hasPerm === 'function' && hasPerm('transactions_edit')))) { %>
                                        <button onclick='openEditModal(<%- JSON.stringify(t).replace(/'/g, "\\'") %>)' class="btn btn-primary" style="padding: 6px 10px; font-size: 12px;" title="Edit Loading Record">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                    <% } %>
                                    <% if (typeof user !== 'undefined' && user && (user.username === 'admin' || user.role === 'admin' || (typeof hasPerm === 'function' && (hasPerm('transactions_delete') || hasPerm('delete_records'))))) { %>
                                        <form action="/loading/<%= t.id %>/delete" method="POST" onsubmit="confirmAjaxDelete(event, this, 'loading record')" style="display:inline;">
                                            <button type="submit" class="btn btn-danger" style="padding: 6px 10px; font-size: 12px; background-color: #ffc300; border-color: #e6b000; color: #000000;" title="Delete Record">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<!-- Edit Loading Modal -->
<div id="editModal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,0.6); backdrop-filter: blur(4px);">
    <div style="background-color: #fff; margin: 5% auto; padding: 25px; border-radius: 12px; width: 90%; max-width: 500px; box-shadow: 0 10px 25px rgba(0,0,0,0.3); border-top: 5px solid var(--primary-green);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
            <h3 style="margin: 0; color: var(--primary-green-dark);"><i class="fa-solid fa-pen-to-square"></i> Edit Loading Record</h3>
            <span onclick="closeEditModal()" style="font-size: 24px; font-weight: bold; cursor: pointer; color: #666;">&times;</span>
        </div>

        <form id="editForm" action="" method="POST" onsubmit="submitAjaxForm(event, this, 'Loading record updated successfully')">
            <div class="form-group" style="margin-bottom: 12px;">
                <label style="font-weight: 600;">Loading Number</label>
                <input type="text" id="editTripNo" class="form-control" readonly style="background: #f1f5f9; font-weight: 700; color: #334155;">
            </div>

            <div class="form-group" style="margin-bottom: 12px;">
                <label for="editVehicleNo" style="font-weight: 600;">Vehicle Number <span style="color:red;">*</span></label>
                <select id="editVehicleNo" name="vehicleNo" required class="form-control">
                    <% (vehicles || []).forEach(v => { %>
                        <option value="<%= v %>"><%= v %></option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 12px;">
                <label for="editDriverName" style="font-weight: 600;">Driver Name</label>
                <input type="text" id="editDriverName" name="driverName" class="form-control" required>
            </div>

            <div class="form-group" style="margin-bottom: 12px;">
                <label for="editLoadedQty" style="font-weight: 600;">Loaded Tray Quantity <span style="color:red;">*</span></label>
                <input type="number" id="editLoadedQty" name="loadedQty" min="1" class="form-control" required>
            </div>

            <div class="form-group" style="margin-bottom: 12px;">
                <label for="editDispatchedDate" style="font-weight: 600;">Dispatch Date & Time</label>
                <input type="datetime-local" id="editDispatchedDate" name="dispatchedDate" class="form-control" required>
            </div>

            <div class="form-group" style="margin-bottom: 20px;">
                <label for="editNotes" style="font-weight: 600;">Remarks</label>
                <input type="text" id="editNotes" name="notes" class="form-control">
            </div>

            <div style="display: flex; gap: 10px;">
                <button type="submit" class="btn btn-primary" style="flex: 1; padding: 12px;">
                    <i class="fa-solid fa-save"></i> Save Changes
                </button>
                <button type="button" onclick="closeEditModal()" class="btn btn-secondary" style="padding: 12px;">
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const now = new Date();
        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
        const dtInput = document.getElementById('dispatchedDate');
        if (dtInput) dtInput.value = now.toISOString().slice(0, 16);
    });

    function openEditModal(t) {
        document.getElementById('editForm').action = '/loading/' + t.id + '/edit';
        document.getElementById('editTripNo').value = t.tripNo || '';
        document.getElementById('editVehicleNo').value = t.vehicleNo || '';
        document.getElementById('editDriverName').value = t.driverName || '';
        document.getElementById('editLoadedQty').value = t.loadedQty || '';
        
        if (t.dispatchedDate) {
            const d = new Date(t.dispatchedDate);
            d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
            document.getElementById('editDispatchedDate').value = d.toISOString().slice(0, 16);
        }
        document.getElementById('editNotes').value = t.notes || '';
        document.getElementById('editModal').style.display = 'block';
    }

    function closeEditModal() {
        document.getElementById('editModal').style.display = 'none';
    }

    window.addEventListener('click', function(e) {
        const m = document.getElementById('editModal');
        if (e.target === m) closeEditModal();
    });
</script>

<%- include('partials/footer') %>
