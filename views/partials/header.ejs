                                                            <i class="fa-solid fa-cogs"></i> Administration
                                                        </div>
                                                        <i class="fa-solid fa-chevron-down submenu-icon"></i>
                                                    </a>
                                                    <ul class="submenu">
                                                        <% if (user.username === 'admin' || user.role === 'admin' || (typeof hasPerm === 'function' && hasPerm('admin_branches_users'))) { %>
                                                        <li class="<%= activePath === '/users' ? 'active' : '' %>">
                                                            <a href="/users">Branches & Users</a>
                                                        </li>
                                                        <% } %>
                                                        <% if (user.username === 'admin' || user.role === 'admin' || (typeof hasPerm === 'function' && hasPerm('admin_roles'))) { %>
                                                        <li class="<%= activePath === '/roles' ? 'active' : '' %>">
                                                            <a href="/roles">Roles</a>
                                                        </li>
                                                        <% } %>
                                                        <% if (user.username === 'admin' || user.role === 'admin' || (typeof hasPerm === 'function' && hasPerm('admin_view_logs'))) { %>
                                                        <li class="<%= activePath === '/logs' ? 'active' : '' %>">
                                                            <a href="/logs">Logs</a>
                                                        </li>
                                                        <% } %>
                                                        <% if (user.username === 'admin' || user.role === 'admin' || (typeof hasPerm === 'function' && hasPerm('admin_settings'))) { %>
                                                        <li class="<%= activePath === '/settings' ? 'active' : '' %>">
                                                            <a href="/settings">Settings</a>
                                                        </li>
                                                        <% } %>
                                                    </ul>
                                                </li>
                                                                                <% } %>

                                                                                    <!-- 10. Profile -->
                                                                                    <li
                                                                                        class="<%= activePath === '/profile' ? 'active' : '' %>">
                                                                                        <a href="/profile"><i
                                                                                                class="fa-solid fa-user-gear"></i>
                                                                                            Profile</a>
