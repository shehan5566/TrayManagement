<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nelna Agri - Tray Tracking System</title>
    <!-- Favicon / Tab Logo -->
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link rel="shortcut icon" type="image/png" href="/images/logo.png">
    <link rel="apple-touch-icon" href="/images/logo.png">
    <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>">
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- SweetAlert2 for modern popups -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Flatpickr for better date/time inputs -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <!-- Chart.js for Interactive Dashboard Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .flatpickr-calendar {
            z-index: 99999999 !important;
        }

        .flatpickr-day.selected,
        .flatpickr-day.startRange,
        .flatpickr-day.endRange,
        .flatpickr-day.selected.inRange,
        .flatpickr-day.startRange.inRange,
        .flatpickr-day.endRange.inRange,
        .flatpickr-day.selected:focus,
        .flatpickr-day.startRange:focus,
        .flatpickr-day.endRange:focus,
        .flatpickr-day.selected:hover,
        .flatpickr-day.startRange:hover,
        .flatpickr-day.endRange:hover,
        .flatpickr-day.selected.prevMonthDay,
        .flatpickr-day.startRange.prevMonthDay,
        .flatpickr-day.endRange.prevMonthDay,
        .flatpickr-day.selected.nextMonthDay,
        .flatpickr-day.startRange.nextMonthDay,
        .flatpickr-day.endRange.nextMonthDay {
            background: #ffd54f !important;
            border-color: #ffd54f !important;
            color: #333 !important;
        }
    </style>
    <script>
        try { localStorage.removeItem('theme'); } catch (e) {}
        document.documentElement.removeAttribute('data-theme');
    </script>
</head>

<body>

    <% if (user) { %>
        <div class="app-layout">

            <header class="top-header">
                <div class="nav-container">
                    <div class="brand" style="display: flex; align-items: center; gap: 10px;">
                        <button class="header-icon-btn mobile-only" id="headerSidebarToggleBtn" onclick="handleSidebarToggle()" title="Toggle Menu" style="background: rgba(255,255,255,0.2); border: none; color: #ffffff; width: 36px; height: 36px; border-radius: 8px; font-size: 18px; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            <i class="fa-solid fa-bars"></i>
                        </button>
                        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                            <a href="/dashboard" style="display: flex; align-items: center; gap: 10px; text-decoration: none; color: inherit; cursor: pointer;" title="Go to Dashboard">
                                <img src="/images/logo.png" alt="Nelna Logo" class="brand-logo-img">
                                <div class="brand-text">
                                    <h1>NELNA AGRI DEVELOPMENT (PVT) LTD</h1>
                                    <p class="brand-subtitle">TRAY MANAGEMENT SYSTEM</p>
                                </div>
                            </a>

                            <!-- Interactive Location Switcher Dropdown (Positioned directly at top header) -->
                            <% if (typeof canSwitchLocation !== 'undefined' && canSwitchLocation && typeof availableLocations !== 'undefined' && availableLocations.length > 0) { %>
                                <div class="header-location-dropdown-wrapper" id="headerLocationDropdownWrapper">
                                    <button type="button" class="header-location-badge location-switcher-badge" id="headerLocationBtn" onclick="toggleLocationDropdown(event)" title="Click to switch active location">
                                        <i class="fa-solid fa-location-dot"></i>
                                        <span class="location-name-text"><%= (user && user.locationName) ? user.locationName : 'Head Office' %></span>
                                        <i class="fa-solid fa-chevron-down loc-caret"></i>
                                    </button>
                                    <div class="header-location-menu" id="headerLocationMenu">
                                        <div class="loc-menu-header">
                                            <div style="display: flex; align-items: center; gap: 6px;">
                                                <i class="fa-solid fa-building-circle-check" style="color: var(--primary-green);"></i>
                                                <span style="font-weight: 700;">Switch Active Location</span>
                                            </div>
                                            <span class="loc-count-pill"><%= availableLocations.length %> branches</span>
                                        </div>
                                        <div class="loc-menu-list">
                                            <% if (user.role === 'admin' || user.username === 'admin') { 
                                                const isAllActive = user.locationId === 'all';
                                            %>
                                                <div class="loc-menu-item <%= isAllActive ? 'active' : '' %>" role="button" tabindex="0" onclick="switchUserLocation('all', 'All Locations (Global)')" style="border-bottom: 1px dashed rgba(0,0,0,0.1); margin-bottom: 4px; padding-bottom: 8px;">
                                                    <div class="loc-item-left">
                                                        <span class="loc-item-dot <%= isAllActive ? 'loc-item-dot-active' : '' %>" style="background: <%= isAllActive ? '#10b981' : '#64748b' %>;"></span>
                                                        <span class="loc-item-name" style="font-weight: 700;">🌐 All Locations (Global)</span>
                                                    </div>
                                                    <% if (isAllActive) { %>
                                                        <span class="loc-active-tag"><i class="fa-solid fa-check"></i> Active</span>
                                                    <% } %>
                                                </div>
                                            <% } %>
                                            <% availableLocations.forEach(loc => { 
                                                const isCurrent = (String(user.locationId) === String(loc.id)) || (!user.locationId && loc.id === 'main');
                                            %>
                                                <div class="loc-menu-item <%= isCurrent ? 'active' : '' %>" role="button" tabindex="0" onclick="switchUserLocation('<%= loc.id %>', '<%= loc.name.replace(/'/g, "\\'") %>')">
                                                    <div class="loc-item-left">
                                                        <span class="loc-item-dot <%= isCurrent ? 'loc-item-dot-active' : '' %>"></span>
                                                        <span class="loc-item-name"><%= loc.name %></span>
                                                    </div>
                                                    <% if (isCurrent) { %>
                                                        <span class="loc-active-tag"><i class="fa-solid fa-check"></i> Active</span>
                                                    <% } %>
                                                </div>
                                            <% }) %>
                                        </div>
                                    </div>
                                </div>
                            <% } else { %>
                                <div class="header-location-badge">
                                    <i class="fa-solid fa-location-dot"></i>
                                    <%= (user && user.locationName) ? user.locationName : 'Head Office' %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                    <div class="header-right">
                        <!-- Multilingual AI Voice Assistant Button -->
                        <button class="header-icon-btn" onclick="openVoiceModal()"
                            title="AI Voice Assistant (Sinhala, Tamil, English)">
                            <i class="fa-solid fa-microphone" style="color: #10b981;"></i>
                        </button>
                        <!-- Command Palette Trigger Button -->
                        <button class="header-icon-btn" onclick="toggleCommandPalette()"
                            title="Search & Quick Actions (Ctrl + K)">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </button>
                        <!-- Notifications Dropdown -->
                        <div class="notification-dropdown-wrapper">
                            <button class="header-icon-btn" id="notificationBtn" title="Notifications"
                                onclick="toggleNotificationDropdown(event)">
                                <i class="fa-solid fa-bell"></i>
                                <span class="notification-badge" id="notificationBadge" style="display: none;">0</span>
                            </button>
                            <div class="notification-dropdown-menu" id="notificationDropdownMenu">
                                <div class="notification-dropdown-header">
                                    <span>Notifications</span>
                                    <span class="notification-count-tag" id="notificationCountTag">0 new</span>
                                </div>
                                <div class="notification-dropdown-body" id="notificationList">
                                    <div class="notification-empty">
                                        <i class="fa-solid fa-bell-slash"
                                            style="font-size: 24px; color: var(--text-light); margin-bottom: 8px;"></i>
                                        <p>No new notifications</p>
                                    </div>
                                </div>
                                <div class="notification-dropdown-footer">
                                    <a href="/receive-stock"><i class="fa-solid fa-boxes-packing"></i> View Pending
                                        Stock Transfers</a>
                                </div>
                            </div>
                        </div>
                        <!-- User Welcome Dropdown -->
                        <div class="user-dropdown-wrapper">
                            <button class="user-dropdown-btn"
                                onclick="document.querySelector('.user-dropdown-menu').classList.toggle('show')">
                                <i class="fa-solid fa-user-circle" style="font-size: 22px;"></i>
                                <span>Welcome, <%= user.username %></span>
                                <i class="fa-solid fa-chevron-down" style="font-size: 10px;"></i>
                            </button>
                            <div class="user-dropdown-menu">
                                <a href="/profile"><i class="fa-solid fa-user-gear"></i> Profile</a>
                                <a href="/logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <script>
                function toggleLocationDropdown(event) {
                    if (event) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    const menu = document.getElementById('headerLocationMenu');
                    const btn = document.getElementById('headerLocationBtn');
                    if (!menu || !btn) return;

                    const isOpen = menu.classList.contains('show');
                    // Close other dropdowns
                    const userDropdown = document.querySelector('.user-dropdown-menu');
                    if (userDropdown) userDropdown.classList.remove('show');
                    const notifDropdown = document.getElementById('notificationDropdownMenu');
                    if (notifDropdown) notifDropdown.classList.remove('show');

                    if (isOpen) {
                        menu.classList.remove('show');
                        btn.classList.remove('open');
                    } else {
                        // Position directly beneath the location badge at the top
                        const rect = btn.getBoundingClientRect();
                        menu.style.position = 'fixed';
                        menu.style.top = (rect.bottom + 6) + 'px';
                        
                        let leftPos = rect.left;
                        if (leftPos + 310 > window.innerWidth) {
                            leftPos = Math.max(10, window.innerWidth - 320);
                        }
                        menu.style.left = leftPos + 'px';
                        menu.style.zIndex = '9999999';

                        menu.classList.add('show');
                        btn.classList.add('open');
                    }
                }

                window.addEventListener('scroll', function() {
                    const locDropdown = document.getElementById('headerLocationMenu');
                    const locBtn = document.getElementById('headerLocationBtn');
                    if (locDropdown && locDropdown.classList.contains('show')) {
                        locDropdown.classList.remove('show');
                        if (locBtn) locBtn.classList.remove('open');
                    }
                }, { passive: true });

                window.addEventListener('resize', function() {
                    const locDropdown = document.getElementById('headerLocationMenu');
                    const locBtn = document.getElementById('headerLocationBtn');
                    if (locDropdown && locDropdown.classList.contains('show')) {
                        locDropdown.classList.remove('show');
                        if (locBtn) locBtn.classList.remove('open');
                    }
                });

                async function switchUserLocation(locationId, locationName) {
                    const menu = document.getElementById('headerLocationMenu');
                    const btn = document.getElementById('headerLocationBtn');
                    if (menu) menu.classList.remove('show');
                    if (btn) btn.classList.remove('open');

                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            title: 'Switching Location...',
                            html: `Switching active branch to <strong>${locationName}</strong>`,
                            allowOutsideClick: false,
                            allowEscapeKey: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });
                    }

                    try {
                        const res = await fetch('/api/user/switch-location', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify({ locationId })
                        });

                        const data = await res.json();
                        if (data.success) {
                            window.location.reload();
                        } else {
                            if (typeof Swal !== 'undefined') {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: data.error || 'Failed to switch location'
                                });
                            } else {
                                alert(data.error || 'Failed to switch location');
                            }
                        }
                    } catch (err) {
                        console.error('Error switching location:', err);
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                icon: 'error',
                                title: 'Network Error',
                                text: 'Could not contact server.'
                            });
                        } else {
                            alert('Could not contact server.');
                        }
                    }
                }

                document.addEventListener('click', function(e) {
                    const locDropdown = document.getElementById('headerLocationMenu');
                    const locBtn = document.getElementById('headerLocationBtn');
                    if (locDropdown && locBtn && !locBtn.contains(e.target) && !locDropdown.contains(e.target)) {
                        locDropdown.classList.remove('show');
                        locBtn.classList.remove('open');
                    }
                });

                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') {
                        const locDropdown = document.getElementById('headerLocationMenu');
                        const locBtn = document.getElementById('headerLocationBtn');
                        if (locDropdown) locDropdown.classList.remove('show');
                        if (locBtn) locBtn.classList.remove('open');
                    }
                });
            </script>

