                                                </li>
                                                <% } %>

                                                <!-- 8. Damage & Audit Log -->
                                                <% if (typeof hasPerm !=='function' || hasPerm('damages_view')) { %>
                                                <li class="<%= activePath === '/damages' ? 'active' : '' %>">
                                                    <a href="/damages"><i class="fa-solid fa-boxes-stacked"></i> Damage & Audit</a>
                                                </li>
                                                <% } %>

                                                <!-- 9. Reports -->
                                                <% if (typeof hasPerm !=='function' || hasPerm('reports_view')) { %>
                                                <li class="<%= activePath === '/reports' ? 'active' : '' %>">
                                                    <a href="/reports"><i class="fa-solid fa-file-invoice"></i> Reports</a>
                                                </li>
                                                <% } %>

                                                <!-- 10. Analytics -->
                                                <% if (typeof hasPerm !=='function' || hasPerm('analytics_view')) { %>
                                                <li class="<%= activePath === '/analytics' ? 'active' : '' %>">
                                                    <a href="/analytics"><i class="fa-solid fa-chart-pie"></i> Analytics</a>
                                                </li>
                                                <% } %>

                                                <!-- 11. Administration -->
                                                <% const canSeeAdmin = user.username === 'admin' ||
                                                    user.role === 'admin' || (typeof hasPerm === 'function' &&
                                                    (hasPerm('admin_branches_users') ||
                                                    hasPerm('admin_roles') ||
                                                    hasPerm('admin_view_logs') ||
                                                    hasPerm('admin_settings'))); %>
                                                <% if (canSeeAdmin) { %>
                                                <li class="has-submenu <%= ['/users', '/roles', '/logs', '/settings'].includes(activePath) ? 'open' : '' %>">
                                                    <a href="#" onclick="toggleSubmenu(event, this)">
