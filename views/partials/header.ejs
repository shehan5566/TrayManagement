                                        <!-- 3. In & Out Entry -->
                                        <% if (typeof hasPerm !=='function' || hasPerm('transactions_view')) { %>
                                            <li class="<%= activePath.startsWith('/transactions') ? 'active' : '' %>">
                                                <a href="/transactions"><i class="fa-solid fa-right-left"></i> In & Out
                                                    Entry</a>
                                            </li>
                                            <% } %>

                                                <!-- 4. Stock Transfers -->
