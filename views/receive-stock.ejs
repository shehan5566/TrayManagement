<%- include('partials/header') %>


    <div style="margin-bottom: 25px;">
        <h2 style="color: var(--primary-green-dark);"><i class="fa-solid fa-boxes-packing"></i> Receive Stock</h2>
        <p style="color: var(--text-light); font-size: 14px;">Process incoming Goods Receipt Notes (GRN) from other
            branches.</p>
    </div>

    <% if (error) { %>
        <div class="error-banner">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <%= error %>
        </div>
        <% } %>

            <!-- Incoming Transfers List -->
            <div class="content-box">
                <div class="box-header">
                    <span class="box-title"><i class="fa-solid fa-inbox"></i> Incoming Transfers</span>
                </div>
                <div class="table-responsive">
                    <table id="incomingTransfersTable" class="compact-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Doc No</th>
                                <th>From Branch</th>
                                <th>Vehicle No</th>
                                <th>Dispatched Qty</th>
                                <th>Remarks</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% const incoming = transfers.filter(t => (user && user.locationId && user.locationId !== 'all' ? t.toLocationId === user.locationId : true) && t.status === 'PENDING'); %>
                                        <% incoming.forEach(t=> { %>
                                            <tr>
                                                <td>
                                                    <%= new Date(t.dispatchedDate).toLocaleString('en-GB', { timeZone: 'Asia/Colombo' }) %>
                                                </td>
                                                <td><span class="badge"
                                                        style="background-color: var(--accent-yellow); color: #333;">
                                                        <%= t.transferDocNo || 'N/A' %>
                                                    </span></td>
                                                <td>
                                                    <%= t.fromLocationName %>
                                                </td>
                                                <td>
                                                    <%= t.vehicleNo || '-' %>
                                                </td>
                                                <td>
                                                    <%= t.dispatchedQty %>
                                                </td>
                                                <td>
                                                    <%= t.remarks || '-' %>
                                                    <% if (t.varianceRejectionReason) { %>
                                                        <div style="margin-top: 4px; font-size: 11px; color: #dc2626; font-weight: 600;">
                                                            <i class="fa-solid fa-rotate-left"></i> Re-count: <%= t.varianceRejectionReason %>
                                                        </div>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <% if (user.username === 'admin' || user.role === 'admin' || (typeof hasPerm === 'function' && hasPerm('receive_stock_approve'))) { %>
                                                    <div style="display: flex; gap: 8px; justify-content: center;">
                                                        <button
                                                            onclick="openGRNModal('<%= t.id %>', <%= t.dispatchedQty %>, '<%= t.fromLocationName %>', '<%= t.transferDocNo %>')"
                                                            class="btn btn-primary"
                                                            style="padding: 6px 10px; font-size: 12px;">
                                                            Process GRN
                                                        </button>
                                                    </div>
                                                    <% } else { %>
                                                        <span style="color: var(--text-light); font-size: 11px;">View only</span>
                                                    <% } %>
                                                </td>
                                            </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- GRN Variance Approvals Queue (Pending Approval State) -->
            <% const pendingApprovals = transfers.filter(t => (user && user.locationId && user.locationId !== 'all' ? t.toLocationId === user.locationId : true) && t.status === 'PENDING_APPROVAL'); %>
            <% if (pendingApprovals.length > 0) { %>
            <div class="content-box" style="margin-top: 25px; border-top: 4px solid #f59e0b; display: flex; flex-direction: column; gap: 15px;">
                <div class="box-header" style="display: flex; justify-content: space-between; align-items: center;">
                    <span class="box-title" style="color: #b45309;">
                        <i class="fa-solid fa-triangle-exclamation" style="color: #f59e0b;"></i> GRN Variance Approvals Queue
                    </span>
                    <span class="badge" style="background: #fef3c7; color: #b45309; border: 1px solid #fde68a; font-size: 12px; padding: 4px 10px; font-weight: 700;">
                        <%= pendingApprovals.length %> Awaiting Manager Approval
                    </span>
                </div>
                <div class="table-responsive">
                    <table id="varianceApprovalsTable" class="compact-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Transfer Ref</th>
                                <th>From Branch</th>
                                <th>Vehicle No</th>
                                <th>Dispatched</th>
                                <th>Received</th>
                                <th>Variance</th>
                                <th>Variance Reason</th>
                                <th>Submitted By</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% pendingApprovals.forEach(t => { %>
                                <tr style="background: #fffdf5;">
                                    <td><%= t.receivedDate ? new Date(t.receivedDate).toLocaleString('en-GB', { timeZone: 'Asia/Colombo' }) : new Date(t.dispatchedDate).toLocaleString('en-GB', { timeZone: 'Asia/Colombo' }) %></td>
                                    <td><span class="badge" style="background-color: var(--accent-yellow); color: #333;"><%= t.transferDocNo || 'N/A' %></span></td>
                                    <td><%= t.fromLocationName %></td>
                                    <td><%= t.vehicleNo || '-' %></td>
                                    <td><strong><%= t.dispatchedQty %></strong></td>
                                    <td><strong style="color: <%= t.variance < 0 ? '#dc2626' : '#d97706' %>;"><%= t.receivedQty %></strong></td>
                                    <td>
                                        <span class="badge" style="<%= t.variance < 0 ? 'background:#fee2e2; color:#b91c1c; border:1px solid #fca5a5;' : 'background:#fef3c7; color:#b45309; border:1px solid #fde68a;' %>">
                                            <%= t.variance > 0 ? '+' + t.variance : t.variance %> Trays
                                        </span>
                                    </td>
                                    <td style="font-style: italic; color: #334155;"><%= t.varianceReason || t.remarks || '-' %></td>
                                    <td><%= t.receivedBy || 'System' %></td>
                                    <td style="text-align: center;">
                                        <% if (user.username === 'admin' || user.role === 'admin' || (typeof hasPerm === 'function' && (hasPerm('receive_stock_approve') || hasPerm('grn_variance_direct_approve')))) { %>
                                            <button class="btn btn-receipt-action" style="background: #fef3c7; color: #b45309; border: 1px solid #fde68a;"
                                                data-id="<%= t.id %>"
                                                data-ref="<%= t.transferDocNo || 'N/A' %>"
                                                data-from="<%= t.fromLocationName %>"
                                                data-disp="<%= t.dispatchedQty %>"
                                                data-rec="<%= t.receivedQty %>"
                                                data-var="<%= t.variance %>"
                                                data-reason="<%= t.varianceReason || t.remarks || '' %>"
                                                data-veh="<%= t.vehicleNo || '-' %>"
                                                data-by="<%= t.receivedBy || 'System' %>"
                                                onclick="openReviewModalFromBtn(this)" title="Review & Action">
                                                <i class="fa-solid fa-clipboard-check"></i>
                                            </button>
                                        <% } else { %>
                                            <span class="badge" style="background: #f1f5f9; color: #64748b; font-size: 11px;">Pending Manager</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
            <% } %>

            <div class="content-box" style="margin-top: 25px; display: flex; flex-direction: column; gap: 15px;">
                <div class="box-header">
                    <span class="box-title"><i class="fa-solid fa-clock-rotate-left"></i> Received Transfer
                        History</span>
                </div>

                <!-- Date Filter Form -->
                <form action="/receive-stock" method="GET"
                    style="display: flex; gap: 15px; align-items: flex-end; background: var(--bg-light); padding: 15px; border-radius: 8px; border: 1px solid var(--border-light);">
                    <div style="display: flex; flex-direction: column; gap: 5px;">
                        <label for="startDate" style="font-size: 12px; font-weight: 600; color: var(--text-dark);">Start
                            Date</label>
                        <input type="date" id="startDate" name="startDate" value="<%= startDate %>"
                            style="padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 5px;">
                        <label for="endDate" style="font-size: 12px; font-weight: 600; color: var(--text-dark);">End
                            Date</label>
                        <input type="date" id="endDate" name="endDate" value="<%= endDate %>"
                            style="padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                    </div>
                    <button type="submit" class="btn btn-primary" style="padding: 8px 16px; height: 38px;">
                        <i class="fa-solid fa-filter"></i> Search
                    </button>
                    <a href="/receive-stock" class="btn btn-secondary"
                        style="padding: 8px 16px; height: 38px; text-decoration: none; display: flex; align-items: center; justify-content: center; background-color: #f1f3f5; color: #333;">
                        Clear
                    </a>
                </form>

                <div class="table-responsive">
                    <table id="receivedHistoryTable" class="compact-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Transfer No</th>
                                <th>GRN No</th>
                                <th>From</th>
                                <th>Vehicle No</th>
                                <th>Dispatched Qty</th>
                                <th>Received Qty</th>
                                <th>Variance</th>
                                <th>Status</th>
                                <th style="text-align: center; width: 130px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% const history = transfers.filter(t => (t.status === 'ACCEPTED' || t.status === 'REJECTED') && (user && user.locationId && user.locationId !== 'all' ? t.toLocationId === user.locationId : true)); %>
                                <% history.forEach(t=> { %>
                                            <tr>
                                                 <td>
                                                     <%= t.receivedDate ? new Date(t.receivedDate).toLocaleDateString('en-GB', { timeZone: 'Asia/Colombo' }) : new Date(t.dispatchedDate).toLocaleDateString('en-GB', { timeZone: 'Asia/Colombo' }) %>
                                                 </td>
                                                <td>
                                                    <%= t.transferDocNo || '-' %>
                                                </td>
                                                <td>
                                                    <%= t.grnNo || '-' %>
                                                </td>
                                                <td>
                                                    <%= t.fromLocationName %>
                                                </td>
                                                <td>
                                                    <%= t.vehicleNo || '-' %>
                                                </td>
                                                <td>
                                                    <%= t.dispatchedQty %>
                                                </td>
                                                <td>
                                                    <%= t.status==='REJECTED' ? '-' : t.receivedQty %>
                                                </td>
                                                <td>
                                                    <% if(t.variance !== 0) { %>
                                                        <span style="color: <%= t.variance < 0 ? '#d32f2f' : '#b45309' %>; font-weight: bold;">
                                                            <%= t.variance > 0 ? '+' + t.variance : t.variance %>
                                                        </span>
                                                        <% if (t.varianceApprovedBy) { %>
                                                            <div style="font-size: 10px; color: #166534; font-weight: 600;" title="Approved by <%= t.varianceApprovedBy %>">
                                                                <i class="fa-solid fa-circle-check"></i> Approved
                                                            </div>
                                                        <% } %>
                                                    <% } else { %>
                                                        0
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <% if (t.status==='ACCEPTED' ) { %>
                                                        <span class="badge"
                                                            style="background:#1b5e20; color:white; padding:4px 8px; font-size:11px;">ACCEPTED</span>
                                                        <% } else if (t.status==='REJECTED' ) { %>
                                                            <span class="badge"
                                                                style="background:#d32f2f; color:white; padding:4px 8px; font-size:11px;">REJECTED</span>
                                                            <% } else { %>
                                                                <span class="badge"
                                                                    style="background:var(--accent-yellow); color:#333; padding:4px 8px; font-size:11px;">PENDING</span>
                                                                <% } %>
                                                </td>
                                                <td style="text-align: center;">
                                                    <div style="display: flex; gap: 6px; justify-content: center; align-items: center; margin: 0 auto; width: fit-content;">
                                                        <a href="/transfers/<%= t._id || t.id %>/print-grn" target="_blank" class="btn btn-receipt-action" title="Print Goods Received Note (GRN)"><i class="fa-solid fa-print"></i></a>
                                                        <% if (user.username === 'admin' || user.role === 'admin' || (typeof hasPerm === 'function' && (hasPerm('receive_stock_backdate') || hasPerm('receive_stock_delete')))) { %>
                                                            <% if (t.status === 'ACCEPTED' && (user.username === 'admin' || user.role === 'admin' || (typeof hasPerm === 'function' && hasPerm('receive_stock_backdate')))) { %>
                                                                <button class="btn btn-action-edit" onclick="openBackdateGRNModal('<%= t._id || t.id %>', '<%= t.receivedDate || '' %>')" title="Backdate GRN"><i class="fa-solid fa-calendar-day"></i></button>
                                                            <% } %>
                                                            <% if (user.username === 'admin' || user.role === 'admin' || (typeof hasPerm === 'function' && hasPerm('receive_stock_delete'))) { %>
                                                                <button class="btn btn-action-delete" onclick="deleteTransfer('<%= t.id %>')" title="Delete Record"><i class="fa-solid fa-trash"></i></button>
                                                            <% } %>
                                                        <% } %>
                                                    </div>
                                                </td>
                                            </tr>
                                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <% if (user.username === 'admin' || user.role === 'admin' || (typeof hasPerm === 'function' && hasPerm('receive_stock_approve'))) { %>
            <!-- GRN Modal -->
            <div id="grnModal" class="modal"
                style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5);">
                <div class="modal-content"
                    style="background-color: #fefefe; margin: 8% auto; padding: 25px; border-radius: 12px; width: 90%; max-width: 420px; box-shadow: 0 10px 35px rgba(0,0,0,0.22); border-top: 5px solid var(--primary-green-dark);">
                    <div
                        style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; border-bottom: 2px solid var(--accent-yellow); padding-bottom: 10px;">
                        <h3 style="margin: 0; color: var(--primary-green-dark); font-size: 17px;"><i
                                class="fa-solid fa-boxes-packing"></i> Process GRN</h3>
                        <span onclick="document.getElementById('grnModal').style.display='none'"
                            style="color: #aaa; font-size: 26px; font-weight: bold; cursor: pointer;">&times;</span>
                    </div>

                    <form id="grnForm" method="POST" onsubmit="submitGRNForm(event)">
                        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; margin-bottom: 15px; font-size: 13px;">
                            <p style="margin: 3px 0;">Receiving from: <strong id="grnFromBranch" style="color: #1e293b;"></strong></p>
                            <p style="margin: 3px 0;">Transfer Ref No: <strong id="grnTransferRef" style="color: #1e293b;"></strong></p>
                            <p style="margin: 3px 0;">Dispatched Quantity: <strong id="grnExpectedQty" style="color: #166534; font-size: 14px;"></strong> Trays</p>
                        </div>

                        <div class="form-group">
                            <label style="font-weight: 700; font-size: 13px; color: #1e293b;">Actual Received Quantity <span style="color: #dc2626;">*</span></label>
                            <input type="number" id="grnReceivedQty" name="receivedQty" min="0" required oninput="checkGRNVariance()" style="width: 100%; padding: 8px 12px; font-size: 14px; border: 1.5px solid #cbd5e1; border-radius: 6px; box-sizing: border-box;">
                        </div>

                        <!-- Real-time Variance Alert Box -->
                        <div id="grnVarianceAlert" style="display: none; margin: 12px 0; padding: 10px 14px; border-radius: 8px; font-size: 12.5px; line-height: 1.4;">
                        </div>

                        <!-- Variance Reason Field (Mandatory when variance exists) -->
                        <div id="grnVarianceReasonGroup" class="form-group" style="display: none; margin-top: 12px;">
                            <label style="color: #b45309; font-weight: 700; font-size: 12.5px;">Variance Reason / Notes <span style="color: #dc2626;">*</span></label>
                            <textarea id="grnVarianceReason" name="varianceReason" rows="2" style="width: 100%; padding: 8px; border: 1.5px solid #fde68a; border-radius: 6px; font-size: 12.5px; box-sizing: border-box;" placeholder="Explain reason for discrepancy (e.g. broken in transit, short loaded)..."></textarea>
                        </div>

                        <input type="hidden" name="action" value="ACCEPT">

                        <% if (user.role === 'admin' || user.username === 'admin' || (typeof hasPerm === 'function' && hasPerm('receive_stock_backdate'))) { %>
                            <div class="form-group" style="margin-top: 15px;">
                                <label style="font-size: 12.5px; font-weight: 600;">Received Date & Time</label>
                                <input type="datetime-local" id="receivedDate" name="receivedDate" class="form-control" style="width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px; box-sizing: border-box;">
                                <small style="color: var(--text-light); font-size: 11px;">Leave empty for current time</small>
                            </div>
                        <% } %>

                        <button type="submit" id="btnSubmitGRN" class="btn btn-primary"
                            style="width: 100%; margin-top: 18px; padding: 10px; font-weight: 700; font-size: 13.5px; display: flex; align-items: center; justify-content: center; gap: 8px;">
                            <i class="fa-solid fa-check"></i> Submit GRN
                        </button>
                    </form>
                </div>
            </div>

            <!-- Review GRN Variance Modal (For Managers / Admins) -->
            <div id="reviewVarianceModal" class="modal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5);">
                <div class="modal-content" style="background-color: #fff; margin: 8% auto; padding: 25px; border-radius: 12px; width: 90%; max-width: 460px; box-shadow: 0 10px 35px rgba(0,0,0,0.22); border-top: 5px solid #f59e0b;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 2px solid #fde68a; padding-bottom: 10px;">
                        <h3 style="margin: 0; color: #b45309; font-size: 16px; display: flex; align-items: center; gap: 8px;">
                            <i class="fa-solid fa-triangle-exclamation" style="color: #f59e0b;"></i> Review GRN Discrepancy
                        </h3>
                        <span onclick="closeReviewVarianceModal()" style="color: #94a3b8; font-size: 24px; font-weight: bold; cursor: pointer;">&times;</span>
                    </div>

                    <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 12px 14px; margin-bottom: 16px; font-size: 12.5px;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                            <span style="color: #64748b;">Transfer Ref:</span>
                            <strong id="revTransferRef" style="color: #1e293b;"></strong>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                            <span style="color: #64748b;">From Branch:</span>
                            <strong id="revFromBranch" style="color: #1e293b;"></strong>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                            <span style="color: #64748b;">Vehicle No:</span>
                            <strong id="revVehicleNo" style="color: #1e293b;"></strong>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                            <span style="color: #64748b;">Submitted By:</span>
                            <strong id="revSubmittedBy" style="color: #1e293b;"></strong>
                        </div>
                        <hr style="border: 0; border-top: 1px dashed #fde68a; margin: 8px 0;">
                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; text-align: center; gap: 8px; margin-top: 8px;">
                            <div style="background: #fff; padding: 6px; border-radius: 6px; border: 1px solid #e2e8f0;">
                                <div style="font-size: 10px; color: #64748b; font-weight: 600;">DISPATCHED</div>
                                <div id="revDispatchedQty" style="font-size: 15px; font-weight: 800; color: #1e293b;"></div>
                            </div>
                            <div style="background: #fff; padding: 6px; border-radius: 6px; border: 1px solid #e2e8f0;">
                                <div style="font-size: 10px; color: #64748b; font-weight: 600;">RECEIVED</div>
                                <div id="revReceivedQty" style="font-size: 15px; font-weight: 800; color: #144d37;"></div>
                            </div>
                            <div id="revVarianceCard" style="background: #fee2e2; padding: 6px; border-radius: 6px; border: 1px solid #fca5a5;">
                                <div style="font-size: 10px; color: #b91c1c; font-weight: 600;">VARIANCE</div>
                                <div id="revVarianceQty" style="font-size: 15px; font-weight: 800; color: #b91c1c;"></div>
                            </div>
                        </div>
                        <div style="margin-top: 10px; padding: 8px; background: #fff; border-radius: 6px; border: 1px solid #e2e8f0;">
                            <div style="font-size: 10.5px; color: #64748b; font-weight: 600; margin-bottom: 2px;">REASON GIVEN BY RECEIVER:</div>
                            <div id="revReason" style="font-size: 12px; font-style: italic; color: #1e293b;"></div>
                        </div>
                    </div>

                    <div class="form-group" style="margin-bottom: 16px;">
                        <label style="font-size: 12px; font-weight: 700; color: #334155;">Manager Notes (Optional):</label>
                        <input type="text" id="revManagerNotes" class="form-control" style="width: 100%; padding: 8px; border: 1.5px solid #cbd5e1; border-radius: 6px; font-size: 12.5px; box-sizing: border-box;" placeholder="e.g. Verified with driver / stock loss acknowledged">
                    </div>

                    <input type="hidden" id="revTransferId">

                    <div style="display: flex; gap: 10px; margin-top: 10px;">
                        <button type="button" class="btn" onclick="submitApproveVariance()" style="flex: 1; background: #144d37; color: #fff; padding: 10px; border-radius: 6px; font-weight: 700; font-size: 12.5px; border: none; cursor: pointer;">
                            <i class="fa-solid fa-check"></i> Approve GRN
                        </button>
                        <button type="button" class="btn" onclick="submitRejectVariance()" style="flex: 1; background: #dc2626; color: #fff; padding: 10px; border-radius: 6px; font-weight: 700; font-size: 12.5px; border: none; cursor: pointer;">
                            <i class="fa-solid fa-rotate-left"></i> Reject & Recount
                        </button>
                    </div>
                </div>
            </div>
            <% } %>

            <script>
                function openGRNModal(transferId, expectedQty, fromBranch, transferDocNo) {
                    document.getElementById('grnFromBranch').innerText = fromBranch;
                    document.getElementById('grnExpectedQty').innerText = expectedQty;
                    document.getElementById('grnTransferRef').innerText = transferDocNo || 'N/A';
                    document.getElementById('grnReceivedQty').value = expectedQty;
                    document.getElementById('grnForm').action = '/transfers/' + transferId + '/grn';
                    
                    // Reset variance fields
                    const reasonGroup = document.getElementById('grnVarianceReasonGroup');
                    const alertBox = document.getElementById('grnVarianceAlert');
                    const reasonInput = document.getElementById('grnVarianceReason');
                    if (reasonGroup) reasonGroup.style.display = 'none';
                    if (alertBox) alertBox.style.display = 'none';
                    if (reasonInput) {
                        reasonInput.value = '';
                        reasonInput.required = false;
                    }

                    checkGRNVariance();
                    document.getElementById('grnModal').style.display = 'block';
                }

                function checkGRNVariance() {
                    const expectedEl = document.getElementById('grnExpectedQty');
                    const receivedEl = document.getElementById('grnReceivedQty');
                    const alertBox = document.getElementById('grnVarianceAlert');
                    const reasonGroup = document.getElementById('grnVarianceReasonGroup');
                    const reasonInput = document.getElementById('grnVarianceReason');
                    const btn = document.getElementById('btnSubmitGRN');

                    if (!expectedEl || !receivedEl || !btn) return;

                    const expected = parseInt(expectedEl.innerText, 10) || 0;
                    const receivedVal = receivedEl.value;
                    if (receivedVal === '') {
                        if (alertBox) alertBox.style.display = 'none';
                        if (reasonGroup) reasonGroup.style.display = 'none';
                        return;
                    }

                    const received = parseInt(receivedVal, 10);
                    const diff = received - expected;

                    if (diff === 0) {
                        if (alertBox) alertBox.style.display = 'none';
                        if (reasonGroup) reasonGroup.style.display = 'none';
                        if (reasonInput) reasonInput.required = false;

                        btn.style.background = '#144d37';
                        btn.style.borderColor = '#144d37';
                        btn.innerHTML = '<i class="fa-solid fa-check"></i> Submit GRN';
                    } else if (diff < 0) {
                        if (alertBox) {
                            alertBox.style.display = 'block';
                            alertBox.style.background = '#fee2e2';
                            alertBox.style.border = '1.5px solid #fca5a5';
                            alertBox.style.color = '#991b1b';
                            alertBox.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> <strong>Shortfall of ${Math.abs(diff)} Trays detected!</strong> Destination branch inventory will not be credited until a Manager reviews and approves this discrepancy.`;
                        }
                        if (reasonGroup) reasonGroup.style.display = 'block';
                        if (reasonInput) reasonInput.required = true;

                        btn.style.background = '#b45309';
                        btn.style.borderColor = '#b45309';
                        btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Submit for Manager Approval';
                    } else {
                        if (alertBox) {
                            alertBox.style.display = 'block';
                            alertBox.style.background = '#fef3c7';
                            alertBox.style.border = '1.5px solid #fde68a';
                            alertBox.style.color = '#92400e';
                            alertBox.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> <strong>Excess of +${diff} Trays detected!</strong> This transfer requires Manager Approval before adding extra stock to destination warehouse.`;
                        }
                        if (reasonGroup) reasonGroup.style.display = 'block';
                        if (reasonInput) reasonInput.required = true;

                        btn.style.background = '#b45309';
                        btn.style.borderColor = '#b45309';
                        btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Submit for Manager Approval';
                    }
                }

                async function submitGRNForm(event) {
                    event.preventDefault();
                    const form = document.getElementById('grnForm');
                    const submitBtn = document.getElementById('btnSubmitGRN');

                    const expectedQty = parseInt(document.getElementById('grnExpectedQty').innerText, 10);
                    const receivedQty = parseInt(document.getElementById('grnReceivedQty').value, 10);
                    const variance = receivedQty - expectedQty;

                    if (variance !== 0) {
                        const reason = document.getElementById('grnVarianceReason').value.trim();
                        if (!reason) {
                            Swal.fire('Variance Reason Required', 'Please provide an explanation / reason for the quantity discrepancy.', 'warning');
                            document.getElementById('grnVarianceReason').focus();
                            return;
                        }
                    }

                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Processing...';
                    }

                    try {
                        const formData = new FormData(form);
                        const data = Object.fromEntries(formData.entries());

                        const response = await fetch(form.action, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                            body: JSON.stringify(data)
                        });

                        const result = await response.json();

                        if (result.success) {
                            if (result.queued) {
                                Swal.fire({
                                    icon: 'info',
                                    title: 'Submitted for Manager Approval',
                                    html: `<b>${result.message}</b><br><br>The destination branch warehouse balance will not be updated until an authorized Manager reviews and approves this variance.`,
                                    confirmButtonColor: '#144d37'
                                }).then(() => {
                                    window.location.reload();
                                });
                            } else {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'GRN Processed',
                                    text: result.message || 'Stock successfully received and credited.',
                                    confirmButtonColor: '#144d37',
                                    timer: 1500
                                }).then(() => {
                                    window.location.reload();
                                });
                            }
                        } else {
                            Swal.fire('Error', result.error || 'Failed to process GRN', 'error');
                            if (submitBtn) {
                                submitBtn.disabled = false;
                                checkGRNVariance();
                            }
                        }
                    } catch (err) {
                        Swal.fire('Error', 'Network error occurred while submitting GRN', 'error');
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            checkGRNVariance();
                        }
                    }
                }

                function openReviewModalFromBtn(btn) {
                    const ds = btn.dataset;
                    openReviewVarianceModal(
                        ds.id,
                        ds.ref,
                        ds.from,
                        parseInt(ds.disp, 10),
                        parseInt(ds.rec, 10),
                        parseInt(ds.var, 10),
                        ds.reason,
                        ds.veh,
                        ds.by
                    );
                }

                function openReviewVarianceModal(id, refNo, fromBranch, dispQty, recQty, variance, reason, vehicleNo, submittedBy) {
                    document.getElementById('revTransferId').value = id;
                    document.getElementById('revTransferRef').innerText = refNo || 'N/A';
                    document.getElementById('revFromBranch').innerText = fromBranch || 'N/A';
                    document.getElementById('revVehicleNo').innerText = vehicleNo || 'N/A';
                    document.getElementById('revSubmittedBy').innerText = submittedBy || 'System';
                    document.getElementById('revDispatchedQty').innerText = dispQty;
                    document.getElementById('revReceivedQty').innerText = recQty;

                    const varCard = document.getElementById('revVarianceCard');
                    const varQty = document.getElementById('revVarianceQty');
                    if (variance < 0) {
                        varCard.style.background = '#fee2e2';
                        varCard.style.borderColor = '#fca5a5';
                        varQty.style.color = '#b91c1c';
                        varQty.innerText = `${variance} Trays`;
                    } else {
                        varCard.style.background = '#fef3c7';
                        varCard.style.borderColor = '#fde68a';
                        varQty.style.color = '#b45309';
                        varQty.innerText = `+${variance} Trays`;
                    }

                    document.getElementById('revReason').innerText = reason || 'No reason provided';
                    document.getElementById('revManagerNotes').value = '';
                    document.getElementById('reviewVarianceModal').style.display = 'block';
                }

                function closeReviewVarianceModal() {
                    const m = document.getElementById('reviewVarianceModal');
                    if (m) m.style.display = 'none';
                }

                async function submitApproveVariance() {
                    const id = document.getElementById('revTransferId').value;
                    const notes = document.getElementById('revManagerNotes').value.trim();

                    const confirmed = await Swal.fire({
                        title: 'Approve GRN with Variance?',
                        text: 'This will authorize the quantity discrepancy, credit received trays to destination warehouse stock, and generate the official GRN document.',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#144d37',
                        cancelButtonColor: '#64748b',
                        confirmButtonText: 'Yes, Approve GRN'
                    });

                    if (!confirmed.isConfirmed) return;

                    try {
                        const res = await fetch('/transfers/' + id + '/approve-variance', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                            body: JSON.stringify({ remarks: notes })
                        });
                        const data = await res.json();
                        if (data.success) {
                            Swal.fire('Approved!', data.message || 'GRN Variance approved successfully.', 'success').then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire('Error', data.error || 'Failed to approve variance', 'error');
                        }
                    } catch (e) {
                        Swal.fire('Error', 'Network error occurred', 'error');
                    }
                }

                async function submitRejectVariance() {
                    const id = document.getElementById('revTransferId').value;
                    const { value: reason } = await Swal.fire({
                        title: 'Reject & Request Physical Re-count',
                        input: 'textarea',
                        inputLabel: 'Rejection Reason / Instructions to Storekeeper:',
                        inputPlaceholder: 'e.g. Please physically re-count crate layers with driver...',
                        showCancelButton: true,
                        confirmButtonColor: '#dc2626',
                        confirmButtonText: 'Reject & Send Back',
                        inputValidator: (value) => {
                            if (!value) {
                                return 'You must enter a reason for returning the transfer for recount!';
                            }
                        }
                    });

                    if (!reason) return;

                    try {
                        const res = await fetch('/transfers/' + id + '/reject-variance', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                            body: JSON.stringify({ reason: reason })
                        });
                        const data = await res.json();
                        if (data.success) {
                            Swal.fire('Returned for Re-count', data.message || 'Transfer returned to incoming queue for re-counting.', 'info').then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire('Error', data.error || 'Failed to reject variance', 'error');
                        }
                    } catch (e) {
                        Swal.fire('Error', 'Network error occurred', 'error');
                    }
                }

                  function deleteTransfer(id) {
                      Swal.fire({
                          title: 'Are you sure?',
                          text: "This will permanently delete the transfer and revert stock balances. This cannot be undone!",
                          icon: 'warning',
                          showCancelButton: true,
                          confirmButtonColor: '#174e3e',
                          cancelButtonColor: '#757575',
                          confirmButtonText: 'Yes, delete it!'
                      }).then(async (result) => {
                          if (result.isConfirmed) {
                              try {
                                  const res = await fetch('/transfers/' + id, { method: 'DELETE' });
                                  const data = await res.json();
                                  if (data.success) {
                                      Swal.fire('Deleted!', 'Transfer has been deleted.', 'success').then(() => {
                                          window.location.reload();
                                      });
                                  } else {
                                      Swal.fire('Error!', data.error || 'Failed to delete transfer', 'error');
                                  }
                              } catch (err) {
                                  Swal.fire('Error!', 'Network error occurred.', 'error');
                              }
                          }
                      });
                  }

                  function openBackdateGRNModal(id, receivedDateStr) {
                      let formattedReceive = '';

                      try {
                          if (receivedDateStr && receivedDateStr !== 'undefined' && receivedDateStr !== 'null') {
                              const r = new Date(receivedDateStr);
                              if (!isNaN(r.getTime())) {
                                  formattedReceive = (new Date(r.getTime() - r.getTimezoneOffset() * 60000)).toISOString().slice(0, 16);
                              }
                          }
                      } catch (e) {}

                      Swal.fire({
                          title: 'Backdate Received (GRN) Date',
                          html: `
                              <div style="text-align: left; display: flex; flex-direction: column; gap: 10px; font-size: 14px;">
                                  <div>
                                      <label style="font-weight: bold; color: var(--primary-green-dark);">Received (GRN) Date & Time</label>
                                      <input type="datetime-local" id="swal-receive-date" class="swal2-input" value="${formattedReceive}" style="width: 90%; margin: 5px 0;">
                                  </div>
                              </div>
                          `,
                          showCancelButton: true,
                          confirmButtonText: '<i class="fa-solid fa-save"></i> Save Date',
                          confirmButtonColor: '#1b4d3e',
                          didOpen: () => {
                              const dateInput = document.getElementById('swal-receive-date');
                              if (dateInput && typeof flatpickr !== 'undefined') {
                                  try {
                                      const fp = flatpickr(dateInput, {
                                          enableTime: true,
                                          dateFormat: "Y-m-d\\TH:i",
                                          altInput: true,
                                          altFormat: "Y-m-d h:i K",
                                          time_24hr: false,
                                          allowInput: true,
                                          clickOpens: true
                                      });
                                      if (fp && fp.calendarContainer) {
                                          fp.calendarContainer.style.zIndex = '99999999';
                                      }
                                  } catch (e) {}
                              }
                          },
                          preConfirm: () => {
                              const rDate = document.getElementById('swal-receive-date').value;
                              return { receivedDate: rDate };
                          }
                      }).then(async (result) => {
                          if (result.isConfirmed) {
                              try {
                                  const res = await fetch('/transfers/' + id + '/backdate', {
                                      method: 'POST',
                                      headers: { 'Content-Type': 'application/json' },
                                      body: JSON.stringify(result.value)
                                  });
                                  const responseData = await res.json();
                                  if (responseData.success) {
                                      Swal.fire('Success', 'GRN date updated successfully', 'success').then(() => {
                                          window.location.reload();
                                      });
                                  } else {
                                      Swal.fire('Error', responseData.error || 'Update failed', 'error');
                                  }
                              } catch (err) {
                                  Swal.fire('Error', 'Network error', 'error');
                              }
                          }
                      });
                  }
            </script>

