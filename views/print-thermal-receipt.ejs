<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Receipt <%= tx.receiptNo ? 'RE-' + String(tx.receiptNo).padStart(6, '0') : 'RE' %></title>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, 'Courier New', monospace;
            color: #1f2937;
        }

        body {
            background-color: #f3f4f6;
            padding: 14px 8px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        /* Controls Section (Hidden on paper print) */
        .no-print {
            margin-bottom: 12px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            width: 100%;
            max-width: 380px;
        }

        .btn {
            padding: 12px 14px;
            font-size: 13px;
            font-weight: 700;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            text-align: center;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.12);
            transition: all 0.15s ease;
        }

        .btn-print {
            background-color: #107c41;
            color: #ffffff;
        }
        .btn-print:active { transform: scale(0.98); background-color: #0b5a2f; }

        .btn-back {
            background-color: #4b5563;
            color: #ffffff;
        }
        .btn-back:active { transform: scale(0.98); background-color: #374151; }

        .status-box {
            padding: 10px 12px;
            border-radius: 8px;
            font-size: 12px;
            line-height: 1.4;
            display: none;
            text-align: left;
        }
        .status-box.info { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }
        .status-box.success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; font-weight: bold; }
        .status-box.warning { background: #fffbeb; color: #92400e; border: 1px solid #fde68a; }
        .status-box.error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }

        /* Mobile App Receipt Card */
        .receipt-container {
            width: 100%;
            max-width: 380px;
            background: #ffffff;
            padding: 16px 14px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            border: 1px solid #e5e7eb;
            font-size: 12px;
            line-height: 1.4;
        }

        .text-center { text-align: center; }
        .text-right { text-align: right; }
        .text-bold { font-weight: 700; }
        
        .divider {
            border-top: 1px dashed #cbd5e1;
            margin: 8px 0;
        }

        .receipt-logo-img {
            height: 48px;
            width: auto;
            object-fit: contain;
            margin-bottom: 4px;
            display: inline-block;
        }

        .header-title {
            font-size: 13.5px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            line-height: 1.25;
            color: #174e3e;
        }

        .header-subtitle {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            color: #1f2937;
            margin-top: 2px;
        }

        .header-meta {
            font-size: 9.5px;
            color: #6b7280;
            text-transform: uppercase;
        }

        .row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 4px;
            font-size: 11.5px;
        }

        .row .label {
            color: #1b5e20;
            font-weight: 600;
        }

        .row .val {
            font-weight: 700;
            text-align: right;
            max-width: 65%;
            word-break: break-word;
        }

        .badge-out {
            display: inline-block;
            padding: 4px 10px;
            font-size: 12px;
            font-weight: 800;
            border-radius: 6px;
            background: #fffbeb;
            color: #b45309;
            border: 1.5px solid #f59e0b;
        }

        .badge-in {
            display: inline-block;
            padding: 4px 10px;
            font-size: 12px;
            font-weight: 800;
            border-radius: 6px;
            background: #f0fdf4;
            color: #15803d;
            border: 1.5px solid #22c55e;
        }

        .qty-box {
            border: 1.5px solid #1f2937;
            padding: 6px 4px;
            margin: 8px 0;
            text-align: center;
            border-radius: 6px;
            background: #f9fafb;
        }

        .qty-number {
            font-size: 20px;
            font-weight: 900;
            color: #111827;
        }

        .statement-box {
            margin: 8px 0;
            padding: 8px 10px;
            border-radius: 6px;
            font-size: 11px;
        }

        @media print {
            html, body {
                background: #ffffff !important;
                padding: 0 !important;
                margin: 0 !important;
                width: 100% !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            .no-print {
                display: none !important;
            }

            .receipt-container {
                width: 100% !important;
                max-width: 95mm !important;
                margin: 0 auto !important;
                box-shadow: none !important;
                border: none !important;
                padding: 2mm 8mm !important;
                font-size: 11.5pt !important;
            }

            .header-title {
                font-size: 14pt !important;
            }

            .header-subtitle {
                font-size: 11.5pt !important;
            }

            .header-meta {
                font-size: 10pt !important;
            }

            .row {
                width: 100% !important;
                display: flex !important;
                justify-content: space-between !important;
                align-items: flex-start !important;
                font-size: 11.5pt !important;
                margin-bottom: 4px !important;
            }

            .row .label {
                font-size: 11.5pt !important;
            }

            .row .val {
                font-size: 11.5pt !important;
            }

            .statement-box {
                width: 100% !important;
                box-sizing: border-box !important;
                font-size: 11pt !important;
            }

            .qty-box {
                width: 100% !important;
                box-sizing: border-box !important;
            }

            .qty-number {
                font-size: 22pt !important;
            }

            .receipt-logo-img {
                max-height: 42px !important;
                display: block !important;
                margin: 0 auto 4px auto !important;
            }

            @page {
                size: auto;
                margin: 1.5mm;
            }
        }
    </style>
</head>
<body>

    <!-- On-screen Action Controls -->
    <div class="no-print">
        <div style="display: flex; gap: 8px;">
            <a href="/driver" class="btn btn-back" style="flex: 1;" onclick="handleBackClick(event)">
                <i class="fa-solid fa-arrow-left"></i> ‹ Back
            </a>
            <button type="button" id="btPrintBtn" onclick="printViaBluetooth()" class="btn btn-print" style="flex: 1;">
                <i class="fa-solid fa-print"></i> Print
            </button>
        </div>

        <!-- Status Message Box -->
        <div id="btStatus" class="status-box"></div>
    </div>

    <% 
        var isOut = (tx && tx.type === 'OUT'); 
        var rate = Number(tx && tx.depositPerTray) || 2000; 
        var countQty = Number(tx && tx.count) || 0; 
        var totalTrayDeposit = Number(tx && tx.expectedDeposit) || (countQty * rate); 
        var paidAmt = 0; 
        if (tx && tx.totalDeposit !== undefined && tx.totalDeposit !== null && tx.totalDeposit !== '') { 
            paidAmt = Number(tx.totalDeposit); 
        } else if (tx && tx.depositOption === 'ZERO') { 
            paidAmt = 0; 
        } else if (tx && tx.depositOption === 'HALF') { 
            paidAmt = totalTrayDeposit / 2; 
        } else { 
            paidAmt = totalTrayDeposit; 
        } 
        var pendingAmt = totalTrayDeposit - paidAmt; 

        var modeText = 'Full Deposit (100%)';
        if (tx.depositOption === 'CUSTOM' || (paidAmt > 0 && paidAmt !== totalTrayDeposit && paidAmt !== totalTrayDeposit / 2)) {
            modeText = 'Custom';
        } else if (tx.depositOption === 'HALF' || (paidAmt === totalTrayDeposit / 2 && paidAmt > 0)) {
            modeText = 'Half Payment (50%)';
        } else if (tx.depositOption === 'ZERO' || paidAmt === 0) {
            modeText = 'No Deposit (0%)';
        }

        var custPendingDeposit = typeof totalCustomerPendingDeposit !== 'undefined' ? totalCustomerPendingDeposit : pendingAmt;
    %>

    <!-- Mobile App Receipt Card (System In & Out details formatted for Mobile) -->
    <div class="receipt-container">
        <!-- Header -->
        <div class="text-center" style="margin-bottom: 6px;">
            <img src="/images/logo.png" alt="Nelna Logo" class="receipt-logo-img">
            <div class="header-title"><%= (typeof settings !== 'undefined' && settings.companyName) ? settings.companyName : 'NELNA AGRI DEVELOPMENT (PVT) LTD' %></div>
            <div class="header-subtitle">Tray Transaction Receipt</div>
            <div class="header-meta">Store Operations Log / Route</div>
        </div>

        <div class="divider"></div>

        <!-- Meta Info -->
        <div class="row">
            <span style="color: #6b7280;">RECEIPT NO:</span>
            <span class="val text-bold">RE-<%= String(tx.receiptNo || 0).padStart(6, '0') %></span>
        </div>
        <div class="row">
            <span style="color: #6b7280;">CREATED:</span>
            <span class="val"><%= tx.user || 'Driver' %></span>
        </div>
        <div class="row">
            <span style="color: #6b7280;">DATE & TIME:</span>
            <span class="val"><%= new Date(tx.date).toLocaleDateString('en-GB') %> <%= new Date(tx.date).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
        </div>
        <div class="row">
            <span style="color: #6b7280;">VEHICLE NO:</span>
            <span class="val text-bold"><code><%= tx.vehicleNo || 'N/A' %></code></span>
        </div>

        <div class="divider"></div>

        <!-- Customer Info -->
        <div class="row">
            <span style="color: #6b7280;">CUSTOMER:</span>
            <span class="val text-bold"><%= customer ? customer.name : tx.customerName %></span>
        </div>
        <div class="row">
            <span style="color: #6b7280;">CONTACT:</span>
            <span class="val"><%= (customer && customer.phone) ? customer.phone : '-' %></span>
        </div>

        <div class="divider"></div>

        <!-- Transaction Type Badge -->
        <div class="text-center" style="margin: 6px 0;">
            <span class="<%= isOut ? 'badge-out' : 'badge-in' %>">
                <%= isOut ? '📤 TRAY ISSUE (OUT)' : '📥 TRAY RETURN (IN)' %>
            </span>
        </div>

        <!-- Quantity Highlight -->
        <div class="qty-box">
            <div style="font-size: 9.5px; text-transform: uppercase; color: #4b5563; font-weight: bold;">Tray Quantity</div>
            <div class="qty-number"><%= countQty %> TRAYS</div>
        </div>

        <!-- Exact System In & Out Receipt Fields -->
        <div class="row">
            <span class="label">Rate:</span>
            <span class="val">Rs. <%= rate.toLocaleString() %> / Tray</span>
        </div>
        <div class="row">
            <span class="label"><%= isOut ? 'Total Payable Amount:' : 'Total Refundable Amount:' %></span>
            <span class="val text-bold">Rs. <%= totalTrayDeposit.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %></span>
        </div>
        <div class="row">
            <span class="label"><%= isOut ? 'Deposit Amount:' : 'Refund Amount:' %></span>
            <span class="val text-bold" style="color: <%= isOut ? '#b45309' : '#15803d' %>; font-size: 13px;">Rs. <%= paidAmt.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %></span>
        </div>
        <div class="row">
            <span class="label"><%= isOut ? 'Pending Deposit Balance:' : 'Pending Refund Balance:' %></span>
            <span class="val text-bold" style="color: <%= pendingAmt > 0 ? '#dc2626' : '#15803d' %>;">
                Rs. <%= Math.abs(pendingAmt).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                <% if (pendingAmt === 0) { %><span style="font-size: 9.5px; font-weight: normal; color: #6b7280;">(Fully <%= isOut ? 'Paid' : 'Refunded' %>)</span><% } %>
            </span>
        </div>
        <div class="row">
            <span class="label">Payment Mode:</span>
            <span class="val"><%= modeText %></span>
        </div>
        <% if (tx.remarks) { %>
        <div class="row" style="margin-top: 3px;">
            <span class="label">Remarks:</span>
            <span class="val" style="font-style: italic;"><%= tx.remarks %></span>
        </div>
        <% } %>

        <!-- Deposit & Refund Statement Highlight Box -->
        <div class="statement-box" style="background-color: <%= isOut ? '#fffbea' : '#f0fdf4' %>; border: 1.5px solid <%= isOut ? '#f59e0b' : '#22c55e' %>;">
            <div style="font-size: 11px; font-weight: 700; color: #1f2937;">
                <%= isOut ? '🪙 Deposit Statement (Paid & Pending):' : '💵 Refund Statement (Paid & Pending):' %>
            </div>
            <div style="font-size: 10px; color: #4b5563; margin-top: 3px;">
                Total Value: <%= countQty %> Trays × Rs. <%= rate.toLocaleString() %> = <strong>Rs. <%= totalTrayDeposit.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %></strong>
            </div>
            <div style="font-size: 10.5px; margin-top: 2px; color: <%= pendingAmt > 0 ? '#dc2626' : '#15803d' %>; font-weight: bold;">
                <%= isOut ? 'Pending Unpaid Deposit' : 'Pending Unrefunded Balance' %>: Rs. <%= Math.abs(pendingAmt).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 5px; padding-top: 4px; border-top: 1px dashed <%= isOut ? '#f59e0b' : '#22c55e' %>;">
                <span style="font-size: 9.5px; font-weight: bold; text-transform: uppercase; color: #6b7280;"><%= isOut ? 'Paid Amount:' : 'Refunded Amount:' %></span>
                <span style="font-size: 15px; font-weight: 900; color: <%= isOut ? '#b45309' : '#15803d' %>;">Rs. <%= paidAmt.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %></span>
            </div>
        </div>

        <!-- Customer Outstanding Net Balance Box -->
        <div style="background: #f9fafb; border: 1px solid #e5e7eb; padding: 6px 8px; text-align: center; margin: 6px 0; border-radius: 6px;">
            <div>
                <span style="font-size: 10px; font-weight: bold; text-transform: uppercase; color: #4b5563;">Customer Net Tray Balance: </span>
                <strong style="font-size: 12px; color: <%= (customer && customer.currentBalance > 0) ? '#dc2626' : '#15803d' %>;"><%= customer ? customer.currentBalance : 0 %> Trays Outstanding</strong>
            </div>
            <div style="margin-top: 2px;">
                <span style="font-size: 10px; font-weight: bold; text-transform: uppercase; color: #4b5563;">Pending Deposit Balance: </span>
                <strong style="font-size: 12px; color: <%= custPendingDeposit > 0 ? '#dc2626' : '#15803d' %>;">Rs. <%= custPendingDeposit.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %></strong>
            </div>
        </div>

        <!-- 3 Signature Lines (Identical to System Receipt) -->
        <div style="margin-top: 65px; padding-top: 4px;">
            <div style="display: flex; justify-content: space-between; text-align: center; font-size: 9.5px; color: #4b5563;">
                <div style="border-top: 1px dotted #9ca3af; width: 30%; padding-top: 3px;">Created By</div>
                <div style="border-top: 1px dotted #9ca3af; width: 30%; padding-top: 3px;">Checked By</div>
                <div style="border-top: 1px dotted #9ca3af; width: 30%; padding-top: 3px;">Received By</div>
            </div>
        </div>

        <div class="divider" style="margin-top: 12px;"></div>

        <!-- Footer -->
        <div class="text-center" style="font-size: 10px; line-height: 1.3; color: #6b7280;">
            <div style="font-weight: bold; color: #174e3e;">*** THANK YOU! ***</div>
        </div>
    </div>

    <script>
        const txData = <%- JSON.stringify(tx) %>;
        const customerData = <%- JSON.stringify(customer) %>;
        const settingsData = <%- JSON.stringify(settings || {}) %>;
        const totalPendingDepositVal = <%= custPendingDeposit %>;

        // Generate Standard ESC/POS Thermal Command Buffer (Configured for 110mm Thermal Paper)
        function generateEscPosCommands() {
            const encoder = new TextEncoder();
            const parts = [];

            function text(str) {
                parts.push(encoder.encode(str));
            }
            function cmd(bytes) {
                parts.push(new Uint8Array(bytes));
            }

            // On 110mm paper (832 dots / ~69 columns printable width):
            // Center the 44-character receipt block with 12 spaces on left and 13 on right
            const sideMargin = 12;
            const innerWidth = 44;
            const padLeft = ' '.repeat(sideMargin);

            // Helper to format two-column key-value lines centered on 110mm roll
            function formatLine(left, right, width = innerWidth) {
                left = String(left || '');
                right = String(right || '');
                const spaces = width - left.length - right.length;
                let lineStr = '';
                if (spaces > 0) {
                    lineStr = left + ' '.repeat(spaces) + right;
                } else {
                    const avail = width - right.length - 1;
                    if (avail > 2) {
                        lineStr = left.substring(0, avail) + ' ' + right;
                    } else {
                        lineStr = left + '\n' + padLeft + ' '.repeat(Math.max(0, width - right.length)) + right;
                    }
                }
                return padLeft + lineStr + '\n';
            }

            const divider = padLeft + "-".repeat(innerWidth) + "\n";
            const countQty = Number(txData.count) || 0;

            // 1. Initialize Printer (ESC @)
            cmd([0x1B, 0x40]);

            // Select Font A (12x24 dots per char)
            cmd([0x1B, 0x4D, 0x00]);

            // Set left margin to 0 (GS L 0 0)
            cmd([0x1D, 0x4C, 0x00, 0x00]);

            // Set printable area width to 832 dots (110mm width: 0x0340)
            cmd([0x1D, 0x57, 0x40, 0x03]);

            // Select standard line spacing (1/6 inch)
            cmd([0x1B, 0x32]);

            // 2. Company Header (Centered across 110mm roll)
            cmd([0x1B, 0x61, 0x01]); // Center align
            cmd([0x1B, 0x45, 0x01]); // Bold on
            const compName = settingsData.companyName || "NELNA AGRI DEVELOPMENT (PVT) LTD";
            text(compName + "\n");
            cmd([0x1B, 0x45, 0x00]); // Bold off
            text("TRAY TRANSACTION RECEIPT\n");
            text("Store Operations Log / Route\n");
            cmd([0x1B, 0x61, 0x00]); // Left align for divider & details
            text(divider);

            // 3. Receipt Details (Centered with balanced side margins)
            cmd([0x1B, 0x61, 0x00]); // Left align
            text(formatLine("REC NO:", "RE-" + String(txData.receiptNo || 0).padStart(6, '0')));
            const d = new Date(txData.date);
            const dateStr = d.toLocaleDateString('en-GB') + " " + d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            text(formatLine("DATE:", dateStr));
            text(formatLine("VEHICLE:", txData.vehicleNo || 'N/A'));
            if (txData.user) text(formatLine("CREATED:", txData.user));
            text(divider);
            
            // Customer Info
            const custName = customerData.name || txData.customerName || '';
            const maxCustLen = innerWidth - 11;
            if (custName.length <= maxCustLen) {
                text(formatLine("CUSTOMER:", custName));
            } else {
                text(padLeft + "CUSTOMER: " + custName + "\n");
            }
            if (customerData.phone) text(formatLine("CONTACT:", customerData.phone));
            text(divider);

            // 4. Type & Large Quantity (Center Align)
            cmd([0x1B, 0x61, 0x01]);
            cmd([0x1B, 0x45, 0x01]);
            if (txData.type === 'OUT') {
                text(">>> TRAY ISSUE (OUT) >>>\n");
            } else {
                text("<<< TRAY RETURN (IN) <<<\n");
            }
            // Double width & height for tray count
            cmd([0x1D, 0x21, 0x11]);
            text(countQty + " TRAYS\n");
            cmd([0x1D, 0x21, 0x00]); // Reset to normal size
            cmd([0x1B, 0x45, 0x00]); // Bold off
            cmd([0x1B, 0x61, 0x00]);
            text(divider);

            // 5. System Financial Details (Centered with balanced side margins)
            cmd([0x1B, 0x61, 0x00]);
            const rate = Number(txData.depositPerTray) || 2000;
            const expected = Number(txData.expectedDeposit) || (countQty * rate);
            let paid = 0;
            if (txData.totalDeposit !== undefined && txData.totalDeposit !== null && txData.totalDeposit !== '') {
                paid = Number(txData.totalDeposit);
            } else if (txData.depositOption === 'ZERO') {
                paid = 0;
            } else if (txData.depositOption === 'HALF') {
                paid = expected / 2;
            } else {
                paid = expected;
            }
            const pending = expected - paid;

            text(formatLine("Rate:", "Rs. " + rate.toLocaleString() + "/Tray"));
            const totLabel = txData.type === 'OUT' ? "Total Payable:" : "Total Refund:";
            text(formatLine(totLabel, "Rs. " + expected.toLocaleString('en-US', { minimumFractionDigits: 2 })));
            const depLabel = txData.type === 'OUT' ? "Deposit Paid:" : "Refund Paid:";
            text(formatLine(depLabel, "Rs. " + paid.toLocaleString('en-US', { minimumFractionDigits: 2 })));
            const pendLabel = txData.type === 'OUT' ? "Pending Dep:" : "Pending Ref:";
            text(formatLine(pendLabel, "Rs. " + Math.abs(pending).toLocaleString('en-US', { minimumFractionDigits: 2 })));
            text(formatLine("Payment Mode:", txData.depositOption || 'FULL'));

            if (txData.remarks) {
                text(formatLine("Remarks:", txData.remarks));
            }

            text(divider);

            // 6. Statement Box (Centered title, balanced rows)
            cmd([0x1B, 0x61, 0x01]);
            cmd([0x1B, 0x45, 0x01]);
            text("DEPOSIT/REFUND STATEMENT\n");
            cmd([0x1B, 0x45, 0x00]);
            cmd([0x1B, 0x61, 0x00]);
            text(formatLine("Total Value:", "Rs. " + expected.toLocaleString('en-US', { minimumFractionDigits: 2 })));
            text(formatLine("Paid Amount:", "Rs. " + paid.toLocaleString('en-US', { minimumFractionDigits: 2 })));
            text(formatLine("Pending Dep:", "Rs. " + Math.abs(pending).toLocaleString('en-US', { minimumFractionDigits: 2 })));
            text(divider);

            // 7. Customer Net Balance (Centered title, balanced rows)
            cmd([0x1B, 0x61, 0x01]);
            cmd([0x1B, 0x45, 0x01]);
            text("CUSTOMER OUTSTANDING\n");
            cmd([0x1B, 0x45, 0x00]);
            cmd([0x1B, 0x61, 0x00]);
            text(formatLine("Net Tray Bal:", (customerData.currentBalance || 0) + " TRAYS"));
            text(formatLine("Pending Dep:", "Rs. " + totalPendingDepositVal.toLocaleString('en-US', { minimumFractionDigits: 2 })));
            text(divider);

            // 8. Signatures & Footer (Dotted lines on top, labels below - with ample vertical signing room)
            cmd([0x1B, 0x61, 0x00]);
            text("\n\n\n\n\n\n");
            text(padLeft + "  ..........     ..........     ..........  \n");
            text(padLeft + "  Created By     Checked By    Received By  \n");
            text(divider);
            cmd([0x1B, 0x61, 0x01]);
            text("*** THANK YOU! ***\n");

            // 9. Paper Feed lines
            cmd([0x1B, 0x64, 0x04]);

            // Combine all Uint8Array parts
            const totalLen = parts.reduce((acc, p) => acc + p.length, 0);
            const combined = new Uint8Array(totalLen);
            let offset = 0;
            for (const p of parts) {
                combined.set(p, offset);
                offset += p.length;
            }
            return combined;
        }

        const BLE_SERVICES = [
            '000018f0-0000-1000-8000-00805f9b34fb',
            'e7810a71-73ae-499d-8c15-faa9aef0c3f2',
            '49535343-fe7d-4ae5-8fa9-9fafd205e455',
            '0000ff00-0000-1000-8000-00805f9b34fb',
            '0000fee7-0000-1000-8000-00805f9b34fb',
            '0000ae00-0000-1000-8000-00805f9b34fb',
            '0000af00-0000-1000-8000-00805f9b34fb',
            '0000ffe0-0000-1000-8000-00805f9b34fb',
            '0000fff0-0000-1000-8000-00805f9b34fb',
            '0000ffe5-0000-1000-8000-00805f9b34fb'
        ];

        // Handle Back button click (closes modal if inside iframe)
        function handleBackClick(e) {
            if (window.parent && window.parent !== window && typeof window.parent.closeReceiptPreviewModal === 'function') {
                e.preventDefault();
                window.parent.closeReceiptPreviewModal();
            }
        }

        // Web Bluetooth Direct Connect & Print
        async function printViaBluetooth() {
            const statusBox = document.getElementById('btStatus');
            statusBox.style.display = 'block';
            statusBox.className = 'status-box info';
            statusBox.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Bluetooth Printers සොයමින් පවතී...';

            // 1. If running inside the Driver Portal modal, print via parent window's active Bluetooth connection
            if (window.parent && window.parent !== window && typeof window.parent.printViaConnectedBluetooth === 'function') {
                try {
                    const printerName = localStorage.getItem('savedBluetoothPrinterName') || 'Printer';
                    statusBox.innerHTML = `<i class="fa-solid fa-print fa-bounce"></i> <strong>${printerName}</strong> වෙතින් රිසිට්පත මුද්‍රණය වෙමින් පවතී...`;
                    const rawData = generateEscPosCommands();
                    await window.parent.printViaConnectedBluetooth(rawData);
                    statusBox.className = 'status-box success';
                    statusBox.innerHTML = `<i class="fa-solid fa-circle-check"></i> <strong>${printerName}</strong> වෙතින් රිසිට්පත සාර්ථකව මුද්‍රණය විය!`;
                    return;
                } catch (parentErr) {
                    console.warn('Parent print failed, trying local connection:', parentErr);
                    // Fall through to local connection
                }
            }

            if (!navigator.bluetooth) {
                statusBox.className = 'status-box warning';
                statusBox.innerHTML = '<i class="fa-solid fa-circle-info"></i> මෙම Browser එකෙහි Web Bluetooth සහය නොදක්වන බැවින් System Print විවෘත වේ...';
                setTimeout(() => { window.print(); }, 400);
                return;
            }

            try {
                let device = null;
                const savedId = localStorage.getItem('savedBluetoothPrinterId');
                const savedName = localStorage.getItem('savedBluetoothPrinterName');

                // 1. If saved printer exists, try to reuse permitted device without opening chooser
                if (savedId && navigator.bluetooth.getDevices) {
                    try {
                        const permittedDevices = await navigator.bluetooth.getDevices();
                        device = permittedDevices.find(d => d.id === savedId) || null;
                        if (device) {
                            statusBox.innerHTML = `<i class="fa-solid fa-link fa-spin"></i> සුරකින ලද <strong>${device.name || savedName}</strong> වෙත සෘජුව සම්බන්ධ වෙමින් පවතී...`;
                        }
                    } catch (e) {
                        console.log('Permitted device lookup note:', e);
                    }
                }

                // 2. If not permitted yet or not found, open Bluetooth chooser dialog
                if (!device) {
                    device = await navigator.bluetooth.requestDevice({
                        acceptAllDevices: true,
                        optionalServices: BLE_SERVICES
                    });
                    localStorage.setItem('savedBluetoothPrinterId', device.id);
                    localStorage.setItem('savedBluetoothPrinterName', device.name || 'Printer');
                }

                statusBox.innerHTML = `<i class="fa-solid fa-link"></i> <strong>${device.name || 'Printer'}</strong> වෙත සම්බන්ධ වෙමින් පවතී...`;

                let server = null;
                try {
                    server = await device.gatt.connect();
                } catch (connErr) {
                    console.warn('Direct connect to device failed, prompting picker:', connErr);
                    device = await navigator.bluetooth.requestDevice({
                        acceptAllDevices: true,
                        optionalServices: BLE_SERVICES
                    });
                    localStorage.setItem('savedBluetoothPrinterId', device.id);
                    localStorage.setItem('savedBluetoothPrinterName', device.name || 'Printer');
                    statusBox.innerHTML = `<i class="fa-solid fa-link"></i> <strong>${device.name || 'Printer'}</strong> වෙත සම්බන්ධ වෙමින් පවතී...`;
                    server = await device.gatt.connect();
                }

                // Find writable characteristic in all primary services
                const services = await server.getPrimaryServices();
                let writeChar = null;

                for (const service of services) {
                    try {
                        const chars = await service.getCharacteristics();
                        for (const c of chars) {
                            if (c.properties.write || c.properties.writeWithoutResponse) {
                                writeChar = c;
                                break;
                            }
                        }
                        if (writeChar) break;
                    } catch (e) {
                        // Scan other services
                    }
                }

                if (!writeChar) {
                    throw new Error('තෝරාගත් Printer එකෙහි Data Write Characteristic හමු නොවීය. කරුණාකර System Print භාවිතා කරන්න.');
                }

                statusBox.innerHTML = `<i class="fa-solid fa-print fa-bounce"></i> <strong>${device.name || 'Printer'}</strong> වෙතින් රිසිට්පත මුද්‍රණය වෙමින් පවතී...`;

                const rawData = generateEscPosCommands();

                // Send data in chunks of 100 bytes for BLE MTU safety
                const CHUNK_SIZE = 100;
                for (let i = 0; i < rawData.length; i += CHUNK_SIZE) {
                    const chunk = rawData.slice(i, i + CHUNK_SIZE);
                    if (writeChar.properties.writeWithoutResponse) {
                        await writeChar.writeValueWithoutResponse(chunk);
                    } else {
                        await writeChar.writeValue(chunk);
                    }
                    await new Promise(r => setTimeout(r, 35));
                }

                statusBox.className = 'status-box success';
                statusBox.innerHTML = `<i class="fa-solid fa-circle-check"></i> <strong>${device.name || 'Printer'}</strong> වෙතින් රිසිට්පත සාර්ථකව මුද්‍රණය විය!`;

                // Do not disconnect! Keep connected for next print!

            } catch (err) {
                if (err.name === 'NotFoundError') {
                    statusBox.className = 'status-box warning';
                    statusBox.innerHTML = '<i class="fa-solid fa-ban"></i> Printer තේරීම අවලංගු කරන ලදී (Cancelled).';
                } else {
                    console.error('Bluetooth Print Error:', err);
                    statusBox.className = 'status-box error';
                    statusBox.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> Bluetooth දෝෂයකි: ${err.message}.<br>කරුණාකර <strong>System Print</strong> භාවිතා කරන්න.`;
                    setTimeout(() => { window.print(); }, 1200);
                }
            }
        }

        // On receipt load: show detected saved printer notice & trigger autoprint if requested
        document.addEventListener('DOMContentLoaded', function() {
            const savedName = localStorage.getItem('savedBluetoothPrinterName');
            const statusBox = document.getElementById('btStatus');
            if (savedName && statusBox) {
                statusBox.style.display = 'block';
                statusBox.className = 'status-box info';
                statusBox.innerHTML = `<i class="fa-solid fa-print"></i> සුරකින ලද ප්‍රින්ටරය: <strong>${savedName}</strong>`;
            }

            if (window.location.search.includes('autoprint=1')) {
                setTimeout(() => {
                    printViaBluetooth();
                }, 400);
            }
        });
    </script>
</body>
</html>
