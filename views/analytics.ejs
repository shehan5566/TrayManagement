<%- include('partials/header') %>

    <div class="content-header" style="margin-bottom: 24px;">
        <div>
            <h2
                style="font-size: 26px; font-weight: 700; color: var(--text-dark); margin: 0; display: flex; align-items: center; gap: 12px;">
                <i class="fa-solid fa-chart-pie" style="color: var(--primary-green);"></i> Advanced Analytics &
                Forecasting
            </h2>
            <p style="color: var(--text-light); margin: 4px 0 0 0; font-size: 14px;">
                AI-driven tray return velocity scores, branch stock utilization heatmaps, and predictive demand
                analytics.
            </p>
        </div>
    </div>

    <!-- Key Analytics Cards -->
    <div class="metrics-grid"
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 28px;">
        <div class="card metric-card" style="border-left: 4px solid #f59e0b;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <span
                        style="font-size: 13px; font-weight: 600; color: var(--text-light); text-transform: uppercase;">Outstanding
                        Trays</span>
                    <h3 style="font-size: 28px; font-weight: 800; color: var(--text-dark); margin: 8px 0 0 0;">
                        <%= totalOutstanding.toLocaleString() %>
                    </h3>
                    <span style="font-size: 12px; color: #f59e0b; font-weight: 600;">Trays held by customers</span>
                </div>
                <div
                    style="width: 44px; height: 44px; border-radius: 12px; background: rgba(245, 158, 11, 0.15); display: flex; align-items: center; justify-content: center; color: #f59e0b; font-size: 20px;">
                    <i class="fa-solid fa-boxes-stacked"></i>
                </div>
            </div>
        </div>

        <div class="card metric-card" style="border-left: 4px solid #10b981;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <span
                        style="font-size: 13px; font-weight: 600; color: var(--text-light); text-transform: uppercase;">Return
                        Velocity Score</span>
                    <h3 style="font-size: 28px; font-weight: 800; color: var(--text-dark); margin: 8px 0 0 0;">
                        <%= returnVelocity %>%
                    </h3>
                    <span style="font-size: 12px; color: #10b981; font-weight: 600;"><i
                            class="fa-solid fa-arrow-trend-up"></i> Return speed efficiency</span>
                </div>
                <div
                    style="width: 44px; height: 44px; border-radius: 12px; background: rgba(16, 185, 129, 0.15); display: flex; align-items: center; justify-content: center; color: #10b981; font-size: 20px;">
                    <i class="fa-solid fa-bolt"></i>
                </div>
            </div>
        </div>

        <div class="card metric-card" style="border-left: 4px solid #f59e0b;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <span
                        style="font-size: 13px; font-weight: 600; color: var(--text-light); text-transform: uppercase;">Total
                        Trays Issued</span>
                    <h3 style="font-size: 28px; font-weight: 800; color: var(--text-dark); margin: 8px 0 0 0;">
                        <%= totalOut.toLocaleString() %>
                    </h3>
                    <span style="font-size: 12px; color: #f59e0b; font-weight: 600;">Outward transactions</span>
                </div>
                <div
                    style="width: 44px; height: 44px; border-radius: 12px; background: rgba(245, 158, 11, 0.15); display: flex; align-items: center; justify-content: center; color: #f59e0b; font-size: 20px;">
                    <i class="fa-solid fa-truck-ramp-box"></i>
                </div>
            </div>
        </div>

        <div class="card metric-card" style="border-left: 4px solid #10b981;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <span
                        style="font-size: 13px; font-weight: 600; color: var(--text-light); text-transform: uppercase;">Total
                        Trays Returned</span>
                    <h3 style="font-size: 28px; font-weight: 800; color: var(--text-dark); margin: 8px 0 0 0;">
                        <%= totalIn.toLocaleString() %>
                    </h3>
                    <span style="font-size: 12px; color: #10b981; font-weight: 600;">Inward receipts</span>
                </div>
                <div
                    style="width: 44px; height: 44px; border-radius: 12px; background: rgba(16, 185, 129, 0.15); display: flex; align-items: center; justify-content: center; color: #10b981; font-size: 20px;">
                    <i class="fa-solid fa-rotate-left"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Predictive Insight Alert Banner -->
    <div class="card"
        style="padding: 20px 24px; margin-bottom: 28px; background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(59, 130, 246, 0.12)); border: 1px solid rgba(16, 185, 129, 0.3);">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div
                style="width: 48px; height: 48px; border-radius: 14px; background: var(--primary-green); color: white; display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
            </div>
            <div>
                <h4 style="margin: 0; font-size: 16px; font-weight: 700; color: var(--text-dark);">
                    Stock Forecast
                </h4>
                <p style="margin: 4px 0 0 0; font-size: 14px; color: var(--text-light);">
                    Based on current dispatch trends, estimated tray requirement for next month is <strong>
                        <%= Math.round((totalOut || 1000) * 1.12).toLocaleString() %> Trays
                    </strong> (+12% growth). Recommended to maintain a safety buffer of at least <strong>
                        <%= Math.round((totalOut || 1000) * 0.2).toLocaleString() %> Trays
                    </strong> across main distribution branches.
                </p>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 24px; margin-bottom: 28px;">
        <!-- Branch Stock Heatmap Chart -->
        <div class="card" style="padding: 24px;">
            <h3 style="font-size: 16px; font-weight: 700; color: var(--text-dark); margin: 0 0 16px 0;">
                <i class="fa-solid fa-location-dot" style="color: #f59e0b; margin-right: 8px;"></i> Branch Stock
                Distribution
            </h3>
            <div style="position: relative; height: 260px;">
                <canvas id="branchStockChart"></canvas>
            </div>
        </div>

        <!-- Circulation Comparison Chart -->
        <div class="card" style="padding: 24px;">
            <h3 style="font-size: 16px; font-weight: 700; color: var(--text-dark); margin: 0 0 16px 0;">
                <i class="fa-solid fa-right-left" style="color: var(--primary-green); margin-right: 8px;"></i> Inward vs
                Outward Circulation
            </h3>
            <div style="position: relative; height: 260px;">
                <canvas id="circulationChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Branch Utilization Breakdown Table -->
    <div class="card" style="padding: 24px;">
        <h3 style="font-size: 18px; font-weight: 700; color: var(--text-dark); margin: 0 0 16px 0;">
            <i class="fa-solid fa-table-cells" style="color: var(--primary-green); margin-right: 8px;"></i> Branch Utilization
            Breakdown
        </h3>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Branch Name</th>
                        <th>Current Stock</th>
                        <th>Transactions Recorded</th>
                        <th>Utilization Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% branchStats.forEach(b=> { %>
                        <tr>
                            <td style="font-weight: 700; color: var(--text-dark);">
                                <%= b.name %>
                            </td>
                            <td style="font-weight: 800; color: var(--primary-green); font-size: 15px;">
                                <%= b.stock.toLocaleString() %> Trays
                            </td>
                            <td>
                                <%= b.txCount %> Transactions
                            </td>
                            <td>
                                <% if (b.stock> 1000) { %>
                                    <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981;"><i
                                            class="fa-solid fa-circle-check"></i> HIGH CAPACITY</span>
                                    <% } else if (b.stock> 200) { %>
                                        <span class="badge"
                                            style="background: rgba(59, 130, 246, 0.15); color: #3b82f6;"><i
                                                class="fa-solid fa-circle-info"></i> OPTIMAL</span>
                                        <% } else { %>
                                            <span class="badge"
                                                style="background: rgba(239, 68, 68, 0.15); color: #ef4444;"><i
                                                    class="fa-solid fa-triangle-exclamation"></i> LOW STOCK</span>
                                            <% } %>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const branchNames = <%- JSON.stringify(branchStats.map(b => b.name)) %>;
            const branchStocks = <%- JSON.stringify(branchStats.map(b => b.stock)) %>;

            // Branch Stock Chart
            const ctx1 = document.getElementById('branchStockChart').getContext('2d');
            new Chart(ctx1, {
                type: 'bar',
                data: {
                    labels: branchNames,
                    datasets: [{
                        label: 'Available Stock',
                        data: branchStocks,
                        backgroundColor: 'rgba(23, 78, 62, 0.85)',
                        borderColor: '#174e3e',
                        borderWidth: 2,
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });

            // Circulation Doughnut Chart (Green & Yellow Theme with Percentages)
            const ctx2 = document.getElementById('circulationChart').getContext('2d');
            
            // Custom Plugin to draw percentage text directly on chart slices
            const doughnutPercentagesPlugin = {
                id: 'doughnutPercentages',
                afterDraw(chart) {
                    const { ctx, data } = chart;
                    const total = data.datasets[0].data.reduce((a, b) => Number(a) + Number(b), 0);
                    if (total <= 0) return;

                    chart.getDatasetMeta(0).data.forEach((datapoint, index) => {
                        const val = data.datasets[0].data[index];
                        if (!val || val <= 0) return;
                        const percentage = ((val / total) * 100).toFixed(1) + '%';
                        
                        const { x, y } = datapoint.tooltipPosition();
                        ctx.save();
                        ctx.fillStyle = '#ffffff';
                        ctx.font = 'bold 12px sans-serif';
                        ctx.textAlign = 'center';
                        ctx.textBaseline = 'middle';
                        ctx.shadowColor = 'rgba(0, 0, 0, 0.6)';
                        ctx.shadowBlur = 4;
                        ctx.fillText(percentage, x, y);
                        ctx.restore();
                    });
                }
            };

            new Chart(ctx2, {
                type: 'doughnut',
                data: {
                    labels: ['Trays Returned (IN)', 'Trays Issued (OUT)', 'Outstanding with Customers'],
                    datasets: [{
                        data: [<%= totalIn %>, <%= totalOut %>, <%= totalOutstanding %>],
                        backgroundColor: ['#10b981', '#f59e0b', '#174e3e'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                plugins: [doughnutPercentagesPlugin],
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                boxWidth: 12,
                                padding: 14,
                                font: { size: 12, weight: '600' },
                                generateLabels: function(chart) {
                                    const data = chart.data;
                                    if (data.labels.length && data.datasets.length) {
                                        const dataset = data.datasets[0];
                                        const total = dataset.data.reduce((a, b) => Number(a) + Number(b), 0);
                                        return data.labels.map(function(label, i) {
                                            const val = dataset.data[i] || 0;
                                            const pct = total > 0 ? ((val / total) * 100).toFixed(1) : 0;
                                            const style = chart.getDatasetMeta(0).controller.getStyle(i);
                                            return {
                                                text: `${label} (${pct}%)`,
                                                fillStyle: style.backgroundColor,
                                                strokeStyle: style.borderColor,
                                                lineWidth: style.borderWidth,
                                                hidden: !chart.isDatasetVisible(0) || chart.getDatasetMeta(0).data[i].hidden,
                                                index: i
                                            };
                                        });
                                    }
                                    return [];
                                }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const label = context.label || '';
                                    const value = context.raw || 0;
                                    const total = context.chart.data.datasets[0].data.reduce((a, b) => Number(a) + Number(b), 0);
                                    const pct = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                    return ` ${label}: ${value.toLocaleString()} Trays (${pct}%)`;
                                }
                            }
                        }
                    },
                    cutout: '60%'
                }
            });
        });
    </script>

    <%- include('partials/footer') %>