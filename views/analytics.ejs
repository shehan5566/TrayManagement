    <!-- Reconciliation Sheet Scripts -->
    <script>
        function resetReconciliationForm() {
            // Reset Physical Balance
            const physInput = document.getElementById('reconPhysicalBalance');
            if (physInput) physInput.value = '';

            // Reset Responsible Person dropdown to initial empty option
            const respSelect = document.getElementById('reconResponsible');
            if (respSelect) respSelect.selectedIndex = 0;

            // Reset Remarks
            const remarksInput = document.getElementById('reconRemarks');
            if (remarksInput) remarksInput.value = '';

            // Reset Tray Type to Standard Trays
            const trayInput = document.getElementById('reconTrayType');
            if (trayInput) trayInput.value = 'Standard Trays';

            // Reset Date to current today date
            const dateInput = document.getElementById('reconDate');
            if (dateInput) {
                const now = new Date();
                const year = now.getFullYear();
                const month = String(now.getMonth() + 1).padStart(2, '0');
                const day = String(now.getDate()).padStart(2, '0');
                dateInput.value = `${year}-${month}-${day}`;
            }

            // Reset Period / Month to current month
            const periodInput = document.getElementById('reconPeriod');
            if (periodInput) {
                const now = new Date();
                periodInput.value = now.toLocaleString('en-US', { month: 'long', year: 'numeric' });
            }

            // Reset Warehouse dropdown to default selected (or first)
            const locSelect = document.getElementById('reconLocation');
            if (locSelect) {
                const userLocOption = locSelect.querySelector('option[selected]');
                if (userLocOption) {
                    locSelect.value = userLocOption.value;
                } else if (locSelect.options.length > 0) {
                    locSelect.selectedIndex = 0;
                }
            }

            // Reset button and form submission state
            const form = document.getElementById('reconForm');
            if (form) form.classList.remove('is-submitting');
            const btn = document.getElementById('btnGenerateRecon');
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-file-pdf" style="color: #ffc107;"></i> Generate & Download PDF';
            }

            handleLocationChange();
        }

        function openReconciliationModal() {
            const modal = document.getElementById('reconciliationModal');
            if (!modal) return;
            
            resetReconciliationForm();
            modal.style.display = 'flex';
        }

        function closeReconciliationModal() {
            const modal = document.getElementById('reconciliationModal');
            if (modal) modal.style.display = 'none';
            resetReconciliationForm();
        }

        window.openReconciliationModal = openReconciliationModal;
        window.closeReconciliationModal = closeReconciliationModal;

        window.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeReconciliationModal();
            }
        });

        function handleDateChange() {
            const dateInput = document.getElementById('reconDate');
            const periodInput = document.getElementById('reconPeriod');
            if (dateInput && dateInput.value && periodInput) {
                const parts = dateInput.value.split('-');
                if (parts.length === 3) {
                    const d = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
                    if (!isNaN(d.getTime())) {
                        periodInput.value = d.toLocaleString('en-US', { month: 'long', year: 'numeric' });
                    }
                }
            }
            updateSystemBalanceForDate();
        }

        function handleLocationChange() {
            updateSystemBalanceForDate();
        }

        async function updateSystemBalanceForDate() {
            const locSelect = document.getElementById('reconLocation');
            const dateInput = document.getElementById('reconDate');
            const sysBalInput = document.getElementById('reconSystemBalance');
            if (!locSelect || !sysBalInput) return;

            const locId = locSelect.value;
            const dateVal = dateInput ? dateInput.value : '';
            const selectedOpt = locSelect.options[locSelect.selectedIndex];
            const liveStock = selectedOpt ? parseInt(selectedOpt.getAttribute('data-stock') || '0', 10) : 0;

            const now = new Date();
            const todayStr = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;

            // If no date or date is today or future, use current live warehouse stock
            if (!dateVal || dateVal >= todayStr) {
                sysBalInput.value = liveStock;
                calculateReconMetrics();
                return;
            }

            // Historical date selected: fetch the exact warehouse balance as of that date
            try {
                sysBalInput.style.opacity = '0.5';
                const response = await fetch(`/api/analytics/warehouse-balance?locationId=${encodeURIComponent(locId)}&date=${encodeURIComponent(dateVal)}`);
                const data = await response.json();
                if (data && data.success && typeof data.balance === 'number') {
                    sysBalInput.value = data.balance;
                } else {
                    sysBalInput.value = liveStock;
                }
            } catch (err) {
                console.error('Failed to fetch historical warehouse stock:', err);
                sysBalInput.value = liveStock;
            } finally {
                sysBalInput.style.opacity = '1';
                calculateReconMetrics();
            }
        }

        function calculateReconMetrics() {
            const sysBalInput = document.getElementById('reconSystemBalance');
            const physInput = document.getElementById('reconPhysicalBalance');
            const diffBadge = document.getElementById('reconDiffBadge');
            const statusBadge = document.getElementById('reconStatusBadge');
            
            if (!sysBalInput || !physInput || !diffBadge || !statusBadge) return;
            const sysBal = parseInt(sysBalInput.value || '0', 10);
            
            if (physInput.value === '') {
                diffBadge.innerText = '0 Trays';
                diffBadge.style.color = '#15803d';
                statusBadge.innerText = 'PENDING COUNT';
                statusBadge.style.background = '#f1f5f9';
                statusBadge.style.color = '#475569';
                statusBadge.style.borderColor = '#cbd5e1';
                return;
            }

            const physBal = parseInt(physInput.value || '0', 10);
            const diff = physBal - sysBal;

            if (diff === 0) {
                diffBadge.innerText = '0 Trays';
                diffBadge.style.color = '#15803d';
                statusBadge.innerText = 'MATCHED';
                statusBadge.style.background = '#dcfce7';
                statusBadge.style.color = '#15803d';
                statusBadge.style.borderColor = '#86efac';
            } else if (diff < 0) {
                diffBadge.innerText = `${diff.toLocaleString()} Trays`;
                diffBadge.style.color = '#b91c1c';
                statusBadge.innerText = 'SHORTFALL';
                statusBadge.style.background = '#fee2e2';
                statusBadge.style.color = '#b91c1c';
                statusBadge.style.borderColor = '#fca5a5';
            } else {
                diffBadge.innerText = `+${diff.toLocaleString()} Trays`;
                diffBadge.style.color = '#b45309';
                statusBadge.innerText = 'EXCESS';
                statusBadge.style.background = '#fef3c7';
                statusBadge.style.color = '#b45309';
                statusBadge.style.borderColor = '#fde68a';
            }
        }

        function generateReconciliationReport(event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }

            const form = document.getElementById('reconForm');
            if (form && !form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const locSelect = document.getElementById('reconLocation');
            const locName = locSelect && locSelect.options[locSelect.selectedIndex] ? locSelect.options[locSelect.selectedIndex].getAttribute('data-name') : 'Warehouse';
            const responsible = document.getElementById('reconResponsible').value || '-';
            const countingDate = document.getElementById('reconDate').value || new Date().toISOString().split('T')[0];
            const period = document.getElementById('reconPeriod').value || '-';
            const trayType = document.getElementById('reconTrayType').value || 'Standard Trays';
            const systemBal = parseInt(document.getElementById('reconSystemBalance').value || '0', 10);
            const physInput = document.getElementById('reconPhysicalBalance');
            const physBal = physInput && physInput.value !== '' ? parseInt(physInput.value, 10) : 0;
            const diff = physBal - systemBal;
            const remarks = document.getElementById('reconRemarks').value || '-';
            const preparedBy = document.getElementById('reconPreparedBy').value || 'System User';

            let statusLabel = 'MATCHED';
            let statusClass = 'badge-in';
            let statusStyle = 'background-color: #dcfce7 !important; color: #15803d !important; border-color: #86efac !important;';
            if (diff < 0) {
                statusLabel = 'SHORTFALL';
                statusClass = 'badge-out';
                statusStyle = 'background-color: #fee2e2 !important; color: #b91c1c !important; border-color: #fca5a5 !important;';
            } else if (diff > 0) {
                statusLabel = 'EXCESS';
                statusClass = 'badge-pending';
                statusStyle = 'background-color: #fef3c7 !important; color: #b45309 !important; border-color: #fde68a !important;';
            }

            const diffText = diff > 0 ? `+${diff.toLocaleString()} Trays` : `${diff.toLocaleString()} Trays`;

            // Reset button and form state so it never gets stuck in Processing...
            if (form) form.classList.remove('is-submitting');
            const btn = document.getElementById('btnGenerateRecon');
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-file-pdf" style="color: #ffc107;"></i> Generate & Download PDF';
            }

            closeReconciliationModal();
            triggerReconciliationPrintWindow({
                locName,
                responsible,
                countingDate,
                period,
                trayType,
                systemBal,
                physBal,
                diff,
                diffText,
                statusLabel,
                statusStyle,
                remarks,
                preparedBy
            });
        }

        function triggerReconciliationPrintWindow(data) {
            const win = window.open('', '_blank', 'height=850,width=920');
            if (!win) {
                alert('Pop-up blocked! Please allow pop-ups for this website to print or download the PDF.');
                return;
            }

            const today = new Date().toLocaleDateString('en-CA');
            const generatedAt = new Date().toLocaleString();

            win.document.write(`<!DOCTYPE html>
                <html>
                    <head>
                        <meta charset="UTF-8">
                        <title>Tray Reconciliation - ${data.locName} - ${today}</title>
                        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
                        <style>
                            @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
                            
                            @page {
                                size: A4 portrait;
                                margin: 12mm 12mm;
                            }

                            * {
                                box-sizing: border-box;
                            }

                            body { 
                                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
                                margin: 0;
                                padding: 15px 25px; 
                                color: #1e293b;
                                background: #fff;
                                -webkit-print-color-adjust: exact !important;
                                print-color-adjust: exact !important;
                            }

                            .report-action-bar {
                                position: sticky;
                                top: 0;
                                left: 0;
                                right: 0;
                                background: #ffffff;
                                padding: 10px 20px;
                                border-bottom: 2px solid #e2e8f0;
                                display: flex;
                                justify-content: space-between;
                                align-items: center;
                                box-shadow: 0 2px 6px rgba(0,0,0,0.06);
                                z-index: 9999;
                                margin: -15px -25px 20px -25px;
                            }

                            .report-action-title {
                                font-size: 13.5px;
                                font-weight: 700;
                                color: #144d37;
                                display: flex;
                                align-items: center;
                                gap: 8px;
                            }

                            .report-action-buttons {
                                display: flex;
                                gap: 10px;
                                align-items: center;
                            }

                            .btn-action {
                                border: none;
                                padding: 7px 15px;
                                border-radius: 6px;
                                font-size: 12.5px;
                                font-weight: 600;
                                cursor: pointer;
                                display: inline-flex;
                                align-items: center;
                                gap: 6px;
                                transition: all 0.15s ease;
                            }

                            .btn-pdf {
                                background-color: #144d37;
                                color: #ffffff;
                            }
                            .btn-pdf:hover {
                                background-color: #0f3929;
                            }

                            .btn-print {
                                background-color: #2563eb;
                                color: #ffffff;
                            }
                            .btn-print:hover {
                                background-color: #1d4ed8;
                            }

                            .btn-close {
                                background-color: #64748b;
                                color: #ffffff;
                            }
                            .btn-close:hover {
                                background-color: #475569;
                            }

                            .letterhead {
                                display: flex;
                                align-items: center;
                                border-bottom: 2.5px solid #144d37;
                                padding-bottom: 12px;
                                margin-bottom: 16px;
                                page-break-after: avoid;
                            }

                            .letterhead-img {
                                width: 70px;
                                height: 70px;
                                object-fit: contain;
                                margin-right: 18px;
                            }

                            .letterhead-text h1 {
                                margin: 0;
                                color: #144d37;
                                font-size: 20px;
                                text-transform: uppercase;
                                font-weight: 700;
                                letter-spacing: 0.5px;
                            }

                            .letterhead-text p {
                                margin: 3px 0 0 0;
                                font-size: 11.5px;
                                color: #475569;
                            }

                            .doc-title-box {
                                background: #f0fdf4;
                                border: 1.5px solid #144d37;
                                border-radius: 8px;
                                padding: 10px 16px;
                                text-align: center;
                                margin-bottom: 16px;
                            }

                            .doc-title {
                                font-size: 17px;
                                font-weight: 800;
                                margin: 0;
                                color: #144d37;
                                letter-spacing: 0.8px;
                                text-transform: uppercase;
                            }

                            .doc-meta {
                                font-size: 11px;
                                color: #64748b;
                                margin-top: 4px;
                            }

                            .section-header {
                                background-color: #144d37 !important;
                                color: #ffffff !important;
                                padding: 7px 12px;
                                font-size: 12px;
                                font-weight: 700;
                                letter-spacing: 0.5px;
                                text-transform: uppercase;
                                border: 1px solid #144d37;
                                border-top-left-radius: 6px;
                                border-top-right-radius: 6px;
                                -webkit-print-color-adjust: exact !important;
                                print-color-adjust: exact !important;
                            }

                            table.recon-table { 
                                width: 100% !important; 
                                border-collapse: collapse !important; 
                                font-size: 11.5px !important; 
                                margin-bottom: 16px;
                                border: 1px solid #cbd5e1;
                                border-bottom-left-radius: 6px;
                                border-bottom-right-radius: 6px;
                                overflow: hidden;
                            }

                            table.recon-table th, table.recon-table td { 
                                border: 1px solid #cbd5e1 !important; 
                                padding: 7px 12px !important; 
                                text-align: left; 
                                vertical-align: middle;
                            }

                            table.recon-table td.label-col {
                                width: 35%;
                                font-weight: 600;
                                color: #334155;
                                background-color: #f8fafc !important;
                                -webkit-print-color-adjust: exact !important;
                                print-color-adjust: exact !important;
                            }

                            table.recon-table td.val-col {
                                width: 65%;
                                color: #0f172a;
                            }

                            .table-subnote {
                                font-size: 10px;
                                color: #64748b;
                                font-style: italic;
                                margin-top: -10px;
                                margin-bottom: 16px;
                            }

                            .badge {
                                display: inline-block;
                                padding: 3px 8px;
                                border-radius: 5px;
                                font-size: 10.5px;
                                font-weight: 700;
                                border: 1px solid transparent;
                                -webkit-print-color-adjust: exact !important;
                                print-color-adjust: exact !important;
                            }

                            .sign-table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-top: 18px;
                                font-size: 11px;
                            }

                            .sign-table td {
                                padding: 10px 12px;
                                vertical-align: middle;
                                border: 1px solid #e2e8f0;
                            }

                            .sign-title {
                                font-weight: 700;
                                color: #1e293b;
                                width: 25%;
                            }

                            .sign-line {
                                width: 75%;
                                color: #475569;
                            }

                            @media print {
                                .no-print, .report-action-bar {
                                    display: none !important;
                                }
                                body {
                                    padding: 0 !important;
                                }
                            }
                        </style>
                    </head>
                    <body>
                        <div class="report-action-bar no-print">
                            <div class="report-action-title">
                                <i class="fa-solid fa-file-signature" style="color: #144d37;"></i> Tray Counting & Balance Reconciliation
                            </div>
                            <div class="report-action-buttons">
                                <button id="btnDownloadPdf" onclick="downloadReportAsPdfFile()" class="btn-action btn-pdf">
                                    <i class="fa-solid fa-file-arrow-down"></i> Download PDF
                                </button>
                                <button onclick="window.print()" class="btn-action btn-print">
                                    <i class="fa-solid fa-print"></i> Print
                                </button>
                                <button onclick="window.close()" class="btn-action btn-close">
                                    <i class="fa-solid fa-xmark"></i> Close
                                </button>
                            </div>
                        </div>

                        <div id="reportPrintContent">
                            <div class="letterhead">
                                <img src="${window.location.origin}/images/logo.png" class="letterhead-img" alt="Nelna Logo" onerror="this.style.display='none'">
                                <div class="letterhead-text">
                                    <h1>Nelna Agri Development (Pvt) Ltd</h1>
                                    <p>No. 558, Avissawella Road, Ihala Bomiriya, Kaduwela | Tel: 0112054212 | 0761391535</p>
                                    <p>Tray Management System - Official Report</p>
                                </div>
                            </div>

                            <div class="doc-title-box">
                                <div class="doc-title">TRAY COUNTING & BALANCE RECONCILIATION</div>
                                <div class="doc-meta">Generated: ${generatedAt} | Warehouse: ${data.locName}</div>
                            </div>

                            <!-- 1. BASIC INFORMATION -->
                            <div class="section-header">Basic Information</div>
                            <table class="recon-table">
                                <tr>
                                    <td class="label-col">Warehouse</td>
                                    <td class="val-col"><strong>${data.locName}</strong></td>
                                </tr>
                                <tr>
                                    <td class="label-col">Responsible Person</td>
                                    <td class="val-col">${data.responsible}</td>
                                </tr>
                                <tr>
                                    <td class="label-col">Counting Date</td>
                                    <td class="val-col"><strong>${data.countingDate}</strong></td>
                                </tr>
                                <tr>
                                    <td class="label-col">Month</td>
                                    <td class="val-col">${data.period}</td>
                                </tr>
                            </table>

                            <!-- 2. TRAY RECONCILIATION DATA -->
                            <div class="section-header">Tray Reconciliation Data</div>
                            <table class="recon-table">
                                <tr>
                                    <td class="label-col">Tray</td>
                                    <td class="val-col"><strong>${data.trayType}</strong></td>
                                </tr>
                                <tr>
                                    <td class="label-col">System Balance</td>
                                    <td class="val-col"><strong>${data.systemBal.toLocaleString()} Trays</strong></td>
                                </tr>
                                <tr>
                                    <td class="label-col">Physical Balance</td>
                                    <td class="val-col"><strong>${data.physBal.toLocaleString()} Trays</strong></td>
                                </tr>
                                <tr style="background-color: #f0fdf4 !important;">
                                    <td class="label-col" style="font-weight: 700; color: #144d37;">Difference</td>
                                    <td class="val-col" style="font-weight: 800; font-size: 13px; color: ${data.diff === 0 ? '#15803d' : (data.diff < 0 ? '#b91c1c' : '#b45309')};">
                                        ${data.diffText}
                                    </td>
                                </tr>
                                <tr>
                                    <td class="label-col">Status</td>
                                    <td class="val-col">
                                        <span class="badge" style="${data.statusStyle}">
                                            ${data.statusLabel}
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="label-col">Remarks</td>
                                    <td class="val-col">${data.remarks}</td>
                                </tr>
                            </table>
                            <div class="table-subnote">Note: Difference = Physical Warehouse Balance − Tray Management System Balance.</div>

                            <!-- 3. SIGN-OFF & VERIFICATION -->
                            <div class="section-header">Sign-Off & Verification</div>
                            <table class="sign-table">
                                <tr>
                                    <td class="sign-title">Prepared By:</td>
                                    <td class="sign-line">
                                        <strong>${data.preparedBy}</strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="sign-title">Checked By:</td>
                                    <td class="sign-line" style="color: #94a3b8;">
                                        ................................................................................................................................................
                                    </td>
                                </tr>
                                <tr>
                                    <td class="sign-title">Verified By:</td>
                                    <td class="sign-line" style="color: #94a3b8;">
                                        ................................................................................................................................................
                                    </td>
                                </tr>
                                <tr>
                                    <td class="sign-title">Date:</td>
                                    <td class="sign-line" style="color: #94a3b8;">
                                        ................................................................................................................................................
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"><\/script>
                        <script>
                            function downloadReportAsPdfFile() {
                                const btn = document.getElementById('btnDownloadPdf');
                                if (btn) {
                                    btn.disabled = true;
                                    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Generating PDF...';
                                }
                                const element = document.getElementById('reportPrintContent');
                                const cleanFilename = 'Tray_Reconciliation_${data.locName.replace(/[^a-zA-Z0-9_-]/g, "_")}_${today}.pdf';
                                const opt = {
                                    margin: [10, 10, 10, 10],
                                    filename: cleanFilename,
                                    image: { type: 'jpeg', quality: 0.98 },
                                    html2canvas: { scale: 2, useCORS: true, logging: false },
                                    jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
                                    pagebreak: { mode: ['avoid-all', 'css', 'legacy'] }
                                };
                                if (window.html2pdf) {
                                    html2pdf().set(opt).from(element).save().then(() => {
                                        if (btn) {
                                            btn.disabled = false;
                                            btn.innerHTML = '<i class="fa-solid fa-file-arrow-down"></i> Download PDF';
                                        }
                                    }).catch(err => {
                                        console.error('html2pdf error:', err);
                                        if (btn) {
                                            btn.disabled = false;
                                            btn.innerHTML = '<i class="fa-solid fa-file-arrow-down"></i> Download PDF';
                                        }
                                        window.print();
                                    });
                                } else {
                                    window.print();
                                }
                            }
                        <\/script>
                    </body>
                </html>`);
            win.document.close();
        }
    </script>

    <%- include('partials/footer') %>