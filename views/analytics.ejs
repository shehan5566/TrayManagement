<%- include('partials/header') %>

    <div class="content-header" style="margin-bottom: 24px;">
        <div>
            <h2 style="font-size: 26px; font-weight: 700; color: var(--text-dark); margin: 0; display: flex; align-items: center; gap: 12px;">
                <i class="fa-solid fa-chart-pie" style="color: var(--primary-green);"></i> Advanced AI Analytics & Forecasting
            </h2>
            <p style="color: var(--text-light); margin: 4px 0 0 0; font-size: 14px;">
                AI-driven return cycle analysis, loss risk detection, in-transit vehicle/route variances, and branch stock forecasts.
            </p>
        </div>
    </div>

    <!-- Key Analytics Cards -->
    <div class="metrics-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; margin-bottom: 28px;">
        <!-- Outstanding Trays -->
        <div class="card metric-card" style="border-left: 4px solid #f59e0b; padding: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <span style="font-size: 12px; font-weight: 600; color: var(--text-light); text-transform: uppercase;">Outstanding Trays</span>
                    <h3 style="font-size: 26px; font-weight: 800; color: var(--text-dark); margin: 6px 0 0 0;">
                        <%= totalOutstanding.toLocaleString() %>
                    </h3>
                    <span style="font-size: 12px; color: #f59e0b; font-weight: 600;">Held by customers</span>
                </div>
                <div style="width: 42px; height: 42px; border-radius: 12px; background: rgba(245, 158, 11, 0.15); display: flex; align-items: center; justify-content: center; color: #f59e0b; font-size: 18px;">
                    <i class="fa-solid fa-boxes-stacked"></i>
                </div>
            </div>
        </div>

        <!-- High Loss Risk Trays -->
        <div class="card metric-card" style="border-left: 4px solid #ef4444; padding: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <span style="font-size: 12px; font-weight: 600; color: var(--text-light); text-transform: uppercase;">High Loss Risk</span>
                    <h3 style="font-size: 26px; font-weight: 800; color: #ef4444; margin: 6px 0 0 0;">
                        <%= (typeof highRiskTrays !== 'undefined' ? highRiskTrays : 0).toLocaleString() %>
                    </h3>
                    <span style="font-size: 12px; color: #ef4444; font-weight: 600;">
                        Exposure: Rs. <%= (typeof highRiskExposure !== 'undefined' ? highRiskExposure : 0).toLocaleString() %>
                    </span>
                </div>
                <div style="width: 42px; height: 42px; border-radius: 12px; background: rgba(239, 68, 68, 0.15); display: flex; align-items: center; justify-content: center; color: #ef4444; font-size: 18px;">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
            </div>
        </div>

        <!-- Transit Shortage -->
        <div class="card metric-card" style="border-left: 4px solid #dc2626; padding: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <span style="font-size: 12px; font-weight: 600; color: var(--text-light); text-transform: uppercase;">Transit Shortage</span>
                    <h3 style="font-size: 26px; font-weight: 800; color: var(--text-dark); margin: 6px 0 0 0;">
                        <%= (typeof totalTransitShortage !== 'undefined' ? totalTransitShortage : 0).toLocaleString() %>
                    </h3>
                    <span style="font-size: 12px; color: #dc2626; font-weight: 600;">Shortage in transfers</span>
                </div>
                <div style="width: 42px; height: 42px; border-radius: 12px; background: rgba(220, 38, 38, 0.15); display: flex; align-items: center; justify-content: center; color: #dc2626; font-size: 18px;">
                    <i class="fa-solid fa-truck-ramp-box"></i>
                </div>
            </div>
        </div>

        <!-- Avg Turnaround Days -->
        <div class="card metric-card" style="border-left: 4px solid #3b82f6; padding: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <span style="font-size: 12px; font-weight: 600; color: var(--text-light); text-transform: uppercase;">Avg Return Cycle</span>
                    <h3 style="font-size: 26px; font-weight: 800; color: var(--text-dark); margin: 6px 0 0 0;">
                        <%= typeof avgTurnaroundDays !== 'undefined' ? avgTurnaroundDays : '7.0' %> <span style="font-size: 15px; font-weight: 600; color: var(--text-light);">Days</span>
                    </h3>
                    <span style="font-size: 12px; color: #3b82f6; font-weight: 600;">Customer turnaround</span>
                </div>
                <div style="width: 42px; height: 42px; border-radius: 12px; background: rgba(59, 130, 246, 0.15); display: flex; align-items: center; justify-content: center; color: #3b82f6; font-size: 18px;">
                    <i class="fa-solid fa-stopwatch"></i>
                </div>
            </div>
        </div>

        <!-- Return Velocity -->
        <div class="card metric-card" style="border-left: 4px solid #10b981; padding: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <span style="font-size: 12px; font-weight: 600; color: var(--text-light); text-transform: uppercase;">Return Velocity</span>
                    <h3 style="font-size: 26px; font-weight: 800; color: var(--text-dark); margin: 6px 0 0 0;">
                        <%= returnVelocity %>%
                    </h3>
                    <span style="font-size: 12px; color: #10b981; font-weight: 600;"><i class="fa-solid fa-arrow-trend-up"></i> Inward vs Outward</span>
                </div>
                <div style="width: 42px; height: 42px; border-radius: 12px; background: rgba(16, 185, 129, 0.15); display: flex; align-items: center; justify-content: center; color: #10b981; font-size: 18px;">
                    <i class="fa-solid fa-bolt"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Predictive Forecast Banner -->
    <div class="card" style="padding: 18px 22px; margin-bottom: 28px; background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(59, 130, 246, 0.12)); border: 1px solid rgba(16, 185, 129, 0.3);">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 46px; height: 46px; border-radius: 12px; background: var(--primary-green); color: white; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
            </div>
            <div>
                <h4 style="margin: 0; font-size: 15px; font-weight: 700; color: var(--text-dark);">
                    Predictive Stock Forecast & Requirement
                </h4>
                <p style="margin: 4px 0 0 0; font-size: 13.5px; color: var(--text-light); line-height: 1.5;">
                    Estimated tray demand for next month: <strong><%= Math.round((totalOut || 1000) * 1.12).toLocaleString() %> Trays</strong> (+12% expansion trend). Maintain a safety stock buffer of <strong><%= Math.round((totalOut || 1000) * 0.2).toLocaleString() %> Trays</strong> at main distribution hubs to prevent stockouts.
                </p>
            </div>
        </div>
    </div>

    <!-- SECTION 1: CUSTOMER LOSS RISK & RETURN CYCLE WATCHLIST -->
    <div class="card" style="padding: 24px; margin-bottom: 28px; border-top: 4px solid #ef4444;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 18px;">
            <div>
                <h3 style="font-size: 17px; font-weight: 700; color: var(--text-dark); margin: 0; display: flex; align-items: center; gap: 10px;">
                    <i class="fa-solid fa-shield-halved" style="color: #ef4444;"></i> Predictive Customer Return Cycle & Loss Risk Watchlist
                </h3>
                <p style="color: var(--text-light); font-size: 13px; margin: 4px 0 0 0;">
                    Compares individual customer turnaround cycle against actual overdue days to detect loss risk before it happens.
                </p>
            </div>
            <div>
                <% if (typeof highRiskList !== 'undefined' && highRiskList.length > 0) { %>
                    <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; font-weight: 700; padding: 6px 12px; font-size: 12px;">
                        <i class="fa-solid fa-triangle-exclamation"></i> <%= highRiskList.length %> Critical Risk Account(s)
                    </span>
                <% } else { %>
                    <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; font-weight: 700; padding: 6px 12px; font-size: 12px;">
                        <i class="fa-solid fa-check-circle"></i> All Customer Cycles Normal
                    </span>
                <% } %>
            </div>
        </div>

        <% if (typeof lossRiskCustomers !== 'undefined' && lossRiskCustomers.length > 0) { %>
            <div class="table-responsive">
                <table class="table" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 2px solid var(--border-color);">
                            <th style="padding: 10px 12px; text-align: left; font-size: 12.5px;">Customer Name</th>
                            <th style="padding: 10px 12px; text-align: left; font-size: 12.5px;">Contact</th>
                            <th style="padding: 10px 12px; text-align: right; font-size: 12.5px;">Pending Trays</th>
                            <th style="padding: 10px 12px; text-align: center; font-size: 12.5px;">Expected Cycle</th>
                            <th style="padding: 10px 12px; text-align: center; font-size: 12.5px;">Days Pending</th>
                            <th style="padding: 10px 12px; text-align: right; font-size: 12.5px;">Financial Exposure</th>
                            <th style="padding: 10px 12px; text-align: center; font-size: 12.5px;">Risk Level</th>
                            <th style="padding: 10px 12px; text-align: right; font-size: 12.5px;">Quick Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% lossRiskCustomers.slice(0, 15).forEach(c => { %>
                            <tr style="border-bottom: 1px solid var(--border-color);">
                                <td style="padding: 10px 12px;">
                                    <strong style="color: var(--text-dark); font-size: 13.5px;"><%= c.name %></strong>
                                </td>
                                <td style="padding: 10px 12px; color: var(--text-light); font-size: 13px;">
                                    <%= c.phone %>
                                </td>
                                <td style="padding: 10px 12px; text-align: right;">
                                    <span class="badge" style="background: <%= c.currentBalance >= 50 ? 'rgba(239, 68, 68, 0.15)' : 'rgba(245, 158, 11, 0.15)' %>; color: <%= c.currentBalance >= 50 ? '#ef4444' : '#f59e0b' %>; font-weight: 700; font-size: 12px;">
                                        <%= c.currentBalance %> Trays
                                    </span>
                                </td>
                                <td style="padding: 10px 12px; text-align: center; font-size: 13px; color: var(--text-dark);">
                                    <%= c.avgCycle %> Days
                                </td>
                                <td style="padding: 10px 12px; text-align: center;">
                                    <strong style="color: <%= c.daysPending >= 14 ? '#ef4444' : (c.daysPending >= 7 ? '#f59e0b' : '#10b981') %>; font-size: 13px;">
                                        <%= c.daysPending %> Days
                                    </strong>
                                </td>
                                <td style="padding: 10px 12px; text-align: right; font-weight: 700; color: var(--text-dark); font-size: 13px;">
                                    Rs. <%= (c.exposureValue || 0).toLocaleString() %>
                                </td>
                                <td style="padding: 10px 12px; text-align: center;">
                                    <% if (c.riskLevel === 'HIGH') { %>
                                        <span class="badge" style="background: #ef4444; color: white; font-weight: 700; font-size: 11px; padding: 4px 8px;">
                                            <i class="fa-solid fa-fire"></i> HIGH RISK (<%= c.riskScore %>%)
                                        </span>
                                    <% } else if (c.riskLevel === 'MEDIUM') { %>
                                        <span class="badge" style="background: #f59e0b; color: white; font-weight: 700; font-size: 11px; padding: 4px 8px;">
                                            <i class="fa-solid fa-clock"></i> MEDIUM (<%= c.riskScore %>%)
                                        </span>
                                    <% } else { %>
                                        <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; font-weight: 700; font-size: 11px; padding: 4px 8px;">
                                            <i class="fa-solid fa-check"></i> NORMAL
                                        </span>
                                    <% } %>
                                </td>
                                <td style="padding: 10px 12px; text-align: right;">
                                    <div style="display: inline-flex; gap: 6px;">
                                        <button onclick="sendReminderSMS('<%= c.id %>')" class="btn btn-sm" style="font-size: 11px; background: #174e3e; color: white; border: none; padding: 4px 8px; border-radius: 4px; cursor: pointer; display: inline-flex; align-items: center; gap: 4px;" title="Send Reminder SMS">
                                            <i class="fa-solid fa-comment-sms"></i> SMS
                                        </button>
                                        <a href="/reports?showBreakup=<%= c.id %>" class="btn btn-secondary btn-sm" style="font-size: 11px; padding: 4px 8px; border-radius: 4px; text-decoration: none;" title="View Statement">
                                            <i class="fa-solid fa-clock-rotate-left"></i> History
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div style="text-align: center; padding: 32px; color: var(--text-light);">
                <i class="fa-solid fa-circle-check" style="font-size: 38px; color: #10b981; margin-bottom: 12px; display: block;"></i>
                <h4 style="margin: 0; font-size: 16px; font-weight: 700; color: var(--text-dark);">Zero At-Risk Accounts</h4>
                <p style="margin: 4px 0 0 0; font-size: 13.5px; color: var(--text-light);">Currently there are no overdue customer tray accounts. All customer return cycles are normal.</p>
            </div>
        <% } %>
    </div>

    <!-- SECTION 2: TRANSIT SHORTAGES - VEHICLE & ROUTE VARIANCE ANALYTICS -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 24px; margin-bottom: 28px;">
        <!-- Vehicle Shortages Bar Chart -->
        <div class="card" style="padding: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h3 style="font-size: 16px; font-weight: 700; color: var(--text-dark); margin: 0;">
                    <i class="fa-solid fa-truck" style="color: #ef4444; margin-right: 8px;"></i> Vehicle Transit Shortage Variance
                </h3>
                <span style="font-size: 12px; color: var(--text-light); font-weight: 600;">Lost trays in transit</span>
            </div>
            <div style="position: relative; height: 260px;">
                <canvas id="vehicleShortageChart"></canvas>
            </div>
        </div>

        <!-- Route Discrepancy Breakdown Table -->
        <div class="card" style="padding: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h3 style="font-size: 16px; font-weight: 700; color: var(--text-dark); margin: 0;">
                    <i class="fa-solid fa-route" style="color: #f59e0b; margin-right: 8px;"></i> Route Loss Analysis
                </h3>
                <span style="font-size: 12px; color: var(--text-light); font-weight: 600;">By Transfer Routes</span>
            </div>
            <div class="table-responsive" style="max-height: 260px; overflow-y: auto;">
                <table class="table" style="width: 100%; font-size: 13px;">
                    <thead>
                        <tr style="border-bottom: 2px solid var(--border-color);">
                            <th style="padding: 8px 10px; text-align: left;">Route Name</th>
                            <th style="padding: 8px 10px; text-align: right;">Transfers</th>
                            <th style="padding: 8px 10px; text-align: right;">Dispatched</th>
                            <th style="padding: 8px 10px; text-align: right;">Received</th>
                            <th style="padding: 8px 10px; text-align: right;">Shortage</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof routeShortageStats !== 'undefined' && routeShortageStats.length > 0) { %>
                            <% routeShortageStats.forEach(r => { %>
                                <tr style="border-bottom: 1px solid var(--border-color);">
                                    <td style="padding: 8px 10px; font-weight: 700; color: var(--text-dark);"><%= r.route %></td>
                                    <td style="padding: 8px 10px; text-align: right;"><%= r.transfers %></td>
                                    <td style="padding: 8px 10px; text-align: right;"><%= r.dispatched.toLocaleString() %></td>
                                    <td style="padding: 8px 10px; text-align: right;"><%= r.received.toLocaleString() %></td>
                                    <td style="padding: 8px 10px; text-align: right; font-weight: 700; color: <%= r.shortage > 0 ? '#ef4444' : '#10b981' %>;">
                                        <%= r.shortage > 0 ? '-' + r.shortage : '0' %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" style="text-align: center; padding: 24px; color: var(--text-light);">
                                    No completed stock transfer records available yet.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- SECTION 3: BRANCH STOCK & CIRCULATION CHARTS -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 24px; margin-bottom: 28px;">
        <!-- Branch Stock Heatmap Chart -->
        <div class="card" style="padding: 24px;">
            <h3 style="font-size: 16px; font-weight: 700; color: var(--text-dark); margin: 0 0 16px 0;">
                <i class="fa-solid fa-location-dot" style="color: #f59e0b; margin-right: 8px;"></i> Branch Stock Distribution
            </h3>
            <div style="position: relative; height: 260px;">
                <canvas id="branchStockChart"></canvas>
            </div>
        </div>

        <!-- Circulation Comparison Chart -->
        <div class="card" style="padding: 24px;">
            <h3 style="font-size: 16px; font-weight: 700; color: var(--text-dark); margin: 0 0 16px 0;">
                <i class="fa-solid fa-right-left" style="color: var(--primary-green); margin-right: 8px;"></i> Inward vs Outward Circulation
            </h3>
            <div style="position: relative; height: 260px;">
                <canvas id="circulationChart"></canvas>
            </div>
        </div>
    </div>

    <!-- SECTION 4: BRANCH UTILIZATION BREAKDOWN TABLE -->
    <div class="card" style="padding: 24px;">
        <h3 style="font-size: 18px; font-weight: 700; color: var(--text-dark); margin: 0 0 16px 0;">
            <i class="fa-solid fa-table-cells" style="color: var(--primary-green); margin-right: 8px;"></i> Branch Stock & Activity Breakdown
        </h3>
        <div class="table-responsive">
            <table class="table" style="width: 100%;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--border-color);">
                        <th style="padding: 10px; text-align: left;">Branch Name</th>
                        <th style="padding: 10px; text-align: right;">Current Stock</th>
                        <th style="padding: 10px; text-align: center;">Transactions Recorded</th>
                        <th style="padding: 10px; text-align: center;">Capacity Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% branchStats.forEach(b => { %>
                        <tr style="border-bottom: 1px solid var(--border-color);">
                            <td style="padding: 10px; font-weight: 700; color: var(--text-dark);">
                                <%= b.name %>
                            </td>
                            <td style="padding: 10px; text-align: right; font-weight: 800; color: var(--primary-green); font-size: 14.5px;">
                                <%= b.stock.toLocaleString() %> Trays
                            </td>
                            <td style="padding: 10px; text-align: center; color: var(--text-dark);">
                                <%= b.txCount %> Transactions
                            </td>
                            <td style="padding: 10px; text-align: center;">
                                <% if (b.stock > 1000) { %>
                                    <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
                                        <i class="fa-solid fa-circle-check"></i> HIGH CAPACITY
                                    </span>
                                <% } else if (b.stock > 200) { %>
                                    <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6;">
                                        <i class="fa-solid fa-circle-info"></i> OPTIMAL
                                    </span>
                                <% } else { %>
                                    <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: #ef4444;">
                                        <i class="fa-solid fa-triangle-exclamation"></i> LOW STOCK
                                    </span>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function sendReminderSMS(customerId) {
            Swal.fire({
                title: 'Send Reminder SMS?',
                text: "Are you sure you want to send an overdue balance reminder SMS to this customer?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, Send SMS',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/api/sms/send-balance', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ customerId })
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire('Success', 'Reminder SMS sent successfully!', 'success');
                        } else {
                            Swal.fire('Error', data.error || 'Failed to send SMS', 'error');
                        }
                    })
                    .catch(err => {
                        Swal.fire('Error', 'An unexpected error occurred', 'error');
                    });
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            // 1. Vehicle Shortage Bar Chart
            <% 
                const vLabels = (typeof vehicleShortageStats !== 'undefined' && vehicleShortageStats.length > 0) 
                    ? vehicleShortageStats.map(v => v.vehicleNo) 
                    : ['No Vehicles'];
                const vData = (typeof vehicleShortageStats !== 'undefined' && vehicleShortageStats.length > 0) 
                    ? vehicleShortageStats.map(v => v.shortage) 
                    : [0];
            %>
            const vehicleLabels = <%- JSON.stringify(vLabels) %>;
            const vehicleShortages = <%- JSON.stringify(vData) %>;

            const ctxVehicle = document.getElementById('vehicleShortageChart');
            if (ctxVehicle) {
                new Chart(ctxVehicle.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: vehicleLabels,
                        datasets: [{
                            label: 'Tray Shortage (Lost/Missing)',
                            data: vehicleShortages,
                            backgroundColor: 'rgba(239, 68, 68, 0.85)',
                            borderColor: '#dc2626',
                            borderWidth: 2,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: { 
                                beginAtZero: true,
                                ticks: { precision: 0 }
                            }
                        }
                    }
                });
            }

            // 2. Branch Stock Chart
            const branchNames = <%- JSON.stringify(branchStats.map(b => b.name)) %>;
            const branchStocks = <%- JSON.stringify(branchStats.map(b => b.stock)) %>;

            const ctx1 = document.getElementById('branchStockChart');
            if (ctx1) {
                new Chart(ctx1.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: branchNames,
                        datasets: [{
                            label: 'Available Stock',
                            data: branchStocks,
                            backgroundColor: 'rgba(23, 78, 62, 0.85)',
                            borderColor: '#174e3e',
                            borderWidth: 2,
                            borderRadius: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });
            }

            // 3. Circulation Doughnut Chart
            const ctx2 = document.getElementById('circulationChart');
            if (ctx2) {
                const doughnutPercentagesPlugin = {
                    id: 'doughnutPercentages',
                    afterDraw(chart) {
                        const { ctx, data } = chart;
                        const total = data.datasets[0].data.reduce((a, b) => Number(a) + Number(b), 0);
                        if (total <= 0) return;

                        chart.getDatasetMeta(0).data.forEach((datapoint, index) => {
                            const val = data.datasets[0].data[index];
                            if (!val || val <= 0) return;
                            const percentage = ((val / total) * 100).toFixed(1) + '%';
                            
                            const { x, y } = datapoint.tooltipPosition();
                            ctx.save();
                            ctx.fillStyle = '#ffffff';
                            ctx.font = 'bold 12px sans-serif';
                            ctx.textAlign = 'center';
                            ctx.textBaseline = 'middle';
                            ctx.shadowColor = 'rgba(0, 0, 0, 0.6)';
                            ctx.shadowBlur = 4;
                            ctx.fillText(percentage, x, y);
                            ctx.restore();
                        });
                    }
                };

                new Chart(ctx2.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: ['Trays Returned (IN)', 'Trays Issued (OUT)', 'Outstanding with Customers'],
                        datasets: [{
                            data: [<%= totalIn %>, <%= totalOut %>, <%= totalOutstanding %>],
                            backgroundColor: ['#10b981', '#f59e0b', '#174e3e'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    plugins: [doughnutPercentagesPlugin],
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    boxWidth: 12,
                                    padding: 14,
                                    font: { size: 12, weight: '600' }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const label = context.label || '';
                                        const value = context.raw || 0;
                                        const total = context.chart.data.datasets[0].data.reduce((a, b) => Number(a) + Number(b), 0);
                                        const pct = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                        return ` ${label}: ${value.toLocaleString()} Trays (${pct}%)`;
                                    }
                                }
                            }
                        },
                        cutout: '60%'
                    }
                });
            }
        });
    </script>

    <%- include('partials/footer') %>