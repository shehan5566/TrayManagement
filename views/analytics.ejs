                            </label>
                            <input type="number" id="reconPhysicalBalance" required min="0" placeholder="Enter physical trays counted in warehouse..." oninput="calculateReconMetrics()" style="width: 100%; padding: 10px 14px; border: 2px solid #144d37; border-radius: 8px; font-size: 15px; font-weight: 700; color: #1e293b; background: #fff; outline: none; box-sizing: border-box;">
