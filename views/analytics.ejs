                    </button>
                    <button type="button" id="btnGenerateRecon" onclick="generateReconciliationReport(event)" style="padding: 10px 22px; border: none; background: linear-gradient(135deg, #144d37, #1f6f43); color: #ffffff; font-size: 14px; font-weight: 700; border-radius: 8px; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 12px rgba(20, 77, 55, 0.25);">
