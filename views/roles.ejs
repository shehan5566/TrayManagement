<%- include('partials/header') %>

<div style="margin-bottom: 25px;">
    <h2 style="color: var(--primary-green-dark);"><i class="fa-solid fa-users-rectangle"></i> User Roles Management</h2>
    <p style="color: var(--text-light); font-size: 14px;">Define roles and configure specific system access permissions.</p>
</div>

<% if (error) { %>
    <div class="error-banner">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <%= error %>
    </div>
<% } %>

<div class="users-layout" style="grid-template-columns: 1fr;">
    
    <!-- Roles List -->
    <div class="content-box">
        <div class="box-header" style="display: flex; justify-content: space-between; align-items: center;">
            <span class="box-title"><i class="fa-solid fa-list"></i> System Roles</span>
            <button onclick="openRoleModal()" class="btn btn-primary" style="padding: 6px 12px; font-size: 13px;">
                <i class="fa-solid fa-plus"></i> Add New Role
            </button>
        </div>

        <div class="table-responsive">
            <table id="rolesTable">
                <thead>
                    <tr>
                        <th>Role Name</th>
                        <th style="width: 150px; text-align: center;">Is SuperUser</th>
                        <th style="text-align: center; width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% (typeof roles !== 'undefined' ? roles : []).forEach(r => { %>
                        <tr>
                            <td><strong><%= r.name %></strong></td>
                            <td style="text-align: center;">
                                <% if (r.isSuperUser) { %>
                                    <span class="badge" style="background:#1b5e20; color:white; padding:4px 8px; font-size:11px;">True</span>
                                <% } else { %>
                                    <span class="badge" style="background:#757575; color:white; padding:4px 8px; font-size:11px;">False</span>
                                <% } %>
                            </td>
                            <td>
                                <div style="display: flex; gap: 8px; justify-content: center;">
                                    <button onclick="openRoleModal(this.getAttribute('data-role'))" data-role="<%= JSON.stringify(r) %>" class="btn btn-secondary" style="padding: 6px 10px; font-size: 12px; color: var(--primary-green-dark);" title="Edit Role">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                    <form action="/roles/<%= r.id %>/delete" method="POST" onsubmit="confirmAjaxDelete(event, this, 'role')">
                                        <button type="submit" class="btn btn-danger" style="padding: 6px 10px; font-size: 12px; background-color: #ffc300; border-color: #e6b000; color: #000000;" title="Delete Role">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create/Edit Role Modal -->
<div id="roleModal" class="modal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); overflow-y: auto;">
    <div class="modal-content" style="background-color: #fefefe; margin: 40px auto; padding: 25px; border-radius: 8px; width: 95%; max-width: 900px; box-shadow: 0 4px 20px rgba(0,0,0,0.2);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 2px solid var(--accent-yellow); padding-bottom: 10px;">
            <h3 id="roleModalTitle" style="margin: 0; color: var(--primary-green-dark);"><i class="fa-solid fa-layer-group"></i> Create User Role</h3>
            <span onclick="closeRoleModal()" style="color: #aaa; font-size: 28px; font-weight: bold; cursor: pointer;">&times;</span>
        </div>

        <form id="roleForm" action="/roles/create" method="POST" onsubmit="submitAjaxForm(event, this, 'Role saved successfully', () => window.location.reload())">
            <div style="display: flex; gap: 20px; margin-bottom: 20px; align-items: flex-end;">
                <div class="form-group" style="flex-grow: 1; margin: 0;">
                    <label for="roleName">Role Name <span style="color: red;">*</span></label>
                    <input type="text" id="roleName" name="name" placeholder="e.g. Distributor" required>
                </div>
                <div class="form-group" style="margin: 0; padding-bottom: 10px;">
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-weight: bold; color: var(--text-dark);">
                        <input type="checkbox" id="roleIsSuperUser" name="isSuperUser" value="true" onchange="togglePermissionsGrid()"> IsSuperUser
                    </label>
                </div>
            </div>

            <style>
                .permissions-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
                    gap: 15px;
                    margin-top: 20px;
                }
                .perm-category {
                    border: 1px solid #e0e0e0;
                    border-radius: 6px;
                    padding: 12px;
                    background: #fdfdfd;
                }
                .perm-category-title {
                    font-size: 13px;
                    color: var(--primary-green-dark);
                    font-weight: bold;
                    margin-bottom: 10px;
                    text-transform: uppercase;
                    border-bottom: 1px solid #eee;
                    padding-bottom: 5px;
                }
                .perm-tags-container {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 8px;
                }
                .perm-tag-label {
                    display: inline-flex;
                    align-items: center;
                    gap: 5px;
                    background: #fff8e1;
                    border: 1px solid #ffe082;
                    color: #594214;
                    padding: 5px 10px;
                    border-radius: 6px;
                    font-size: 12px;
                    font-weight: 600;
                    cursor: pointer;
                    user-select: none;
                    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
                }
                .perm-tag-label:hover {
                    background: #ffecb3;
                    border-color: #ffd54f;
                }
                .perm-tag-label input[type="checkbox"] {
                    margin: 0;
                    cursor: pointer;
                    accent-color: #10b981;
                }
                .perm-tag-label.selected {
                    background: #10b981;
                    border-color: #059669;
                    color: #ffffff;
                    font-weight: 700;
                    box-shadow: 0 2px 6px rgba(16, 185, 129, 0.25);
                }
                .perm-tag-label.selected:hover {
                    background: #059669;
                }
            </style>

            <div id="permissionsSection">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 10px;">
                    <p style="margin: 0; color: #666; font-size: 13px;">Select the specific permissions for this role by clicking the tags below.</p>
                    <div style="display: flex; gap: 8px;">
                        <button type="button" onclick="toggleAllPermissions(true)" class="btn btn-sm" style="padding: 5px 12px; font-size: 12px; background-color: #10b981; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; display: inline-flex; align-items: center; gap: 5px;">
                            <i class="fa-solid fa-check-double"></i> Select All
                        </button>
                        <button type="button" onclick="toggleAllPermissions(false)" class="btn btn-sm" style="padding: 5px 12px; font-size: 12px; background-color: #ffc300; color: #000; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; display: inline-flex; align-items: center; gap: 5px;">
                            <i class="fa-solid fa-xmark"></i> Deselect All
                        </button>
                    </div>
                </div>
                <div class="permissions-grid">
                        
                        <!-- 1. Transactions (In/Out) -->
                        <div class="perm-category">
                            <div class="perm-category-title">1. Transactions (In/Out)</div>
                            <div class="perm-tags-container">
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="transactions_view"> View</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="transactions_edit"> Edit</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="transactions_create"> Create</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="transactions_delete"> Delete</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="transactions_backdate"> Backdate</label>
                            </div>
                        </div>

                        <!-- 2. Stock Transfers -->
                        <div class="perm-category">
                            <div class="perm-category-title">2. Stock Transfers</div>
                            <div class="perm-tags-container">
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="stock_transfers_view"> View</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="stock_transfers_edit"> Edit</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="stock_transfers_create"> Create</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="stock_transfers_delete"> Delete</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="stock_transfers_backdate"> Backdate</label>
                            </div>
                        </div>

                        <!-- 3. Receive stock -->
                        <div class="perm-category">
                            <div class="perm-category-title">3. Receive stock</div>
                            <div class="perm-tags-container">
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="receive_stock_view"> View</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="receive_stock_edit"> Edit</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="receive_stock_approve"> Approve</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="receive_stock_delete"> Delete</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="receive_stock_backdate"> Backdate</label>
                            </div>
                        </div>

                        <!-- 4. Administration -->
                        <div class="perm-category">
                            <div class="perm-category-title">4. Administration</div>
                            <div class="perm-tags-container">
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="admin_view_logs"> View Logs</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="admin_branches_users"> Branches & Users</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="admin_roles"> Roles</label>
                            </div>
                        </div>

                        <!-- 5. Dashboards & Reports -->
                        <div class="perm-category">
                            <div class="perm-category-title">5. Dashboards & Reports</div>
                            <div class="perm-tags-container">
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="reports_view"> View Reports</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="reports_send_manually"> Send Report Manually</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="dashboard_main"> Main Dashboard</label>
                            </div>
                        </div>

                        <!-- 6. Opening Balance (Warehouse) -->
                        <div class="perm-category">
                            <div class="perm-category-title">6. Opening Balance (Warehouse)</div>
                            <div class="perm-tags-container">
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="opening_balance_edit"> Edit</label>
                            </div>
                        </div>

                        <!-- 7. Action Required -->
                        <div class="perm-category">
                            <div class="perm-category-title">7. Action Required</div>
                            <div class="perm-tags-container">
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="action_sms"> SMS</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="action_view_history"> View History</label>
                            </div>
                        </div>

                        <!-- 8. Customer Management -->
                        <div class="perm-category">
                            <div class="perm-category-title">8. Customer Management</div>
                            <div class="perm-tags-container">
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="customer_view"> View</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="customer_edit"> Edit</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="customer_create"> Create</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="customer_delete"> Delete</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="customer_sms"> SMS</label>
                                <label class="perm-tag-label"><input type="checkbox" name="permissions" value="customer_history"> History</label>
                            </div>
                        </div>

                    </div>
            </div>

            <div style="display: flex; gap: 10px; margin-top: 25px; justify-content: flex-end;">
                <button type="button" class="btn btn-secondary" onclick="closeRoleModal()">Cancel</button>
                <button type="submit" class="btn btn-primary" id="roleSubmitBtn">Save Role</button>
            </div>
        </form>
    </div>
</div>

<script>
    // Style toggle for tag labels
    document.querySelectorAll('.perm-tag-label input[type="checkbox"]').forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            if (this.checked) {
                this.parentElement.classList.add('selected');
            } else {
                this.parentElement.classList.remove('selected');
            }
        });
    });

    function toggleAllPermissions(selectAll) {
        document.querySelectorAll('.perm-tag-label input[type="checkbox"]').forEach(checkbox => {
            checkbox.checked = selectAll;
            if (selectAll) {
                checkbox.parentElement.classList.add('selected');
            } else {
                checkbox.parentElement.classList.remove('selected');
            }
        });
    }

    function togglePermissionsGrid() {
        const isSuperUser = document.getElementById('roleIsSuperUser').checked;
        const section = document.getElementById('permissionsSection');
        if (isSuperUser) {
            section.style.opacity = '0.4';
            section.style.pointerEvents = 'none';
        } else {
            section.style.opacity = '1';
            section.style.pointerEvents = 'auto';
        }
    }

    function openRoleModal(roleStr = null) {
        const modal = document.getElementById('roleModal');
        const form = document.getElementById('roleForm');
        
        // Reset form
        form.reset();
        document.querySelectorAll('.perm-tag-label').forEach(label => label.classList.remove('selected'));
        
        if (roleStr) {
            const role = JSON.parse(roleStr);
            document.getElementById('roleModalTitle').innerHTML = '<i class="fa-solid fa-pen"></i> Edit User Role';
            form.action = '/roles/' + role.id + '/update';
            document.getElementById('roleName').value = role.name;
            document.getElementById('roleIsSuperUser').checked = role.isSuperUser;
            
            if (role.permissions && Array.isArray(role.permissions)) {
                role.permissions.forEach(perm => {
                    const cb = form.querySelector('input[value="' + perm + '"]');
                    if (cb) {
                        cb.checked = true;
                        cb.parentElement.classList.add('selected');
                    }
                });
            }
        } else {
            document.getElementById('roleModalTitle').innerHTML = '<i class="fa-solid fa-layer-group"></i> Create User Role';
            form.action = '/roles/create';
        }
        
        togglePermissionsGrid();
        modal.style.display = 'block';
    }

    function closeRoleModal() {
        document.getElementById('roleModal').style.display = 'none';
    }
</script>

<%- include('partials/footer') %>
