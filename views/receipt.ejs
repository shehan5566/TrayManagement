<%- include('partials/header') %>

    <% 
        const returnUrl = (typeof backUrl !== 'undefined' && backUrl) ? backUrl : '/transactions';
        const isFromDriver = (typeof isDriver !== 'undefined' && isDriver) || returnUrl.includes('/driver');
        const backBtnText = isFromDriver ? 'Back to Driver Portal (ආපසු)' : 'Back to Logs';
    %>

    <div class="print-actions print-actions-top" style="margin-top: 15px; margin-bottom: 5px;">
        <button onclick="window.print()" class="btn btn-primary" style="padding: 10px 20px;">
            <i class="fa-solid fa-print"></i> Print Receipt Slip
        </button>
        <a href="<%= returnUrl %>" class="btn btn-secondary" style="padding: 10px 20px;">
            <i class="fa-solid fa-arrow-left"></i> <%= backBtnText %>
        </a>
    </div>

    <div class="receipt-card" style="position: relative;">
        <% if (tx.isDeleted) { %>
            <div style="position: absolute; top: 40%; left: 50%; transform: translate(-50%, -50%) rotate(-30deg); font-size: 70px; font-weight: bold; color: rgba(255, 0, 0, 0.15); z-index: 10; pointer-events: none; white-space: nowrap; border: 5px solid rgba(255, 0, 0, 0.15); padding: 20px; border-radius: 10px;">CANCELLED</div>
        <% } %>
        <div class="receipt-header">
            <img src="/images/logo.png" alt="Nelna Agri Development Logo" class="receipt-logo-img">
            <div class="receipt-title">Nelna Agri Development (Pvt) Ltd</div>
            <div class="receipt-doc-title" style="font-size: 13px; color: var(--text-dark); font-weight: 600;">Tray
                Transaction Receipt</div>
            <div class="receipt-subtitle">Store Operations Log</div>
        </div>

        <div class="receipt-meta">
            <div>
                <strong>Receipt No:</strong> RE-<%= String(tx.receiptNo || 0).padStart(6, '0') %><br>
                    <strong>Created:</strong>
                    <%= tx.user %>
            </div>
            <div style="text-align: right;">
                <strong>Date:</strong>
                <%= new Date(tx.date).toLocaleDateString() %><br>
                    <strong>Time:</strong>
                    <%= new Date(tx.date).toLocaleTimeString() %>
            </div>
        </div>

        <% 
            var isOut = (tx && tx.type === 'OUT'); 
            var rate = Number(tx && tx.depositPerTray) || 2000; 
            var countQty = Number(tx && tx.count) || 0; 
            var totalTrayDeposit = Number(tx && tx.expectedDeposit) || (countQty * rate); 
            var paidAmt = 0; 
            if (tx && tx.totalDeposit !== undefined && tx.totalDeposit !== null && tx.totalDeposit !== '') { 
                paidAmt = Number(tx.totalDeposit); 
            } else if (tx && tx.depositOption === 'ZERO') { 
                paidAmt = 0; 
            } else if (tx && tx.depositOption === 'HALF') { 
                paidAmt = totalTrayDeposit / 2; 
            } else { 
                paidAmt = totalTrayDeposit; 
            } 
            var pendingAmt = totalTrayDeposit - paidAmt; 
        %>

            <table class="receipt-details-table">
                <tr>
                    <td class="label">Customer Name</td>
                    <td class="value"><strong>
                            <%= customer ? customer.name : tx.customerName %>
                        </strong></td>
                </tr>
                <tr>
                    <td class="label">Contact Number</td>
                    <td class="value">
                        <%= customer ? customer.phone : '-' %>
                    </td>
                </tr>
                <tr>
                    <td class="label">Transaction Type</td>
                    <td class="value">
                        <span class="badge badge-<%= tx.type === 'IN' ? 'in' : 'out' %>"
                            style="font-size: 12px; padding: 5px 12px;">
                            <%= tx.type==='IN' ? 'TRAY RETURN (IN)' : 'TRAY ISSUE (OUT)' %>
                        </span>
                    </td>
                </tr>
                <tr>
                    <td class="label" style="font-weight: 600; color: #1b5e20;">Tray Quantity</td>
                    <td class="value"><strong>
                            <%= tx.count %> Trays
                        </strong></td>
                </tr>
                <tr>
                    <td class="label" style="font-weight: 600; color: #1b5e20;">Rate</td>
                    <td class="value">Rs. <%= (tx.depositPerTray || 2000).toLocaleString() %> / Tray</td>
                </tr>
                <tr>
                    <td class="label" style="font-weight: 600; color: #1b5e20;">
                        <%= isOut ? 'Total Payable Amount' : 'Total Refundable Amount' %>
                    </td>
                    <td class="value"><strong>Rs. <%= totalTrayDeposit.toLocaleString('en-LK', { minimumFractionDigits:
                                2 }) %></strong></td>
                </tr>
                <tr>
                    <td class="label" style="font-weight: 600; color: #1b5e20;">
                        <%= isOut ? 'Deposit Amount' : 'Refund Amount' %>
                    </td>
                    <td class="value">
                        <strong style="color: <%= isOut ? '#b28900' : '#2e7d32' %>; font-size: 15px;">
                            Rs. <%= paidAmt.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                        </strong>
                    </td>
                </tr>
                <tr>
                    <td class="label" style="font-weight: 600; color: #1b5e20;">
                        <%= isOut ? 'Pending Deposit Balance' : 'Pending Refund Balance' %>
                    </td>
                    <td class="value">
                        <strong style="color: <%= pendingAmt > 0 ? '#d32f2f' : '#2e7d32' %>; font-size: 15px;">
                            Rs. <%= Math.abs(pendingAmt).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                                <% if (pendingAmt===0) { %>
                                    <span style="font-size: 11px; font-weight: normal; color: #666;">(Fully <%= isOut
                                            ? 'Paid' : 'Refunded' %>)</span>
                                    <% } %>
                        </strong>
                    </td>
                </tr>
                <tr>
                    <td class="label" style="font-weight: 600; color: #1b5e20;">Deposit / Payment Mode</td>
                    <td class="value">
                        <% if (tx.depositOption==='CUSTOM' || (paidAmt> 0 && paidAmt !== totalTrayDeposit && paidAmt !==
                            totalTrayDeposit / 2)) { %>
                            Custom
                            <% } else if (tx.depositOption==='HALF' || (paidAmt===totalTrayDeposit / 2 && paidAmt> 0)) {
                                %>
                                Half Payment (50%)
                                <% } else if (tx.depositOption==='ZERO' || paidAmt===0) { %>
                                    No Deposit (0%)
                                    <% } else { %>
                                        Full Deposit (100%)
                                        <% } %>
                    </td>
                </tr>
                <tr>
                    <td class="label" style="font-weight: 600; color: #1b5e20;">Vehicle No</td>
                    <td class="value"><code><%= tx.vehicleNo %></code></td>
                </tr>
                <% if (tx.remarks) { %>
                    <tr>
                        <td class="label" style="font-weight: 600; color: #1b5e20;">Remarks</td>
                        <td class="value" style="font-style: italic;">
                            <%= tx.remarks %>
                        </td>
                    </tr>
                    <% } %>
            </table>

            <!-- Deposit & Refund Summary Highlight Box -->
            <div
                style="margin: 18px 0; padding: 16px 20px; border-radius: 8px; background-color: <%= isOut ? '#fffbea' : '#e8f5e9' %>; border: 2px solid <%= isOut ? '#ffc107' : '#66bb6a' %>;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div style="font-size: 14px; font-weight: 700; color: #333;">
                            <% if (isOut) { %>
                                <i class="fa-solid fa-coins"></i> Deposit Statement (Paid & Pending):
                                <% } else { %>
                                    <i class="fa-solid fa-hand-holding-dollar"></i> Refund Statement (Paid & Pending):
                                    <% } %>
                        </div>
                        <div style="font-size: 12px; color: #555; margin-top: 4px;">
                            Total Value: <%= countQty %> Trays × Rs. <%= rate.toLocaleString() %> = <strong>Rs. <%=
                                            totalTrayDeposit.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                                    </strong>
                        </div>
                        <div
                            style="font-size: 12px; margin-top: 2px; color: <%= pendingAmt > 0 ? '#d32f2f' : '#2e7d32' %>; font-weight: 600;">
                            <%= isOut ? 'Pending Unpaid Deposit' : 'Pending Unrefunded Balance' %>: Rs. <%=
                                    Math.abs(pendingAmt).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                        </div>
                    </div>
                    <div style="text-align: right;">
                        <div
                            style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #666; margin-bottom: 2px;">
                            <%= isOut ? 'Paid Amount' : 'Refunded Amount' %>
                        </div>
                        <div style="font-size: 24px; font-weight: 900; color: <%= isOut ? '#b28900' : '#2e7d32' %>;">
                            Rs. <%= paidAmt.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                        </div>
                    </div>
                </div>
            </div>

            <div
                style="padding: 10px 14px; background-color: #f9f9f9; border-radius: 6px; font-size: 12.5px; border: 1px solid #eee; margin-bottom: 10px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 4px;">
                <div>
                    <strong>Customer's Net Tray Balance:</strong>
                    <span
                        style="font-weight: 700; color: <%= (customer && customer.currentBalance > 0) ? '#d32f2f' : '#2e7d32' %>">
                        <%= customer ? customer.currentBalance : 0 %> Trays Outstanding
                    </span>
                </div>
                <div>
                    <strong>Pending Deposit Balance:</strong>
                    <span
                        style="font-weight: 700; color: <%= (typeof totalCustomerPendingDeposit !== 'undefined' ? totalCustomerPendingDeposit : pendingAmt) > 0 ? '#d32f2f' : '#2e7d32' %>">
                        Rs. <%= (typeof totalCustomerPendingDeposit !== 'undefined' ? totalCustomerPendingDeposit : pendingAmt).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                    </span>
                </div>
            </div>

            <div class="receipt-signatures">
                <div class="signature-line">Created By</div>
                <div class="signature-line">Checked By</div>
                <div class="signature-line">Received By</div>
            </div>
    </div>

    <div class="print-actions">
        <button onclick="window.print()" class="btn btn-primary" style="padding: 12px 24px;">
            <i class="fa-solid fa-print"></i> Print Receipt Slip
        </button>
        <a href="<%= returnUrl %>" class="btn btn-secondary" style="padding: 12px 24px;">
            <i class="fa-solid fa-arrow-left"></i> <%= backBtnText %>
        </a>
    </div>



    <%- include('partials/footer') %>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('smsSent') === 'true') {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'success',
                    title: 'SMS Sent Successfully',
                    text: 'The receipt SMS was sent to the customer.',
                    timer: 3500,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                });
            }
        }
    });
</script>
